# Reference clones — cloned for investigation, not part of Verso
/sources/

# Most first-party plugin sources are independent reference repos. The plugin
# SDK and the bundled core DNS/DHCP, Firewall and System plugins are exceptions:
# the Verso packages build and ship them, so a clean shell checkout must contain
# all four.
/plugins/*
!/plugins/verso-plugin-sdk/
!/plugins/verso-plugin-sdk/**
!/plugins/verso-plugin-dnsdhcp/
!/plugins/verso-plugin-dnsdhcp/**
!/plugins/verso-plugin-firewall/
!/plugins/verso-plugin-firewall/**
!/plugins/verso-plugin-system/
!/plugins/verso-plugin-system/**
/plugins/**/target/

# Scratch research notes — not part of the project
/FINDINGS.md

# Go build artifacts
/build/
/verso
/verso-plugin-*
*.test
*.out

# Rust build artifacts
/verso-rpcd/target/

# Per-machine Makefile overrides (OPENWRT_DIR, KEY, VERSO_REPO_DIR, …)
/local.mk

# Editor / OS / tooling
.DS_Store
*.swp
/.playwright-mcp/

# Claude Code local worktrees and session state
.claude/
