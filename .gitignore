# Reference clones — cloned for investigation, not part of Verso
/sources/

# The plugin SDK and the core plugins — Interfaces, System and Firewall — live
# here. Every other plugin is a repository of its own (we-are-mono/verso-plugin-*),
# checked out beside them, where `make dev` deploys it too.
/plugins/*
!/plugins/verso-plugin-sdk/
!/plugins/verso-plugin-sdk/**
!/plugins/verso-plugin-firewall/
!/plugins/verso-plugin-firewall/**
!/plugins/verso-plugin-system/
!/plugins/verso-plugin-system/**
!/plugins/verso-plugin-interfaces/
!/plugins/verso-plugin-interfaces/**
/plugins/**/target/

# Scratch research notes — not part of the project
/FINDINGS.md

# Go build artifacts
/build/
/verso
/verso-plugin-*
*.test
*.out

# Rust build artifacts
/verso-rpcd/target/

# Per-machine Makefile overrides (OPENWRT_DIR, KEY, VERSO_REPO_DIR, …)
/local.mk

# Editor / OS / tooling
.DS_Store
*.swp
/.playwright-mcp/

# Claude Code local worktrees and session state
.claude/

# Other coding agents' local skills and hooks
/.agents/
/.codex/

# Impeccable's state, all of it local
/.impeccable/

# graphify's knowledge graph, built locally
/graphify-out/
