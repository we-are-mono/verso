{
  "verso-plugin-system": {
    "description": "Verso system configuration",
    "read": {
      "uci": [
        "system",
        "network",
        "dropbear"
      ],
      "ubus": {
        "verso": [
          "accessCredentials"
        ]
      }
    },
    "write": {
      "uci": [
        "system",
        "network",
        "dropbear"
      ],
      "ubus": {
        "verso": [
          "setSystemTime",
          "setAuthorizedKeys",
          "setWebCertificate",
          "makeWebCertificate"
        ]
      }
    }
  }
}
