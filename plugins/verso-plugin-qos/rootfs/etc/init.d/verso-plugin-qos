USE_PROCD=1
START=93
STOP=12

start_service() {
	grep -q '^verso-plugin-qos:' /etc/passwd 2>/dev/null || \
		echo 'verso-plugin-qos:x:6009:6000:Verso device limits plugin:/var/run/verso:/bin/false' >> /etc/passwd

	# The caps this plugin owns live in a config of its own; uci refuses to write
	# into a file that is not there, so the service makes sure it is.
	[ -f /etc/config/qos ] || : > /etc/config/qos

	mkdir -p /var/run/verso
	chown root:verso /var/run/verso
	chmod 1770 /var/run/verso

	procd_open_instance qos
	procd_set_param command /usr/bin/verso-plugin-qos
	procd_set_param user verso-plugin-qos
	procd_set_param group verso
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
