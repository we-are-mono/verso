{
  "dhcp": {
    "dnsmasq_main": {
      ".type": "dnsmasq",
      ".name": "dnsmasq_main",
      ".index": 0,
      "domain": "lan",
      "local": "/lan/",
      "expandhosts": "1",
      "noresolv": "1",
      "localservice": "1",
      "domainneeded": "1",
      "cachesize": "1000",
      "dnsforwardmax": "150",
      "port": "53",
      "authoritative": "1",
      "readethers": "1",
      "leasefile": "/tmp/dhcp.leases",
      "rebind_domain": "plex.direct",
      "notinterface": "loopback",
      "server": ["1.1.1.1", "9.9.9.9", "/corp.example.com/10.66.0.53"]
    },
    "domain_backup_v4": {
      ".type": "domain",
      ".name": "domain_backup_v4",
      ".index": 1,
      "name": "backup.lan",
      "ip": "10.0.0.31"
    },
    "domain_backup_v6": {
      ".type": "domain",
      ".name": "domain_backup_v6",
      ".index": 2,
      "name": "backup.lan",
      "ip": "2a00:ee2:2d00:2e00::31"
    },
    "cname_photos": {
      ".type": "cname",
      ".name": "cname_photos",
      ".index": 3,
      "cname": "photos.lan",
      "target": "nas.lan"
    },
    "cname_cloud": {
      ".type": "cname",
      ".name": "cname_cloud",
      ".index": 4,
      "cname": "cloud.lan",
      "target": "nas.lan"
    },
    "srv_matrix": {
      ".type": "srvhost",
      ".name": "srv_matrix",
      ".index": 5,
      "srv": "_matrix._tcp.lan",
      "target": "nas.lan",
      "port": "8448",
      "class": "10",
      "weight": "5"
    },
    "mx_lan": {
      ".type": "mxhost",
      ".name": "mx_lan",
      ".index": 6,
      "domain": "lan",
      "relay": "nas.lan",
      "pref": "10"
    },
    "lan": {
      ".type": "dhcp",
      ".name": "lan",
      ".index": 7,
      "interface": "lan",
      "start": "100",
      "limit": "150",
      "leasetime": "12h",
      "ra": "server",
      "dhcpv6": "server",
      "dhcp_option": ["6,10.0.0.30"]
    },
    "guest": {
      ".type": "dhcp",
      ".name": "guest",
      ".index": 8,
      "interface": "guest",
      "leasetime": "2h"
    },
    "wan": {
      ".type": "dhcp",
      ".name": "wan",
      ".index": 9,
      "interface": "wan",
      "ignore": "1",
      "leasetime": "8h"
    },
    "host_nas": {
      ".type": "host",
      ".name": "host_nas",
      ".index": 10,
      "name": "nas",
      "mac": "30:9C:23:5E:88:01",
      "ip": "10.0.0.30",
      "hostid": "::30"
    },
    "host_thermo": {
      ".type": "host",
      ".name": "host_thermo",
      ".index": 11,
      "name": "thermo-attic",
      "mac": ["b0:02:47:aa:c3:19"],
      "ip": "10.0.30.61"
    },
    "boot_pxe": {
      ".type": "boot",
      ".name": "boot_pxe",
      ".index": 12,
      "filename": "pxelinux.0",
      "serveraddress": "10.0.0.30",
      "servername": "nas"
    }
  },
  "network": {
    "loopback": {
      ".type": "interface",
      ".name": "loopback",
      ".index": 0,
      "device": "lo",
      "proto": "static",
      "ipaddr": "127.0.0.1",
      "netmask": "255.0.0.0"
    },
    "lan": {
      ".type": "interface",
      ".name": "lan",
      ".index": 1,
      "device": "br-lan",
      "proto": "static",
      "ipaddr": "10.0.0.1",
      "netmask": "255.255.255.0",
      "ip6assign": "60"
    },
    "guest": {
      ".type": "interface",
      ".name": "guest",
      ".index": 2,
      "device": "br-guest",
      "proto": "static",
      "ipaddr": "10.0.20.1",
      "netmask": "255.255.255.0"
    },
    "wan": {
      ".type": "interface",
      ".name": "wan",
      ".index": 3,
      "device": "wan0",
      "proto": "dhcp"
    }
  }
}
