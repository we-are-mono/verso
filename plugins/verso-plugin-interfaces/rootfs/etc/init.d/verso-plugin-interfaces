USE_PROCD=1
START=93
STOP=12

start_service() {
	grep -q '^verso-plugin-interfaces:' /etc/passwd 2>/dev/null || \
		echo 'verso-plugin-interfaces:x:6007:6000:Verso interfaces plugin:/var/run/verso:/bin/false' >> /etc/passwd

	# The socket has a directory of its own, which only this plugin's account
	# writes and the verso group may only reach (ADR-007). In the shared
	# /var/run/verso any plugin may create a name, and could take this one in
	# the moment a restart frees it. /var/run is root's, so nothing can stand
	# where the directory belongs before it exists. A plugin that once served
	# /var/run/verso/interfaces.sock leaves that file, its own account's, in
	# place: while it stands no other plugin can bind the old name for a shell
	# that still dials it during an upgrade, so it is never removed.
	mkdir -p /var/run/verso-plugin-interfaces
	chown verso-plugin-interfaces:verso /var/run/verso-plugin-interfaces
	chmod 0750 /var/run/verso-plugin-interfaces

	procd_open_instance interfaces
	procd_set_param command /usr/bin/verso-plugin-interfaces
	procd_set_param env VERSO_INTERFACES_SOCKET=/var/run/verso-plugin-interfaces/interfaces.sock
	procd_set_param user verso-plugin-interfaces
	procd_set_param group verso
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
