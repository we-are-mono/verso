<div class="@container">
<div data-verso-maintenance{{if .Checking}} data-verso-update-busy{{end}} class="grid min-w-0 grid-cols-1 items-start gap-10 @6xl:grid-cols-form">
  {{/* The masthead opens onto the first section without a rule. Later sections start
       with a Quiet Sand heading band, 32px after the preceding content. Bands
       extend through the frame's left gutter while their words stay aligned. */}}
  <div data-verso-form-column class="w-full min-w-0 max-w-form shrink-0">
    {{.Notices}}
    <section data-verso-section="ruled" id="firmware">
      {{/* The ledger: what this router runs part by part, with an Available
           column only while a build is offered. The check stands on the heading
           line with when it last ran, or that it has not; only a warning is
           explained, in the marigold band above the ledger. */}}
      <div data-verso-section-band class="{{template "verso-section-band-class"}}">
        <h2 class="{{template "verso-section-title-class"}}">{{t "Firmware"}}</h2>
        <form method="post" action="/system/maintenance/updates/check" class="ml-auto flex max-w-full flex-wrap items-center justify-end gap-3">
          {{template "verso-csrf" .CSRFToken}}
          {{if .Checked}}<span data-verso-section-meta class="{{template "verso-section-meta-class"}} {{template "verso-section-meta-label-class"}} tabular-nums">{{.Checked}}</span>{{end}}
          <button type="submit" data-busy-label="{{t "Checking…"}}"{{if .Checking}} disabled aria-disabled="true" aria-busy="true"{{end}} class="flex h-7 cursor-pointer items-center gap-2 rounded-xs border px-3 text-sm font-medium {{template "verso-btn-secondary"}} disabled:cursor-default disabled:border-rule disabled:bg-quiet disabled:text-sand-5">{{if .Checking}}{{template "verso-waiting" ""}}{{t "Checking…"}}{{else}}{{t "Check again"}}{{end}}</button>
        </form>
      </div>
      {{/* Handwritten content keeps the first field row's 12px top inset, as
           Access does, in addition to the heading band's 20px content gap. */}}
      <div class="flex flex-col gap-5 pt-3">
        {{/* A warning, not an error: it stands in the marigold band, words in
             the deep step. With nothing wrong there is nothing here at all. */}}
        {{if .Ledger.Title}}
        <div>
          {{/* 16px all round, the mark on the title's line, the sentence 4px
               under it. Title and sentence are one size, 14px, the title bold
               (DESIGN: inline warnings) — a step under the section's 18px
               heading, so the two never compete. The update tool's own
               words ride inside, under a marigold hairline, in mono, which is
               label enough: this is what the machine wrote. They wrap rather than scroll, because a one-line
               message cut off at the edge is a message withheld. */}}
          <div data-verso-ledger-warning class="flex items-start gap-2 rounded-xs bg-marigold-soft p-4 text-sm leading-[1.45] text-marigold-deep">
            <span aria-hidden="true" class="mt-1.75 size-1.5 shrink-0 rounded-[1px] bg-marigold"></span>
            <div class="min-w-0 flex-1">
              <p class="font-semibold">{{.Ledger.Title}}</p>
              <p class="mt-1">{{.Ledger.Lede}}</p>
              {{if .Ledger.Complaint}}
              {{/* The copy control stands on the message's own first line, beside
                   the words it copies; its 28px box is pulled up 2px so it
                   centres on the 24px line. */}}
              <div class="mt-3 flex items-start border-t border-marigold-line pt-3 leading-6">
                <p data-verso-ledger-complaint class="min-w-0 font-mono text-base leading-6 font-medium [overflow-wrap:anywhere] whitespace-pre-wrap">{{.Ledger.Complaint}}</p>
                <button type="button" x-data="copy" @click="run" :data-copy-failed="failed" aria-label="{{ t "Copy" }}" class="verso-copy-inline group/copy relative grid size-7 shrink-0 cursor-pointer place-items-center rounded-xs border border-transparent text-marigold-deep transition-colors hover:border-marigold-line hover:bg-marigold-line/50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-marigold-deep">
                  <span x-ref="src" class="hidden">{{.Ledger.Complaint}}</span>
                  <span x-show="idle">{{icon "copy" "size-4"}}</span>
                  <span x-show="done" x-cloak>{{icon "check" "size-4"}}</span>
                  <span class="{{template "verso-copy-tip-class"}}">{{template "verso-copy-label" "Copy"}}</span>
                </button>
              </div>
              {{end}}
            </div>
          </div>
        </div>
        {{end}}
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr class="border-b border-rule-strong">
                <th scope="col" class="w-px px-3.5 py-2.5"><span class="sr-only">{{t "Part"}}</span></th>
                <th scope="col" class="px-3.5 py-2.5 text-left text-xs leading-6 font-medium tracking-[.08em] whitespace-nowrap text-meta uppercase">{{t "Current"}}</th>
                {{if .Ledger.Offer}}<th scope="col" class="px-3.5 py-2.5 text-left text-xs leading-6 font-medium tracking-[.08em] whitespace-nowrap text-meta uppercase">{{t "Available"}}</th>{{end}}
              </tr>
            </thead>
            <tbody>
              {{range .Ledger.Rows}}
              <tr class="border-b border-rule hover:bg-quiet">
                <th scope="row" class="w-px px-3.5 py-2.5 text-left leading-6 font-semibold whitespace-nowrap text-body">{{.Label}}</th>
                {{/* Values keep to one line: a version broken mid-token is a misread
                     one. On a phone the revisions step aside so the diff fits. */}}
                <td class="px-3.5 py-2.5 leading-6 whitespace-nowrap">{{if .Current}}<span class="font-mono text-base font-medium text-ink">{{.Current}}</span>{{if .CurrentRev}}<span class="ml-1.5 hidden text-meta sm:inline">{{.CurrentRev}}</span>{{end}}{{else}}<span class="text-meta">{{t "Unavailable"}}</span>{{end}}</td>
                {{if $.Ledger.Offer}}<td class="px-3.5 py-2.5 leading-6 whitespace-nowrap">
                  {{- if eq .Change "changed"}}<span data-verso-ledger-changed class="inline-flex items-center gap-2"><span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] bg-denim"></span><span><span class="font-mono text-base font-medium text-ink">{{.Next}}</span>{{if .NextRev}}<span class="ml-1.5 hidden text-meta sm:inline">{{.NextRev}}</span>{{end}}</span></span>
                  {{- else if eq .Change "same"}}<span class="text-meta">{{t "same"}}</span>
                  {{- else}}<span class="text-meta" title="{{t "Not reported by the update server"}}"><span aria-hidden="true">—</span><span class="sr-only">{{t "Not reported by the update server"}}</span></span>{{end -}}
                </td>{{end}}
              </tr>
              {{end}}
            </tbody>
          </table>
        </div>
        {{if or .Ledger.Server .Ledger.Changes}}<p class="text-sm text-meta">{{.Ledger.Server}}{{if and .Ledger.Server .Ledger.Changes}} · {{end}}{{if .Ledger.Changes}}<span class="tabular-nums">{{.Ledger.Changes}}</span>{{end}}</p>{{end}}
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">{{.Install}}{{.Owut}}{{.Manual}}</div>
        {{/* The software half of "is this router current", while anything
             installed has a newer version: an info band with the answer above
             it, its door leading to Packages, where the list and its act live. */}}
        {{if .Packages}}<div id="package-updates">{{.Packages}}</div>{{end}}
        {{/* The standing arrangement is its own group, 40px off what is above
             it, and closes the section. */}}
        <div class="mt-5">{{.Autocheck}}</div>
      </div>
    </section>
    <section data-verso-section="ruled" data-verso-ruled data-verso-section-divider id="back-up-and-restore">
      <div data-verso-section-band class="{{template "verso-section-band-class"}}">
        <h2 class="{{template "verso-section-title-class"}}">{{t "Back up and restore"}}</h2>
        {{template "verso-section-lede" (t "The backup contains system and plugin settings registered with OpenWrt. Restoring replaces the saved files and reboots the router.")}}
      </div>
      <div class="flex flex-wrap items-center gap-3 pt-3">
        <a href="/system/maintenance/backup" download="openwrt-backup.tar.gz" class="flex h-9 items-center gap-2 rounded-xs border border-denim bg-denim px-4 font-semibold text-white hover:border-denim-deep hover:bg-denim-deep {{template "verso-press"}}">{{icon "download" "size-4"}}{{t "Download backup"}}</a>
        <span class="text-meta">{{t "or"}}</span>{{.Restore}}
      </div>
    </section>
    <section data-verso-section="ruled" data-verso-ruled data-verso-section-divider id="reboot">
      <div data-verso-section-band class="{{template "verso-section-band-class"}}">
        <h2 class="{{template "verso-section-title-class"}}">{{t "Reboot"}}</h2>
        <span class="{{template "verso-section-meta-class"}} ml-auto"><span class="{{template "verso-section-meta-label-class"}}">{{t "Running for"}}</span><span data-verso-section-meta class="{{template "verso-section-meta-value-class"}}">{{.Uptime}}</span></span>
      </div>
      <div class="pt-3">
        {{if .Staged}}<div class="mb-5 flex items-start gap-2 rounded-xs bg-marigold-soft px-3 py-2 text-sm leading-[1.45] text-marigold-deep"><span class="mt-1.75 size-1.5 shrink-0 rounded-[1px] bg-marigold"></span><span>{{.StageLabel}} · {{t "Apply or discard these before rebooting."}}</span></div>{{end}}
        <form method="post" action="/system/maintenance/restart" data-verso-reboot class="flex flex-wrap items-center gap-3">
          {{template "verso-csrf" .CSRFToken}}
          {{if .Staged}}
          <button type="submit" name="stage" value="apply" class="h-9 cursor-pointer rounded-xs border px-4 font-semibold {{template "verso-btn-secondary"}}">{{t "Apply changes, then reboot"}}</button>
          <button type="submit" name="stage" value="discard" class="h-9 cursor-pointer rounded-xs border border-rule-strong px-4 font-semibold text-crimson-deep hover:border-crimson hover:bg-crimson-soft">{{t "Discard and reboot"}}</button>
          {{else}}<div class="max-w-full">{{.Reboot}}</div>{{end}}
          <p data-verso-reboot-error hidden role="alert" class="w-full {{template "verso-error-line"}}"></p>
        </form>
      </div>
    </section>
    <section data-verso-section="ruled" data-verso-ruled data-verso-section-divider id="factory-reset">
      <div data-verso-section-band class="{{template "verso-section-band-class"}}">
        <h2 class="{{template "verso-section-title-class"}}">{{t "Factory reset"}}</h2>
        {{template "verso-section-lede" (t "Erase settings, installed plugins, and local data. This cannot be undone and no backup is taken for you.")}}
      </div>
      {{/* One field, one act, on one row a small step apart — the pattern a
           list's add row keeps: each control whole, its own corners and
           border. */}}
      <form method="post" action="/system/maintenance/factory-reset" data-verso-reset data-hostname="{{.Hostname}}" class="flex flex-col gap-2 pt-3">
        {{template "verso-csrf" .CSRFToken}}
        {{if .Hostname}}
        <label for="reset-host" class="text-sm text-body">{{t "Type the hostname to confirm"}} · <span class="font-mono font-medium text-ink">{{.Hostname}}</span></label>
        <div data-verso-reset-row class="flex max-w-full items-center gap-2">
          <input id="reset-host" name="hostname" required autocomplete="off" class="{{template "verso-input-class"}} {{template "verso-input-border" ""}} w-56! min-w-0">
          <button type="submit" class="h-9 shrink-0 cursor-pointer rounded-xs border border-crimson bg-crimson px-4 text-sm font-semibold text-white enabled:hover:border-crimson-deep enabled:hover:bg-crimson-deep disabled:pointer-events-none disabled:border-rule-strong disabled:bg-quiet disabled:text-glyph">{{t "Erase and start over"}}</button>
        </div>
        {{else}}
        <button type="submit" class="h-9 w-fit cursor-pointer rounded-xs border border-crimson bg-crimson px-4 text-sm font-semibold text-white enabled:hover:border-crimson-deep enabled:hover:bg-crimson-deep">{{t "Erase and start over"}}</button>
        {{end}}
      </form>
    </section>
  </div>
  <aside class="hidden min-w-0 @6xl:block">
    <h2 class="mb-3 text-xs font-medium tracking-[.08em] text-meta uppercase">{{t "On this page"}}</h2>
    <nav class="flex flex-col border-l border-rule">
      <a data-verso-rail-link href="#firmware" class="aria-[current=true]:font-semibold aria-[current=true]:text-ink aria-[current=true]:shadow-[inset_2px_0_0_var(--color-ink)] py-1.5 pl-4 text-sm font-semibold text-ink hover:text-denim-deep">{{t "Firmware"}}</a>
      <a data-verso-rail-link href="#back-up-and-restore" class="aria-[current=true]:font-semibold aria-[current=true]:text-ink aria-[current=true]:shadow-[inset_2px_0_0_var(--color-ink)] py-1.5 pl-4 text-sm text-body hover:text-ink">{{t "Back up and restore"}}</a>
      <a data-verso-rail-link href="#reboot" class="aria-[current=true]:font-semibold aria-[current=true]:text-ink aria-[current=true]:shadow-[inset_2px_0_0_var(--color-ink)] py-1.5 pl-4 text-sm text-body hover:text-ink">{{t "Reboot"}}</a>
      <a data-verso-rail-link href="#factory-reset" class="aria-[current=true]:font-semibold aria-[current=true]:text-ink aria-[current=true]:shadow-[inset_2px_0_0_var(--color-ink)] py-1.5 pl-4 text-sm text-body hover:text-ink">{{t "Factory reset"}}</a>
    </nav>
    <div class="mt-7 flex flex-col gap-2 border-t border-rule pt-4 text-sm leading-[1.45] text-body">
      <h2 class="text-xs font-medium tracking-[.08em] text-meta uppercase">{{t "Before you flash"}}</h2>
      <p class="flex items-start gap-2.5"><span class="mt-1.75 size-1.5 shrink-0 rounded-[1px] bg-green"></span>{{t "Download a backup before replacing the firmware."}}</p>
      <p class="flex items-start gap-2.5"><span class="mt-1.75 size-1.5 shrink-0 rounded-[1px] bg-marigold"></span>{{t "Use an image built for this board."}}</p>
      <p class="flex items-start gap-2.5"><span class="mt-1.75 size-1.5 shrink-0 rounded-[1px] bg-marigold"></span>{{t "Keep the router connected to power during the upgrade."}}</p>
    </div>
  </aside>
</div>
</div>
