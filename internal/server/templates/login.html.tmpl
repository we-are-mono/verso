<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in · Verso</title>
<style>{{.CSS}}</style>
</head>
<body class="min-h-screen m-0 flex items-center justify-center bg-slate-100 text-slate-900 antialiased text-sm leading-normal">
  <div class="w-full max-w-sm px-6">
    <h1 class="mb-6 text-center text-lg font-semibold tracking-tight">Verso</h1>
    <div class="rounded-md border border-slate-300 bg-white shadow-md px-8 py-8">
      <h2 class="mb-5 text-base font-medium">Sign in</h2>
      {{if .Error}}<div class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-600">{{.Error}}</div>{{end}}
      <form method="post" action="/login" class="space-y-4">
        <div class="space-y-1.5">
          <label for="username" class="block text-sm font-medium text-slate-900">Username</label>
          <input id="username" name="username" type="text" value="root" autocomplete="username" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
        </div>
        <div class="space-y-1.5">
          <label for="password" class="block text-sm font-medium text-slate-900">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
        </div>
        <button type="submit" class="w-full cursor-pointer rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-sky-700 active:bg-sky-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>
