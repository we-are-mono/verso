<!doctype html>
<html lang="{{ .Lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="Verso {{ .Version }}">
<title>{{ t "Sign in" }} · Verso</title>
{{template "verso-icons"}}
<link rel="preload" href="/assets/fonts/hanken-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inconsolata-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{.Stylesheet}}">
<style id="verso-theme">{{ .Theme }}</style>
<script src="/assets/verso-buttons.js" defer></script>
<script src="/assets/verso-login.js" defer></script>
</head>
{{/* A takeover (blocks/takeover.css): the bar names the box, and the sign-in
     card (blocks/login.css) stands in the room under it. The card is the
     shell's own widgets (loginCard); only public facts cross this boundary,
     and the browser refreshes the live ones in place, never receiving the
     authenticated overview. */}}
<body class="verso-takeover" data-verso-surface="cards">
  {{template "takeover.bar" .}}

  <main class="verso-takeover__main">
    {{/* The page is the router; signing in is its card. */}}
    <h1 class="sr-only">{{if .Hostname}}{{.Hostname}}{{else}}{{ t "This device" }}{{end}}</h1>
    <div class="verso-login" data-login data-unix="{{ .Status.Unix }}" data-offset="{{ .Status.Offset }}" data-zone="{{ .Status.Zone }}"
      data-online-label="{{.Online}}" data-offline-label="{{.Offline}}" data-unknown-label="{{.Unknown}}" data-busy-label="{{.SigningIn}}">
      {{.Card}}
    </div>
  </main>
  <template data-verso-button-waiting>{{template "verso-waiting" ""}}</template>
</body>
</html>
