{{/* verso-page-action: the page's one primary doorway, sat hard right on the
     heading row. It is the accent button of the whole page, so it speaks the
     same colour and press as the shell's own Save & Apply; anything quieter
     belongs beside the content it acts on, not up here. */}}
{{define "verso-page-action"}}<a href="{{.Href}}" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-sky-700 active:translate-y-px active:bg-sky-800 active:shadow-none motion-reduce:active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:bg-sky-700 dark:text-gray-100 dark:hover:bg-sky-800 dark:active:bg-sky-900">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>{{end}}
