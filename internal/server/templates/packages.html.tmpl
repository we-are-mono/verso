<div data-verso-packages data-package-all="{{.All}}"{{if .Busy}} data-verso-package-busy{{end}}>
{{/* The listing's control band, as every table has it. The cut is one
     dropdown: Installed and Upgradable narrow the inventory on screen, and All
     is a different listing — the cached index, paged by the router — so its
     option (or, from it, theirs) loads that listing instead of narrowing. */}}
<div data-verso-actionbar class="flex flex-wrap items-center gap-4 border-y border-rule bg-quiet p-4">
  <div class="relative flex max-w-full items-center">
    <span class="pointer-events-none absolute left-2.5 text-faint">{{icon "search" "size-4"}}</span>
    <input type="search" data-package-query {{if not .All}}data-verso-listing-filter{{end}} value="{{.Query}}" autocomplete="off" aria-label="{{t "Find a package"}}" placeholder="{{t "Find a package"}}" class="h-9 w-80 max-w-full rounded-xs border border-rule-strong bg-white pr-3 pl-8.5 text-sm text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] placeholder:text-meta hover:border-faint focus:border-denim focus:outline-none">
  </div>
  <div class="relative flex max-w-full min-w-44 items-center">
    <select data-package-cut {{if not .All}}data-verso-listing-cut{{end}} aria-label="{{t "Show"}}" class="h-9 w-full cursor-pointer appearance-none rounded-xs border border-rule-strong bg-white pr-9 pl-3 text-sm text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] transition-colors hover:border-faint focus:border-denim focus:outline-none">
      {{if .All}}
      <option value="" data-href="/system/packages">{{t "Installed"}} · {{.Installed}}</option>
      <option value="upgradable" data-href="/system/packages?tab=upgradable">{{t "Upgradable"}} · {{.Upgradable}}</option>
      <option value="all" selected>{{t "All"}} · {{.Count}}</option>
      {{else}}
      <option value="" selected>{{t "Installed"}} · {{.Installed}}</option>
      <option value="upgradable">{{t "Upgradable"}} · {{.Upgradable}}</option>
      <option value="all" data-href="/system/packages?tab=all">{{t "All"}}</option>
      {{end}}
    </select>
    <span class="pointer-events-none absolute right-3 flex text-meta">{{icon "chevron-down" "size-4"}}</span>
  </div>
  <div class="ml-auto flex flex-wrap items-center gap-3">
    <span data-package-note class="text-sm text-meta" aria-live="polite">{{.Note}}</span>
    <form data-package-refresh method="post" action="/system/packages/discover">
      {{template "verso-csrf" .CSRFToken}}<input type="hidden" name="return_to" value="/system/packages">
      <button type="submit" name="_action" value="refresh"{{if .Busy}} disabled aria-disabled="true"{{end}} class="flex h-9 items-center gap-2.5 rounded-xs border px-4 text-sm font-semibold {{if .Busy}}pointer-events-none border-rule-strong bg-quiet text-glyph{{else}}{{template "verso-btn-secondary"}}{{end}}">{{if .Busy}}{{template "verso-waiting" ""}}{{t "Refreshing index…"}}{{else}}{{t "Refresh index"}}{{end}}</button>
    </form>
  </div>
</div>
{{.Body}}
{{if .All}}<nav aria-label="{{t "Package pages"}}" class="mt-5 flex items-center gap-4 text-sm"><span class="text-meta">{{printf (t "%d matches") .Total}}</span>{{if .Previous}}<a data-package-page href="{{.Previous}}" class="text-denim-deep hover:underline">{{t "Previous"}}</a>{{end}}{{if .Next}}<a data-package-page href="{{.Next}}" class="text-denim-deep hover:underline">{{t "Next"}}</a>{{end}}</nav>{{end}}
<template data-package-waiting>{{template "verso-waiting" ""}}</template>
<p data-package-error role="alert" hidden class="mt-5 text-sm text-crimson-deep"></p>
</div>
