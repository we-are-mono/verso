<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.CSS}}</style>
</head>
<body class="min-h-screen m-0 flex flex-col bg-verso-bg text-verso-fg antialiased text-[0.9375rem] leading-normal">
<header class="border-b border-verso-border-light px-6 py-[1.125rem]">
  <h1 class="text-lg font-semibold tracking-tight">Verso</h1>
</header>
<div class="flex flex-1">
  <nav class="w-56 shrink-0 border-r border-verso-border-light px-3 pt-12 pb-4 text-sm">
    <ul class="space-y-1">
      {{range .Nav}}
      <li>
        <details {{if .Open}}open {{end}}class="group">
          <summary class="flex items-center justify-between cursor-pointer select-none list-none px-3 py-2 font-medium [&::-webkit-details-marker]:hidden">
            {{.Title}}
            <span class="verso-chevron text-verso-muted">&rsaquo;</span>
          </summary>
          <ul class="mt-0.5 space-y-0.5">
            {{range .Links}}
            <li><a href="{{.Href}}" class="block py-1.5 pl-6 pr-3 {{if .Active}}font-medium text-verso-accent{{else}}text-verso-muted{{end}}">{{.Label}}</a></li>
            {{end}}
          </ul>
        </details>
      </li>
      {{end}}
      <li><form method="post" action="/logout"><input type="hidden" name="_csrf" value="{{.CSRFToken}}"><button type="submit" class="block w-full cursor-pointer rounded px-3 py-2 text-left font-medium">Logout</button></form></li>
    </ul>
  </nav>
  <main class="flex-1 bg-verso-content pl-12 pr-6 pt-12 pb-6">
    <div class="max-w-3xl">
      {{if .NoPassword}}
      <div class="mb-8 flex items-start gap-2 rounded-md border border-verso-warning-border bg-verso-warning-bg px-4 py-3 text-sm text-verso-warning">
        <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/></svg>
        <div><span class="font-medium">No root password set.</span> Anyone who can reach this device can administer it — set one with <code>passwd</code> over SSH.</div>
      </div>
      {{end}}
      <h2 class="text-2xl font-normal tracking-tight mb-10">{{.Heading}}</h2>
      {{.Body}}
    </div>
  </main>
</div>
</body>
</html>
