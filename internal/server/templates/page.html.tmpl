<!doctype html>
<html lang="{{ .Lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{if .CSRFToken}}<meta name="verso-csrf" content="{{.CSRFToken}}">{{end}}
{{if .SessionExpiry}}<meta name="verso-session-expiry" content="{{.SessionExpiry}}">{{end}}
{{/* What htmx does with an answer, by status. A refusal (422) swaps in like a
     success: it is the panel re-rendered with the offending controls marked,
     and a refusal that showed nothing would read as a save that did nothing.
     Every other 4xx/5xx stays out of the swap and reaches the shell's script
     as an error, which shows it where the person is. */}}
<meta name="htmx-config" content='{"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true},{"code":"[45]..","swap":false,"error":true}]}'>
<title>{{.Title}}</title>
<link rel="preload" href="/assets/fonts/hanken-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inconsolata-latin.woff2" as="font" type="font/woff2" crossorigin>
<style id="verso-css">{{.CSS}}</style>
{{/* Synchronous, pre-paint: a page a staged save lands on holds the chip back
     from its first paint, until the change flies to it (CSP-safe,
     first-party). */}}
<script src="/assets/verso-boot.js"></script>
</head>
<body x-data="sidebar" class="min-h-screen m-0 flex flex-col bg-ground font-sans text-sm leading-normal text-ink">
{{/* The top bar: the device's nameplate on the left — the hostname in mono,
     then who built the board and what they call it; a fresh box with no
     readable name says what it is instead — with what waits on its stage
     beside it, and, on the right, the way out.
     The right-hand group is aligned to the content column rather than to the
     bar's own edge, so what sits there lines up with a page's primary action
     below it. White, a step above the paper the page sits on, and it stays at
     the top while the page scrolls under it. On a phone it also holds the
     hamburger that opens the rail. Only the home page adds app-wide warnings
     here. */}}
<header class="sticky top-0 z-30 flex h-14 shrink-0 items-center gap-4 border-b border-rule bg-canvas px-6">
  <button type="button" @click="toggle" x-ref="menuButton" :aria-expanded="expanded" aria-controls="verso-rail" aria-label="{{ t "Open menu" }}" class="grid size-9 shrink-0 place-items-center rounded-xs text-body transition-colors hover:bg-mid hover:text-ink md:hidden">{{icon "menu" "size-5"}}</button>
  {{/* One line whatever the name's length; where the bar has to cut it, the
       whole name is a hover away. */}}
  <a href="/" data-verso-nameplate{{if .Nameplate}} title="{{.Nameplate}}"{{end}} class="min-w-0 truncate font-mono text-xl leading-none font-bold tracking-tight text-ink">{{if .Nameplate}}{{.Nameplate}}{{else}}{{ t "This device" }}{{end}}</a>
  {{if .Maker}}<span class="hidden h-5 w-px shrink-0 bg-rule-strong sm:block"></span>
  <span class="hidden min-w-0 truncate text-sm font-light text-body sm:block"><span class="font-semibold text-ink">{{.Maker}}</span>{{if .Model}} · {{.Model}}{{end}}</span>{{end}}
  {{/* The stage's chip: how many changes wait on the router and that nothing
       is live yet, opening the review drawer — the one place the stage is
       applied or let go from (ADR-010). The stage is the router's, held and
       rolled back on the device, so it stands with the router's nameplate
       rather than with the session's way out; it never gives way, the name
       does. It shows for as long as the stage holds something. */}}
  {{template "verso-staged-chip" .Staged}}
  <div data-verso-session class="pointer-events-none absolute inset-y-0 right-0 left-0 flex items-center md:left-72">
    <div class="mx-4 flex min-w-0 max-w-6xl flex-1 items-center justify-end gap-2 sm:mx-6 md:ml-10 md:mr-10 md:gap-4">
      {{if and .Overview .NoPassword}}<a href="/system/access" title="{{ t "No administrator password is set." }} {{ t "Anyone who can reach this router can change its settings." }}" class="pointer-events-auto flex h-7 min-w-0 items-center gap-2 rounded-xs border border-crimson bg-crimson-soft px-2.5 text-sm font-semibold text-crimson-deep"><span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] bg-crimson"></span><span class="sr-only xl:not-sr-only xl:truncate">{{ t "No administrator password" }}</span></a>
      {{else if .UpdateNotice}}<a href="/system/maintenance" title="{{.UpdateNotice}}" class="pointer-events-auto flex h-7 min-w-0 items-center gap-2 rounded-xs border border-denim bg-denim-soft px-2.5 text-sm font-semibold text-denim-deep hover:border-denim-deep hover:bg-denim-soft/80"><span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] bg-denim"></span><span class="sr-only xl:not-sr-only xl:truncate">{{.UpdateNotice}}</span></a>{{end}}
      {{/* Logging out is a plain act with the identity it ends beside it: the
           account is a decided constant (ADR-007: one root credential, the shell
           its authority), so the button states the name and the verb — no
           avatar, no presence, nothing an account system would imply. */}}
      <form method="post" action="/logout" class="pointer-events-auto">
        <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
        <button type="submit" title="{{ t "End this session" }}" class="flex h-8 cursor-pointer items-center gap-2 rounded-xs border border-transparent px-3 text-sm font-medium text-body transition-colors hover:border-rule-strong hover:bg-quiet hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">
          <span class="flex text-meta">{{icon "user" "size-4"}}</span>
          <span class="font-mono text-base font-medium">root</span>
          <span class="h-3.5 w-px bg-rule-strong"></span>
          <span class="font-normal">{{ t "Log out" }}</span>
        </button>
      </form>
    </div>
  </div>
</header>
{{/* Under the bar: the rail and the page, side by side. */}}
<div class="flex min-h-0 flex-1">
{{/* Mobile: a scrim behind the off-canvas drawer; tap it to close. */}}
<div x-show="open" x-cloak @click="close" x-transition.opacity class="fixed inset-0 z-30 bg-ink/40 md:hidden"></div>
{{/* Left rail: the sidebar. On phones it's an off-canvas drawer behind the bar's
     hamburger (verso.js "sidebar"); on desktop it's the static rail under the
     bar, as tall as what the bar leaves of the screen. No fill of its own —
     one hairline separates it from the page, and only the active row is a
     surface. */}}
<aside id="verso-rail" class="verso-drawer fixed inset-y-0 left-0 z-40 flex h-screen w-72 shrink-0 flex-col border-r border-rule bg-ground md:sticky md:inset-y-auto md:top-14 md:left-auto md:z-auto md:h-[calc(100vh-3.5rem)]" :class="drawerClass" @keydown.escape.window="close">
  {{/* On a phone the rail is a drawer over the bar, so it carries its own way
       shut. */}}
  <div class="flex items-center justify-end px-4 pt-4 md:hidden">
    <button type="button" @click="close" x-ref="railClose" aria-label="{{ t "Close menu" }}" class="grid size-8 shrink-0 place-items-center rounded-xs text-faint transition-colors hover:bg-mid hover:text-ink">{{icon "x" "size-5"}}</button>
  </div>
  {{/* One flat list of destinations — no titles, no rules. The row you are in
       opens its subpages beneath it, so the rail carries the whole path. */}}
  <nav class="min-h-0 flex-1 overflow-y-auto pt-7 pb-4">
    <ul data-verso-nav-rows class="flex flex-col gap-0.5">
      {{range .Nav.Rows}}{{template "verso-nav-row" .}}{{end}}
    </ul>
  </nav>
</aside>
{{/* A page whose subject is a running stream rather than a document asks for the
     whole viewport: it fills the height, scrolls inside itself, and runs to the
     right and bottom edges instead of sitting in the reading measure. The frame
     hands it that by becoming a column and giving it the leftover height; what
     goes in it is the page's own business. */}}
{{/* Every other page is a column too, at least as tall as what the bar leaves
     of the screen, so its colophon stands at the bottom of a short page and
     under the last of a long one. */}}
<main class="@container flex min-w-0 flex-1 flex-col{{if eq .Width "full"}} h-[calc(100vh-3.5rem)] min-h-0{{end}}">
  {{/* Subpages are the rail's business — the active row opens them beneath
       itself, so a page's own depth is read in one place and the content area
       starts at the content. */}}
  {{/* Security state sits at the navigation seam, not inside one page's content. */}}
  {{if and .NoPassword (not .Overview)}}
  {{/* the square hangs on the banner's first 28px line */}}
  <div class="relative z-10 -mt-px flex items-start gap-2.5 border-y border-crimson-line bg-crimson-soft px-8 py-3 text-sm leading-7 text-crimson-deep">
    <span class="flex shrink-0 pt-1">{{template "verso-message-mark" "danger"}}</span>
    <span><span class="font-semibold">{{ t "No administrator password is set." }}</span> {{ t "Anyone who can reach this router can change its settings." }}</span>
  </div>
  {{else if .Banner}}
  <div class="relative z-10 -mt-px flex items-start gap-2.5 border-y px-8 py-3 text-sm leading-7
    {{if eq .Banner.Variant "danger"}}border-crimson-line bg-crimson-soft text-crimson-deep
    {{else if eq .Banner.Variant "warning"}}border-marigold-line bg-marigold-soft text-marigold-deep
    {{else}}border-denim-line bg-denim-soft text-denim-deep{{end}}">
    <span class="flex shrink-0 pt-1">{{if or (eq .Banner.Variant "danger") (eq .Banner.Variant "warning")}}{{template "verso-message-mark" .Banner.Variant}}{{else}}{{template "verso-message-mark" "info"}}{{end}}</span>
    <span>{{if .Banner.Title}}<span class="font-semibold">{{.Banner.Title}}</span>{{end}}{{if and .Banner.Title .Banner.Body}} {{end}}{{.Banner.Body}}</span>
  </div>
  {{end}}
  {{/* The page's frame: 40px of air on every side, and inside it a measure the
       page declares (default normal). The padding is outside the cap, so the
       cap is the content's real width rather than a box the padding eats into —
       a wide page is 1152px of content, which is what every canvas is drawn
       against. Left-aligned against the rail; no centring, which reads better
       on a wide monitor. */}}
  <div class="{{if eq .Width "full"}}flex min-h-0 flex-1 flex-col{{else}}flex-1{{end}}">
    {{/* The title stands 32px under the top edge. The masthead labels the page
         without a dividing line. The frame's bottom padding becomes the
         natural gap before the footer.
         A full page keeps the side and top air for its masthead but never the
         bottom: what is below the masthead runs to the edge. Home's display
         verdict keeps the full 40px, as far from the top as from the left. */}}
    <div class="{{if eq .Width "full"}}flex min-h-0 flex-1 flex-col px-10 pt-8{{else if .Overview}}px-4 pt-10 pb-16 sm:px-6 md:px-10{{else}}px-10 pt-8 pb-10{{end}}">
    <div class="{{if eq .Width "full"}}verso-page-full{{else if eq .Width "form"}}max-w-form{{else if eq .Width "narrow"}}max-w-4xl{{else if eq .Width "wide"}}max-w-6xl{{else}}max-w-5xl{{end}}">
    {{if or .Kicker .Subheading .Display}}
    {{/* Page titles and ledes have no divider. Their 32px bottom padding
         separates them from the content; a control band keeps its own 32px
         gap. Whatever measure the column keeps, the stylesheet ends
         the masthead's acts under Log out. Home's display verdict opens onto
         its own strip, and on a full page keeps to the top bar's column. */}}
    <div{{if not .Display}} data-verso-masthead{{end}} class="{{if .Display}}mb-5{{if eq .Width "full"}} max-w-6xl{{end}}{{else}}pb-8{{end}}">
      {{if .Back}}{{template "verso-page-back" .Back}}{{end}}
      {{if .Kicker}}<div class="verso-kicker">{{if .Live}}<span class="verso-live-dot size-1.5 shrink-0 rounded-[1px] bg-green"></span>{{end}}{{.Kicker}}{{if .KickerStatus}}<span class="text-green-deep">· {{.KickerStatus}}</span>{{end}}</div>{{end}}
      {{/* The heading line: the heading and what acts on the page, centred on
           each other; the lede reads under the line, so the act centres on the
           heading, not on the heading and its lede together. The line is an
           act's height whether it holds one or not, so moving between pages
           never shifts the heading or what sits under it. */}}
      <div class="flex min-h-9 flex-wrap items-center justify-between gap-5">
        {{/* A Display masthead's heading is the page's own subject (the device
             name), so it carries no "— <tab>" detail — that suffix labels a
             section page, and would only wrap a long device name onto its own line.
             A toned heading is a message about now, not a place-label: it tints
             in the tone vocabulary and drops the suffix the same way ("neutral"
             drops the suffix without a tint). */}}
        <h1 class="min-w-0 verso-page-heading{{if eq .Tone "info"}} text-denim-deep{{else if eq .Tone "success"}} text-green-deep{{else if eq .Tone "warning"}} text-marigold-deep{{else if eq .Tone "danger"}} text-crimson-deep{{end}}">{{.Heading}}{{if and .HeadingDetail (not .Display) (not .Tone)}}<span class="text-faint"> — {{.HeadingDetail}}</span>{{end}}</h1>
        {{if .Modes}}
        {{/* The one segmented tray every switch in the app wears: the view in
             force filled in the body ink, the rest plain words that darken
             under the pointer — never the action colour, which is for what
             leads somewhere. */}}
        <nav aria-label="{{ t "Page view" }}" class="inline-flex shrink-0 gap-0.5 rounded-xs border border-rule-strong bg-quiet p-0.5">
          {{range .Modes}}<a href="{{.Href}}"{{if .Active}} aria-current="page"{{end}} class="flex h-7.5 items-center rounded-xs px-3.5 text-sm whitespace-nowrap transition-colors {{if .Active}}pointer-events-none bg-body font-semibold text-white{{else}}font-normal text-body hover:text-ink{{end}}">{{.Label}}</a>{{end}}
        </nav>
        {{end}}
        {{if .HeadingAct}}{{.HeadingAct}}{{end}}
      </div>
      {{if .Subheading}}<p class="verso-lede">{{.Subheading}}</p>{{end}}
    </div>
    {{else if .Heading}}
    <div data-verso-masthead class="pb-8">
      {{if .Back}}{{template "verso-page-back" .Back}}{{end}}
      {{/* An act's height whether it holds one or not, as above. */}}
      <div class="flex min-h-9 flex-wrap items-center justify-between gap-5">
        <h1 class="verso-page-heading{{if eq .Tone "info"}} text-denim-deep{{else if eq .Tone "success"}} text-green-deep{{else if eq .Tone "warning"}} text-marigold-deep{{else if eq .Tone "danger"}} text-crimson-deep{{end}}">{{.Heading}}{{if and .HeadingDetail (not .Tone)}}<span class="text-faint"> — {{.HeadingDetail}}</span>{{end}}</h1>
        {{if .HeadingAct}}{{.HeadingAct}}{{end}}
      </div>
    </div>
    {{end}}
    {{/* The flash: the one-shot outcome at the top of the content — a PRG
         confirmation, or a plugin envelope's notice. Coloured by the tone
         vocabulary; rendered once by the chrome, gone on the next view. The
         partial is shared with the panel that answers its own submission, so
         an outcome reads the same wherever it lands. */}}
    {{template "verso-flash" .Flash}}
    <div{{if eq .Width "form"}} data-verso-form-column{{end}} class="verso-page-body">{{.Body}}</div>
    </div>
    </div>
  </div>
  {{/* The colophon: what runs this router, the page's last line, on a
       hairline from the rail to the window's edge; its words keep to the page's
       column and end under Log out. A log has none: it runs on as long as the
       router writes, and a footer would only be pushed away under it. The
       copy puts the facts on the clipboard as a bug report asks for them, and
       the line answers by washing what it copied, fact by fact, the way a
       selection would (verso.css). */}}
  {{if ne .Width "full"}}{{with .Colophon}}
  <footer data-verso-colophon x-data="copy" :data-copied="done" class="border-t border-rule bg-quiet">
    <div class="flex max-w-[calc(var(--container-6xl)+5rem)] items-center gap-4 px-10 py-3 font-mono text-base leading-6 text-meta">
      <p class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3">
        <span class="verso-colophon-fact font-medium">{{.Release}}</span>
        {{if .Revision}}<span aria-hidden="true" class="hidden sm:inline">·</span><span class="verso-colophon-fact hidden [--fact:1] sm:inline">{{.Revision}}</span>{{end}}
        {{if .Target}}<span aria-hidden="true" class="hidden xl:inline">·</span><span class="verso-colophon-fact hidden [--fact:2] xl:inline">{{.Target}}</span>{{end}}
      </p>
      <span class="verso-colophon-fact shrink-0 [--fact:3]">Verso {{.Verso}}</span>
      <button type="button" @click="run" :data-copy-failed="failed" aria-label="{{ t "Copy for a bug report" }}" class="group/copy relative grid {{template "verso-btn-icon"}}">
        <span x-ref="src" class="hidden">{{.Report}}</span>
        <span x-show="idle">{{icon "copy" "size-4"}}</span>
        <span x-show="done" x-cloak class="text-green">{{icon "check" "size-4"}}</span>
        <span class="{{template "verso-copy-tip-class"}}">{{template "verso-copy-label" "Copy for a bug report"}}</span>
      </button>
    </div>
  </footer>
  {{end}}{{end}}
</main>
</div>
{{/* The outcome layer: where an act made in place says how it went. A page you
     arrive at says what happened before it at the top, in the flash; an act
     taken on this page says what just happened here, at the right, under the
     bar, where the panel it came from has just gone (verso-page.js). The same
     flash element, the same words and tones; only the place and the lifetime
     differ. The sentence is read aloud through the page's announcer as it
     arrives (verso-page.js), since this layer is hidden until then. */}}
<div id="verso-outcome" hidden class="verso-outcome fixed top-[4.5rem] right-4 left-4 z-40 sm:right-6 sm:left-auto sm:w-full sm:max-w-md">
  <div data-verso-outcome-slot class="[&>.verso-flash]:mb-0 [&>.verso-flash]:pr-12 [&>.verso-flash]:shadow-[0_4px_12px_rgba(27,25,23,.14)]"></div>
  <button type="button" data-verso-outcome-close aria-label="{{ t "Close" }}" class="absolute top-2 right-2 grid size-7 cursor-pointer place-items-center rounded-xs text-meta transition-colors hover:bg-mid/50 hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim">{{icon "x" "size-4"}}</button>
</div>
{{/* The refusal navigator: while settings on the page stand refused, how many,
     and the way to the next one. It pins itself under the bar, centred over
     the content column, and counts down as each refusal is corrected — a
     refusal clears on its first change — until it says the form is ready to
     save and folds away (verso-forms.js). The fields themselves are the
     truth: the shell counts their refusals, so no plugin writes a sentence
     telling you to look for them. */}}
<div id="verso-refusals" hidden role="status" class="group/refusals fixed top-[4.25rem] left-1/2 z-20 flex h-9 -translate-x-1/2 items-center gap-2 rounded-xs border border-crimson-line bg-crimson-soft pr-1 pl-3 text-sm font-normal whitespace-nowrap text-crimson-deep shadow-[0_4px_12px_rgba(27,25,23,.14)] md:left-[calc(50%+9rem)] data-[ready]:border-green-line data-[ready]:bg-green-soft data-[ready]:text-green-deep">
  <span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] bg-crimson group-data-[ready]/refusals:bg-green"></span>
  <span data-verso-refusals-count class="inline-block pr-2"></span>
  <button type="button" data-verso-refusals-next class="flex h-7 cursor-pointer items-center gap-1 rounded-xs px-2 font-semibold transition-colors hover:bg-crimson-line/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-crimson-deep group-data-[ready]/refusals:hidden">{{ t "Next" }}{{icon "arrow-down" "size-3.5"}}</button>
</div>
{{/* The session ending: a minute before this page's session runs out, the
     page stops what it is doing and says so (verso-commit.js). An alert
     dialog, because the time is limited and the answer is one act: staying
     signed in slides the idle window, and signing out ends it now. At the
     twelve-hour cap there is nothing to slide, so the same dialog only says so
     and is acknowledged. Staged changes live in the router's stage and survive
     either way; only typing not yet saved is at risk, and the dialog says that
     rather than leaving it to be found out. */}}
{{if .SessionExpiry}}
<div id="verso-session-ending" hidden class="fixed inset-0 z-[60] flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-ink/18 backdrop-blur-[0.125rem]"></div>
  <div role="alertdialog" aria-modal="true" aria-labelledby="verso-session-ending-title" aria-describedby="verso-session-ending-body" tabindex="-1"
    class="relative w-full max-w-md rounded-xs border border-rule-strong bg-ground shadow-[0_8px_32px_rgba(27,25,23,.16)] focus:outline-none">
    <div class="px-5 pt-4 pb-5">
      <h2 id="verso-session-ending-title" class="text-base font-semibold text-ink">
        <span data-verso-session-extendable>{{ t "You’ll be signed out in" }}</span><span data-verso-session-capped hidden>{{ t "Your session ends in" }}</span>
        <span data-verso-session-countdown class="tabular-nums">1:00</span>
      </h2>
      <p id="verso-session-ending-body" class="mt-2 text-sm leading-[1.45] text-body text-pretty"><span data-verso-session-capped hidden>{{ t "Sessions last at most 12 hours." }} </span>{{ t "Staged changes are kept. Anything typed but not saved will be lost." }}</p>
      <div class="mt-6 flex items-center gap-2 border-t border-rule pt-5">
        <button type="button" data-verso-session-stay data-verso-session-extendable class="{{template "verso-btn-box"}} {{template "verso-btn-primary"}} focus-visible:outline-denim-deep">{{ t "Stay signed in" }}</button>
        <button type="button" data-verso-session-dismiss data-verso-session-capped hidden class="{{template "verso-btn-box"}} {{template "verso-btn-primary"}} focus-visible:outline-denim-deep">{{ t "Keep working" }}</button>
        <form method="post" action="/logout" class="flex">
          <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
          <button type="submit" class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{ t "Sign out" }}</button>
        </form>
      </div>
    </div>
  </div>
</div>
{{end}}
{{/* Strings the shell's client script writes into the page (verso.js T),
     localized at render — client JS has no translator (ADR-012). */}}
<script type="application/json" id="verso-i18n">{{.JSStrings}}</script>
<template data-verso-button-waiting>{{template "verso-waiting" ""}}</template>
{{/* Shell client-side JS (ADR-004), served first-party under the strict CSP. One
     file per concern, each explaining itself at its top; verso.js is the
     translator and the Alpine components the others stand on, so it comes first,
     and all of them come before Alpine — the components have to be registered
     before it boots. Deferred scripts run in the order they appear here, which is
     the whole of the ordering this needs: no file calls into another at load. */}}
<script src="/assets/verso.js" defer></script>
<script src="/assets/verso-buttons.js" defer></script>
<script src="/assets/verso-forms.js" defer></script>
<script src="/assets/verso-tables.js" defer></script>
<script src="/assets/verso-commit.js" defer></script>
<script src="/assets/verso-stream.js" defer></script>
<script src="/assets/verso-listing.js" defer></script>
<script src="/assets/verso-takeover.js" defer></script>
<script src="/assets/verso-page.js" defer></script>
<script src="/assets/verso-system.js" defer></script>
<script src="/assets/verso-packages.js" defer></script>
<script src="/assets/htmx.min.js" defer></script>
<script src="/assets/alpine.csp.min.js" defer></script>
{{if .Dev}}<script src="/assets/verso-dev.js" defer></script>{{end}}
</body>
</html>
