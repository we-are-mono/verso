<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{if .CSRFToken}}<meta name="verso-csrf" content="{{.CSRFToken}}">{{end}}
<title>{{.Title}}</title>
<link rel="preload" href="/assets/fonts/hanken.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inconsolata-latin.woff2" as="font" type="font/woff2" crossorigin>
<style>{{.CSS}}</style>
{{/* Synchronous, pre-paint: restores the Advanced-settings seam's saved state so it
     never flashes or re-animates on navigation (CSP-safe, first-party). */}}
<script src="/assets/verso-boot.js"></script>
</head>
<body x-data="sidebar" class="min-h-screen m-0 flex bg-canvas text-slate-900 antialiased font-sans text-sm leading-normal">
{{/* Mobile: a scrim behind the off-canvas drawer; tap it to close. */}}
<div x-show="open" x-cloak @click="close" x-transition.opacity class="fixed inset-0 z-30 bg-black/50 md:hidden"></div>
{{/* Left rail: the sidebar. On phones it's an off-canvas drawer behind a hamburger
     (verso.js "sidebar"); on desktop it's the static rail. */}}
<aside class="verso-drawer fixed inset-y-0 left-0 z-40 flex h-screen w-64 shrink-0 flex-col border-r border-slate-200 bg-white md:sticky md:inset-y-auto md:left-auto md:top-0 md:z-auto" :class="drawerClass" @keydown.escape.window="close">
  <div class="flex items-center justify-between px-5 py-5">
    <a href="/" class="text-lg font-semibold tracking-tight">Verso</a>
    <div class="flex items-center gap-1">
      {{/* Light/dark toggle — flips .dark on <html> and persists it (verso.js
           toggleTheme); the palette vars under :root.dark do the rest, and
           verso-boot.js re-applies the choice pre-paint on every page. */}}
      <button type="button" @click="toggleTheme" aria-label="Toggle theme" class="grid size-8 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction">{{icon "moon" "size-5 verso-theme-moon"}}{{icon "sun" "size-5 verso-theme-sun"}}</button>
      <button type="button" @click="close" aria-label="Close menu" class="grid size-8 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction md:hidden">{{icon "x" "size-5"}}</button>
    </div>
  </div>
  <nav class="min-h-0 flex-1 overflow-y-auto px-3 pb-4">
    {{/* Everyday rows — plain labels + icons, no status (the homepage owns that). */}}
    <ul class="space-y-0.5">
      {{range .Nav.Basic}}
      <li><a href="{{.Href}}"{{if .Active}} aria-current="page"{{end}} class="group flex items-center gap-2.5 rounded-xl px-2.5 py-2 transition-colors {{if .Active}}bg-slate-50 dark:bg-menu-interaction{{else}}hover:bg-slate-50 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction{{end}}">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg transition {{if .Active}}text-sky-600{{else}}text-slate-400 group-hover:translate-x-1 group-hover:text-slate-600{{end}}">{{icon .Icon "size-5"}}</span>
        <span class="text-sm transition {{if .Active}}font-semibold text-sky-600{{else}}font-medium text-slate-700 group-hover:translate-x-1 group-hover:text-slate-900{{end}}">{{.Label}}</span>
        {{if .Detail}}<span class="ml-auto flex items-center gap-1.5 text-xs font-medium {{if eq .Variant "good"}}text-green-700{{else}}text-slate-400{{end}}">
          {{if .Dot}}<span class="size-1.5 shrink-0 rounded-full {{if eq .Variant "good"}}verso-live-dot bg-green-500{{else}}bg-slate-400{{end}}"></span>{{end}}{{.Detail}}</span>{{end}}
      </a></li>
      {{end}}
    </ul>
    {{/* Advanced settings — a collapsible seam; verso.js toggles aria-expanded + persists
         it, the grid-rows CSS drives the reveal. Groups are the real manifest sections. */}}
    <div x-data="advseam" class="mt-2.5 border-t border-slate-100 pt-2.5">
      <button type="button" @click="toggle" :aria-expanded="open" aria-controls="verso-adv" class="verso-seam group flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 transition-colors hover:bg-slate-50 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition group-hover:translate-x-1 group-hover:text-slate-600">{{icon "sliders-horizontal" "size-5"}}</span>
        <span class="text-sm font-medium text-slate-700 transition group-hover:translate-x-1 group-hover:text-slate-900">Advanced settings</span>
        <span class="verso-chev ml-auto text-slate-400">{{icon "chevron-down" "size-4"}}</span>
      </button>
      <div id="verso-adv" class="verso-adv-wrap">
        <div class="verso-adv space-y-3 pt-1.5">
          {{range .Nav.Advanced}}
          <div>
            <div class="px-3 pb-0.5 text-[0.6875rem] font-bold uppercase tracking-wider text-slate-400">{{.Title}}</div>
            <ul class="space-y-0.5">
              {{range .Links}}
              <li><a href="{{.Href}}"{{if .Active}} aria-current="page"{{end}} class="group flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors {{if .Active}}bg-slate-50 font-medium text-sky-600 dark:bg-menu-interaction{{else}}text-slate-500 hover:bg-slate-50 hover:text-slate-900 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction{{end}}">
                <span class="size-1 shrink-0 rounded-full transition {{if .Active}}bg-sky-600{{else}}bg-slate-300 group-hover:translate-x-1 group-hover:bg-sky-600{{end}}"></span><span class="transition {{if not .Active}}group-hover:translate-x-1{{end}}">{{.Label}}</span></a></li>
              {{end}}
            </ul>
          </div>
          {{end}}
        </div>
      </div>
    </div>
  </nav>
  {{/* Bottom: the "update ready" device row, then sign out. */}}
  <div class="space-y-1 border-t border-slate-100 p-3">
    <a href="/plugins/hostname/" class="group relative flex items-center gap-3 rounded-xl px-2 py-2 text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction">
      <span class="relative grid size-9 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-500 transition group-hover:translate-x-1 group-hover:text-slate-600">
        {{icon "settings" "size-5"}}
        <span class="absolute -right-0.5 -top-0.5 size-2.5 rounded-full bg-amber-500 ring-2 ring-white" aria-hidden="true"></span>
      </span>
      <span class="text-sm font-medium transition group-hover:translate-x-1">This device</span>
      <span class="ml-auto text-xs font-medium text-amber-700">Update ready</span>
    </a>
    {{/* Account chip: who's signed in + a quick sign-out. */}}
    <div class="flex items-center gap-3 rounded-xl px-2 py-2">
      <span class="grid size-9 shrink-0 place-items-center rounded-full bg-sky-100 text-sm font-semibold text-sky-700">A</span>
      <div class="min-w-0 flex-1">
        <div class="truncate text-sm font-medium text-slate-900">Administrator</div>
        <div class="flex items-center gap-1.5 text-xs text-slate-500"><span class="size-1.5 shrink-0 rounded-full bg-green-500"></span>Signed in</div>
      </div>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
        <button type="submit" aria-label="Sign out" class="grid size-8 shrink-0 place-items-center rounded-lg text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction">{{icon "log-out" "size-5"}}</button>
      </form>
    </div>
  </div>
</aside>
<main class="min-w-0 flex-1{{if .Pages}} verso-haspages{{end}}">
  {{/* The top bar — third navigation tier (sidebar → domain, top bar → this
       domain's subpages, in-page → position). Full width of the content area,
       offset past the sidebar by construction; sticky on desktop so switching
       stays one click from any depth. */}}
  {{if .Pages}}
  {{/* Tabs keep 12px of internal horizontal padding for a comfortable target.
       The bar therefore starts 12px before the 32px content gutter, placing
       the first label and its active underline exactly on the content edge. */}}
  <nav class="z-30 flex h-12 items-center gap-1 border-b {{if or .NoPassword (and .Banner (eq .Banner.Variant "danger"))}}border-red-200 dark:border-red-500/20{{else}}border-slate-200{{end}} bg-white px-5 md:sticky md:top-0" aria-label="Subpages">
    {{range .Pages}}
    <a href="{{.Href}}"{{if .Active}} aria-current="page"{{end}}
      class="relative flex h-full items-center px-3 text-sm font-medium transition-colors {{if .Active}}dark:bg-menu-interaction {{if or $.NoPassword (and $.Banner (eq $.Banner.Variant "danger"))}}text-red-700 after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-red-600 dark:text-red-400 dark:after:bg-red-500{{else}}text-slate-900 after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-sky-600{{end}}{{else}}text-slate-500 hover:text-slate-900 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction{{end}}">{{.Label}}</a>
    {{end}}
  </nav>
  {{end}}
  {{/* Security state sits at the navigation seam, not inside one page's content:
       below the secondary menu when present, in that same top position otherwise. */}}
  {{if .NoPassword}}
  <div class="relative z-10 -mt-px flex h-12 items-center gap-2 border-y border-red-200 bg-red-50 px-8 text-sm text-red-700 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-300">
    {{icon "triangle-alert" "size-4 shrink-0 text-red-600 dark:text-red-400"}}
    <span><span class="font-semibold dark:text-red-400">No administrator password is set.</span> Anyone who can reach this router can change its settings.</span>
  </div>
  {{else if .Banner}}
  <div class="relative z-10 -mt-px flex h-12 items-center gap-2 border-y px-8 text-sm
    {{if eq .Banner.Variant "danger"}}border-red-200 bg-red-50 text-red-700 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-300
    {{else if eq .Banner.Variant "warning"}}border-amber-200 bg-amber-50 text-amber-800
    {{else}}border-sky-200 bg-sky-50 text-sky-800{{end}}">
    {{if eq .Banner.Variant "danger"}}{{icon "triangle-alert" "size-4 shrink-0 text-red-600 dark:text-red-400"}}
    {{else if eq .Banner.Variant "warning"}}{{icon "triangle-alert" "size-4 shrink-0 text-amber-600"}}
    {{else}}{{icon "info" "size-4 shrink-0 text-sky-600"}}{{end}}
    <span>{{if .Banner.Title}}<span class="font-semibold{{if eq .Banner.Variant "danger"}} dark:text-red-400{{end}}">{{.Banner.Title}}</span>{{end}}{{if and .Banner.Title .Banner.Body}} {{end}}{{.Banner.Body}}</span>
  </div>
  {{end}}
  {{/* Mobile top bar: the hamburger opens the drawer. */}}
  <div class="sticky top-0 z-20 flex items-center gap-3 border-b border-slate-200 bg-white/90 px-4 py-3 backdrop-blur md:hidden">
    <button type="button" @click="toggle" aria-label="Open menu" class="grid size-9 place-items-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 dark:hover:bg-menu-interaction dark:active:bg-menu-interaction">{{icon "menu" "size-5"}}</button>
    <a href="/" class="text-base font-semibold tracking-tight">Verso</a>
  </div>
  {{/* Content width is a per-page preset the page declares (default normal),
       left-aligned against the rail (no centring — better on wide monitors).
       The outer width also governs the staged-changes footer: its rules touch
       the rail on the left and stop at this same page boundary on the right. */}}
  <div class="verso-page-enter {{if eq .Width "narrow"}}max-w-4xl{{else if eq .Width "wide"}}max-w-6xl{{else}}max-w-5xl{{end}}">
    {{/* pt equals px, so the masthead sits as far from the top edge as from the
         left one. The bottom padding becomes the natural gap before the footer. */}}
    <div class="px-8 pt-8 pb-10">
    {{if or .Kicker .Subheading}}
    {{/* Artifact-style masthead a page opts into: an uppercase kicker (with a live dot),
         a serif display headline, and a lede. Falls back to the plain heading below. */}}
    <div class="mb-10">
      {{if .Kicker}}<div class="verso-kicker">{{if .Live}}<span class="verso-live-dot size-2 shrink-0 rounded-full bg-green-500"></span>{{end}}{{.Kicker}}{{if .KickerStatus}}<span class="text-emerald-600">· {{.KickerStatus}}</span>{{end}}</div>{{end}}
      <h1 class="verso-page-heading">{{.Heading}}{{if .HeadingDetail}}<span class="text-slate-400"> — {{.HeadingDetail}}</span>{{end}}</h1>
      {{if .Subheading}}<p class="verso-lede">{{.Subheading}}</p>{{end}}
    </div>
    {{else if .Heading}}
    <h2 class="text-2xl font-normal tracking-tight mb-10">{{.Heading}}{{if .HeadingDetail}}<span class="text-slate-400"> — {{.HeadingDetail}}</span>{{end}}</h2>
    {{end}}
    {{/* The PRG flash: the one-shot confirmation of the action that just
         redirected here. Rendered once by the chrome, gone on the next view. */}}
    {{if .FlashMessage}}
    <div class="verso-flash mb-6 flex items-center gap-2 rounded-md border px-4 py-3 text-sm {{if eq .FlashVariant "danger"}}border-red-200 bg-red-50 text-red-700{{else}}border-green-200 bg-green-50 text-green-700 dark:border-green-500/15 dark:bg-green-500/10 dark:text-green-300{{end}}">
      {{if eq .FlashVariant "danger"}}{{icon "circle-alert" "size-4 shrink-0"}}{{else}}{{icon "circle-check" "size-4 shrink-0"}}{{end}}
      <span>{{.FlashMessage}}</span>
    </div>
    {{end}}
    <div class="verso-page-body">{{.Body}}</div>
    </div>

    {{/* Staged-changes footer (shell-owned, verso.js "capsule"): it follows
         the page content in flow. Its top and bottom rules span from the sidebar
         boundary to the page's right edge, while its controls align with the
         content padding. It renders from UCI's own stage (ADR-010): the count
         and review list are the pending `uci changes`, server-rendered; the
         buttons post to /uci/*. Staging pages show it always (inert when clean);
         immediate-action pages only when the shared stage holds changes from
         elsewhere. Apply carries the auto-rollback promise. */}}
    {{if .ShowCapsule}}
    <div id="verso-capsule" data-csrf="{{.CSRFToken}}" data-staged-count="{{.Capsule.Count}}"
      class="verso-capsule mr-8 mb-10 rounded-r-sm border-y border-r border-slate-200 bg-surface-subtle dark:border-gray-700">
      <div class="relative flex flex-wrap items-center gap-3 px-8 py-5">
      <button type="button" id="verso-capsule-apply"{{if not .Capsule.Count}} disabled{{end}}
        class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-sky-700 disabled:pointer-events-none disabled:opacity-40 dark:bg-sky-700 dark:text-gray-100 dark:hover:bg-sky-800 dark:active:bg-sky-900">Save &amp; Apply</button>
      <button type="button" id="verso-capsule-discard"{{if not .Capsule.Count}} disabled{{end}}
        class="rounded-lg px-3.5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-100 disabled:pointer-events-none disabled:opacity-40 dark:text-gray-300 dark:hover:bg-gray-900 dark:active:bg-gray-950">Discard</button>
      {{if or .Capsule.Count .HasPageForm}}<button type="button" id="verso-capsule-review" aria-expanded="false"{{if not .Capsule.Count}} disabled{{end}}
        class="ml-auto inline-flex items-center gap-2 text-sm text-slate-500 transition-colors enabled:cursor-pointer enabled:hover:text-slate-900 disabled:pointer-events-none dark:text-gray-400 dark:enabled:hover:text-gray-200">
        <span id="verso-capsule-dot" class="size-2 shrink-0 rounded-full {{if .Capsule.Count}}bg-sky-500{{else}}bg-slate-300 dark:bg-gray-600{{end}}"></span>
        <span id="verso-capsule-text">{{.Capsule.Label}}</span>
      </button>{{else}}<span class="ml-auto inline-flex items-center gap-2 text-sm text-slate-500 dark:text-gray-400">
        <span id="verso-capsule-dot" class="size-2 shrink-0 rounded-full bg-slate-300 dark:bg-gray-600"></span>
        <span id="verso-capsule-text">{{.Capsule.Label}}</span>
      </span>{{end}}
      {{if or .Capsule.Count .HasPageForm}}
      <div id="verso-capsule-list" aria-hidden="true" class="verso-capsule-review absolute bottom-full z-10 rounded-t-sm border border-b-0 border-slate-200 bg-surface-subtle dark:border-gray-700">
        <div class="flex items-center justify-between gap-4 px-8 pt-3 pb-2">
          <div id="verso-capsule-list-title" class="text-sm font-semibold text-slate-900 dark:text-gray-100">{{.Capsule.Label}}</div>
          <button type="button" id="verso-capsule-close" aria-label="Close change review" class="grid size-7 shrink-0 place-items-center rounded text-slate-400 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 dark:hover:text-gray-100">
            {{icon "chevron-down" "size-4"}}
          </button>
        </div>
        <div id="verso-capsule-local-changes" class="hidden px-8 pb-4"></div>
        {{if .Capsule.Count}}<ul id="verso-capsule-staged-changes" class="verso-drawer-scrollbar max-h-80 space-y-1 overflow-y-auto px-8 pb-4 font-mono text-sm font-medium text-slate-700 dark:text-gray-200">
          {{range .Capsule.Items}}<li>{{.}}</li>{{end}}
        </ul>{{end}}
      </div>
      {{end}}
      </div>
    </div>
    {{end}}
  </div>
</main>
{{/* Shell client-side JS (ADR-004), served first-party under the strict CSP.
     verso.js registers the shell's Alpine components before Alpine starts. */}}
<script src="/assets/verso.js" defer></script>
<script src="/assets/htmx.min.js" defer></script>
<script src="/assets/alpine.csp.min.js" defer></script>
{{if .Dev}}<script src="/assets/verso-dev.js" defer></script>{{end}}
</body>
</html>
