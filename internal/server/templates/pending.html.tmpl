{{/* The Pending changes page's own parts (ADR-010), set into its cards as
     the shell's blocks (widget.Embed): the steps an apply takes, the acts
     under the changes, and the notification that offers an undo back. */}}

{{/* verso-pending-steps: what an apply does, numbered because it happens in
     that order, one line each. Each step names its part in the apply, so the
     page's script says each one's state as the router reports it: Saving
     then Saved, the reloads Started, the check-in counting the window down
     then Kept. A step that shortens its line carries the whole as its title.
     A step reads as a setting's name does (blocks/apply.css): what the
     apply will do is the card's content, not a note about it. */}}
{{define "verso-pending-steps"}}<ol data-verso-apply-steps class="verso-apply">
  {{range .}}<li data-verso-apply-step="{{.Kind}}"{{with .Title}} title="{{.}}"{{end}} class="verso-apply__step">
    <span class="verso-apply__number">{{.Number}}.</span>
    <span class="verso-apply__text">{{.Text}}</span>
    <span data-verso-apply-state aria-live="polite" hidden class="verso-apply__state"><span data-verso-apply-wait hidden>{{template "verso-waiting" ""}}</span><span data-verso-apply-done hidden class="verso-apply__done">{{icon "check" "size-4"}}</span><span data-verso-apply-word class="tabular-nums"></span></span>
  </li>{{end}}
</ol>{{end}}

{{/* verso-pending-acts: the page's two acts, under the changes, so they are
     read before either is pressed. Apply posts the When you apply card's
     form, which carries the note; it stands hidden until the page's script is
     there to see the apply through, since the router keeps an apply only when
     the page checks in. Discard all is the secondary act, as a Cancel is:
     nothing was applied, so the router runs as it is either way, and it lets
     the stage go without asking. They are the apply form's acts, so they
     stand where a page form's Save does: on the sand 24px under the last
     card, as one card stands under another (sections.css). */}}
{{define "verso-pending-acts"}}<div data-verso-pending-acts data-verso-form-actions data-verso-rule class="flex flex-wrap items-center gap-4">
  <button type="submit" form="verso-pending-apply" data-verso-pending-apply hidden class="verso-button">{{.Apply}}</button>
  <form method="post" action="/pending/discard" class="contents">{{template "verso-csrf" .CSRF}}<button type="submit" class="verso-button" data-verso-style="secondary">{{t "Discard all"}}</button></form>
  <noscript><span class="text-sm text-meta">{{t "Applying needs scripting: the router keeps an apply only when this page answers it."}}</span></noscript>
  {{/* What the page says when the router turns an apply away. */}}
  <template data-verso-apply-refused>{{template "verso-flash" .Refused}}</template>
</div>{{end}}

{{/* verso-pending-putback: an undo's outcome, offering what it took back
     once, in the notification's own dress. */}}
{{define "verso-pending-putback"}}<div {{template "verso-flash-attrs" "info"}}>
  {{template "verso-message-mark" "info"}}
  <span class="min-w-0 flex-1">{{.Words}}</span>
  {{if .Restorable}}<form method="post" action="/pending/restore" class="contents">{{template "verso-csrf" .CSRF}}<input type="hidden" name="undo" value="{{.Token}}"><button type="submit" class="verso-link type-button shrink-0 cursor-pointer" data-verso-door>{{t "Put it back"}}</button></form>{{end}}
</div>{{end}}
