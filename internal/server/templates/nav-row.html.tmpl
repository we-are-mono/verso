{{/* verso-nav-row: one destination in the rail, and the subpages it opens while
     it is the one you are in — the nav block (blocks/nav.css). A leading icon
     identifies each destination; the subpages share that identity and carry
     only their labels. The marker, the face of each row, its chevron, the
     branch and each subpage carry a name for the page change (--verso-vt)
     and their kind (--verso-vt-class; a chevron takes its row's), so the
     marker glides to where you are going. */}}
{{/* verso-nav-marker: where you are — one in the rail, laid behind the words of
     the place it marks. */}}
{{define "verso-nav-marker"}}<span data-verso-nav-marker aria-hidden="true" style="--verso-vt: verso-nav-marker; --verso-vt-class: verso-nav-marker" class="verso-nav__marker"></span>{{end}}
{{/* verso-nav-square: the rail's state mark, in a tone's hue; a live one
     breathes. */}}
{{define "verso-nav-square"}}<span aria-hidden="true" class="verso-mark" data-verso-tone="{{if or (eq . "success") (eq . "danger") (eq . "info")}}{{.}}{{else}}muted{{end}}"{{if eq . "success"}} data-verso-live{{end}}></span>{{end}}
{{/* A group (its subpages known on every page) is a disclosure named with
     every other, so the browser keeps one open and the keyboard and a screen
     reader get it with no script; it opens with the page it holds. Its row is
     the summary and leads nowhere. Any other row is a link, and a plugin that
     names its subpages only on its own page opens them under it there. */}}
{{define "verso-nav-row"}}
<li>
  {{if .Group}}
  <details name="verso-nav"{{if .Open}} open{{end}} class="verso-nav__group">
    <summary{{if .Hint}} title="{{.Hint}}"{{end}} class="verso-nav__row"{{template "verso-nav-row-state" .}}>{{template "verso-nav-face" .}}</summary>
    {{template "verso-nav-branch" .}}
  </details>
  {{else}}
  <a href="{{.Href}}"{{if .Active}} aria-current="page"{{end}}{{if .Hint}} title="{{.Hint}}"{{end}} class="verso-nav__row"{{template "verso-nav-row-state" .}}>
    {{if and .Active (not .Children)}}{{template "verso-nav-marker"}}{{end}}
    {{template "verso-nav-face" .}}
  </a>
  {{if and .Active .Children}}{{template "verso-nav-branch" .}}{{end}}
  {{end}}
</li>
{{end}}
{{define "verso-nav-row-state"}}{{if .Active}} data-verso-active{{if .Children}} data-verso-open{{end}}{{end}}{{end}}
{{define "verso-nav-face"}}
    <span style="--verso-vt: {{.Transition}}; --verso-vt-class: verso-nav-row" class="verso-nav__face">
      {{if .Active}}{{icon .Icon "size-4 shrink-0 text-ink"}}{{else}}{{icon .Icon "size-4 shrink-0 text-glyph"}}{{end}}
      <span class="min-w-0{{if .Detail}} shrink-0{{end}} truncate">{{.Label}}</span>
      {{/* What waits there, at the row's end: a word or two, led by the rail's
           square and tinted with it. The row's name never gives way to it; the
           words do, and the row's title keeps the whole sentence. */}}
      {{if .Detail}}<span class="verso-nav__detail"{{if eq .Variant "info"}} data-verso-tone="info"{{end}} data-verso-figures>{{if .Dot}}{{template "verso-nav-square" .Variant}}{{end}}<span class="min-w-0 truncate">{{.Detail}}</span></span>
      {{else if .Dot}}{{template "verso-nav-square" .Variant}}{{end}}
      {{/* A row that opens into subpages says so on every page: one chevron,
           pointing the way it opens while closed and turned down over its open
           branch. It is named for its row, so a page change turns it; a group's
           turns as it opens in place, on the rail's easing. */}}
      {{if or (and .Active .Children) .Opens}}<span style="--verso-vt: {{.ChevronTransition}}" class="verso-nav__chevron{{if not .Detail}} ml-auto{{end}}"{{if and (not .Group) .Active .Children}} data-verso-down{{end}}>{{icon "chevron-right" "size-4"}}</span>{{end}}
    </span>
{{end}}
{{define "verso-nav-branch"}}
  {{/* Its labels align with the parent's label 56px in, leaving the icon
       column to the first tier. Each subpage is numbered in its class so the
       page change can bring them in in order. */}}
  <ul style="--verso-vt: {{.BranchTransition}}; --verso-vt-class: verso-nav-branch" class="verso-nav__branch">
    {{range $i, $sub := .Children}}
    <li><a href="{{.Href}}"{{if .Active}} aria-current="page" data-verso-active{{end}} class="verso-nav__sub">
      {{if .Active}}{{template "verso-nav-marker"}}{{end}}
      <span style="--verso-vt: {{.Transition}}; --verso-vt-class: verso-nav-sub verso-nav-sub-{{$i}}" class="verso-nav__face"><span class="min-w-0 truncate">{{.Label}}</span></span>
    </a></li>
    {{end}}
  </ul>
{{end}}
