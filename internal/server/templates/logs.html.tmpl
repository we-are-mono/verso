<div data-verso-system-log class="contents">
  {{/* The log runs straight under the heading: what narrows it and what acts
       on it stand on the heading line (logs.acts). What stands between the
       reader and the log — a source that cannot be read — is said on a line
       of its own above it, as the firewall log does. */}}
  <p data-log-health role="status" hidden class="verso-console-notice -mx-10 border-b border-rule-strong bg-marigold-soft px-10 py-3 text-sm text-marigold-deep"></p>
  <div data-verso-console-rows data-scroll="sand" class="verso-drawer-scrollbar -mx-10 min-h-0 flex-1 overflow-y-auto bg-quiet pt-3 pb-6 shadow-[inset_0_4px_4px_-4px_rgba(27,25,23,.14)]">
    <div data-verso-stream-empty class="px-10 py-6 text-sm text-meta">{{t "Waiting for logs…"}}</div>
  </div>
</div>
{{/* logs.acts: the log's bar, on the heading line — the search first, then its
     acts as equals in the one quiet dress: the live control, which says what
     the log is doing (its title says the act) and turns its spinner while
     lines arrive, what the log offers, then the page's settings. The search
     and the live control are the firewall log's own (verso-listing-search,
     actionbar.live), so both logs read alike. */}}
{{define "logs.acts"}}
<div data-verso-actionbar="log" class="flex min-w-0 flex-wrap items-center gap-2">
  {{template "verso-listing-search" .}}
  <button type="button" data-log-pause title="{{t "Pause"}}" class="flex h-control cursor-pointer items-center gap-2 rounded-xs border px-4 text-sm font-semibold whitespace-nowrap {{template "verso-btn-secondary"}}">{{template "verso-waiting" ""}}<span data-log-pause-label>{{t "Connecting…"}}</span></button>
  <button type="button" data-log-download class="flex h-control cursor-pointer items-center rounded-xs border px-4 text-sm font-semibold whitespace-nowrap {{template "verso-btn-secondary"}}">{{t "Download"}}</button>
  <span x-data="modal" class="contents">
    <a href="/system/logs/settings" @click.prevent="showPanel" class="flex h-control items-center rounded-xs border px-4 text-sm font-semibold whitespace-nowrap {{template "verso-btn-secondary"}}">{{t "Settings"}}</a>
    {{template "verso-drawer-fetched" ""}}
  </span>
</div>
{{end}}
{{/* logs.view: how the log is read, at the head of its settings drawer and
     outside their form, so it never stages — whether the firewall's traffic
     is folded in. The page's script keeps it in step with the log
     (verso-listing.js). */}}
{{define "logs.view"}}
<label class="mb-6 flex cursor-pointer items-center gap-2 text-sm font-semibold text-ink">
  <span class="relative inline-flex size-4.5 shrink-0 items-center justify-center">
    <input type="checkbox" data-log-include-firewall class="peer sr-only">
    <span class="absolute inset-0 rounded-xs border border-choice-border bg-white shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] peer-checked:border-choice peer-checked:bg-choice peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-denim-deep"></span>
    <span class="relative text-white opacity-0 peer-checked:opacity-100">{{icon "check" "size-3.5 [stroke-width:3]"}}</span>
  </span>
  {{t "Include firewall traffic"}}
</label>
{{end}}
