<div data-verso-system-log class="contents">
  <div data-verso-actionbar class="-mx-10 flex flex-none flex-wrap items-center gap-4 border-b border-rule-strong px-10 pb-5">
    <div class="relative flex max-w-full items-center">
      <span class="pointer-events-none absolute left-2.5 text-faint">{{icon "search" "size-4"}}</span>
      <input type="search" data-verso-listing-filter autocomplete="off" aria-label="{{t "Find a message or source"}}" placeholder="{{t "Find a message or source"}}" class="h-9 w-72 max-w-full rounded-xs border border-rule-strong bg-white pr-3 pl-8.5 text-sm text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] placeholder:text-meta hover:border-faint focus:border-denim focus:outline-none">
    </div>
    <div class="inline-flex gap-0.5 rounded-xs border border-rule-strong bg-quiet p-0.5">
      <button type="button" data-verso-tab="" data-active="true" aria-pressed="true" class="pointer-events-none flex h-7.5 items-center gap-2 rounded-xs bg-body px-3.5 font-semibold text-white">{{t "All"}}<span class="font-mono font-medium text-white/70">0</span></button>
      <button type="button" data-verso-tab="warnings" aria-pressed="false" class="flex h-7.5 cursor-pointer items-center gap-2 rounded-xs px-3.5 font-normal text-body hover:text-ink">{{t "Warnings"}}<span class="font-mono font-medium text-meta">0</span></button>
      <button type="button" data-verso-tab="errors" aria-pressed="false" class="flex h-7.5 cursor-pointer items-center gap-2 rounded-xs px-3.5 font-normal text-body hover:text-ink">{{t "Errors"}}<span class="font-mono font-medium text-meta">0</span></button>
    </div>
    <div class="relative flex max-w-full items-center">
      <select aria-label="{{t "Source"}}" data-verso-listing-select="source" class="h-9 max-w-48 appearance-none rounded-xs border border-rule-strong bg-white pr-9 pl-3 font-mono text-base text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] hover:border-faint focus:border-denim focus:outline-none"><option value="">{{t "Every source"}}</option></select>
      <span class="pointer-events-none absolute right-3 text-glyph">{{icon "chevron-down" "size-4"}}</span>
    </div>
    <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-body">
      <span class="relative inline-flex size-4.5 shrink-0 items-center justify-center">
        <input type="checkbox" data-log-include-firewall class="peer sr-only"{{if .IncludeFirewall}} checked{{end}}>
        <span class="absolute inset-0 rounded-xs border border-rule-strong bg-white shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] peer-checked:border-body peer-checked:bg-body peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-denim"></span>
        <span class="relative text-white opacity-0 peer-checked:opacity-100">{{icon "check" "size-3.5 [stroke-width:3]"}}</span>
      </span>
      {{t "Include firewall traffic"}}
    </label>
    <div class="ml-auto flex flex-wrap items-center gap-2">
      <span class="mr-2 flex items-center gap-2 whitespace-nowrap text-sm text-meta"><span data-log-state-mark class="size-1.5 rounded-[1px] border border-faint"></span><span data-log-state role="status">{{t "Connecting…"}}</span></span>
      <button type="button" data-log-pause class="h-9 cursor-pointer rounded-xs border px-4 font-semibold {{template "verso-btn-secondary"}}">{{t "Pause"}}</button>
      <button type="button" data-log-download class="flex h-9 cursor-pointer items-center gap-2 rounded-xs border px-4 font-semibold {{template "verso-btn-secondary"}}">{{icon "download" "size-4"}}{{t "Download"}}</button>
      <span x-data="modal" class="contents">
        <a href="/system/logs/settings" @click.prevent="showPanel" class="flex h-9 items-center rounded-xs border px-4 font-semibold {{template "verso-btn-secondary"}}">{{t "Settings"}}</a>
        {{template "verso-drawer-fetched" ""}}
      </span>
    </div>
  </div>
  <div data-verso-console-rows data-scroll="sand" class="verso-drawer-scrollbar -mx-10 min-h-0 flex-1 overflow-y-auto bg-quiet pt-3 pb-6">
    <div data-verso-stream-empty class="px-10 py-6 text-sm text-meta">{{t "Waiting for logs…"}}</div>
  </div>
</div>
