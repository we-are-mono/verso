<div data-verso-system-log class="contents">
  {{/* The log's bar holds what narrows it; what acts on it sits on the
       heading line (logs.acts). The hairline runs to the window's edges with
       the log, while the controls keep to the content column. */}}
  <div data-verso-actionbar class="-mx-10 flex-none border-y border-rule bg-quiet px-10 py-4">
  <div class="flex w-full max-w-6xl flex-wrap items-center gap-4">
    <div class="relative flex max-w-full items-center">
      <span class="pointer-events-none absolute left-2.5 text-faint">{{icon "search" "size-4"}}</span>
      <input type="search" data-verso-listing-filter autocomplete="off" aria-label="{{t "Find a message or source"}}" placeholder="{{t "Find a message or source"}}" class="h-9 w-56 max-w-full rounded-xs border border-rule-strong bg-white pr-3 pl-8.5 text-sm text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] placeholder:text-meta hover:border-faint focus:border-denim focus:outline-none">
    </div>
    <div class="relative flex max-w-full min-w-44 items-center">
      <select data-verso-listing-cut aria-label="{{t "Show"}}" class="h-9 w-full cursor-pointer appearance-none rounded-xs border border-rule-strong bg-white pr-9 pl-3 text-sm text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] transition-colors hover:border-faint focus:border-denim focus:outline-none">
        <option value="" data-label="{{t "All messages"}}" selected>{{t "All messages"}} · 0</option>
        <option value="warnings" data-label="{{t "Warnings"}}">{{t "Warnings"}} · 0</option>
        <option value="errors" data-label="{{t "Errors"}}">{{t "Errors"}} · 0</option>
      </select>
      <span class="pointer-events-none absolute right-3 flex text-meta">{{icon "chevron-down" "size-4"}}</span>
    </div>
    <div class="relative flex max-w-full items-center">
      <select aria-label="{{t "Source"}}" data-verso-listing-select="source" class="h-9 max-w-48 appearance-none rounded-xs border border-rule-strong bg-white pr-9 pl-3 font-mono text-base text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] hover:border-faint focus:border-denim focus:outline-none"><option value="">{{t "Every source"}}</option></select>
      <span class="pointer-events-none absolute right-3 text-glyph">{{icon "chevron-down" "size-4"}}</span>
    </div>
    <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-body">
      <span class="relative inline-flex size-4.5 shrink-0 items-center justify-center">
        <input type="checkbox" data-log-include-firewall class="peer sr-only"{{if .IncludeFirewall}} checked{{end}}>
        <span class="absolute inset-0 rounded-xs border border-rule-strong bg-white shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] peer-checked:border-body peer-checked:bg-body peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-denim"></span>
        <span class="relative text-white opacity-0 peer-checked:opacity-100">{{icon "check" "size-3.5 [stroke-width:3]"}}</span>
      </span>
      {{t "Include firewall traffic"}}
    </label>
  </div>
  </div>
  {{/* What stands between the reader and the log — a source that cannot be
       read — is said on a line of its own above it, as the firewall log does. */}}
  <p data-log-health role="status" hidden class="verso-console-notice -mx-10 border-b border-rule-strong bg-marigold-soft px-10 py-3 text-sm text-marigold-deep"></p>
  <div data-verso-console-rows data-scroll="sand" class="verso-drawer-scrollbar -mx-10 min-h-0 flex-1 overflow-y-auto bg-ground pt-3 pb-6">
    <div data-verso-stream-empty class="px-10 py-6 text-sm text-meta">{{t "Waiting for logs…"}}</div>
  </div>
</div>
{{/* logs.acts: the log's acts on the heading line, as equals in the one quiet
     dress — the live control, which says what the log is doing (its title
     says the act) and turns its spinner while lines arrive, what the log
     offers, then the page's settings. The live control is the firewall log's
     own (actionbar.live), so both logs read alike. */}}
{{define "logs.acts"}}
<div class="flex shrink-0 flex-wrap items-center gap-2">
  <button type="button" data-log-pause title="{{t "Pause"}}" class="flex h-9 cursor-pointer items-center gap-2 rounded-xs border px-4 text-sm font-semibold whitespace-nowrap {{template "verso-btn-secondary"}}">{{template "verso-waiting" ""}}<span data-log-pause-label>{{t "Connecting…"}}</span></button>
  <button type="button" data-log-download class="flex h-9 cursor-pointer items-center rounded-xs border px-4 text-sm font-semibold whitespace-nowrap {{template "verso-btn-secondary"}}">{{t "Download"}}</button>
  <span x-data="modal" class="contents">
    <a href="/system/logs/settings" @click.prevent="showPanel" class="flex h-9 items-center rounded-xs border px-4 text-sm font-semibold whitespace-nowrap {{template "verso-btn-secondary"}}">{{t "Settings"}}</a>
    {{template "verso-drawer-fetched" ""}}
  </span>
</div>
{{end}}
