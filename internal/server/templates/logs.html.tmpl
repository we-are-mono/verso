<div data-verso-system-log class="verso-console">
  {{/* The log runs straight under the heading: what narrows it and what acts
       on it stand on the heading line (logs.acts). What stands between the
       reader and the log — a source that cannot be read — is said on a line
       of its own above it, as the firewall log does. */}}
  <p data-log-health role="status" hidden class="verso-console__notice"></p>
  <div data-verso-console-rows data-scroll="sand" class="verso-console__rows verso-drawer-scrollbar">
    <div data-verso-stream-empty class="verso-console__waiting">{{t "Waiting for logs…"}}</div>
  </div>
</div>
{{/* logs.acts: the log's bar, on the heading line — the search first, then its
     acts as equals in the one quiet dress: the live control, which says what
     the log is doing (its title says the act) and turns its spinner while
     lines arrive, what the log offers, then the page's settings. The search
     and the live control are the firewall log's own (verso-listing-search,
     actionbar.live), so both logs read alike. */}}
{{define "logs.acts"}}
<div class="verso-actionbar" data-verso-actionbar="log">
  {{template "verso-listing-search" .}}
  <button type="button" data-log-pause title="{{t "Pause"}}" class="verso-button" data-verso-style="secondary">{{template "verso-waiting" ""}}<span data-log-pause-label>{{t "Connecting…"}}</span></button>
  <button type="button" data-log-download class="verso-button" data-verso-style="secondary">{{t "Download"}}</button>
  <span x-data="modal" class="contents">
    <a href="/system/logs/settings" @click.prevent="showPanel" class="verso-button" data-verso-style="secondary">{{t "Settings"}}</a>
    {{template "verso-drawer-fetched" ""}}
  </span>
</div>
{{end}}
{{/* logs.view: how the log is read, at the head of its settings drawer and
     outside their form, so it never stages — whether the firewall's traffic
     is folded in. The page's script keeps it in step with the log
     (verso-listing.js). */}}
{{define "logs.view"}}
<label class="mb-6 flex cursor-pointer items-center gap-2 text-sm font-medium text-ink">
  <span class="relative inline-flex size-4 shrink-0 items-center justify-center">
    <input type="checkbox" data-log-include-firewall class="peer sr-only">
    <span class="absolute inset-0 rounded-xs border border-choice-border bg-canvas shadow-(--shadow-field) peer-checked:border-choice peer-checked:bg-choice peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-denim-deep"></span>
    <span class="relative text-on-fill opacity-0 peer-checked:opacity-100">{{icon "check" "size-3 [stroke-width:3]"}}</span>
  </span>
  {{t "Include firewall traffic"}}
</label>
{{end}}
