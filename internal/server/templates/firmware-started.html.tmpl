<!doctype html>
<html lang="{{ .Lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{range .Bars}}<meta name="theme-color"{{with .Media}} media="{{.}}"{{end}} content="{{.Colour}}">{{end}}
<title>{{ t "Firmware installation started" }} · OpenWrt</title>
{{template "verso-icons"}}
<link rel="preload" href="/assets/fonts/hanken-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{.Stylesheet}}">
<style id="verso-theme">{{.Theme}}</style>
</head>
{{/* A takeover (blocks/takeover.css), its one column in the middle of the
     window: what is happening, the one act, and what to do if it is early. */}}
<body class="verso-takeover">
  <main class="verso-takeover__main">
    <div class="verso-takeover__column">
      <p class="verso-takeover__kicker">{{ t "FIRMWARE INSTALLING" }}</p>
      <div class="verso-takeover__words">
        <h1 class="verso-takeover__title">{{ t "Your router is restarting" }}</h1>
        <p class="verso-takeover__lede">{{ t "OpenWrt is writing the verified firmware and restoring your settings. Do not disconnect power while the router completes the upgrade." }}</p>
      </div>
      <a href="/" class="verso-button verso-takeover__act">{{ t "Return to OpenWrt in about 5 minutes" }}</a>
      <p class="verso-takeover__note">{{ t "If the router is not ready when you return, wait a little longer and try again." }}</p>
    </div>
  </main>
</body>
</html>
