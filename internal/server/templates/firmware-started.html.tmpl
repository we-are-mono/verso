<!doctype html>
<html lang="{{ .Lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>{{ t "Firmware installation started" }} · OpenWrt</title>
<link rel="preload" href="/assets/fonts/hanken-latin.woff2" as="font" type="font/woff2" crossorigin>
<style>{{.CSS}}</style>
</head>
<body class="m-0 min-h-screen bg-canvas font-sans text-sm leading-normal text-ink">
  <main class="flex min-h-screen items-center px-6 py-12 sm:px-8">
    <div class="w-full max-w-lg">
      <p class="verso-kicker">{{ t "FIRMWARE INSTALLING" }}</p>
      <h1 class="text-4xl font-medium tracking-tight text-ink">{{ t "Your router is restarting" }}</h1>
      <p class="mt-4 max-w-md text-base leading-7 text-body">
        {{ t "OpenWrt is writing the verified firmware and restoring your settings. Do not disconnect power while the router completes the upgrade." }}
      </p>
      {{/* The one act on the page, in the treatment every forward act wears
           (page-action.html.tmpl): the 36px primary. */}}
      <a href="/" class="mt-8 {{template "verso-btn-box"}} {{template "verso-btn-primary"}} focus-visible:outline-denim-deep">
        {{ t "Return to OpenWrt in about 5 minutes" }}
      </a>
      <p class="mt-3 text-sm text-meta">{{ t "If the router is not ready when you return, wait a little longer and try again." }}</p>
    </div>
  </main>
</body>
</html>
