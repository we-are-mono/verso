{{/* The files a package installed (blocks/files.css). */}}
<div data-package-files class="verso-files">
  <h3 class="verso-files__title">{{t "Installed files"}}</h3>
  {{if .Files}}<ul class="verso-files__list">{{range .Files}}<li class="verso-files__path" data-verso-verbatim>{{.}}</li>{{end}}</ul>{{else}}<p class="verso-files__none">{{t "No files recorded for this package."}}</p>{{end}}
</div>
