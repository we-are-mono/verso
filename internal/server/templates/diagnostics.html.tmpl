<div data-verso-diagnostics class="contents">
  {{/* The run's output fills the sand under the heading as a log does, each
       line as the router wrote it; until something runs, it says so. */}}
  <div data-verso-diag-output data-scroll="sand" role="log" class="verso-drawer-scrollbar -mx-10 min-h-0 flex-1 overflow-y-auto bg-quiet pt-3 pb-6 shadow-[inset_0_4px_4px_-4px_rgba(27,25,23,.14)]">
    <p data-verso-diag-empty class="px-10 py-6 text-sm text-meta">{{t "Nothing run yet."}}</p>
  </div>
</div>
{{/* diagnostics.acts: what to run, on a line of its own under the heading —
     the tool, what it reaches for, the way out it leaves by and the IP family,
     then the act at the right, where Log out ends. Run rests until there is a
     target; while a run goes, Stop stands in its place. A DNS lookup is not
     bound to an interface, so the page puts that choice to rest for it
     (verso-diagnostics.js). */}}
{{define "diagnostics.acts"}}
<form data-verso-diag-form novalidate class="flex min-w-0 basis-full flex-wrap items-center gap-2">
  {{/* Each tool leads with its own glyph, the one the pick swaps in: ping's
       echo, traceroute's path, the lookup's search. */}}
  <div class="relative w-44">
    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-glyph">
      <span data-verso-diag-glyph="ping" class="flex">{{icon "radio" "size-4"}}</span>
      <span data-verso-diag-glyph="traceroute" hidden class="flex">{{icon "route" "size-4"}}</span>
      <span data-verso-diag-glyph="nslookup" hidden class="flex">{{icon "search" "size-4"}}</span>
    </span>
    <select name="tool" aria-label="{{t "Tool"}}" class="{{template "verso-input-words"}} {{template "verso-input-border" false}} cursor-pointer appearance-none pr-9 pl-9.5">
      <option value="ping" selected>{{t "Ping"}}</option>
      <option value="traceroute">{{t "Traceroute"}}</option>
      <option value="nslookup">{{t "DNS lookup"}}</option>
    </select>
    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-meta">{{icon "chevron-down" "size-4"}}</span>
  </div>
  {{/* The target offers back what this browser reached for before, newest
       first, as it is typed into (verso-diagnostics.js); the browser's own
       drop arrow stays off, so it reads as the field it is. */}}
  <div class="w-100 max-w-full">
    <input type="text" name="target" list="verso-diag-recent" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="{{t "example.com or 1.1.1.1"}}" aria-label="{{t "Host or address"}}" class="{{template "verso-input-class"}} {{template "verso-input-border" false}} [&::-webkit-calendar-picker-indicator]:hidden!">
    <datalist id="verso-diag-recent" data-verso-diag-recent></datalist>
  </div>
  {{/* The way out wears the interface's glyph, as an interface cited anywhere
       does. "any interface" is words and reads in the sans; a picked
       interface is its name, verbatim, in mono (verso-diagnostics.js). */}}
  <div class="relative w-48">
    <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-glyph">{{icon "network" "size-4"}}</span>
    <select name="interface" aria-label="{{t "Interface"}}" class="{{template "verso-input-words"}} {{template "verso-input-border" false}} cursor-pointer appearance-none pr-9 pl-9.5 disabled:cursor-default disabled:bg-quiet disabled:text-meta">
      <option value="" selected>{{t "any interface"}}</option>
      {{range .Interfaces}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
    </select>
    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-meta">{{icon "chevron-down" "size-4"}}</span>
  </div>
  {{/* The family is a cut, so a dropdown like its neighbours. */}}
  <div class="relative w-36">
    <select name="family" aria-label="{{t "IP family"}}" class="{{template "verso-input-words"}} {{template "verso-input-border" false}} cursor-pointer appearance-none pr-9 pl-3">
      {{range $i, $family := .Families}}<option value="{{.Value}}"{{if not $i}} selected{{end}}>{{.Label}}</option>{{end}}
    </select>
    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-meta">{{icon "chevron-down" "size-4"}}</span>
  </div>
  {{/* Run leads with play, the act naming its own glyph. Stop carries the
       waiting mark turning while the router answers, as a log's Live does
       while lines arrive; pressed, the mark holds still until the run's
       ending lands. */}}
  <button type="submit" data-verso-diag-run disabled class="ml-auto {{template "verso-btn-box"}} {{template "verso-btn-primary"}} {{template "verso-btn-waiting"}} focus-visible:outline-denim-deep">{{icon "play" "size-4"}}{{t "Run"}}</button>
  <button type="button" data-verso-diag-stop hidden class="ml-auto {{template "verso-btn-box"}} gap-2.5 border {{template "verso-btn-secondary"}} disabled:pointer-events-none focus-visible:outline-denim">{{template "verso-waiting" ""}}{{t "Stop"}}</button>
  <p data-verso-diag-error hidden role="alert" class="basis-full {{template "verso-error-line"}}"></p>
</form>
{{end}}
