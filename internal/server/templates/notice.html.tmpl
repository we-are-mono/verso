{{/* notice: a shell-owned message rendered through the tokens (not plugin content).
     An optional action gives the dead end a door — e.g. an unavailable plugin
     points at the management page that can turn it back on (ADR-011). */}}
{{/* One hairline on the page's own ground, and the door beside the message in the
     secondary button's treatment — the same frame and the same act every other
     boxed surface in the app wears. */}}
<section class="verso-notice" data-verso-kind="plain">
  <h3 class="verso-notice__title">{{.Title}}</h3>
  <p class="mt-1">{{.Message}}</p>
  {{if .ActionHref}}<a href="{{.ActionHref}}" class="verso-button mt-3" data-verso-style="secondary">{{.ActionLabel}}</a>{{end}}
</section>
