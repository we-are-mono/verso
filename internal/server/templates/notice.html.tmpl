{{/* notice: a shell-owned message rendered through the tokens (not plugin content).
     An optional action gives the dead end a door — e.g. an unavailable plugin
     points at the management page that can turn it back on (ADR-011). */}}
<section class="rounded-lg border border-slate-300 px-4 py-4">
  <h3 class="text-sm font-medium text-slate-900">{{.Title}}</h3>
  <p class="mt-1 text-sm text-slate-500">{{.Message}}</p>
  {{if .ActionHref}}<a href="{{.ActionHref}}" class="mt-3 inline-block rounded-md border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-900 transition-colors hover:border-sky-600 hover:text-sky-600">{{.ActionLabel}}</a>{{end}}
</section>
