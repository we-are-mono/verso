<!doctype html>
<html lang="{{ .Lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{range .Bars}}<meta name="theme-color"{{with .Media}} media="{{.}}"{{end}} content="{{.Colour}}">{{end}}
<title>{{ .Title }} · OpenWrt</title>
{{template "verso-icons"}}
<link rel="preload" href="/assets/fonts/hanken-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inconsolata-latin.woff2" as="font" type="font/woff2" crossorigin>
<style id="verso-css">{{.CSS}}</style>
<style id="verso-theme">{{.Theme}}</style>
</head>
{{/* The restarting takeover (blocks/takeover.css): the router's nameplate in
     the bar, so the person knows which box they are waiting for, and the one
     column under it. The three surfaces are all painted here;
     verso-takeover.js only moves [hidden] between them as its poll of the
     status endpoint moves, and ticks the clock. */}}
<body class="verso-takeover">
  {{template "takeover.bar" .}}
  <main class="verso-takeover__main">
    <div class="verso-takeover__column" data-verso-restarting data-verso-restarting-status="{{.Status}}" data-verso-restarting-budget="{{.Budget}}"{{with .Target}} data-verso-restarting-target="{{.}}"{{end}}>
      <div data-verso-restarting-surface="working">
        <div class="verso-takeover__state">
          <span class="verso-takeover__mark">{{template "verso-waiting" ""}}</span>
          <div class="verso-takeover__words">
            <h1 class="verso-takeover__title">{{.Title}}</h1>
            <p class="verso-takeover__lede">{{.Lede}}</p>
          </div>
        </div>
        <div class="verso-takeover__reading">
          {{/* Elapsed, not remaining: the one number this screen can say honestly. */}}
          <span data-verso-restarting-clock class="verso-takeover__clock" data-verso-figures>0:00</span>
          <span class="verso-takeover__estimate">{{.Estimate}}</span>
        </div>
        {{if .Address}}{{template "restarting.address" .Address}}{{end}}
        <p class="verso-takeover__note">{{ t "Stay on this page. It reconnects on its own and asks you to sign in." }}</p>
      </div>

      <div data-verso-restarting-surface="back" hidden>
        <div class="verso-takeover__state">
          <span class="verso-takeover__mark"><span class="verso-mark" data-verso-tone="success"></span></span>
          <div class="verso-takeover__words">
            <h1 class="verso-takeover__title">{{ t "Back online" }}</h1>
            <p class="verso-takeover__lede">{{ t "It answered. Sign in again to carry on." }}</p>
          </div>
        </div>
        <a href="/login" class="verso-button verso-takeover__act">{{ t "Sign in" }}</a>
      </div>

      <div data-verso-restarting-surface="stalled" hidden>
        <div class="verso-takeover__state">
          <span class="verso-takeover__mark"><span class="verso-mark" data-verso-tone="warning"></span></span>
          <div class="verso-takeover__words">
            <h1 class="verso-takeover__title">{{ t "This is taking longer than expected" }}</h1>
            <p class="verso-takeover__lede">{{ t "The router hasn't answered here yet. It may still be starting." }}</p>
          </div>
        </div>
        {{if .Address}}{{template "restarting.address" .Address}}{{end}}
        <a href="{{if .Target}}{{.Target}}{{else}}/{{end}}" class="verso-button verso-takeover__act" data-verso-style="secondary">{{ t "Try the router again" }}</a>
      </div>
    </div>
  </main>
{{/* verso.js carries the screen-reader announcer; verso-page.js draws the
     waiting mark; verso-takeover.js runs the poll. */}}
<script src="/assets/verso.js" defer></script>
<script src="/assets/verso-takeover.js" defer></script>
<script src="/assets/verso-page.js" defer></script>
</body>
</html>
{{/* restarting.address: where the router will answer next, when that is not
     where this page was served from — a caution beside the state. */}}
{{define "restarting.address"}}<div class="verso-notice verso-takeover__aside" data-verso-tone="warning">
  <span aria-hidden="true" class="verso-mark verso-notice__mark" data-verso-tone="warning"></span>
  <div class="verso-notice__words"><p>{{.}}</p></div>
</div>{{end}}
