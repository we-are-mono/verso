{{/* The stage's one surface in the chrome (ADR-010): the Pending changes row,
     first in the rail, standing above every destination while a change
     waits, in the caveat colour — a fact about the device, not an alarm. It
     leads to the Pending changes page. It stays on every page for as long as
     the stage holds something, which is what makes leaving a page safe
     without a word of warning.

     The row is always rendered, hidden while the stage is clean, so the page's
     script can show it in place: as a dashed ghost while an edit is not yet
     saved, then, once saved, saying in a second line what the stage took —
     the change's own words from the page (Latest) — while its count rolls to
     the new one (verso-commit.js). Nothing travels across the screen. */}}
{{define "verso-nav-pending"}}<li id="verso-pending-row" data-count="{{.Staged.Count}}"{{with .Staged.Latest}} data-latest="{{.}}"{{end}}{{if not .Staged.Count}} hidden{{end}} class="verso-pending-row mb-4">
  <a href="/pending"{{if .Nav.PendingActive}} aria-current="page"{{end}} class="verso-pending-link relative flex items-start gap-4 bg-marigold-soft py-2 pr-6 pl-6 leading-6 font-semibold text-marigold-deep focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-marigold-deep">
    <span class="grid h-6 w-4 shrink-0 place-items-center">{{icon "list-todo" "size-4"}}</span>
    <span class="verso-pending-text grid min-w-0 flex-1">
      <span class="flex min-w-0 gap-4"><span class="min-w-0 truncate">{{t "Pending changes"}}</span><span id="verso-pending-count" class="ml-auto tabular-nums">{{.Staged.Count}}</span></span>
      {{/* What the last save staged, or what Save would stage: hidden but for
           those moments, one line, cut where the rail ends. */}}
      <span class="verso-pending-line-wrap -ml-1 min-h-0 overflow-hidden"><span id="verso-pending-line" aria-live="polite" class="verso-pending-line mt-1 block truncate rounded-xs border border-dashed border-transparent px-1 text-sm leading-5.5 font-normal"></span></span>
    </span>
  </a>
</li>{{end}}

{{/* verso-menu-pending: on a phone the rail sits behind the menu button, so
     the button carries the stage's count on the caveat's wash, and an unsaved
     edit's "+1" beside it, dashed (verso-commit.js). */}}
{{define "verso-menu-pending"}}<span id="verso-menu-count" class="text-sm font-semibold tabular-nums"{{if not .Count}} hidden{{end}}>{{.Count}}</span><span id="verso-menu-ghost" hidden class="rounded-xs border border-dashed border-marigold px-1 text-xs leading-4 font-semibold tabular-nums"></span>{{end}}
