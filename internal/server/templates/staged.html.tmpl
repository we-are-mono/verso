{{/* The stage's one surface in the chrome (ADR-010): the Pending changes row,
     first in the rail, standing above every destination while a change
     waits, in the caveat colour — a fact about the device, not an alarm. It
     leads to the Pending changes page. It stays on every page for as long as
     the stage holds something, which is what makes leaving a page safe
     without a word of warning.

     The row is always rendered, hidden while the stage is clean, so an act
     that stages without a reload can show it in place with the new count
     (verso-commit.js). Latest, the newest change in the page's own words, is
     what a screen reader hears then. A Save reloads the page, which draws the
     row anew; nothing previews an edit before it, and nothing animates. */}}
{{define "verso-nav-pending"}}<li id="verso-pending-row" data-count="{{.Staged.Count}}"{{with .Staged.Latest}} data-latest="{{.}}"{{end}}{{if not .Staged.Count}} hidden{{end}}>
  {{/* A rail row like the rest (nav-row.html.tmpl): the same 40px, flush with
       the rows under it, sliding under the pointer but on its own page, and
       keeping its wash. */}}
  <a href="/pending"{{if .Nav.PendingActive}} aria-current="page"{{end}} class="verso-nav__row" data-verso-stage>
    <span class="verso-nav__face">
      <span class="grid h-6 w-4 shrink-0 place-items-center">{{icon "list-todo" "size-4"}}</span>
      <span class="min-w-0 truncate">{{t "Pending changes"}}</span><span id="verso-pending-count" class="ml-auto tabular-nums">{{.Staged.Count}}</span>
    </span>
  </a>
</li>{{end}}

{{/* verso-menu-pending: on a phone the rail sits behind the menu button, so
     the button carries the stage's count on the caveat's wash. */}}
{{define "verso-menu-pending"}}<span id="verso-menu-count" class="verso-bar__count" data-verso-figures{{if not .Count}} hidden{{end}}>{{.Count}}</span>{{end}}
