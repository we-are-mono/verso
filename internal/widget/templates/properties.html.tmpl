{{/* properties: a label/value detail list (a <dl>) — label left, value right, so the
     facts about one thing line up and scan cleanly. Style picks the row separator:
     "plain" (none) or the default hairline between rows. The class strings live here
     (not in Go) so Tailwind's scanner keeps them. A row may offer an inline copy
     button (shell-owned "copy", verso.js); icons from icons.go. */}}
{{/* verso-copy-inline: the icon-sized copy control beside a value — context is the
     text to copy. Shared by properties rows and mono table cells. */}}
{{/* The control is a 24px square that only fills on hover, so a column of them
     beside a column of addresses stays a column of addresses. Its glyph rests at
     the mark step, darkens to ink under the pointer, and turns green the moment
     the value is on the clipboard — the one place a hue at full chroma answers
     an act rather than states a condition. */}}
{{define "verso-copy-inline"}}<button type="button" x-data="copy" @click="run" aria-label="{{ t "Copy" }}" class="group/copy relative ml-1 inline-grid size-6 shrink-0 place-items-center rounded-xs align-middle text-glyph transition-colors hover:bg-rule hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim">
  <span x-ref="src" class="hidden">{{.}}</span>
  <span x-show="idle">{{icon "copy" "size-4"}}</span>
  <span x-show="done" x-cloak class="text-green">{{icon "check" "size-4"}}</span>
  {{/* The bubble sits above the control and flush to its right edge, which is
       what keeps it inside the table on the last column. Pure-CSS reveal on
       hover/keyboard focus — the group is NAMED so an ancestor `group` (a table
       row wears one for its border styling) can never reveal it from afar. */}}
  <span class="{{template "verso-tip-class"}} group-hover/copy:opacity-100 group-focus-visible/copy:opacity-100">
    <span x-show="idle">{{ t "Copy" }}</span>
    <span x-show="done" x-cloak>{{ t "Copied" }}</span>
  </span>
</button>{{end}}
{{/* verso-mark-hue: the packet's fill for a tone — the hue at full chroma, as
     a mark; no tone is the hollow packet, the absent state. Still, never the
     live ring: a fact on a sheet is read, not streamed. */}}
{{define "verso-mark-hue"}}{{if eq . "success"}}bg-green{{else if eq . "warning"}}bg-marigold{{else if eq . "danger"}}bg-crimson{{else if eq . "info"}}bg-denim{{else}}border border-faint{{end}}{{end}}
{{/* verso-prop-span: a stretch between two ends, drawn as the meter's own
     track — never a hairline, which a list of hairline rows would swallow —
     filled in the state's hue up to where now is. The ends are written under
     the track's ends; a screen reader hears them as one range. */}}
{{define "verso-prop-span"}}<span class="sr-only">{{.From}} – {{.To}}</span><span class="block w-full" aria-hidden="true"><span class="relative block h-6"><span class="absolute inset-x-0 top-1/2 h-1.5 -translate-y-1/2 rounded-full bg-rule"></span><span class="absolute left-0 top-1/2 h-1.5 -translate-y-1/2 rounded-full {{template "verso-mark-hue" .Tone}}" style="width: {{.Pos}}"></span></span><span class="flex justify-between gap-4 text-sm font-normal text-meta tabular-nums"><span class="whitespace-nowrap">{{.From}}</span><span class="whitespace-nowrap">{{.To}}</span></span></span>{{end}}
<dl class="{{if or (eq .Style "overview-system") (eq .Style "overview-connection")}}divide-y divide-mid{{else if eq .Style "system"}}space-y-0{{else if or (eq .Style "plain") (eq .Style "identity")}}space-y-3{{else}}divide-y divide-mid{{end}}">
  {{range .Items}}
  {{if or (eq $.Style "overview-system") (eq $.Style "overview-connection")}}
  {{/* 44px, never stated: a 24px line — the mono value's own, the sans label
       and value raised to it — with 10px above and below. */}}
  <div class="flex items-center gap-6 py-2.5{{if eq $.Style "overview-connection"}} first:border-t first:border-mid{{end}}">
    <dt class="shrink-0 text-sm leading-6 text-meta{{if eq $.Style "overview-connection"}} w-24 truncate{{end}}" title="{{.Label}}">{{.Label}}</dt>
    <dd class="flex min-w-0 items-center text-ink{{if eq $.Style "overview-system"}} ml-auto text-right{{end}}">
      {{if .Dot}}<span class="mr-2.5 size-1.5 shrink-0 rounded-[1px] {{if eq .Dot "success"}}bg-green{{else if eq .Dot "warning"}}bg-marigold{{else if eq .Dot "danger"}}bg-crimson{{else}}border border-faint{{end}}"{{if .Key}} data-verso-prop-dot="{{.Key}}"{{end}} aria-hidden="true"></span>{{end}}
      <span{{if .Key}} data-verso-prop="{{.Key}}"{{end}} class="min-w-0 wrap-anywhere font-medium {{if .Mono}}font-mono text-base{{else}}text-sm leading-6{{end}}">{{.Value}}</span>{{if eq .Key "temperature"}}<span data-overview-temp-note class="ml-1 font-sans text-sm font-normal text-meta">{{if .Help}}· {{.Help}}{{end}}</span>{{end}}{{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}
    </dd>
  </div>
  {{else if eq $.Style "identity"}}
  <div>
    <div class="flex items-baseline gap-2 text-base">
      <dt class="text-meta">{{.Label}}:</dt>
      <dd class="{{if and .Mono .Emphasis}}text-lg font-semibold{{else}}font-medium{{end}} {{if .Variant}}{{template "verso-tone-text" .Variant}}{{else}}text-ink{{end}}{{if .Mono}} font-mono{{end}}">{{.Value}}</dd>
    </div>
    {{if .Help}}<p class="mt-1 text-sm leading-snug text-body">{{.Help}}</p>{{end}}
  </div>
  {{else if eq $.Style "system"}}
  {{/* the same 44px row as the overview's: the value's 24px line, inset 10px,
       everything in it a flex item so no glyph's box can lift the line. */}}
  <div class="flex items-center justify-between gap-6 border-t border-mid py-2.5">
    <dt class="text-sm leading-6 text-meta">{{.Label}}</dt>
    <dd class="flex items-center text-sm font-medium text-ink">
      {{if .Dot}}<span class="mr-2 size-1.5 shrink-0 rounded-[1px] {{template "verso-tone-dot" .Dot}}"{{if .Key}} data-verso-prop-dot="{{.Key}}"{{end}}></span>{{end}}<span{{if .Key}} data-verso-prop="{{.Key}}"{{end}} class="{{if .Mono}}font-mono text-base font-medium{{end}}{{if .Variant}} {{template "verso-tone-text" .Variant}}{{end}}">{{.Value}}</span>{{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}
    </dd>
  </div>
  {{else}}
  {{/* A ruled row is the 44px one — a 24px line inset 10px — and its value
       is a flex line too, so a copy control or a badge sits on the line rather
       than lifting it. The plain list has no rows to keep to and keeps the
       type's own line. */}}
  {{/* Every part of a row is a 24px line, and the row hangs from its first:
       a value that wraps keeps its label, copy control and pill level with its
       top line. A row's mark hangs in the gutter, centred on that line, so a
       marked value starts where every other row's value does; its note sits
       under the value, in the value's column, and wraps there. */}}
  {{/* Left-set facts are a document's, read beside a fixed label column; on a
       phone the label sits over its value, which then has the card's width. */}}
  <div class="flex {{if eq $.Align "left"}}flex-col items-start gap-y-1 sm:flex-row {{if .Help}}sm:flex-wrap {{end}}gap-x-6{{else}}{{if .Help}}flex-wrap gap-y-1 {{end}}items-start justify-between gap-x-6{{end}} text-sm{{if eq $.Style "plain"}}{{else}} py-2.5 leading-6{{end}}">
    <dt class="shrink-0 text-meta{{if eq $.Align "left"}} sm:w-24{{end}}">{{.Label}}</dt>
    <dd class="relative flex min-w-0 items-start {{if eq $.Align "left"}}self-stretch sm:flex-1 sm:self-auto text-left{{else if .Span}}min-w-0 flex-1 text-left{{else}}justify-end text-right{{end}}{{if .Emphasis}} text-base{{end}} font-medium text-ink">
      {{if .Span}}{{template "verso-prop-span" .Span}}{{else}}
      {{if .Dot}}<span class="absolute -left-3.75 top-2.25 size-1.5 rounded-[1px] {{template "verso-mark-hue" .Dot}}" aria-hidden="true"></span>{{end}}
      {{if .Chip}}<span class="{{template "verso-chip-class"}}">{{.Value}}</span>{{else}}<span class="min-w-0 wrap-anywhere text-balance{{if .Mono}} font-mono text-base font-medium{{end}}{{if .Variant}} {{template "verso-tone-text" .Variant}}{{end}}">{{.Value}}</span>{{end}}
      {{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}
      {{if .Status}}<span class="{{if eq $.Align "left"}}ml-auto pl-3{{else}}ml-2{{end}} inline-flex h-6 shrink-0 items-center">{{template "badge.html.tmpl" .Status}}</span>{{end}}
      {{end}}
    </dd>
    {{if .Help}}<p class="basis-full {{if eq $.Align "left"}}sm:pl-30{{else}}text-right{{end}} text-sm leading-snug font-normal text-body">{{.Help}}</p>{{end}}
  </div>
  {{end}}
  {{end}}
</dl>
