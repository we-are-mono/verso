{{/* properties: a label/value detail list (a <dl>) — label left, value right, so the
     facts about one thing line up and scan cleanly. Style picks the row separator:
     "plain" (none) or the default hairline between rows. A "system" list is ruled
     above and below, and under anything before it holds 8px over its first
     rule, so the stack's 24px step becomes the 32px a drawer's content stands
     under its chrome. Padding, not margin: an inline link above it would not
     collapse a margin into the step. The class strings live here
     (not in Go) so Tailwind's scanner keeps them. A row may offer an inline copy
     button (shell-owned "copy", verso.js); icons from icons.go. */}}
{{/* verso-copy-inline: the icon-sized copy control beside a value — context is the
     text to copy. Shared by properties rows and mono table cells. */}}
{{/* The control is a 28px square that only fills on hover, so a column of them
     beside a column of addresses stays a column of addresses. Its glyph rests at
     the mark step, darkens to ink under the pointer, and turns green the moment
     the value is on the clipboard — the one place a hue at full chroma answers
     an act rather than states a condition. */}}
{{define "verso-copy-inline"}}<button type="button" x-data="copy" @click="run" :data-copy-failed="failed" aria-label="{{ t "Copy" }} {{.}}" class="verso-button verso-copy-inline group/copy relative inline-grid align-middle" data-verso-size="icon">
  <span x-ref="src" class="hidden">{{.}}</span>
  <span x-show="idle">{{icon "copy" "size-4"}}</span>
  <span x-show="done" x-cloak class="text-green">{{icon "check" "size-4"}}</span>
  {{/* The bubble sits above the control and flush to its right edge, which is
       what keeps it inside the table on the last column. Pure-CSS reveal on
       hover/keyboard focus — the group is NAMED so an ancestor `group` (a table
       row wears one for its border styling) can never reveal it from afar. */}}
  {{template "verso-copy-tip" "Copy"}}
</button>{{end}}
{{/* verso-mark-hue: the packet's fill for a tone — the hue at full chroma, as
     a mark; no tone is the hollow packet, the absent state. Still, never the
     live ring: a fact on a sheet is read, not streamed. */}}
{{define "verso-mark-hue"}}{{if eq . "success"}}bg-green{{else if eq . "warning"}}bg-marigold{{else if eq . "danger"}}bg-crimson{{else if eq . "info"}}bg-denim{{else}}border border-faint{{end}}{{end}}
{{/* verso-prop-span: a stretch between two ends, drawn as the meter's own
     track — never a hairline, which a list of hairline rows would swallow —
     filled in the state's hue up to where now is. The ends are written under
     the track's ends; a screen reader hears them as one range. */}}
{{define "verso-prop-span"}}<span class="sr-only">{{.From}} – {{.To}}</span><span class="block w-full" aria-hidden="true"><span class="relative block h-6"><span class="absolute inset-x-0 top-1/2 h-1.5 -translate-y-1/2 rounded-full bg-rule"></span><span class="absolute left-0 top-1/2 h-1.5 -translate-y-1/2 rounded-full {{template "verso-mark-hue" .Tone}}" style="width: {{.Pos}}"></span></span><span class="flex justify-between gap-4 text-sm font-normal text-meta tabular-nums"><span class="whitespace-nowrap">{{.From}}</span><span class="whitespace-nowrap">{{.To}}</span></span></span>{{end}}
{{/* The head names the facts on a line of their own: its 24px line, 8px
     over and under, on the strong hairline a column head stands on, so the
     hairline lands on a line and the first row stands 7px after it, as every
     row after a hairline does. A group's title is a heading, its protocol a
     chip beside it; two column names (Part, Current) stand over the labels
     and the values, set as the head of a table is. */}}
{{define "properties.head"}}<div data-verso-properties-head class="flex items-center {{if .Head.Value}}gap-x-6{{else}}gap-3{{end}} border-b border-rule-strong py-2 text-sm leading-6 font-semibold text-ink">
  {{if .Head.Value}}<span class="shrink-0{{if eq .Align "left"}} sm:w-24{{end}}">{{.Head.Label}}</span><span{{if ne .Align "left"}} class="ml-auto"{{end}}>{{.Head.Value}}</span>
  {{else}}<h3 class="text-sm leading-6 font-semibold text-ink">{{.Head.Label}}</h3>{{if .Head.Chip}}<span class="verso-chip" data-verso-verbatim>{{.Head.Chip}}</span>{{end}}{{end}}
</div>{{end}}
{{if .Head}}<section aria-label="{{.Head.Label}}" class="min-w-0">{{template "properties.head" .}}{{end}}
{{/* No facts: the empty set's slot where the first row would stand, its
     frame 7px after the head's hairline so it lands on a line. */}}
{{if and .Empty (not .Items)}}<div{{if .Head}} class="pt-1.75"{{end}}><div data-verso-slot class="{{template "verso-empty-slot-class"}}">{{template "verso-empty-slot-body" .Empty}}</div></div>{{else}}
{{$first := "first:pt-2"}}{{if .Head}}{{$first = "first:pt-1.75"}}{{end}}
<dl class="{{if eq .Style "system"}}space-y-0 border-b border-mid not-first:pt-1.75{{else if or (eq .Style "plain") (eq .Style "identity")}}space-y-3{{end}}">
  {{range .Items}}
  {{if eq $.Style "identity"}}
  <div>
    <div class="flex items-baseline gap-2 text-base">
      <dt class="text-meta">{{.Label}}:</dt>
      <dd{{if .Mono}} data-verso-verbatim{{end}}{{if .Figures}} data-verso-figures{{end}} class="{{if and .Mono .Emphasis}}text-lg font-semibold{{else}}font-medium{{end}} {{if .Variant}}{{template "verso-tone-text" .Variant}}{{else}}text-ink{{end}}{{if .Mono}} font-mono{{end}}">{{.Value}}</dd>
    </div>
    {{if .Help}}<p class="mt-1 text-sm leading-snug text-body">{{.Help}}</p>{{end}}
  </div>
  {{else if eq $.Style "system"}}
  {{/* the same 44px row as the overview's: the value's 24px line, inset 10px,
       everything in it a flex item so no glyph's box can lift the line. */}}
  <div class="flex {{if .Next}}items-start{{else}}items-center{{end}} justify-between gap-6 border-t border-mid py-2.5">
    <dt class="text-sm leading-6 text-meta">{{.Label}}</dt>
    <dd class="flex items-center text-sm font-medium text-ink">
      {{if .Next}}{{/* what it becomes, under what it is, as a table's cell says it */}}<span data-verso-prop-next{{if .Mono}} data-verso-verbatim{{end}} class="flex flex-col items-end{{if .Mono}} font-mono text-base font-medium{{end}}"><span class="text-meta">{{.Value}}</span><span class="flex items-center gap-1.5 text-ink"><span role="img" aria-label="{{t "Available version"}}" title="{{t "Available version"}}" class="flex shrink-0 text-denim">{{icon "corner-down-right" "size-4"}}</span><span>{{.Next}}</span></span></span>{{else}}{{if .Dot}}<span class="verso-mark mr-2" data-verso-tone="{{template "verso-dot-tone" .Dot}}"{{if eq .Dot "success"}} data-verso-live{{end}}{{if .Key}} data-verso-prop-dot="{{.Key}}"{{end}}></span>{{end}}<span{{if .Key}} data-verso-prop="{{.Key}}"{{end}}{{if .Mono}} data-verso-verbatim{{end}}{{if .Figures}} data-verso-figures{{end}} class="{{if .Mono}}font-mono text-base font-medium{{end}}{{if .Duration}} tabular-nums{{end}}{{if .Variant}} {{template "verso-tone-text" .Variant}}{{end}}">{{.Value}}</span>{{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}{{end}}
    </dd>
  </div>
  {{else}}
  {{/* A ruled row is a row of the notebook's grid: every part of it writes on
       the 20px lines with 10px over the first and 9px under the last, and its
       hairline is the next pixel, so a row is a cell more than its lines; the
       last draws none and keeps that pixel as air. Its value is a flex line
       too, so a copy control or a badge rides the line rather than lifting
       it. The plain list has no rows to keep to and keeps the type's own
       line. */}}
  {{/* The row hangs from its first line: a value that wraps keeps its label,
       copy control and pill level with its top line. A row's mark hangs in the
       gutter, centred on that line, so a marked value starts where every other
       row's value does; its note sits under the value, in the value's column,
       and wraps there. */}}
  {{/* Left-set facts are a document's, read beside a fixed label column; on a
       phone the label sits over its value, which then has the card's width.
       A live row carries its key, so the stream rewrites its value (and its
       mark) in place. */}}
  <div class="flex {{if eq $.Align "left"}}flex-col items-start sm:flex-row {{if .Help}}sm:flex-wrap {{end}}gap-x-6{{else}}{{if .Help}}flex-wrap {{end}}items-start justify-between gap-x-6{{end}} text-sm{{if eq $.Style "plain"}}{{else}} border-b border-mid py-row leading-6 {{$first}} last:border-b-0{{end}}">
    <dt class="shrink-0 text-meta{{if eq $.Align "left"}} sm:w-24{{end}}">{{.Label}}</dt>
    <dd class="relative flex min-w-0 items-start {{if eq $.Align "left"}}self-stretch sm:flex-1 sm:self-auto text-left{{else if .Span}}min-w-0 flex-1 text-left{{else}}justify-end text-right{{end}}{{if .Emphasis}} text-base{{end}} font-medium text-ink [&_*]:leading-6">
      {{if .Span}}{{template "verso-prop-span" .Span}}{{else}}
      {{/* A mark hangs in the gutter before a left-set value, so a marked
           value starts where every other row's does; before a value on the
           right edge it leads the value on its line, 8px off. Either way it
           is centred on the value's 24px first line, 9px down. */}}
      {{if .Dot}}<span class="verso-mark {{if eq $.Align "left"}}absolute -left-3.75 top-2.25{{else}}mt-2.25 mr-2{{end}}" data-verso-tone="{{.Dot}}"{{if .Key}} data-verso-prop-dot="{{.Key}}"{{end}} aria-hidden="true"></span>{{end}}
      {{if .Chip}}<span class="verso-chip" data-verso-verbatim>{{.Value}}</span>{{else if .Next}}
      {{/* What the value becomes, under what it is — as a table's cell says
           it: the value it was recedes to Meta, and what it becomes stands in
           Ink, led by the arrow turning down into it in the action colour. */}}
      <span{{if .Mono}} data-verso-verbatim{{end}} class="flex min-w-0 flex-col {{if eq $.Align "left"}}items-start{{else}}items-end{{end}}{{if .Mono}} font-mono text-base font-medium{{end}}"><span class="wrap-anywhere text-meta">{{.Value}}</span><span class="flex items-center gap-1.5 text-ink"><span role="img" aria-label="{{t "Available version"}}" title="{{t "Available version"}}" class="flex shrink-0 text-denim">{{icon "corner-down-right" "size-4"}}</span><span class="wrap-anywhere">{{.Next}}</span></span></span>
      {{else}}<span{{if .Key}} data-verso-prop="{{.Key}}"{{end}}{{if .Mono}} data-verso-verbatim{{end}}{{if .Figures}} data-verso-figures{{end}} class="min-w-0 wrap-anywhere text-balance{{if .Mono}} font-mono text-base font-medium{{end}}{{if .Duration}} tabular-nums{{end}}{{if .Variant}} {{template "verso-tone-text" .Variant}}{{end}}">{{.Value}}</span>{{end}}
      {{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}
      {{if .Status}}<span class="{{if eq $.Align "left"}}ml-auto pl-3{{else}}ml-2{{end}} inline-flex h-6 shrink-0 items-center">{{template "badge.html.tmpl" .Status}}</span>{{end}}
      {{end}}
    </dd>
    {{if .Help}}<p class="basis-full {{if eq $.Align "left"}}sm:pl-30{{else}}text-right{{end}} text-sm leading-6 font-normal text-body">{{.Help}}</p>{{end}}
  </div>
  {{end}}
  {{end}}
</dl>{{end}}
{{if .Head}}</section>{{end}}
