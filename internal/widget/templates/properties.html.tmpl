{{/* properties: a label/value detail list (a <dl>) — label left, value right, so the
     facts about one thing line up and scan cleanly. Style picks the row separator:
     "striped" (zebra), "plain" (none), or the default hairline between rows. The class
     strings live here (not in Go) so Tailwind's scanner keeps them. A row may offer an
     inline copy button (shell-owned "copy", verso.js); icons from icons.go. */}}
{{/* verso-copy-inline: the icon-sized copy control beside a value — context is the
     text to copy. Shared by properties rows and mono table cells. */}}
{{define "verso-copy-inline"}}<button type="button" x-data="copy" @click="run" aria-label="Copy" class="group/copy relative ml-1.5 inline-flex align-middle text-slate-400 transition-colors hover:text-slate-600">
  <span x-ref="src" class="hidden">{{.}}</span>
  <span x-show="idle">{{icon "copy" "size-4"}}</span>
  <span x-show="done" x-cloak>{{icon "check" "size-4 text-green-600"}}</span>
  {{/* Hover bubble beneath the icon: "Click to copy", flipping to "Copied!" on click
       (same idle/done state as the icon). Pure-CSS reveal on hover/keyboard focus —
       the group is NAMED so an ancestor `group` (a table row wears one for its
       border styling) can never reveal the bubble from afar. */}}
  <span class="pointer-events-none absolute left-1/2 top-full z-10 mt-1.5 -translate-x-1/2 whitespace-nowrap rounded-md bg-slate-900 px-2 py-1 text-xs font-medium text-white opacity-0 shadow-md transition-opacity group-hover/copy:opacity-100 group-focus-visible/copy:opacity-100">
    <span x-show="idle">Click to copy</span>
    <span x-show="done" x-cloak>Copied!</span>
  </span>
</button>{{end}}
<dl class="{{if eq .Style "striped"}}overflow-hidden rounded-md{{else if eq .Style "plain"}}space-y-3{{else}}divide-y divide-slate-200{{end}}">
  {{range .Items}}
  <div class="flex items-baseline {{if eq $.Align "left"}}gap-5{{else}}justify-between gap-6{{end}} text-sm{{if eq $.Style "striped"}} px-3 py-2 odd:bg-slate-50{{else if eq $.Style "plain"}}{{else}} py-2.5 first:pt-0 last:pb-0{{end}}">
    <dt class="shrink-0 text-slate-500{{if eq $.Align "left"}} w-24{{end}}">{{.Label}}</dt>
    <dd class="{{if eq $.Align "left"}}flex min-w-0 flex-1 items-baseline text-left{{else}}text-right{{end}} font-medium text-slate-700">
      {{if .Chip}}<span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-1.5 py-0.5 text-xs font-medium text-slate-600">{{.Value}}</span>{{else}}<span class="{{if .Mono}}font-mono{{end}}">{{.Value}}</span>{{end}}
      {{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}
      {{if .Status}}<span class="{{if eq $.Align "left"}}ml-auto pl-3{{else}}ml-2{{end}} inline-flex shrink-0 align-middle">{{template "badge.html.tmpl" .Status}}</span>{{end}}
    </dd>
  </div>
  {{end}}
</dl>
