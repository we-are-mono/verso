{{/* properties: a label/value detail list (a <dl>), the facts block
     (blocks/facts.css) under an optional facts-head. Style picks the row
     separator: the default hairline between rows ("divided"), none
     ("plain"), the System page's ruled rows ("system"), or a label and its
     value on one line ("identity"). A row may offer an inline copy button
     (shell-owned "copy", verso.js); icons from icons.go. */}}
{{/* properties.next: what a value becomes, under what it is — as a table's
     cell says it: the value it was recedes to Meta, and what it becomes
     stands in Ink, led by the arrow turning down into it in the action
     colour. */}}
{{define "properties.next"}}<span data-verso-prop-next{{if .Mono}} data-verso-verbatim{{end}} class="verso-facts__next"><span class="verso-facts__was">{{.Value}}</span><span class="verso-facts__becomes"><span role="img" aria-label="{{t "Available version"}}" title="{{t "Available version"}}" class="verso-facts__arrow">{{icon "corner-down-right" "size-4"}}</span><span>{{.Next}}</span></span></span>{{end}}
{{/* verso-copy-inline: the icon-sized copy control beside a value — context is the
     text to copy. Shared by properties rows and mono table cells. */}}
{{/* The control is a 28px square that only fills on hover, so a column of them
     beside a column of addresses stays a column of addresses. Its glyph rests at
     the mark step, darkens to ink under the pointer, and turns green the moment
     the value is on the clipboard — the one place a hue at full chroma answers
     an act rather than states a condition. */}}
{{define "verso-copy-inline"}}<button type="button" x-data="copy" @click="run" :data-copy-failed="failed" aria-label="{{ t "Copy" }} {{.}}" class="verso-button verso-copy-inline group/copy relative inline-grid align-middle" data-verso-size="icon">
  <span x-ref="src" class="hidden">{{.}}</span>
  <span x-show="idle">{{icon "copy" "size-4"}}</span>
  <span x-show="done" x-cloak class="text-green">{{icon "check" "size-4"}}</span>
  {{/* The bubble sits above the control and flush to its right edge, which is
       what keeps it inside the table on the last column. Pure-CSS reveal on
       hover/keyboard focus — the group is NAMED so an ancestor `group` (a table
       row wears one for its border styling) can never reveal it from afar. */}}
  {{template "verso-copy-tip" "Copy"}}
</button>{{end}}
{{/* verso-prop-span: a stretch between two ends. The ends are written under
     the track's ends; a screen reader hears them as one range. A fact on a
     sheet is read, not streamed, so its fill is never the live ring. */}}
{{define "verso-prop-span"}}<span class="sr-only">{{.From}} – {{.To}}</span><span class="verso-facts__span" aria-hidden="true"><span class="verso-facts__track"><span class="verso-facts__groove"></span><span class="verso-facts__fill"{{with .Tone}} data-verso-tone="{{.}}"{{end}} style="width: {{.Pos}}"></span></span><span class="verso-facts__ends" data-verso-figures><span>{{.From}}</span><span>{{.To}}</span></span></span>{{end}}
{{/* The head names the facts on a line of their own (blocks/facts-head.css).
     A group's title is a heading, its protocol a chip beside it; two column
     names (Part, Current) stand over the labels and the values. */}}
{{define "properties.head"}}<div data-verso-properties-head class="verso-facts-head"{{if .Head.Value}} data-verso-columns{{end}}>
  {{if .Head.Value}}<span class="shrink-0{{if eq .Align "left"}} sm:w-24{{end}}">{{.Head.Label}}</span><span{{if ne .Align "left"}} class="ml-auto"{{end}}>{{.Head.Value}}</span>
  {{else}}<h3>{{.Head.Label}}</h3>{{if .Head.Chip}}<span class="verso-chip" data-verso-verbatim>{{.Head.Chip}}</span>{{end}}{{end}}
</div>{{end}}
{{if .Head}}<section aria-label="{{.Head.Label}}" class="min-w-0">{{template "properties.head" .}}{{end}}
{{/* No facts: the empty set's slot where the first row would stand, its
     frame 7px after the head's hairline so it lands on a line. */}}
{{if and .Empty (not .Items)}}<div{{if .Head}} class="pt-1.75"{{end}}><div data-verso-slot class="verso-slot">{{template "verso-empty-slot-body" .Empty}}</div></div>{{else}}
<dl class="verso-facts" data-verso-style="{{if or (eq .Style "plain") (eq .Style "system") (eq .Style "identity")}}{{.Style}}{{else}}divided{{end}}"{{if eq .Align "left"}} data-verso-align="left"{{end}}{{if .Head}} data-verso-headed{{end}}>
  {{range .Items}}
  {{if eq $.Style "identity"}}
  <div class="verso-facts__row">
    <div class="verso-facts__pair">
      <dt class="verso-facts__label">{{.Label}}:</dt>
      <dd class="verso-facts__value"{{if .Mono}} data-verso-verbatim{{end}}{{if .Figures}} data-verso-figures{{end}}{{if .Emphasis}} data-verso-emphasis{{end}}>{{.Value}}</dd>
    </div>
    {{if .Help}}<p class="verso-facts__help">{{.Help}}</p>{{end}}
  </div>
  {{else if eq $.Style "system"}}
  <div class="verso-facts__row"{{if .Next}} data-verso-next{{end}}>
    <dt class="verso-facts__label">{{.Label}}</dt>
    <dd class="verso-facts__value">
      {{if .Next}}{{/* what it becomes, under what it is, as a table's cell says it */}}{{template "properties.next" .}}{{else}}{{if .Dot}}<span class="verso-mark verso-facts__mark" data-verso-tone="{{template "verso-dot-tone" .Dot}}"{{if eq .Dot "success"}} data-verso-live{{end}}{{if .Key}} data-verso-prop-dot="{{.Key}}"{{end}}></span>{{end}}<span{{if .Key}} data-verso-prop="{{.Key}}"{{end}}{{if .Mono}} data-verso-verbatim{{end}}{{if or .Figures .Duration}} data-verso-figures{{end}} class="verso-facts__text">{{.Value}}</span>{{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}{{end}}
    </dd>
  </div>
  {{else}}
  {{/* A live row carries its key, so the stream rewrites its value (and its
       mark) in place. Its value is a flex line, so a copy control or a badge
       rides the line rather than lifting it. */}}
  <div class="verso-facts__row"{{if .Help}} data-verso-help{{end}}>
    <dt class="verso-facts__label">{{.Label}}</dt>
    <dd class="verso-facts__value"{{if .Span}} data-verso-span{{end}}{{if .Emphasis}} data-verso-emphasis{{end}}>
      {{if .Span}}{{template "verso-prop-span" .Span}}{{else}}
      {{if .Dot}}<span class="verso-mark verso-facts__mark" data-verso-tone="{{.Dot}}"{{if .Key}} data-verso-prop-dot="{{.Key}}"{{end}} aria-hidden="true"></span>{{end}}
      {{if .Chip}}<span class="verso-chip" data-verso-verbatim>{{.Value}}</span>{{else if .Next}}
      {{/* What the value becomes, under what it is — as a table's cell says
           it: the value it was recedes to Meta, and what it becomes stands in
           Ink, led by the arrow turning down into it in the action colour. */}}
      {{template "properties.next" .}}
      {{else}}<span{{if .Key}} data-verso-prop="{{.Key}}"{{end}}{{if .Mono}} data-verso-verbatim{{end}}{{if or .Figures .Duration}} data-verso-figures{{end}} class="verso-facts__text">{{.Value}}</span>{{end}}
      {{if .Copy}}{{template "verso-copy-inline" .Value}}{{end}}
      {{if .Status}}<span class="verso-facts__status">{{template "badge.html.tmpl" .Status}}</span>{{end}}
      {{end}}
    </dd>
    {{if .Help}}<p class="verso-facts__help">{{.Help}}</p>{{end}}
  </div>
  {{end}}
  {{end}}
</dl>{{end}}
{{if .Head}}</section>{{end}}
