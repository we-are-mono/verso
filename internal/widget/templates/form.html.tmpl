{{/* form: POSTs to the current page; fields are pre-rendered trusted HTML */}}<form method="post" class="space-y-6">{{if .Success}}<div class="rounded-md border border-verso-border px-3 py-2 text-sm text-verso-success">{{.Success}}</div>{{end}}{{range .Fields}}{{.}}{{end}}<div><button type="submit" class="rounded-md bg-verso-accent px-4 py-2 text-sm font-medium text-white">{{.Submit}}</button></div></form>
