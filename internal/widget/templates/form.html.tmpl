{{/* form: POSTs to the current page; fields are pre-rendered trusted HTML.
     Inline puts the fields and the submit on one row — visible fields at a
     fixed narrow width, the button beside them at the same height (a search
     row); hidden carriers take no space either way. */}}
{{/* inline widths hit only the field wrappers — the last div is the buttons
     row and sizes to its content. The submit glues onto the last field (one
     instrument: the button acts on the field): the field's input squares its
     right corners and the buttons row pulls back across the gap. */}}
{{/* A form inside a panel posts back into the frame that holds it, and the
     answer swaps in where the form was — the listing behind the panel is
     already on screen and is not rebuilt to change the part that moved. The
     entity panel's form posts to the tab's own route; a plugin's own panel
     posts to no address of its own, which htmx reads as the page's — the one
     the address bar already names, since an open panel is a place. Without
     script the form is simply submitted, and the page answers with the panel
     open on the outcome. */}}
<form{{if or .Inline .Search}} data-verso-compact-form{{end}} method="post"{{if .Action}} action="{{.Action}}"{{end}}{{if .Frame}} hx-post="{{.Panel}}" hx-target="closest {{if eq .Frame "entity"}}[data-verso-entity-body]{{else}}[data-verso-panel]{{end}}" hx-swap="innerHTML"{{end}}{{if .Multipart}} enctype="multipart/form-data"{{end}}{{if .AutoSubmit}} data-verso-autosubmit{{end}}{{if .Page}} data-verso-page-form{{end}}{{if .Dirty}} data-verso-dirty-form{{end}} class="verso-form {{if .Search}}flex flex-wrap items-center gap-3{{else if .Inline}}flex flex-wrap items-end gap-3 {{if .Compact}}[&>div:not(:last-of-type)]:w-52{{else}}[&>div:not(:last-of-type)]:w-72{{end}} [&>div:not(:last-of-type)_input]:rounded-r-none{{else if not .Page}}verso-rhythm [--verso-rhythm:1.5rem]{{end}}">
  {{template "verso-csrf" .CSRFToken}}
  {{if .Success}}
  <div class="flex items-start gap-2 rounded-xs border border-green-line bg-green-soft px-3 py-2 text-sm leading-5 text-green-deep">
    {{template "verso-message-mark" "success"}}
    <span>{{.Success}}</span>
  </div>
  {{end}}
  {{/* A refusal of the whole submission — one no field owns. A field's own
       refusal is its band, and the page's navigator counts them; no form says
       to look for them. The band keeps a dividing line's air below it. */}}
  {{if .Error}}
  <div class="mb-6 flex items-start gap-2 rounded-xs border border-crimson-line bg-crimson-soft px-3 py-2 text-sm leading-5 text-crimson-deep">
    {{template "verso-message-mark" "danger"}}
    <span>{{.Error}}</span>
  </div>
  {{end}}
  {{if .Search}}
  {{/* A search and its act stand side by side, 8px apart, each control whole
       with its own corners and border, as Factory reset's confirm row does:
       the field at the 320px a page's find field keeps, the button after it,
       never inside it. Search forms intentionally contain one unlabelled text
       field plus hidden carriers; secondary actions remain separate controls
       alongside it. */}}
  <div class="flex max-w-full items-center gap-2 [&>.verso-field-row]:w-80 [&>.verso-field-row]:min-w-0">
    {{range .Fields}}{{.}}{{end}}
    {{if .Submit}}<button type="submit"{{if .Dirty}} disabled{{end}} class="{{template "verso-btn-box"}} shrink-0 {{template "verso-btn-primary"}} focus-visible:outline-denim-deep{{if .Dirty}} {{template "verso-btn-waiting"}}{{end}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Submit}}</button>{{end}}
  </div>
  {{if or .Actions .Note}}
  <div class="flex flex-wrap items-center gap-3">
    {{if .CancelHref}}<a href="{{.CancelHref}}"{{if .Frame}} @click.prevent="hide"{{end}} class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}}">{{t "Cancel"}}</a>{{end}}
    {{range .Actions}}<button type="submit" name="_action" value="{{.Action}}"{{if $.Dirty}} disabled{{end}} class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</button>{{end}}
    {{if .Note}}<span class="text-sm text-body [&>p]:inline">{{.Note}}</span>{{end}}
  </div>
  {{end}}
  {{else}}
  {{range .Fields}}{{.}}{{end}}
  {{if or .Submit .Actions}}
  {{/* The commit row: what this form does, and what doing it costs. A rule
       above it closes the fields off, the acts lead, and the consequence sits
       out at the right — read last, where someone's eye already is once they
       have decided to press. A form driven inline keeps its old tight row: it
       is one control's companion, not a page's ending. */}}
  {{/* A form that commits one section of a page draws no rule: its Save
       stands under its own fields, and the next section's rule closes it. A
       page's own form commits the whole page, so its Save stands 32px under
       a section rule of the page's, run out to the rail. A
       panel's form closes on its own rule, inside the panel, except when its
       actions finish the configuration card immediately above them, or when
       the form is only its act (every field hidden): with nothing to close
       off, the act stands 20px under what is above it. */}}
  <div data-verso-form-actions{{if and .ClosesPage (not .JoinsCode)}} data-verso-rule{{end}} class="flex flex-wrap items-center {{if .Inline}}-ml-3 gap-3{{else if .JoinsCode}}mt-5 gap-4{{else if .Sectioned}}mt-8 gap-4{{else if .ClosesPage}}mt-6 gap-4 border-t border-rule pt-8{{else if .LoneAct}}mt-5 gap-4{{else}}mt-7 gap-4 border-t border-rule pt-5{{end}}">
    {{/* No Submit label, no primary button — a form may be driven by its
         actions or by a confirm among its fields instead. */}}
    {{/* A form that waits for a change draws its acts resting, as the page's
         script keeps them until something changes (verso-forms.js): drawn
         active and put to rest after, they would blink denim on every visit. */}}
    {{if .Submit}}<button type="submit"{{if .Dirty}} disabled{{end}} class="{{template "verso-btn-box"}}{{if .Inline}}rounded-l-none{{end}} {{template "verso-btn-primary"}} focus-visible:outline-denim-deep{{if .Dirty}} {{template "verso-btn-waiting"}}{{end}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Submit}}</button>{{end}}
    {{if .CancelHref}}<a href="{{.CancelHref}}"{{if .Frame}} @click.prevent="hide"{{end}} class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}}">{{t "Cancel"}}</a>{{end}}
    {{range .Actions}}<button type="submit" name="_action" value="{{.Action}}"{{if $.Dirty}} disabled{{end}} class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</button>{{end}}
    {{if .Note}}<span class="{{if not .Inline}}ml-auto {{else}}self-center {{end}}text-sm text-meta [&>p]:inline">{{.Note}}</span>{{end}}
  </div>
  {{end}}
  {{/* A form with nothing to press still says what it is for. */}}
  {{if and .Note (not .Submit) (not .Actions)}}<div class="text-sm text-meta [&>p]:inline">{{.Note}}</div>{{end}}
  {{end}}
</form>
