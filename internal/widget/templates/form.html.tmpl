{{/* form: POSTs to the current page; fields are pre-rendered trusted HTML */}}<form method="post" class="space-y-6">{{if .Success}}<div class="flex items-center gap-2 rounded-md border border-verso-success-border bg-verso-success-bg px-3 py-2 text-sm text-verso-success"><svg class="size-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.06l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg><span>{{.Success}}</span></div>{{end}}{{range .Fields}}{{.}}{{end}}<div><button type="submit" class="cursor-pointer rounded-md bg-verso-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-verso-accent-hover active:bg-verso-accent-active focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-verso-accent focus-visible:ring-offset-2">{{.Submit}}</button></div></form>
