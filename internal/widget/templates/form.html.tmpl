{{/* form: POSTs to the current page; fields are pre-rendered trusted HTML */}}
<form method="post" class="space-y-6">
  {{if .CSRFToken}}<input type="hidden" name="_csrf" value="{{.CSRFToken}}">{{end}}
  {{if .Success}}
  <div class="flex items-center gap-2 rounded-md border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-600">
    {{icon "circle-check" "size-4 shrink-0"}}
    <span>{{.Success}}</span>
  </div>
  {{end}}
  {{if .Error}}
  <div class="flex items-center gap-2 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-600">
    {{icon "circle-alert" "size-4 shrink-0"}}
    <span>{{.Error}}</span>
  </div>
  {{end}}
  {{range .Fields}}{{.}}{{end}}
  <div class="flex flex-wrap gap-3">
    <button type="submit" class="cursor-pointer rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-sky-700 active:bg-sky-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2">{{.Submit}}</button>
    {{range .Actions}}<button type="submit" name="_action" value="{{.Action}}" class="cursor-pointer rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900 transition-colors hover:border-sky-600 hover:text-sky-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2">{{.Label}}</button>{{end}}
  </div>
</form>
