{{/* form: POSTs to the current page; fields are pre-rendered trusted HTML.
     Inline puts the fields and the submit on one row — visible fields at a
     fixed narrow width, the button beside them at the same height (a search
     row); hidden carriers take no space either way. */}}
{{/* inline widths hit only the field wrappers — the last div is the buttons
     row and sizes to its content. The submit glues onto the last field (one
     instrument: the button acts on the field): the field's input squares its
     right corners and the buttons row pulls back across the gap. */}}
<form method="post"{{if .Action}} action="{{.Action}}"{{end}}{{if .Multipart}} enctype="multipart/form-data"{{end}}{{if .AutoSubmit}} data-verso-autosubmit{{end}}{{if .Page}} data-verso-page-form{{end}} class="{{if .Search}}flex flex-wrap items-center gap-3{{else if .Inline}}flex flex-wrap items-end gap-3 {{if .Compact}}[&>div:not(:last-of-type)]:w-52{{else}}[&>div:not(:last-of-type)]:w-72{{end}} [&>div:not(:last-of-type)_input]:rounded-r-none{{else if not .Page}}space-y-6{{end}}">
  {{template "verso-csrf" .CSRFToken}}
  {{if .Success}}
  <div class="flex items-center gap-2 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-600">
    {{icon "circle-check" "size-4 shrink-0"}}
    <span>{{.Success}}</span>
  </div>
  {{end}}
  {{if .Error}}
  <div class="flex items-center gap-2 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-600">
    {{icon "circle-alert" "size-4 shrink-0"}}
    <span>{{.Error}}</span>
  </div>
  {{end}}
  {{if .Search}}
  {{/* A search and its action are one compound control. The input owns the
       complete outline/focus halo; right padding reserves the space occupied
       by the inset button, so typed text can never run underneath it. Search
       forms intentionally contain one unlabelled text field plus hidden
       carriers; secondary actions remain separate controls alongside it. */}}
  <div class="relative w-full max-w-sm [&_input[type=text]]:pr-28">
    {{range .Fields}}{{.}}{{end}}
    {{if .Submit}}<button type="submit" class="absolute inset-y-1 right-1 inline-flex cursor-pointer items-center gap-1.5 rounded-md px-4 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 {{template "verso-btn-primary"}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Submit}}</button>{{end}}
  </div>
  {{if or .Actions .Note}}
  <div class="flex flex-wrap items-center gap-3">
    {{range .Actions}}<button type="submit" name="_action" value="{{.Action}}" class="inline-flex cursor-pointer items-center gap-1.5 rounded-md border px-4 py-2 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 {{template "verso-btn-secondary"}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</button>{{end}}
    {{if .Note}}<span class="text-sm text-slate-500 [&>p]:inline">{{.Note}}</span>{{end}}
  </div>
  {{end}}
  {{else}}
  {{range .Fields}}{{.}}{{end}}
  {{if or .Submit .Actions}}
  <div class="flex flex-wrap gap-3{{if .Inline}} -ml-3{{end}}">
    {{/* border-transparent: inputs carry a 1px border, so the button does too —
         inline rows sit at exactly the field's height. No Submit label, no
         primary button — a form may be driven by its actions or by a confirm
         among its fields instead. */}}
    {{if .Submit}}<button type="submit" class="inline-flex cursor-pointer items-center gap-1.5 border border-transparent px-4 py-2 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 {{template "verso-btn-primary"}} {{if .Inline}}rounded-r-md{{else}}rounded-md{{end}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Submit}}</button>{{end}}
    {{range .Actions}}<button type="submit" name="_action" value="{{.Action}}" class="inline-flex cursor-pointer items-center gap-1.5 rounded-md border px-4 py-2 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 {{template "verso-btn-secondary"}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</button>{{end}}
    {{if and .Note .Inline}}<span class="self-center text-sm text-slate-500 [&>p]:inline">{{.Note}}</span>{{end}}
  </div>
  {{end}}
  {{if and .Note (not .Inline)}}<div class="text-sm text-slate-500 [&>p]:inline">{{.Note}}</div>{{end}}
  {{end}}
</form>
