{{/* collection: a short set of kept machine strings. No rules: each item is
     its identity over its detail, stood apart from the next by the row's own
     air, its one act on its first line. The act asks in place and drops its
     question under the item (the confirm is laid into the item's own row).
     The next item is added from the foot: a quiet act that unfolds where it
     stands into the box that takes one, the plugin's live reading of what was
     typed, and the act that adds it. A refused paste comes back open. */}}
<div class="verso-collection">
  {{if .Items}}
  <ul>
    {{range .Items}}
    {{/* Each item writes on the notebook's 20px lines with half a cell above
         and below, so it is whole cells; its act rides the first line, 4px
         over at either edge. */}}
    <li>
      <form method="post"{{if $.Action}} action="{{$.Action}}"{{end}} class="verso-collection__item">
        {{template "verso-csrf" $.CSRFToken}}
        {{if .Name}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{end}}
        <div class="verso-collection__words">
          <p class="verso-collection__title" data-verso-verbatim>{{.Title}}</p>
          {{if .Detail}}<p class="verso-collection__detail" data-verso-verbatim>{{.Detail}}</p>{{end}}
        </div>
        <div class="verso-collection__act">{{.Remove}}</div>
      </form>
    </li>
    {{end}}
  </ul>
  {{/* Where the first item would stand, while there is none: the empty slot
       every set draws (the slot block). It is inert: the add stays at
       the foot, where it stands under the items once there are some. The slot
       keeps no air above it: the subheading's is the gap. */}}
  {{else if .Empty}}
  <div data-verso-slot class="verso-slot">
    {{template "verso-empty-slot-body" .Empty}}
  </div>
  {{end}}
  {{with .Add}}
  {{/* the 28px act centred in the two cells under the last item's row, or a
       cell under the empty slot's edge and then centred in two */}}
  <div x-data="confirm" @keydown.escape="escape"{{if $.Open}} data-verso-open{{end}} class="verso-collection__add"{{if not $.Items}} data-verso-first{{end}}>
    <button type="button" x-ref="trigger" x-show="idle" @click="ask" :aria-expanded="expanded" aria-controls="{{$.AddID}}" class="verso-button group/act relative" data-verso-size="act" data-verso-glyph>{{icon "plus" "size-4"}}{{.Label}}</button>
    <form id="{{$.AddID}}" method="post"{{if $.Action}} action="{{$.Action}}"{{end}} x-show="asking" x-cloak class="verso-collection__form">
      {{template "verso-csrf" $.CSRFToken}}
      <label for="{{$.AddID}}-input" class="sr-only">{{.Label}}</label>
      <input x-ref="first" id="{{$.AddID}}-input" name="{{.Name}}" value="{{.Value}}" type="text"{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}} autocomplete="off" spellcheck="false"{{if .Error}} aria-invalid="true" aria-describedby="{{$.AddID}}-error"{{end}} class="verso-input" data-verso-verbatim>
      {{if .Error}}<p id="{{$.AddID}}-error" data-verso-error class="{{template "verso-refusal-band"}}">{{template "verso-error-words" .Error}}</p>{{end}}
      {{$.Preview}}
      <div class="verso-collection__acts">
        <button type="submit" class="verso-button">{{.Submit}}</button>
        <button type="button" @click="cancel" class="verso-button" data-verso-style="secondary">{{ t "Not now" }}</button>
      </div>
    </form>
  </div>
  {{end}}
</div>
