{{/* field: one labelled control (text or select), with datatype + inline error.
     Kind "hidden" is the bare carrier — no label, no chrome — for a value a
     form must post but a person never edits (e.g. which object a button acts
     on). */}}
{{if eq .Kind "hidden"}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{else}}
<div class="space-y-1.5">
  {{if .Label}}<label for="{{.Name}}" class="block text-sm font-medium text-slate-900">{{.Label}}</label>{{end}}
  {{if eq .Kind "select"}}
  {{/* appearance-none + our own chevron, inset right-3 to mirror the text's pl-3 —
       the native arrow hugs the border and can't follow the theme. */}}
  <div class="relative">
    <select id="{{.Name}}" name="{{.Name}}" class="w-full appearance-none rounded-md border border-slate-300 bg-white py-2 pr-9 pl-3 text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
      {{range .Options}}<option value="{{.Value}}"{{if eq .Value $.Value}} selected{{end}}>{{.Label}}</option>{{end}}
    </select>
    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">{{icon "chevron-down" "size-4"}}</span>
  </div>
  {{else if eq .Kind "checks"}}
  {{/* checks: membership in a known set — all boxes share the field's name and
       post as a multi-value field (name=a&name=b), the list-widget contract.
       Free text is how dead references happen; a closed set makes them
       untypeable. */}}
  <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 pt-0.5 sm:grid-cols-3">
    {{range .Options}}
    <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-900">
      <input type="checkbox" name="{{$.Name}}" value="{{.Value}}"{{if $.Checked .Value}} checked{{end}}
        class="size-4 cursor-pointer rounded border-slate-300 accent-sky-600">
      {{.Label}}
    </label>
    {{end}}
  </div>
  {{else if eq .Kind "password"}}
  {{/* Never reflect a submitted password back into the value attribute. */}}
  <input id="{{.Name}}" name="{{.Name}}" type="password" autocomplete="{{if .Autocomplete}}{{.Autocomplete}}{{else}}new-password{{end}}" class="w-full rounded-md border {{if .Error}}border-red-600 dark:border-red-400{{else}}border-slate-300{{end}} bg-white px-3 py-2 inset-shadow-sm text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
  {{else if eq .Kind "file"}}
  {{/* The native input covers the drop surface invisibly: dropping works without
       plugin JavaScript, and clicking the emphasized phrase opens the OS picker. */}}
  <label for="{{.Name}}" class="relative flex min-h-40 cursor-pointer items-center justify-center rounded-xl border-2 border-dotted {{if .Error}}border-red-400 bg-red-50/40{{else}}border-slate-300 bg-slate-50/60 hover:border-sky-400 hover:bg-sky-50/50{{end}} px-8 py-12 text-center transition-colors">
    <input id="{{.Name}}" name="{{.Name}}" type="file"{{if .Accept}} accept="{{.Accept}}"{{end}} class="absolute inset-0 size-full cursor-pointer opacity-0">
    <span class="pointer-events-none text-sm text-slate-500">
      <span class="mx-auto mb-4 block w-fit text-slate-400">{{icon "upload" "size-10"}}</span>
      <span class="block">{{if .Prompt}}{{.Prompt}}{{else}}Drop a file here{{end}}</span>
      <span class="mt-1 block">or <span class="whitespace-nowrap font-semibold text-sky-600 underline underline-offset-2">choose one from your computer</span>.</span>
    </span>
  </label>
  {{else if eq .Kind "textarea"}}
  <textarea id="{{.Name}}" name="{{.Name}}" rows="5" class="w-full rounded-md border {{if .Error}}border-red-600 dark:border-red-400{{else}}border-slate-300{{end}} bg-white px-3 py-2 inset-shadow-sm font-mono text-sm text-slate-900 focus:border-sky-600 focus:outline-none">{{.Value}}</textarea>
  {{else if eq .Kind "datetime-local"}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="datetime-local" step="1" class="w-full rounded-md border {{if .Error}}border-red-600 dark:border-red-400{{else}}border-slate-300{{end}} bg-white px-3 py-2 inset-shadow-sm text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
  {{else}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="text"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="w-full rounded-md border {{if .Error}}border-red-600 dark:border-red-400{{else}}border-slate-300{{end}} bg-white px-3 py-2 inset-shadow-sm text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
  {{end}}
  {{/* On error, the helper line becomes the error — one line under the field, not two. */}}
  {{if .Error}}<p class="text-sm text-red-600 dark:text-red-400">{{.Error}}</p>{{else if .Help}}<p class="text-sm text-slate-500">{{.Help}}</p>{{end}}
</div>
{{end}}
