{{/* field: one labelled control (text or select), with datatype + inline error */}}<div class="space-y-1.5"><label for="{{.Name}}" class="block text-sm font-medium text-verso-fg">{{.Label}}</label>{{if eq .Kind "select"}}<select id="{{.Name}}" name="{{.Name}}" class="w-full rounded-md border border-verso-border bg-verso-bg px-3 py-2 text-sm text-verso-fg focus:border-verso-accent focus:outline-none">{{range .Options}}<option value="{{.Value}}"{{if eq .Value $.Value}} selected{{end}}>{{.Label}}</option>{{end}}</select>{{else}}<input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="text"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="w-full rounded-md border {{if .Error}}border-verso-danger{{else}}border-verso-border{{end}} bg-verso-bg px-3 py-2 text-sm text-verso-fg focus:border-verso-accent focus:outline-none">{{end}}{{if .Error}}<p class="text-sm text-verso-danger">{{.Error}}</p>{{end}}{{if .Help}}<p class="text-sm text-verso-muted">{{.Help}}</p>{{end}}</div>
