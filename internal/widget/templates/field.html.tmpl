{{/* field: one labelled control, with datatype + inline error. Kind selects the
     input type (text, select, checks, password, file, textarea, datetime-local).
     Kind "hidden" is the bare carrier — no label, no chrome — for a value a
     form must post but a person never edits (e.g. which object a button acts
     on). With an Autocomplete it is instead the account a password form
     belongs to: a text input the password manager reads, never drawn. */}}
{{if eq .Style "code"}}
<div class="space-y-2 py-3" data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="textarea"><label for="{{.Name}}" class="block text-sm font-semibold text-ink">{{.Label}}</label><textarea id="{{.Name}}" name="{{.Name}}" rows="14" spellcheck="false" data-verso-code-editor{{template "verso-field-aria" .}} class="w-full resize-y rounded-xs border border-rule-strong bg-ground p-3 font-mono text-sm leading-relaxed text-ink outline-none hover:border-faint focus:border-denim">{{.Value}}</textarea><p class="text-right font-mono text-sm text-meta">{{t "Lines"}}: <span data-verso-code-lines>{{.LineCount}}</span></p>{{if .Error}}<p id="{{.Name}}-error" class="text-sm text-crimson-deep">{{.Error}}</p>{{end}}</div>
{{else if and (eq .Kind "hidden") .Autocomplete}}<input type="text" name="{{.Name}}" value="{{.Value}}" autocomplete="{{.Autocomplete}}" readonly hidden>{{else if eq .Kind "hidden"}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{else if eq .Kind "file"}}
{{/* A file to drop is its dialog's whole subject, so its area fills the width:
     the app's place-marking dashed hairline on sand, the upload glyph, what to
     drop and the other way to choose one, and under it what fits. The native
     input covers the area invisibly, so a drop works without the page's script
     and a click opens the system's picker. A file dragged over it answers in
     denim (data-dragging, set by verso-forms.js). */}}
<div class="space-y-2">
  <label for="{{.Name}}" data-verso-drop class="group/drop relative flex cursor-pointer flex-col items-center justify-center gap-1 rounded-xs border border-dashed {{if .Error}}border-crimson bg-crimson-soft{{else}}border-rule-strong bg-quiet hover:border-sand-5 data-dragging:border-denim data-dragging:bg-denim-soft focus-within:border-denim{{end}} px-6 py-10 text-center transition-colors">
    <input id="{{.Name}}" name="{{.Name}}" type="file"{{if .Accept}} accept="{{.Accept}}"{{end}}{{if .Required}} required{{end}}{{if .Help}} aria-describedby="{{.Name}}-help"{{end}} class="absolute inset-0 size-full cursor-pointer opacity-0">
    <span aria-hidden="true" class="mb-2 text-glyph transition-colors group-data-dragging/drop:text-denim">{{icon "upload" "size-8"}}</span>
    <span class="text-sm font-semibold text-ink">{{if .Prompt}}{{.Prompt}}{{else}}{{ t "Drop a file here" }}{{end}}</span>
    <span class="text-sm text-body">{{ t "or" }} <span class="font-semibold whitespace-nowrap text-denim-deep underline underline-offset-2">{{ t "choose one from your computer" }}</span></span>
  </label>
  {{if .Help}}<p id="{{.Name}}-help" class="text-sm leading-[1.45] text-pretty text-meta">{{.Help}}</p>{{end}}
  {{if .Error}}<p class="{{template "verso-refusal-band"}}">{{template "verso-error-words" .Error}}</p>{{end}}
</div>
{{else}}
{{/* One field is one row of the form, at the form's own measure: what the thing
     is on the left, growing, and the control on the right at a fixed width. The
     control column is fixed rather than the label's, because a column of
     controls that all begin and end in the same place is what makes a form
     scannable — the labels are words and may be any length.

     Nothing rules between them: fields inside a section already belong together,
     and a hairline every 40px turns a form into a table. Rules separate
     sections; space separates fields. */}}
{{/* The option this row writes travels as data as well as as the chip beside the
     label: the live preview patches that one line the moment the value changes,
     rather than waiting out the round-trip to learn what a person just typed. */}}
<div class="{{template "verso-field-row-class"}}"{{if ne .Style "locked"}} data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="{{if .Kind}}{{.Kind}}{{else}}text{{end}}"{{if .Key}} data-verso-writes="{{.Key}}"{{end}}{{end}}>
  {{if or .Label .Key}}{{template "verso-field-label" .LabelView}}{{end}}
  <div data-verso-control class="{{template "verso-field-control-class"}}">
  {{if eq .Style "locked"}}
  {{/* A value fixed once written: the row keeps its place and its label, the
       control is a quiet box with a padlock and the reason on it, and nothing
       posts. An output is labelable, so the row's label still names it. */}}
  <output id="{{.Name}}"{{if .Help}} title="{{.Help}}"{{end}} class="flex h-9 w-full cursor-help items-center gap-2 rounded-xs border border-rule bg-quiet text-body px-3 text-sm">{{.Value}}<span class="ml-auto flex text-faint">{{icon "lock" "size-3.5"}}</span></output>
  {{else if and (eq .Kind "select") .Segmented}}
  {{/* A pick between three words reads better as all of them than as a box
       that hides two: the choice is priced before it is made. The one in force
       is filled in the body ink, as every selected segment in the app is — the
       toolbar's family cut wears the same tray — and never the action colour,
       which is for what leads somewhere. Radios underneath, so it posts exactly
       as the box does and needs no JavaScript. */}}
  <div role="radiogroup"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="inline-flex w-fit gap-0.5 self-start rounded-xs border border-rule-strong bg-quiet p-0.5">
    {{range .Options}}
    <label class="flex h-7.5 cursor-pointer items-center rounded-xs px-3.5 text-sm font-normal text-body transition-colors hover:text-ink has-checked:bg-body has-checked:font-semibold has-checked:text-white {{template "verso-segment-focus"}}">
      <input type="radio" name="{{$.Name}}" value="{{.Value}}"{{if eq .Value $.Value}} checked{{end}} class="sr-only">
      {{.Label}}
    </label>
    {{end}}
  </div>
  {{else if eq .Kind "select"}}
  {{/* appearance-none + our own chevron, inset right-3 to mirror the text's pl-3 —
       the native arrow hugs the border and can't follow the theme. */}}
  <div class="relative">
    <select id="{{.Name}}" name="{{.Name}}"{{template "verso-field-aria" .}} class="{{if .Words}}{{template "verso-input-words"}}{{else}}{{template "verso-input-class"}}{{end}} {{template "verso-input-border" .Error}} cursor-pointer appearance-none pr-9">
      {{range .Options}}<option value="{{.Value}}"{{if eq .Value $.Value}} selected{{end}}>{{.Label}}</option>{{end}}
    </select>
    <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-meta">{{icon "chevron-down" "size-4"}}</span>
  </div>
  {{else if eq .Kind "checks"}}
  {{/* checks: membership in a known set — all boxes share the field's name and
       post as a multi-value field (name=a&name=b), the list-widget contract.
       Free text is how dead references happen; a closed set makes them
       untypeable. */}}
  {{if .Segmented}}
  {{/* segmented: a set short enough to show whole reads better as one strip of
       chips than as a grid of boxes — seven days fit on a line, and which are on
       is then a shape rather than a list to scan. Still checkboxes underneath,
       so it posts exactly as the grid does and needs no JavaScript. */}}
  <div role="group"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="inline-flex w-fit gap-0.5 self-start rounded-xs border border-rule-strong bg-quiet p-0.5">
    {{range .Options}}
    <label class="flex h-7.5 cursor-pointer items-center rounded-xs px-3.5 text-sm font-normal text-body transition-colors hover:text-ink has-checked:bg-body has-checked:font-semibold has-checked:text-white {{template "verso-segment-focus"}}">
      <input type="checkbox" name="{{$.Name}}" value="{{.Value}}"{{if $.Checked .Value}} checked{{end}} class="sr-only">
      {{.Label}}
    </label>
    {{end}}
  </div>
  {{else}}
  <div role="group"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="grid grid-cols-2 gap-x-4 gap-y-1.5 pt-0.5 sm:grid-cols-3">
    {{range .Options}}
    <label class="flex cursor-pointer items-center gap-2 text-sm text-ink">
      <input type="checkbox" name="{{$.Name}}" value="{{.Value}}"{{if $.Checked .Value}} checked{{end}}
        class="size-4 cursor-pointer rounded-xs border-rule-strong accent-body">
      {{.Label}}
    </label>
    {{end}}
  </div>
  {{end}}
  {{else if and (eq .Kind "password") (eq .Style "reveal")}}
  {{/* A shared secret — a Wi-Fi key someone reads out to a guest — sits in the
       field masked, and the eye beside it shows it. Only this style reflects a
       value; a sign-in password never does. */}}
  <span x-data="reveal" class="flex w-full items-center gap-2">
    <input id="{{.Name}}" name="{{.Name}}" type="password" :type="inputType" value="{{.Value}}" autocomplete="off" spellcheck="false"{{template "verso-field-aria" .}} class="min-w-0 flex-1 {{template "verso-input-words"}} {{template "verso-input-border" .Error}}">
    <button type="button" @click="toggle" :aria-pressed="pressed" aria-pressed="false" aria-label="{{ t "Show password" }}" title="{{ t "Show password" }}" class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-xs border border-rule-strong text-glyph transition-colors hover:border-sand-5 hover:bg-rule hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">
      <span x-show="masked" class="flex">{{icon "eye" "size-4"}}</span>
      <span x-show="shown" x-cloak class="flex">{{icon "eye-off" "size-4"}}</span>
    </button>
  </span>
  {{else if eq .Kind "password"}}
  {{/* Never reflect a submitted password back into the value attribute. */}}
  <input id="{{.Name}}" name="{{.Name}}" type="password" autocomplete="{{if .Autocomplete}}{{.Autocomplete}}{{else}}new-password{{end}}"{{template "verso-field-aria" .}} class="{{template "verso-input-words"}} {{template "verso-input-border" .Error}}">
  {{else if eq .Kind "textarea"}}
  <textarea id="{{.Name}}" name="{{.Name}}" rows="5"{{template "verso-field-aria" .}} class="{{template "verso-input-words"}} {{template "verso-input-border" .Error}} h-auto py-2 leading-relaxed">{{.Value}}</textarea>
  {{else if eq .Kind "datetime-local"}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="datetime-local" step="1"{{template "verso-field-aria" .}} class="{{template "verso-input-class"}} {{template "verso-input-border" .Error}}">
  {{else if eq .Kind "time"}}
  {{/* A clock time on its own — a curfew's edge. The native control keeps the
       platform's own 12/24-hour habit and its picker; the box is sized to what
       it holds rather than to the column, because a time is four characters and
       a full-width field would say it might not be. */}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="time"{{template "verso-field-aria" .}} class="{{template "verso-input-class"}} {{template "verso-input-border" .Error}} w-32">
  {{else if .Pair}}
  {{/* Two values that are one setting: the range's ends side by side with the
       word that joins them, so it reads as the sentence it is rather than as two
       unrelated boxes that happen to sit near each other. */}}
  <span class="flex items-center gap-4">
    <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="text"{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}}{{template "verso-field-aria" .}} class="{{template "verso-input-class"}} {{template "verso-input-border" .Error}} w-26">
    <span id="{{.Name}}-join" class="shrink-0 text-sm text-body">{{.Pair.Join}}</span>
    <input id="{{.Pair.Name}}" name="{{.Pair.Name}}" value="{{.Pair.Value}}" type="text" aria-labelledby="{{.Name}}-label {{.Name}}-join"{{template "verso-field-aria" .}}{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="{{template "verso-input-class"}} {{template "verso-input-border" .Error}} w-26">
  </span>
  {{else}}
  {{/* A unit rides inside the trailing edge: the value and what it counts read
       as one thing, and the box keeps clear of it. */}}
  {{if .Unit}}<span class="relative flex w-fit items-center">{{end}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="text"{{if eq .Measure "number"}} inputmode="numeric"{{end}}{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Autofocus}} autofocus{{end}}{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}}{{template "verso-field-aria" .}} class="{{if .Words}}{{template "verso-input-words"}}{{else}}{{template "verso-input-class"}}{{end}} {{if eq .Measure "address"}}w-44! max-w-full{{else if eq .Measure "number"}}w-24! max-w-full{{end}} {{template "verso-input-border" .Error}}{{if .Unit}} w-44 pr-20{{end}}">
  {{if .Unit}}<span class="pointer-events-none absolute right-3 font-mono text-base font-medium text-meta">{{.Unit}}</span></span>{{end}}
  {{end}}
  {{/* On error, the helper line becomes the error — one line under the field, not
       two. An error is a band on crimson's own soft ground with the mark beside
       it, because a refusal should be findable without reading. */}}
  {{if .Error}}
  <span id="{{.Name}}-error" data-verso-error class="{{template "verso-refusal-band"}}">{{template "verso-error-words" .Error}}</span>
  {{/* Help is not a line under the control: it is what the label explains, and
       it is raised from there. Only a refusal takes space in the row. */}}
  {{end}}
  </div>
  {{/* The remove lane. A row that can be taken out of the set ends in the glyph
       that takes it out; a row that cannot still reserves the width, so every
       control in the group begins and ends in the same place. */}}
  {{if .Lane}}
  {{if .Removable}}{{template "verso-row-remove" .}}{{else}}<span class="size-7 flex-none" aria-hidden="true"></span>{{end}}
  {{end}}
</div>
{{end}}
