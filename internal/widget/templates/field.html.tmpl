{{/* field: one labelled control, with datatype + inline error. Kind selects the
     input type (text, select, checks, password, file, textarea, datetime-local).
     Kind "hidden" is the bare carrier — no label, no chrome — for a value a
     form must post but a person never edits (e.g. which object a button acts
     on). With an Autocomplete it is instead the account a password form
     belongs to: a text input the password manager reads, never drawn.

     Every other kind is one setting's row: the frame (verso-field) draws the
     label, the refusal and the lane, and field.control below draws the
     control inside it. */}}
{{if and (eq .Kind "hidden") .Autocomplete}}<input type="text" name="{{.Name}}" value="{{.Value}}" autocomplete="{{.Autocomplete}}" readonly hidden>{{else if eq .Kind "hidden"}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{else if eq .Kind "file"}}
{{/* A file to drop is its dialog's whole subject, so its area fills the width:
     the app's place-marking dashed hairline on sand, the upload glyph, what to
     drop and the other way to choose one, and under it what fits. The native
     input covers the area invisibly, so a drop works without the page's script
     and a click opens the system's picker. A file dragged over it answers in
     denim (data-dragging, set by verso-forms.js). */}}
<div class="space-y-2">
  <label for="{{.Name}}" data-verso-drop class="group/drop relative flex cursor-pointer flex-col items-center justify-center gap-1 rounded-xs border border-dashed {{if .Error}}border-crimson bg-crimson-soft{{else}}border-rule-strong bg-quiet hover:not-focus-within:border-sand-5 data-dragging:border-denim data-dragging:bg-denim-soft focus-within:border-denim{{end}} px-6 py-10 text-center transition-colors">
    <input id="{{.Name}}" name="{{.Name}}" type="file"{{if .Accept}} accept="{{.Accept}}"{{end}}{{if .Required}} required{{end}}{{if or .Help .Error}} aria-describedby="{{if .Help}}{{.Name}}-help{{end}}{{if and .Help .Error}} {{end}}{{if .Error}}{{.Name}}-error{{end}}"{{end}}{{if .Error}} aria-invalid="true"{{end}} class="absolute inset-0 size-full cursor-pointer opacity-0">
    <span aria-hidden="true" class="mb-2 text-glyph transition-colors group-data-dragging/drop:text-denim">{{icon "upload" "size-8"}}</span>
    <span class="text-sm font-semibold text-ink">{{if .Prompt}}{{.Prompt}}{{else}}{{ t "Drop a file here" }}{{end}}</span>
    <span class="text-sm text-body">{{ t "or" }} <span class="font-semibold whitespace-nowrap text-denim-deep underline underline-offset-2">{{ t "choose one from your computer" }}</span></span>
  </label>
  {{if .Help}}<p id="{{.Name}}-help" class="text-sm leading-[1.45] text-pretty text-meta">{{.Help}}</p>{{end}}
  {{if .Error}}<p id="{{.Name}}-error" data-verso-error class="{{template "verso-refusal-band"}}">{{template "verso-error-words" .Error}}</p>{{end}}
</div>
{{end}}

{{/* field.control: the control a field's row holds. Labels and their keys sit
     directly above it on every surface; sections have rules, and individual
     fields are separated by their padding. */}}
{{define "field.control"}}
  {{if eq .Style "code"}}
  <textarea id="{{.Name}}" name="{{.Name}}" rows="14" spellcheck="false" data-verso-code-editor{{template "verso-field-aria" .}} class="w-full resize-y rounded-xs border {{template "verso-input-border" .Error}} bg-ground p-3 font-mono text-sm leading-relaxed text-ink outline-none">{{.Value}}</textarea>
  <p class="text-right font-mono text-sm text-meta">{{t "Lines"}}: <span data-verso-code-lines>{{.LineCount}}</span></p>
  {{else if eq .Style "locked"}}
  {{/* A value fixed once written: the row keeps its place and its label, the
       control is a quiet box with a padlock and the reason on it, and nothing
       posts. An output is labelable, so the row's label still names it. */}}
  <output id="{{.Name}}"{{if .Help}} title="{{.Help}}"{{end}} class="flex h-9 w-full cursor-help items-center gap-2 rounded-xs border border-rule bg-quiet text-body px-3 text-sm">{{.Value}}<span class="ml-auto flex text-faint">{{icon "lock" "size-3.5"}}</span></output>
  {{else if .UseRadios}}
  {{/* Small single-choice sets stay visible. Native radios retain arrow-key
       navigation, mutual exclusion and the same submitted name/value. */}}
  {{$selected := .SelectedIndex}}
  <div role="radiogroup"{{if .Reshapes}} data-verso-reshape{{end}}{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="flex min-w-0 flex-col items-start">
    {{range $index, $option := .Options}}
    <label class="flex min-h-8 max-w-full cursor-pointer items-center gap-2 py-1 {{if $.Words}}font-sans text-sm font-normal{{else}}font-mono text-base font-normal{{end}} leading-6 text-body">
      <input id="{{$.Name}}{{if $index}}-option-{{$index}}{{end}}" type="radio" name="{{$.Name}}" value="{{.Value}}"{{if eq $index $selected}} checked{{end}}{{with $.DescribedBy}} aria-describedby="{{.}}"{{end}}{{if $.Error}} aria-invalid="true"{{end}} class="size-4.5 shrink-0 cursor-pointer accent-choice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim-deep">
      <span class="min-w-0 wrap-anywhere">{{.Label}}</span>
    </label>
    {{end}}
    {{if .Reshapes}}{{template "verso-reshape-wait" "flex min-h-8 items-center py-1"}}{{end}}
  </div>
  {{else if eq .Kind "select"}}
  {{template "verso-select" .Part}}
  {{else if eq .Kind "checks"}}
  {{/* checks: membership in a known set — all boxes share the field's name and
       post as a multi-value field (name=a&name=b), the list-widget contract.
       Free text is how dead references happen; a closed set makes them
       untypeable. */}}
  {{if .Segmented}}
  {{/* segmented: a set short enough to show whole reads better as one strip of
       chips than as a grid of boxes. Wrap when the field is too narrow to fit
       every option. Still checkboxes underneath,
       so it posts exactly as the grid does and needs no JavaScript. */}}
  <div role="group"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="inline-flex w-fit max-w-full flex-wrap gap-0.5 self-start rounded-xs border border-rule-strong bg-quiet p-0.5">
    {{range .Options}}
    <label class="flex h-7.5 cursor-pointer items-center rounded-xs px-3.5 text-sm font-normal text-body transition-colors hover:text-ink has-checked:bg-choice has-checked:font-semibold has-checked:text-white {{template "verso-segment-focus"}}">
      <input type="checkbox" name="{{$.Name}}" value="{{.Value}}"{{if $.Checked .Value}} checked{{end}} class="sr-only">
      {{/* A checked chip's word goes semibold, which is wider; its hidden
           semibold twin in the same cell holds that width from the start, so
           checking one never nudges the chips after it. */}}
      <span class="grid"><span class="col-start-1 row-start-1">{{.Label}}</span><span aria-hidden="true" class="invisible col-start-1 row-start-1 font-semibold">{{.Label}}</span></span>
    </label>
    {{end}}
  </div>
  {{else}}
  {{/* A set of boxes is read down, one option a row, as a set of radios is:
       options of any length start at the same edge, where a grid's columns
       would scatter them. */}}
  <div role="group"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="flex min-w-0 flex-col items-start">
    {{range .Options}}
    <label class="flex min-h-8 max-w-full cursor-pointer items-center gap-2 py-1 text-sm leading-6 text-body">
      <input type="checkbox" name="{{$.Name}}" value="{{.Value}}"{{if $.Checked .Value}} checked{{end}}
        class="size-4.5 shrink-0 cursor-pointer rounded-xs border-choice-border accent-choice focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim-deep">
      {{.Label}}
    </label>
    {{end}}
  </div>
  {{end}}
  {{else if and (eq .Kind "password") (eq .Style "reveal")}}
  {{/* A shared secret — a Wi-Fi key someone reads out to a guest — sits in the
       field masked, and the eye beside it shows it. Only this style reflects a
       value; a sign-in password never does. */}}
  <span x-data="reveal" class="flex w-full items-center gap-2">
    <input id="{{.Name}}" name="{{.Name}}" type="password" :type="inputType" value="{{.Value}}" autocomplete="off" spellcheck="false"{{template "verso-field-aria" .}} class="min-w-0 flex-1 {{template "verso-input-words"}} {{template "verso-input-border" .Error}}">
    <button type="button" @click="toggle" :aria-pressed="pressed" aria-pressed="false" aria-label="{{ t "Show password" }}" title="{{ t "Show password" }}" class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-xs border border-rule-strong text-glyph transition-colors hover:border-sand-5 hover:bg-rule hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">
      <span x-show="masked" class="flex">{{icon "eye" "size-4"}}</span>
      <span x-show="shown" x-cloak class="flex">{{icon "eye-off" "size-4"}}</span>
    </button>
  </span>
  {{else if eq .Kind "password"}}
  {{/* Never reflect a submitted password back into the value attribute. */}}
  <input id="{{.Name}}" name="{{.Name}}" type="password" autocomplete="{{if .Autocomplete}}{{.Autocomplete}}{{else}}new-password{{end}}"{{template "verso-field-aria" .}} class="{{template "verso-input-words"}} w-64! max-w-full {{template "verso-input-border" .Error}}">
  {{else if eq .Kind "textarea"}}
  <textarea id="{{.Name}}" name="{{.Name}}" rows="5"{{template "verso-field-aria" .}} class="{{template "verso-input-words"}} {{template "verso-input-border" .Error}} h-auto py-2 leading-relaxed">{{.Value}}</textarea>
  {{else if eq .Kind "datetime-local"}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="datetime-local" step="1"{{template "verso-field-aria" .}} class="{{template "verso-input-class"}} {{template "verso-input-border" .Error}}">
  {{else if eq .Kind "time"}}
  {{template "verso-time-input" .Part}}
  {{else if .Unit}}
  {{/* A unit rides inside the frame after the value: the value and what it
       counts read as one thing (verso-box). */}}
  {{template "verso-box" .Box}}
  {{else}}
  {{template "verso-text-input" .Part}}
  {{end}}
  {{/* Help is not a line under the control: it is what the label explains, and
       it is raised from there. Only a refusal takes space in the row, and the
       frame draws it. */}}
{{end}}
