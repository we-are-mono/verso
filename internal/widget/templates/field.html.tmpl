{{/* field: one labelled control, with datatype + inline error. Kind selects the
     input type (text, select, checks, password, file, textarea, datetime-local).
     Kind "hidden" is the bare carrier — no label, no chrome — for a value a
     form must post but a person never edits (e.g. which object a button acts
     on). With an Autocomplete it is instead the account a password form
     belongs to: a text input the password manager reads, never drawn.

     Every other kind is one setting's row: the frame (verso-field) draws the
     label, the refusal and the lane, and field.control below draws the
     control inside it. */}}
{{if and (eq .Kind "hidden") .Autocomplete}}<input type="text" name="{{.Name}}" value="{{.Value}}" autocomplete="{{.Autocomplete}}" readonly hidden>{{else if eq .Kind "hidden"}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{else if and (eq .Kind "file") (eq .Style "text")}}
{{/* A text file a plugin reads: the same drop area, but the picker posts
     nothing. The browser reads the chosen file into the hidden field under it
     (verso-forms.js, data-verso-file-read) and its name beside it, so the form
     posts as any other; a form that reshapes on it is drawn again around what
     the file says. A file already read is named in the area. */}}
<div class="verso-drop"{{if .Error}} data-verso-refused{{end}}{{if .Reshapes}} data-verso-reshape{{end}}>
  <label for="{{.Name}}-file" data-verso-drop class="verso-drop__area">
    <input id="{{.Name}}-file" type="file" data-verso-file-read data-verso-file-max="32768"{{if .Accept}} accept="{{.Accept}}"{{end}}{{if or .Help .Error}} aria-describedby="{{if .Help}}{{.Name}}-help{{end}}{{if and .Help .Error}} {{end}}{{if .Error}}{{.Name}}-error{{end}}"{{end}}{{if .Error}} aria-invalid="true"{{end}} class="verso-drop__picker">
    <span aria-hidden="true" class="verso-drop__glyph">{{icon "upload" "size-8"}}</span>
    {{if .Chosen}}
    <span class="verso-drop__chosen" data-verso-verbatim data-verso-file-chosen>{{.Chosen}}</span>
    <span class="verso-drop__or"><span class="verso-drop__door">{{ t "Choose another" }}</span></span>
    {{else}}
    <span class="verso-drop__prompt">{{if .Prompt}}{{.Prompt}}{{else}}{{ t "Drop a file here" }}{{end}}</span>
    <span class="verso-drop__or">{{ t "or" }} <span class="verso-drop__door">{{ t "choose one from your computer" }}</span></span>
    {{end}}
  </label>
  <textarea name="{{.Name}}" hidden data-verso-file-text>{{.Value}}</textarea>
  <input type="hidden" name="{{.Name}}_name" value="{{.Chosen}}" data-verso-file-name>
  <p hidden data-verso-file-refused class="verso-refusal">{{ t "That file is larger than 32 KiB, so it isn’t a profile this router can use." }}</p>
  {{if .Help}}<p id="{{.Name}}-help" class="verso-drop__help">{{.Help}}</p>{{end}}
  {{if .Error}}<p id="{{.Name}}-error" data-verso-error class="verso-refusal">{{template "verso-error-words" .Error}}</p>{{end}}
</div>
{{else if eq .Kind "file"}}
{{/* A file to drop is its dialog's whole subject, so its area fills the width:
     the app's place-marking dashed hairline on sand, the upload glyph, what to
     drop and the other way to choose one, and under it what fits. The native
     input covers the area invisibly, so a drop works without the page's script
     and a click opens the system's picker. A file dragged over it answers in
     denim (data-dragging, set by verso-forms.js). */}}
<div class="verso-drop"{{if .Error}} data-verso-refused{{end}}>
  <label for="{{.Name}}" data-verso-drop class="verso-drop__area">
    <input id="{{.Name}}" name="{{.Name}}" type="file"{{if .Accept}} accept="{{.Accept}}"{{end}}{{if .Required}} required{{end}}{{if or .Help .Error}} aria-describedby="{{if .Help}}{{.Name}}-help{{end}}{{if and .Help .Error}} {{end}}{{if .Error}}{{.Name}}-error{{end}}"{{end}}{{if .Error}} aria-invalid="true"{{end}} class="verso-drop__picker">
    <span aria-hidden="true" class="verso-drop__glyph">{{icon "upload" "size-8"}}</span>
    <span class="verso-drop__prompt">{{if .Prompt}}{{.Prompt}}{{else}}{{ t "Drop a file here" }}{{end}}</span>
    <span class="verso-drop__or">{{ t "or" }} <span class="verso-drop__door">{{ t "choose one from your computer" }}</span></span>
  </label>
  {{if .Help}}<p id="{{.Name}}-help" class="verso-drop__help">{{.Help}}</p>{{end}}
  {{if .Error}}<p id="{{.Name}}-error" data-verso-error class="verso-refusal">{{template "verso-error-words" .Error}}</p>{{end}}
</div>
{{end}}

{{/* field.control: the control a field's row holds. Labels and their keys sit
     directly above it on every surface; sections have rules, and individual
     fields are separated by their padding. */}}
{{define "field.control"}}
  {{if eq .Style "code"}}
  <textarea id="{{.Name}}" name="{{.Name}}" rows="14" spellcheck="false" data-verso-code-editor{{template "verso-field-aria" .}} class="verso-input" data-verso-kind="code">{{.Value}}</textarea>
  <p class="verso-input__count">{{t "Lines"}}: <span data-verso-code-lines data-verso-figures>{{.LineCount}}</span></p>
  {{else if eq .Style "locked"}}
  {{/* A value fixed once written: the row keeps its place and its label, the
       control is a quiet box with a padlock and the reason on it, and nothing
       posts. An output is labelable, so the row's label still names it. */}}
  <output id="{{.Name}}"{{if .Help}} title="{{.Help}}"{{end}} class="verso-input">{{.Value}}<span class="verso-input__lock">{{icon "lock" "size-3.5"}}</span></output>
  {{else if .UseRadios}}
  {{/* Small single-choice sets stay visible. Native radios retain arrow-key
       navigation, mutual exclusion and the same submitted name/value. The
       choices are the row's answer, read across in order, 16px apart: each
       is 32px, its 24px line and 4px over and under, so it centres on the
       name's line as a control does, and a choice that does not fit wraps
       onto the next 32px line. */}}
  {{$selected := .SelectedIndex}}
  <div role="radiogroup"{{if .Reshapes}} data-verso-reshape{{end}}{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="verso-choice__group" data-verso-kind="radios">
    {{range $index, $option := .Options}}
    <label class="verso-choice__option"{{if not $.Words}} data-verso-verbatim{{end}}>
      <input id="{{$.Name}}{{if $index}}-option-{{$index}}{{end}}" type="radio" name="{{$.Name}}" value="{{.Value}}"{{if eq $index $selected}} checked{{end}}{{with $.DescribedBy}} aria-describedby="{{.}}"{{end}}{{if $.Error}} aria-invalid="true"{{end}} class="verso-choice__native">
      <span>{{.Label}}</span>
    </label>
    {{end}}
    {{if .Reshapes}}<span data-verso-reshape-wait hidden class="verso-choice__option">{{template "verso-waiting" ""}}</span>{{end}}
  </div>
  {{else if eq .Kind "select"}}
  {{template "verso-select" .Part}}
  {{else if eq .Kind "checks"}}
  {{/* checks: membership in a known set — all boxes share the field's name and
       post as a multi-value field (name=a&name=b), the list-widget contract.
       Free text is how dead references happen; a closed set makes them
       untypeable. */}}
  {{if .Segmented}}
  {{/* segmented: a set short enough to show whole reads better as one strip of
       chips than as a grid of boxes. The strip fills its answer, its chips
       sharing the width, so a week stands in the answer column as any answer
       does; it wraps only when a chip's word would not fit. Still checkboxes
       underneath, so it posts exactly as the grid does and needs no
       JavaScript. */}}
  <div role="group"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="verso-choice__group" data-verso-kind="segments">
    {{range .Options}}
    <label class="verso-choice__segment">
      <input type="checkbox" name="{{$.Name}}" value="{{.Value}}"{{if $.Checked .Value}} checked{{end}} class="verso-choice__input">
      {{/* A checked chip's word goes semibold, which is wider; its hidden
           semibold twin in the same cell holds that width from the start, so
           checking one never nudges the chips after it. */}}
      <span class="verso-choice__stack"><span class="verso-choice__words">{{.Label}}</span><span aria-hidden="true" class="verso-choice__twin">{{.Label}}</span></span>
    </label>
    {{end}}
  </div>
  {{else}}
  {{/* A set of boxes is read down, one option a row, as a set of radios is:
       options of any length start at the same edge, where a grid's columns
       would scatter them. */}}
  <div role="group"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{template "verso-field-aria" .}} class="verso-choice__group" data-verso-kind="checks">
    {{range .Options}}
    <label class="verso-choice__option">
      <input type="checkbox" name="{{$.Name}}" value="{{.Value}}"{{if $.Checked .Value}} checked{{end}} class="verso-choice__native">
      <span>{{.Label}}</span>
    </label>
    {{end}}
  </div>
  {{end}}
  {{else if and (eq .Kind "password") (eq .Style "reveal")}}
  {{/* A shared secret — a Wi-Fi key someone reads out to a guest — sits in the
       field masked, and the eye beside it shows it. Only this style reflects a
       value; a sign-in password never does. The eye is a control's square,
       the field's height, so the pair is one control's line. */}}
  <span x-data="reveal" class="flex w-full items-center gap-2">
    <input id="{{.Name}}" name="{{.Name}}" type="password" :type="inputType" value="{{.Value}}" autocomplete="off" spellcheck="false"{{template "verso-field-aria" .}} class="verso-input min-w-0 flex-1">
    <button type="button" @click="toggle" :aria-pressed="pressed" aria-pressed="false" aria-label="{{ t "Show password" }}" title="{{ t "Show password" }}" class="verso-button" data-verso-style="secondary" data-verso-size="square">
      <span x-show="masked" class="flex">{{icon "eye" "size-4"}}</span>
      <span x-show="shown" x-cloak class="flex">{{icon "eye-off" "size-4"}}</span>
    </button>
  </span>
  {{else if eq .Kind "password"}}
  {{/* Never reflect a submitted password back into the value attribute. */}}
  <input id="{{.Name}}" name="{{.Name}}" type="password" autocomplete="{{if .Autocomplete}}{{.Autocomplete}}{{else}}new-password{{end}}"{{if .Autofocus}} autofocus{{end}}{{template "verso-field-aria" .}} class="verso-input">
  {{else if eq .Kind "textarea"}}
  <textarea id="{{.Name}}" name="{{.Name}}" rows="5"{{template "verso-field-aria" .}} class="verso-input">{{.Value}}</textarea>
  {{else if eq .Kind "datetime-local"}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="datetime-local" step="1"{{template "verso-field-aria" .}} class="verso-input" data-verso-verbatim>
  {{else if eq .Kind "time"}}
  {{template "verso-time-input" .Part}}
  {{else if .Unit}}
  {{/* A unit rides inside the frame after the value: the value and what it
       counts read as one thing (verso-box). */}}
  {{template "verso-box" .Box}}
  {{else if .Suggests}}
  {{template "verso-suggest-input" .Part}}
  {{else}}
  {{template "verso-text-input" .Part}}
  {{end}}
  {{/* Help is not a line under the control: it is what the label explains, and
       it is raised from there. Only a refusal takes space in the row, and the
       frame draws it. */}}
{{end}}
