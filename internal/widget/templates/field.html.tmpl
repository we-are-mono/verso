{{/* field: one labelled control (text or select), with datatype + inline error */}}
<div class="space-y-1.5">
  <label for="{{.Name}}" class="block text-sm font-medium text-slate-900">{{.Label}}</label>
  {{if eq .Kind "select"}}
  <select id="{{.Name}}" name="{{.Name}}" class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
    {{range .Options}}<option value="{{.Value}}"{{if eq .Value $.Value}} selected{{end}}>{{.Label}}</option>{{end}}
  </select>
  {{else if eq .Kind "password"}}
  {{/* Never reflect a submitted password back into the value attribute. */}}
  <input id="{{.Name}}" name="{{.Name}}" type="password" autocomplete="new-password" class="w-full rounded-md border {{if .Error}}border-red-600{{else}}border-slate-300{{end}} bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
  {{else if eq .Kind "textarea"}}
  <textarea id="{{.Name}}" name="{{.Name}}" rows="5" class="w-full rounded-md border {{if .Error}}border-red-600{{else}}border-slate-300{{end}} bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-sky-600 focus:outline-none">{{.Value}}</textarea>
  {{else}}
  <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="text"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="w-full rounded-md border {{if .Error}}border-red-600{{else}}border-slate-300{{end}} bg-white px-3 py-2 text-sm text-slate-900 focus:border-sky-600 focus:outline-none">
  {{end}}
  {{if .Error}}<p class="text-sm text-red-600">{{.Error}}</p>{{end}}
  {{if .Help}}<p class="text-sm text-slate-500">{{.Help}}</p>{{end}}
</div>
