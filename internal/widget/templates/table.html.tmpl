{{/* table: config sections as identical rows under kind-typed columns. The card is
     the quietest element (inset table, transparent header — typography alone marks
     it); pills and counters are the loudest. One treatment per element type:
     endpoints are a type icon + label (no pill — the grid already contains them),
     mono is reserved for verbatim machine strings, counters read sans with tabular
     figures. Type scale: data 0.875rem sans (text-sm) / 0.9rem mono, headers 0.75rem. An
     optional seam folds extra rows (stock defaults) inside the same card. */}}
{{/* table.tag: a small coloured label after a cell's value ("new", "WAN") — the
     badge vocabulary as a compact tag, not a full pill. */}}
{{define "table.tag"}}<span class="inline-flex items-center gap-1 rounded-md px-1.5 py-1 text-xs font-medium whitespace-nowrap {{if .TagIcon}}ring-1 ring-inset {{if eq .TagVariant "info"}}bg-sky-50 text-sky-700 ring-sky-600/20 dark:bg-sky-500/10 dark:text-sky-400 dark:ring-sky-500/20{{else}}bg-slate-50 text-slate-600 ring-slate-200 dark:bg-slate-400/10 dark:text-slate-700 dark:ring-slate-400/20{{end}}{{else}}{{if eq .TagVariant "info"}}bg-sky-100 text-sky-800 dark:bg-sky-500/10 dark:text-sky-400{{else if eq .TagVariant "warning"}}bg-amber-100 text-amber-800 dark:bg-amber-500/10 dark:text-amber-400{{else if eq .TagVariant "success"}}bg-emerald-100 text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-400{{else if eq .TagVariant "danger"}}bg-red-100 text-red-800 dark:bg-red-500/10 dark:text-red-400{{else}}bg-slate-100 text-slate-600 dark:bg-slate-400/10 dark:text-slate-700{{end}}{{end}}">{{if .TagIcon}}<span class="{{if eq .TagVariant "info"}}text-sky-600 dark:text-sky-400{{else}}text-slate-400{{end}}">{{icon .TagIcon "size-3.5"}}</span>{{end}}{{.Tag}}</span>{{end}}
{{define "table.chip"}}<span class="inline-flex items-center gap-1 rounded-md ring-1 ring-inset ring-slate-200 bg-slate-50 px-1.5 py-1 text-xs font-medium text-slate-600 whitespace-nowrap dark:bg-slate-400/10 dark:text-slate-700 dark:ring-slate-400/20">{{if .Icon}}<span class="text-slate-400">{{icon .Icon "size-3.5"}}</span>{{end}}{{.Label}}</span>{{end}}
{{define "table.rows"}}
      {{range .}}
      {{if .Group}}
      <tr class="verso-table-group bg-slate-50{{if .Seam}} verso-table-seam-row{{end}}">
        <th colspan="{{.ColumnSpan}}" class="border-b border-slate-200 px-3 py-3 text-left font-normal">
          <span class="flex items-baseline gap-3">
            <span class="text-sm font-semibold text-slate-900">{{.Group.Label}}</span>
            <span class="flex-1"></span>
            <span class="font-mono text-base font-semibold text-slate-500">{{.Group.Chain}}</span>
            <span class="text-sm text-slate-500">· {{.Group.Count}} {{if eq .Group.Count 1}}rule{{else}}rules{{end}}</span>
          </span>
        </th>
      </tr>
      {{end}}
      {{/* Rows are inert: no whole-row click, so cell values stay selectable and
           copy-pastable. A row with a drawer still hosts its own modal scope, but
           it opens from the trailing "Details" link, never the row. The panel
           teleports to <body>. */}}
      {{if .Drawer}}
      <tr x-data="modal" class="group{{if .Seam}} verso-table-seam-row{{end}}"{{if .Reorder}} data-verso-reorder-row data-verso-reorder-id="{{.ID}}" data-verso-reorder-group="{{.ReorderGroup}}"{{end}}{{if .Key}} data-verso-row="{{.Key}}"{{end}}>
      {{else}}
      <tr class="group{{if .Seam}} verso-table-seam-row{{end}}"{{if .Reorder}} data-verso-reorder-row data-verso-reorder-id="{{.ID}}" data-verso-reorder-group="{{.ReorderGroup}}"{{end}}{{if .Key}} data-verso-row="{{.Key}}"{{end}}>
      {{end}}
        {{range .Cells}}
        {{if eq .Kind "reorder"}}
        <td class="w-8 border-b border-slate-200 py-3 pr-2 pl-0 align-middle group-last:border-b-0">
          <button type="button" data-verso-reorder-handle aria-label="{{ t "Reorder" }} {{.RowID}}" title="{{ t "Drag to reorder" }}" class="grid size-6 cursor-grab touch-none place-items-center text-slate-300 transition-colors select-none hover:text-slate-500 active:cursor-grabbing focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600">
            {{icon "grip-vertical" "size-4"}}
          </button>
        </td>
        {{else if eq .Kind "toggle"}}
        {{/* a toggle cell without a form name is an empty slot — rows whose
             thing has no on/off stay blank, not decorated with a dead switch. */}}
        <td class="w-11 border-b border-slate-200 py-3 pr-1 pl-3.5 align-middle first:pl-0 last:pr-0 group-last:border-b-0">
          {{if .Name}}{{template "switch.html.tmpl" .}}{{else if .Icon}}<span class="grid size-7 place-items-center text-slate-400" title="{{.Button}}" aria-label="{{.Button}}">{{icon .Icon "size-4"}}</span>{{end}}
        </td>
        {{else if eq .Kind "action"}}
        {{/* a compact, immediately applied row action. Name/Text carry the
             target field and value; Action is the lifecycle verb. */}}
        <td class="w-11 border-b border-slate-200 py-3 pr-1 pl-3.5 align-middle first:pl-0 last:pr-0 group-last:border-b-0">
          {{if and .Name .Text .Action}}
          <form method="post" class="inline-flex">
            <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
            <input type="hidden" name="{{.Name}}" value="{{.Text}}">
            <button type="submit" name="_action" value="{{.Action}}" aria-label="{{.Button}}" title="{{.Button}}" class="grid size-8 cursor-pointer place-items-center rounded-md text-slate-400 transition-colors hover:bg-slate-100 hover:text-slate-700 active:translate-y-px active:bg-slate-200 active:shadow-none motion-reduce:active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-200 dark:active:bg-gray-950">
              {{icon .Icon "size-4"}}
            </button>
          </form>
          {{end}}
        </td>
        {{else if eq .Kind "endpoint"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle group-last:border-b-0">
          {{$primary := .Primary}}
          <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
            {{range .Endpoints}}
            <span class="inline-flex items-center gap-1.5 whitespace-nowrap {{if $primary}}text-base {{end}}{{if eq .Kind "router"}}font-semibold text-sky-700 dark:text-sky-400{{else if eq .Kind "device"}}font-mono text-base font-semibold tabular-nums text-slate-900{{else if eq .Kind "any"}}text-slate-500{{else}}font-semibold text-slate-900{{end}}">
              <span class="{{if eq .Kind "router"}}text-sky-600 dark:text-sky-400{{else}}text-slate-400{{end}}">{{icon .Icon "size-3.5"}}</span>{{.Label}}
            </span>
            {{end}}
          </span>
        </td>
        {{else if or (eq .Kind "name") (eq .Kind "reference")}}
        {{/* the identity column: the name in bold ink, with an optional small
             category chip inline after it (e.g. the device's zone). */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle group-last:border-b-0">
          <span class="inline-flex items-center gap-2">
            {{if .LeadIcon}}<span class="shrink-0 text-slate-400">{{icon .LeadIcon "size-3.5"}}</span>{{end}}
            <span class="{{if .Primary}}text-base {{end}}{{if eq .Kind "name"}}font-semibold {{else if eq .Kind "reference"}}font-mono text-base font-semibold {{end}}text-slate-900">{{.Text}}</span>
            {{if .Chip}}<span class="inline-flex items-center gap-1 rounded-md ring-1 ring-inset ring-slate-200 bg-slate-50 px-1.5 py-1 text-xs font-medium text-slate-600 dark:bg-slate-400/10 dark:text-slate-700 dark:ring-slate-400/20">{{if .ChipIcon}}<span class="text-slate-400">{{icon .ChipIcon "size-3.5"}}</span>{{end}}{{.Chip}}</span>{{end}}
            {{range .Chips}}{{template "table.chip" .}}{{end}}
            {{if .Tag}}{{template "table.tag" .}}{{end}}
          </span>
        </td>
        {{else if eq .Kind "status"}}
        {{/* a link/state cell: a bare status dot in the cell's variant colour, the
             word calm beside it, and an optional tag (e.g. the WAN uplink). */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle whitespace-nowrap text-slate-600 group-last:border-b-0"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}>
          <span class="inline-flex items-center gap-2">
            <span class="size-2 shrink-0 rounded-full {{if eq .Variant "success"}}bg-emerald-500{{else if eq .Variant "warning"}}bg-amber-500{{else if eq .Variant "danger"}}bg-red-500{{else}}bg-slate-300{{end}}"{{if .Key}} data-verso-dot{{end}}></span>
            <span{{if .Key}} data-verso-value{{end}}>{{.Text}}</span>
            {{if .Tag}}{{template "table.tag" .}}{{end}}
          </span>
        </td>
        {{else if eq .Kind "link"}}
        {{/* a right-aligned action link (e.g. "Details") to the cell's Href. */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 text-right align-middle whitespace-nowrap group-last:border-b-0">{{if .Text}}<a href="{{.Href}}" class="text-sm font-medium text-sky-600 transition-colors hover:text-sky-700">{{.Text}}</a>{{end}}</td>
        {{else if eq .Kind "pill"}}
        {{/* a status pill, a drawer trigger, or a direct row action. A direct
             destructive action opens a compact alert dialog and posts its
             _action marker only after explicit confirmation. */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle whitespace-nowrap group-last:border-b-0">
          {{if .Pill}}{{template "badge.html.tmpl" .Pill}}
          {{else if .Button}}
            {{if .Drawer}}
              <button type="button" @click="show" class="inline-flex items-center rounded-md border border-slate-300 bg-white px-2 py-0.5 text-xs font-medium text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:border-gray-700 dark:bg-transparent dark:text-gray-300 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:active:bg-gray-900">{{.Button}}</button>
            {{else if .Confirm}}
              <span x-data="modal" class="inline">
                <button type="button" @click="show" class="inline-flex items-center rounded-md border border-slate-300 bg-white px-2 py-0.5 text-xs font-medium text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900 active:translate-y-px active:shadow-none motion-reduce:active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:border-gray-700 dark:bg-transparent dark:text-gray-300 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:active:bg-gray-900">{{.Button}}</button>
                <template x-teleport="body">
                  <div x-show="open" x-cloak @keydown.window="onKeydown" class="fixed inset-0 z-50 overflow-y-auto">
                    <div x-show="open" x-transition.opacity @click="hide" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs dark:bg-black/60"></div>
                    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center">
                      <div x-show="open" x-transition x-ref="dialog" tabindex="-1" role="alertdialog" aria-modal="true" aria-labelledby="{{.ConfirmID}}-title" aria-describedby="{{.ConfirmID}}-body" class="relative w-full max-w-md rounded-lg border border-slate-200 bg-white p-5 text-left shadow-xl focus:outline-none sm:p-6">
                        <div class="sm:flex sm:items-start">
                          <div class="mx-auto grid size-12 shrink-0 place-items-center rounded-full bg-red-100 text-red-600 dark:bg-red-500/10 dark:text-red-400 sm:mx-0 sm:size-10">{{icon "triangle-alert" "size-6"}}</div>
                          <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                            <h3 id="{{.ConfirmID}}-title" class="text-base font-semibold text-slate-900">{{.ConfirmTitle}}</h3>
                            <p id="{{.ConfirmID}}-body" class="mt-2 whitespace-normal text-sm text-slate-500">{{.Confirm}}</p>
                          </div>
                        </div>
                        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                          <form method="post">
                            <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
                            <button type="submit" name="_action" value="{{if .Action}}{{.Action}}{{else}}{{.RowID}}{{end}}" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-red-700 active:translate-y-px active:shadow-none motion-reduce:active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 dark:bg-red-800 dark:text-gray-100 dark:hover:bg-red-900 dark:active:bg-red-950 sm:w-auto">{{.Button}}</button>
                          </form>
                          <button type="button" @click="hide" class="inline-flex w-full justify-center rounded-md px-3 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-200 dark:active:bg-gray-900 sm:w-auto">{{ t "Cancel" }}</button>
                        </div>
                      </div>
                    </div>
                  </div>
                </template>
              </span>
            {{else}}
              <form method="post" class="inline">
                <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
                <button type="submit" name="_action" value="{{if .Action}}{{.Action}}{{else}}{{.RowID}}{{end}}" class="inline-flex items-center rounded-md border border-slate-300 bg-white px-2 py-0.5 text-xs font-medium text-slate-700 transition-colors hover:border-slate-400 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:border-gray-700 dark:bg-transparent dark:text-gray-300 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:active:bg-gray-900">{{.Button}}</button>
              </form>
            {{end}}
          {{else}}<span class="{{if .Muted}}text-slate-500{{else}}text-slate-300{{end}}">—</span>{{end}}
        </td>
        {{else if eq .Kind "check"}}
        {{/* a yes/no fact: the checkmark affirms, absence says no — no dash,
             no "no", nothing to read when there is nothing to say. */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle group-last:border-b-0">{{if .On}}{{icon "check" "size-5 [stroke-width:2.5] text-green-600"}}{{end}}</td>
        {{else if eq .Kind "entity"}}
        {{/* entity references — an interface, a zone, or physical ports — as icon
             chips: the Lucide glyph names the kind, the label the one. One chip or
             a wrapping row of them; empty reads as a quiet dash. */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle group-last:border-b-0">
          {{if .Chips}}
          <span class="flex flex-wrap items-center gap-1.5">
            {{range .Chips}}{{template "table.chip" .}}{{end}}
          </span>
          {{else}}<span class="text-slate-300">—</span>{{end}}
        </td>
        {{else if eq .Kind "mono"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle font-mono {{if and .Primary .Emphasis}}text-lg{{else if or .Primary .Emphasis}}text-base{{else}}text-[0.9rem]{{end}}{{if .Emphasis}} font-semibold{{end}} tabular-nums whitespace-nowrap {{if .Muted}}text-slate-500{{else}}text-slate-900{{end}} group-last:border-b-0">{{.Text}}{{if and .Copy .Text}}{{template "verso-copy-inline" .Text}}{{end}}</td>
        {{else if eq .Kind "addr"}}
        {{/* stacked addresses: the primary (IPv4) on top in full ink, a secondary
             line (the global IPv6) muted below — both copyable, so the cell holds
             both families without a second column. */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle font-mono {{if and .Primary .Emphasis}}text-lg{{else if or .Primary .Emphasis}}text-base{{else}}text-[0.9rem]{{end}}{{if .Emphasis}} font-semibold{{end}} tabular-nums group-last:border-b-0">
          {{if .Text}}<div class="whitespace-nowrap text-slate-900">{{.Text}}{{if .Copy}}{{template "verso-copy-inline" .Text}}{{end}}</div>{{end}}
          {{if .Sub}}<div class="whitespace-nowrap text-slate-500">{{.Sub}}{{if .Copy}}{{template "verso-copy-inline" .Sub}}{{end}}</div>{{end}}
          {{if and (not .Text) (not .Sub)}}<span class="text-slate-300">—</span>{{end}}
        </td>
        {{else if eq .Kind "keyword"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle whitespace-nowrap text-slate-600 group-last:border-b-0">{{.Text}}</td>
        {{else if eq .Kind "runtime"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle whitespace-nowrap tabular-nums text-slate-500 group-last:border-b-0">{{.Text}}</td>
        {{else if eq .Kind "comment"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle text-slate-500 group-last:border-b-0">{{.Text}}</td>
        {{else if eq .Kind "rate"}}
        <td class="w-32 min-w-32 max-w-32 border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 text-left align-middle whitespace-nowrap tabular-nums text-slate-500 group-last:border-b-0"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}>{{.Text}}</td>
        {{else if eq .Kind "num"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 text-right align-middle tabular-nums text-slate-500 group-last:border-b-0"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}>{{.Text}}</td>
        {{else}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle {{if .Muted}}text-slate-500{{else}}text-slate-900{{end}} group-last:border-b-0">{{.Text}}</td>
        {{end}}
        {{end}}
        {{if .HasDetail}}
        {{/* the trailing "more" affordance: a plain link hard-right, the only
             click target in the row. Blank when the row has nothing behind it,
             or when its drawer already opens from an in-cell button. */}}
        <td class="border-b border-slate-200 px-3.5 py-3 pr-1 text-right align-middle whitespace-nowrap last:pr-0 group-last:border-b-0">
          {{if and .Drawer (not .Inline)}}<button type="button" @click="show" class="inline-flex items-center gap-1.5 text-sm font-medium text-sky-600 transition-colors hover:text-sky-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600 dark:text-sky-400 dark:hover:text-sky-300">{{if .DrawerIcon}}{{icon .DrawerIcon "size-3.5"}}{{end}}{{.DrawerLabel}}</button>{{end}}
        </td>
        {{end}}
        {{if .Drawer}}
        <template x-teleport="body">
          <div x-show="open" x-cloak @keydown.window="onKeydown" class="fixed inset-0 z-50">
            <div x-show="open" x-transition.opacity @click="hide" class="absolute inset-0 bg-slate-900/50 backdrop-blur-xs dark:bg-black/60"></div>
            <aside x-show="open" @input="markDirty" @change="markDirty"
              x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
              x-transition:leave="transition duration-200 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
              x-ref="dialog" tabindex="-1" role="dialog" aria-modal="true"
              class="verso-drawer-scrollbar absolute inset-y-0 right-0 flex w-full {{if .DrawerWide}}max-w-2xl{{else}}max-w-md{{end}} flex-col overflow-y-auto border-l border-slate-200 bg-white shadow-xl focus:outline-none">
              {{if .DrawerHideTitle}}
              <h3 class="sr-only">{{.DrawerTitle}}</h3>
              <button type="button" @click="hide" aria-label="{{ t "Close" }}"
                class="absolute top-5 right-5 z-10 rounded p-1 text-slate-400 transition-colors hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-sky-600">
                {{icon "x" "size-5"}}
              </button>
              {{else}}<header class="flex shrink-0 items-center justify-between px-5 pt-4 pb-2">
                <h3 class="text-base font-medium text-slate-900">{{.DrawerTitle}}</h3>
                <button type="button" @click="hide" aria-label="{{ t "Close" }}"
                  class="rounded p-1 text-slate-400 transition-colors hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-sky-600">
                  {{icon "x" "size-5"}}
                </button>
              </header>{{end}}
              <div class="space-y-6 px-5 {{if .DrawerHideTitle}}pt-5{{else}}pt-2.5{{end}} pb-5">
                {{range .DrawerBody}}{{.}}{{end}}
              </div>
            </aside>
          </div>
        </template>
        {{end}}
      </tr>
      {{end}}
{{end}}
{{define "table.head"}}
    <thead>
      <tr>
        {{range .Columns}}
        <th scope="col" class="whitespace-nowrap border-b border-slate-200 {{if eq .Kind "reorder"}}w-8 py-0 pr-2 pl-0{{else}}px-3.5 pt-4 pb-2.5 first:pl-0 last:pr-0{{end}} text-sm font-light text-slate-500 {{if eq .Kind "rate"}}w-32 min-w-32 max-w-32 text-left{{else if eq .Kind "num"}}text-right{{else}}text-left{{end}}">{{.Label}}</th>
        {{end}}
        {{if .HasDetail}}<th scope="col" class="border-b border-slate-200"></th>{{end}}
      </tr>
    </thead>
{{end}}
{{/* the default: bare hairline rows flush to the table's edges (first column to
     the left border, last to the right), an optional header band, and inert
     rows — no stripe, no whole-row click, so values stay selectable; Condensed
     just tightens the row padding. style "lined" insets the same hairline rows a
     little — the live-listing look (a process table). style "card" opts into the
     twin-hairline frame — border plus a ring floated 4px out — shared with the
     settings card, so every boxed listing speaks one card language. */}}
{{/* overflow-x-auto lets a genuinely wide table scroll sideways, but the browser
     then computes overflow-y to auto too (CSS spec) — so an in-cell copy button's
     absolute hover tooltip, which sits just below its row, would trip a spurious
     vertical scrollbar on the last row. overflow-y-hidden clips that overhang (the
     tooltip is a hover hint, not content) with no scrollbar. The card style keeps
     its overflow visible so its ring-offset frame is never clipped. */}}
<div class="overflow-x-auto{{if .Card}} rounded-2xl border border-slate-200 bg-white px-5 pb-2 ring-1 ring-slate-200 ring-offset-4 ring-offset-white{{else}} overflow-y-hidden{{if .Lined}} [&_td:first-child]:pl-3 [&_th:first-child]:pl-3 [&_td:last-child]:pr-3 [&_th:last-child]:pr-3{{else if .Condensed}} [&_td]:py-1.5 [&_th]:pt-2.5 [&_th]:pb-2{{end}}{{end}}">
  {{if .Title}}
  {{/* the header band: a top row aligned to the table's own edges (flush
       left title, flush right link), a hairline under it so it reads as the
       table's first row. */}}
  <div class="flex items-baseline gap-3 border-b border-slate-200 pt-1 pb-3">
    <h3 class="text-2xl font-semibold tracking-tight text-slate-900">{{.Title}}</h3>
    {{if .Detail}}<span class="text-sm text-slate-500">{{.Detail}}</span>{{end}}
    <span class="flex-1"></span>
    {{if .Action}}<a href="{{.Action.Href}}" class="shrink-0 text-sm font-medium text-sky-600 transition-colors hover:text-sky-700">{{.Action.Label}}</a>{{end}}
  </div>
  {{end}}
  <table{{if .Reorderable}} data-verso-reorder-table{{end}} class="w-full border-collapse text-sm{{if .AlignTop}} [&_td]:align-top{{end}}">
    {{if .HasLabels}}{{template "table.head" .}}{{end}}
    <tbody>
{{template "table.rows" .Rows}}
      {{if .SeamSummary}}
      {{/* A genuine spanning row keeps the collapsed affordance and every
           revealed row in this table's single column-sizing context. */}}
      <tr class="verso-table-seam-control">
        <td colspan="{{.ColumnSpan}}" class="border-t border-slate-200 p-0 text-left">
          <details>
            <summary class="group flex w-full cursor-pointer items-center justify-start gap-1.5 py-3 text-left text-sm font-semibold text-sky-700 transition-colors select-none hover:text-sky-800 [&::-webkit-details-marker]:hidden">
              {{icon "chevron-right" "verso-chevron size-4"}}
              {{icon "lock" "size-4 text-slate-400"}}
              <span class="underline-offset-2 group-hover:underline">{{.SeamSummary}}</span>
            </summary>
          </details>
        </td>
      </tr>
{{template "table.rows" .SeamRows}}
      {{end}}
    </tbody>
  </table>
</div>
