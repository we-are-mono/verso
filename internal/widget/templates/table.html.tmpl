{{/* table: config sections as identical rows under kind-typed columns. The card is
     the quietest element (inset table, transparent header — typography alone marks
     it); pills and counters are the loudest. One treatment per element type:
     endpoints are a type icon + label (no pill — the grid already contains them),
     mono is reserved for verbatim machine strings, counters read sans with tabular
     figures. Type scale: data 0.95rem sans / 0.9rem mono, headers 0.7rem. An
     optional seam folds extra rows (stock defaults) inside the same card. */}}
{{define "table.rows"}}
      {{range .}}
      {{/* A row with a drawer is an openable object: it hosts its own modal scope,
           opens on click (showFromRow skips clicks on controls inside the row), and
           carries the chevron affordance. The panel itself teleports to <body>. */}}
      {{if .Drawer}}
      <tr x-data="modal" @click="showFromRow" class="group cursor-pointer transition {{if .Lined}}hover:bg-sky-50/50{{else}}hover:bg-sky-100/60{{end}}{{if .Striped}} odd:bg-slate-50{{end}}">
      {{else}}
      <tr class="group transition {{if .Lined}}hover:bg-sky-50/50{{else}}hover:bg-sky-100/60{{end}}{{if .Striped}} odd:bg-slate-50{{end}}">
      {{end}}
        {{range .Cells}}
        {{if eq .Kind "toggle"}}
        {{/* a toggle cell without a form name is an empty slot — rows whose
             thing has no on/off stay blank, not decorated with a dead switch. */}}
        <td class="w-11 border-b border-slate-200 py-3 pr-1 pl-3.5 align-middle first:pl-0 group-last:border-b-0">
          {{if .Name}}{{template "switch.html.tmpl" .}}{{end}}
        </td>
        {{else if eq .Kind "endpoint"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle group-last:border-b-0">
          <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
            {{range .Endpoints}}
            <span class="inline-flex items-center gap-1.5 whitespace-nowrap {{if eq .Kind "router"}}font-semibold text-sky-700{{else if eq .Kind "device"}}font-mono text-[0.9rem] tabular-nums text-slate-900{{else if eq .Kind "any"}}text-slate-500{{else}}font-semibold text-slate-900{{end}}">
              <span class="{{if eq .Kind "router"}}text-sky-600{{else}}text-slate-400{{end}}">{{icon .Icon "size-3.5"}}</span>{{.Label}}
            </span>
            {{end}}
          </span>
        </td>
        {{else if eq .Kind "name"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle font-semibold text-slate-900 group-last:border-b-0">{{.Text}}</td>
        {{else if eq .Kind "pill"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle whitespace-nowrap group-last:border-b-0">{{if .Pill}}{{template "badge.html.tmpl" .Pill}}{{else}}<span class="text-slate-300">—</span>{{end}}</td>
        {{else if eq .Kind "check"}}
        {{/* a yes/no fact: the checkmark affirms, absence says no — no dash,
             no "no", nothing to read when there is nothing to say. */}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle group-last:border-b-0">{{if .On}}{{icon "check" "size-5 [stroke-width:2.5] text-green-600"}}{{end}}</td>
        {{else if eq .Kind "mono"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle font-mono text-[0.9rem] tabular-nums whitespace-nowrap text-slate-900 group-last:border-b-0">{{.Text}}</td>
        {{else if eq .Kind "keyword"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle whitespace-nowrap text-slate-600 group-last:border-b-0">{{.Text}}</td>
        {{else if eq .Kind "comment"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle text-slate-500 group-last:border-b-0">{{.Text}}</td>
        {{else if eq .Kind "num"}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 text-right align-middle tabular-nums text-slate-500 group-last:border-b-0">{{.Text}}</td>
        {{else}}
        <td class="border-b border-slate-200 px-3.5 py-3 first:pl-0 last:pr-0 align-middle text-slate-900 group-last:border-b-0">{{.Text}}</td>
        {{end}}
        {{end}}
        {{if .HasDrawers}}
        <td class="w-8 border-b border-slate-200 py-3 pr-1 text-right align-middle last:pr-0 group-last:border-b-0">
          {{if .Drawer}}<span class="inline-block text-slate-300 transition group-hover:translate-x-0.5 group-hover:text-slate-500">{{icon "chevron-right" "size-4"}}</span>{{end}}
        </td>
        {{end}}
        {{if .Drawer}}
        <template x-teleport="body">
          <div x-show="open" x-cloak @keydown.window="onKeydown" class="fixed inset-0 z-50">
            <div x-show="open" x-transition.opacity @click="hide" class="absolute inset-0 bg-slate-900/50 backdrop-blur-xs"></div>
            <aside x-show="open" @input="markDirty" @change="markDirty"
              x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
              x-transition:leave="transition duration-200 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
              x-ref="dialog" tabindex="-1" role="dialog" aria-modal="true"
              class="absolute inset-y-0 right-0 flex w-full max-w-md flex-col border-l border-slate-200 bg-white shadow-xl focus:outline-none">
              <header class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
                <h3 class="text-base font-medium text-slate-900">{{.DrawerTitle}}</h3>
                <button type="button" @click="hide" aria-label="Close"
                  class="rounded p-1 text-slate-400 transition-colors hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-sky-600">
                  {{icon "x" "size-5"}}
                </button>
              </header>
              <div class="flex-1 space-y-6 overflow-y-auto px-6 py-6">
                {{range .DrawerBody}}{{.}}{{end}}
              </div>
            </aside>
          </div>
        </template>
        {{end}}
      </tr>
      {{end}}
{{end}}
{{define "table.head"}}
    <thead>
      <tr>
        {{range .Columns}}
        <th scope="col" class="whitespace-nowrap border-b border-slate-200 px-3.5 pt-4 pb-2.5 first:pl-0 last:pr-0 text-xs font-bold uppercase tracking-[0.07em] text-slate-500 {{if eq .Kind "num"}}text-right{{else}}text-left{{end}}">{{.Label}}</th>
        {{end}}
        {{if .HasDrawers}}<th scope="col" class="w-8 border-b border-slate-200"></th>{{end}}
      </tr>
    </thead>
{{end}}
{{/* bare by default: striped rows straight on the page (no cell hairlines, a
     little stripe inset). style "lined" keeps the bare ground but divides
     rows with the cells' own hairlines — the live-listing look (a process
     table). style "card" opts into the twin-hairline frame — border plus a
     ring floated 4px out — shared with the settings card, so every boxed
     listing speaks one card language. */}}
<div class="overflow-x-auto{{if .Card}} rounded-2xl border border-slate-200 bg-white px-5 pb-2 ring-1 ring-slate-200 ring-offset-4 ring-offset-white{{else if .Lined}} [&_td:first-child]:pl-3 [&_th:first-child]:pl-3 [&_td:last-child]:pr-3 [&_th:last-child]:pr-3{{else}} [&_td]:border-b-0 [&_td:first-child]:pl-3 [&_th:first-child]:pl-3 [&_td:last-child]:pr-3 [&_th:last-child]:pr-3{{end}}">
  <table class="w-full min-w-[44rem] border-collapse text-[0.95rem]">
    {{template "table.head" .}}
    <tbody>
{{template "table.rows" .Rows}}
    </tbody>
  </table>
  {{if .SeamSummary}}
  {{/* the seam: extra rows folded behind a native <details> — in a card, a
       full-bleed divider inside the same box. verso.js nudges the opened
       content into view. */}}
  <details class="{{if .Card}}-mx-5 overflow-hidden rounded-b-2xl border-t border-slate-200{{end}}">
    {{/* the fold affordance speaks the same voice as the settings seam:
         chevron with the label, interactive sky; the lock marks stock rows. */}}
    <summary class="flex cursor-pointer items-center gap-1.5 {{if .Card}}px-5{{else}}px-3{{end}} py-3 text-sm font-semibold text-sky-700 transition-colors select-none hover:bg-slate-50 hover:text-sky-800 [&::-webkit-details-marker]:hidden">
      {{icon "chevron-right" "verso-chevron size-4"}}
      {{icon "lock" "size-4 text-slate-400"}}
      {{.SeamSummary}}
    </summary>
    <div class="{{if .Card}}px-5 pb-1{{end}}">
      <table class="w-full min-w-[44rem] border-collapse text-[0.95rem]">
        {{template "table.head" .}}
        <tbody>
{{template "table.rows" .SeamRows}}
        </tbody>
      </table>
    </div>
  </details>
  {{end}}
</div>
