{{/* table: config sections as identical rows under kind-typed columns, the
     table block (blocks/table.css) in the listing block's frame
     (blocks/listing.css). The card is the quietest element (inset table,
     transparent header — typography alone marks it); pills and counters are
     the loudest. One treatment per element type: endpoints are a type icon +
     label (no pill — the grid already contains them), mono is reserved for
     verbatim machine strings, counters read sans with tabular figures. An
     optional seam folds extra rows (stock defaults) inside the same card. */}}
{{/* table.tag: a small coloured label after a cell's value ("new", "WAN") — the
     badge vocabulary as a compact tag, not a full pill. */}}
{{/* table.tag: a chip, so the one chip box every citation wears, with its
     hue's hairline on its hue's wash. On a 20px detail line the 22px box
     overhangs the line by a pixel either side rather than making it taller. */}}
{{define "table.tag"}}<span class="verso-chip"{{with .TagVariant}} data-verso-tone="{{.}}"{{end}}>{{if .TagIcon}}<span class="verso-chip__glyph">{{icon .TagIcon "size-3.5"}}</span>{{else if .TagDot}}{{template "verso-chip-packet" .TagVariant}}{{end}}{{.Tag}}</span>{{end}}
{{/* table.name-words: a row's name, its words in a span of their own so a
     switched-off row's marker can lie under them alone. Only the row's name
     carries it; a later identity column is a citation and stays bare.
     table.name-state: the name's state — switched off (Body, the one step
     that holds 4.5 : 1 over the marker) or quiet. */}}
{{define "table.name-words"}}{{if .Identity}}<span class="verso-table__words">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}
{{define "table.name-state"}}{{if .Off}} data-verso-off{{else if .Muted}} data-verso-muted{{end}}{{end}}
{{/* table.laneadd-attrs / -body: a lane's add, given its TableGroup — the
     button block (blocks/button.css), a row's own icon act and a band's add
     being the same control. With words it is the quiet labelled act, and its
     tooltip still names the lane unless the words already say it all; without
     them it is the glyph alone, its words a tip above its right edge. */}}
{{define "table.laneadd-attrs"}} class="verso-button group/act relative"{{if .AddText}} data-verso-size="act" data-verso-style="quiet" data-verso-glyph{{else}} data-verso-size="icon"{{end}}{{end}}
{{define "table.laneadd-body"}}{{icon "plus" "size-4"}}{{if .AddText}}<span>{{.AddText}}</span>{{end}}{{if ne .AddText .AddLabel}}{{template "verso-act-tip" .AddLabel}}{{end}}{{end}}
{{/* table.confirm-dialog: the alert a row act that ends something asks in,
     inside the act's own x-data="modal". Its face is the inline confirm's
     own band (confirmDialog: the compact danger callout) — the question, what
     is at stake, the act named again on the danger button, which posts the
     one pair, and the way back in the band's deep step — so asking in place
     and asking over the page are one anatomy. The band is the frame; the
     dialog adds only the lift a floating layer has. A native <dialog>, as the
     modal widget's is; on a phone it stands at the foot of the window, under
     the thumb. */}}
{{define "table.confirm-dialog"}}
<template x-teleport="body">
  <dialog x-ref="dialog" tabindex="-1" role="alertdialog" aria-labelledby="{{.ID}}-title" aria-describedby="{{.ID}}-body" {{template "verso-dialog-on"}}
    class="verso-modal" data-verso-kind="confirm">
    {{.Question}}
  </dialog>
</template>
{{end}}
{{/* table.confirm-answers: the band's acts — the act, posting the one pair,
     then the way back, bare words in the deep step that close the alert, as
     the inline confirm's answers are (confirm.answers). */}}
{{define "table.confirm-answers"}}<form method="post" class="contents">{{template "verso-csrf" .CSRFToken}}<button type="submit" name="{{.Name}}" value="{{.Value}}" class="verso-button shrink-0" data-verso-style="danger">{{.Act}}</button></form>
<button type="button" @click="hide" class="verso-notice__cancel">{{.Keep}}</button>
{{end}}
{{/* table.detail: the line of words under a cell's value — what it is, or
     since when — in the secondary step, with the cell's tag riding it. */}}
{{define "table.detail"}}<span data-verso-detail class="verso-table__detail"><span>{{.Detail}}</span>{{if .Tag}}{{template "table.tag" .}}{{end}}</span>{{end}}
{{/* table.lane-add: a lane's add, given its TableGroup. Adding to this lane
     opens the panel where the lane is, seeded with the lane's own path — the
     listing stays put behind it. The link is still a link, so with no script
     it is followed and the page answers with the panel open on it. */}}
{{define "table.lane-add"}}{{if and .AddHref .AddPanel}}
            <span x-data="modal" class="contents">
              <a href="{{.AddHref}}" @click.prevent="showPanel" aria-label="{{.AddLabel}}"{{template "table.laneadd-attrs" .}}>{{template "table.laneadd-body" .}}</a>
              {{template "verso-drawer-fetched" ""}}
            </span>
            {{else if .AddHref}}<a href="{{.AddHref}}" aria-label="{{.AddLabel}}"{{template "table.laneadd-attrs" .}}>{{template "table.laneadd-body" .}}</a>{{end}}{{end}}
{{/* table.legend: the marks explained where the marks are: the same dot the
     rows wear, the plain words for it, and after them the one caveat about
     what the listing includes. */}}
{{define "table.legend"}}{{if or .Legend .Note}}
  <div data-verso-table-legend class="verso-listing__legend">
    {{range .Legend}}
    {{if .Ink}}
    {{/* an ink explained in the ink itself: the word in the tone's Deep
         step, as the figures are written, and where it starts and stops. */}}
    <span class="verso-listing__key"><span class="verso-listing__ink"{{with .Variant}} data-verso-tone="{{.}}"{{end}}>{{.Label}}</span>{{if .Detail}}<span class="verso-listing__range">{{.Detail}}</span>{{end}}</span>
    {{else}}
    <span class="verso-listing__key">
      <span class="verso-mark" data-verso-tone="{{.Variant}}"></span>{{.Label}}
    </span>
    {{end}}
    {{end}}
    {{if .Note}}<span class="verso-listing__caveat">{{.Note}}</span>{{end}}
  </div>
{{end}}{{end}}
{{define "table.rows"}}
      {{range .}}
      {{if .AddLabel}}
      {{/* the lane's tail: a quiet add affordance exactly where the next row of
           this group will land — evaluation order is the table's subject, and a
           new entry appends to its own lane. Not a reorder row: drags skip it. */}}
      {{/* The link is the whole line — the spreadsheet's next empty row — so the
           wash covers exactly what clicks, and the label leans right on hover:
           the sidebar's own doorway gesture. The cell's inset moves onto the
           link, and the nudge rides a named group. */}}
      <tr>
        <td colspan="{{.ColumnSpan}}" class="verso-table__tail">
          {{/* the same ink the Router endpoint wears in these rows, so the
               listing's affordance and its subject speak one accent. */}}
          <a href="{{.AddHref}}" class="verso-table__add group/add">
            <span class="flex items-center gap-1.5 transition-transform group-hover/add:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover/add:translate-x-0"><span class="text-denim">{{icon "plus" "size-4"}}</span>{{.AddLabel}}</span>
          </a>
        </td>
      </tr>
      {{else}}
      {{if .Group}}
      {{/* The band that introduces a run of rows: what the group is called — a
           lane by its two ends, the arrow between them a glyph — the verbatim
           string it resolves to, and after a faint dot what it amounts to. */}}
      {{/* The lane's own add sits here, at its head, rather than in a row after
           its last: a listing whose order is its meaning reads top-down, and the
           head is where the eye already is when it decides this is the lane it
           wants. Its words say the act; its tooltip says which lane. */}}
      {{/* A lane is a row, not a band: a row's 40px, a 28px line (the add's
           box) centred in it, on the masthead's Quiet Sand between strong
           hairlines: the first lane's top is the column heads' own; a later
           one draws it on the line where its fill starts, never filling the
           gap above. Every lane after the first starts its own small
           table, 40px below the last row of the one before; the air is
           the row's own padding, so a lane the filter hides takes its gap with
           it. Its add sits as the rows' acts do: on the middle line (5px over,
           6px under) and 7px in from the table's edge, so on hover its border
           ends where theirs does. */}}
      <tr class="verso-table__lane"{{if .Seam}} data-verso-seam{{end}}>
        <th colspan="{{.ColumnSpan}}" class="verso-table__band"{{if .LaneGap}} data-verso-lane-gap{{end}}>
          <span class="verso-table__line">
            <span class="flex items-center gap-2 type-subheading text-ink">{{.Group.Label}}{{if .Group.To}}<span class="flex text-glyph">{{icon "arrow-right" "size-4"}}</span>{{.Group.To}}{{end}}</span>
            {{if .Group.Chain}}<span class="type-value text-meta" data-verso-verbatim>{{.Group.Chain}}</span>{{end}}
            {{if .Group.Tally}}<span class="text-faint">·</span><span class="text-meta">{{.Group.Tally}}</span>{{end}}
            <span class="flex-1"></span>
            {{template "table.lane-add" .Group}}
          </span>
        </th>
      </tr>
      {{end}}
      {{/* Rows are inert: no whole-row click, so cell values stay selectable and
           copy-pastable. A row with a drawer still hosts its own modal scope, but
           it opens from the trailing "Details" link, never the row. The panel
           teleports to <body>. */}}
      {{/* the modal scope reads data-open on init, so a drawer the plugin sent
           back open (a refused submission) is in front of the operator on the
           re-render instead of silently closed. */}}
      {{/* The row states no height. It is as tall as its cells, and every kind
           of cell arrives at 40px by its own inset (blocks/table.css); a
           value that wraps still grows the row by its 24px lines. */}}
      {{/* the row names the section it is, so an act answered in place can
           find this row again in the page the answer came back with. */}}
      {{/* A row that carries only its group is the band alone. */}}
      {{if not .BandOnly}}
      {{if .Drawer}}
      <tr x-data="modal"{{if .Open}} data-open="true"{{end}}{{if .Panel.Closed}} data-closed-href="{{.Panel.Closed}}"{{end}} class="verso-table__row group"{{if .Seam}} data-verso-seam{{end}}{{if .ID}} data-verso-row-id="{{.ID}}"{{end}}{{if .Off}} data-verso-off{{end}}{{if .Reorder}} data-verso-reorder-row data-verso-reorder-id="{{.ID}}" data-verso-reorder-group="{{.ReorderGroup}}"{{end}}{{if .Key}} data-verso-row="{{.Key}}"{{end}}{{if .Tags}} data-verso-tags="{{.Tags}}"{{end}}>
      {{else}}
      <tr class="verso-table__row group"{{if .Seam}} data-verso-seam{{end}}{{if .ID}} data-verso-row-id="{{.ID}}"{{end}}{{if .Off}} data-verso-off{{end}}{{if .Reorder}} data-verso-reorder-row data-verso-reorder-id="{{.ID}}" data-verso-reorder-group="{{.ReorderGroup}}"{{end}}{{if .Key}} data-verso-row="{{.Key}}"{{end}}{{if .Tags}} data-verso-tags="{{.Tags}}"{{end}}>
      {{end}}
        {{range .Cells}}
        {{if .Absent}}
        {{/* nothing to state, said one way in every column: the faint dash in
             the sans, a step below a muted value — the absence of a fact, not a
             quiet one — and "None" to a screen reader. */}}
        <td class="verso-table__cell whitespace-nowrap text-faint{{if eq .Kind "num"}} text-right{{end}}"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}>{{template "verso-none"}}</td>
        {{else if eq .Kind "reorder"}}
        {{/* the drag handle, drawn only where the table persists the new order —
             the column keeps its width either way so the grid stays aligned. */}}
        <td class="verso-table__grip">
          {{if .Draggable}}
          <button type="button" data-verso-reorder-handle aria-label="{{ t "Reorder" }} {{.RowName}}" aria-keyshortcuts="ArrowUp ArrowDown" title="{{ t "Drag to reorder" }}" class="verso-table__handle">
            {{icon "list-chevrons-up-down" "size-4"}}
          </button>
          {{end}}
        </td>
        {{else if eq .Kind "endpoint"}}
        <td class="verso-table__cell">
          {{/* Both ends of a path wear the chip's box, so a zone and an address
               line up down the column whatever they are. Only the router fills
               it: it is the one end that is this device rather than something
               out on the network, and the action colour is what says so. The
               rest read verbatim, in mono — they are strings someone could type
               into the rule. */}}
          <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
            {{range .Endpoints}}
            <span class="verso-chip"{{if eq .Kind "router"}} data-verso-tone="accent"{{else}} data-verso-tone="ink" data-verso-verbatim{{end}}>
              <span class="verso-chip__glyph"{{if eq .Kind "any"}} data-verso-quiet{{end}}>{{icon .Icon "size-4"}}</span>{{.Label}}
            </span>
            {{end}}
          </span>
        </td>
        {{else if or (eq .Kind "name") (eq .Kind "reference")}}
        {{/* the identity column: the name in ink, with whatever qualifies it —
             a maker, a chip saying the address is pinned, a chip saying this is
             the browser you are reading on. The secondary sits after a faint
             separator, so the name still reads as one word at a glance. */}}
        <td class="verso-table__cell relative">
          <span class="verso-table__title">
            {{if and .LeadIcon (not .Expandable)}}<span class="shrink-0 text-faint">{{icon .LeadIcon "size-3.5"}}</span>{{end}}
            {{/* the name is words, never a door: a reader cannot tell what
                 pressing it would do. Where a plugin pointed it, the row's acts
                 lead instead (doorAct). Only an expandable row's name is a
                 control, and its chevron says what it does. A name reads at
                 the listing's 14px wherever its column stands. */}}
            {{if .Expandable}}<button type="button" data-verso-expand-row aria-expanded="false" class="verso-table__expand {{if eq .Indent "pl-6"}}pl-6{{else if eq .Indent "pl-12"}}pl-12{{else if eq .Indent "pl-18"}}pl-18{{end}}" data-verso-verbatim>{{icon "chevron-right" "size-3.5 shrink-0"}}{{if .LeadIcon}}<span class="text-faint">{{icon .LeadIcon "size-3.5"}}</span>{{end}}{{.Text}}</button>
            {{else}}<span class="verso-table__name"{{if eq .Kind "reference"}} data-verso-verbatim{{end}}{{template "table.name-state" .}}>{{template "table.name-words" .}}</span>{{end}}
            {{/* a mark over words is not read aloud, so the row says it */}}
            {{if .Off}}<span class="sr-only">{{t "off"}}</span>{{end}}
            {{if .Sub}}<span class="-mx-1.5 shrink-0 text-faint">·</span><span class="shrink-0 whitespace-nowrap text-meta">{{.Sub}}</span>{{end}}
            {{if .Chip}}<span class="verso-chip" data-verso-verbatim>{{.Chip}}</span>{{end}}
            {{range .Chips}}{{template "verso-chip" .}}{{end}}
            {{if and .Tag (not .Detail)}}{{template "table.tag" .}}{{end}}
          </span>
          {{if .Detail}}{{template "table.detail" .}}{{end}}
        </td>
        {{else if eq .Kind "phrase"}}
        {{/* the row's name as one line of parts: chips for what it cites,
             values in mono as the device wrote them, words in the sans
             between them. The whole line is the name a switched-off row marks
             over; its detail sits beneath, as a name's does. */}}
        <td class="verso-table__cell relative">
          <span class="flex min-w-0 items-center">
            {{/* an expandable row's phrase is its control, led by the
                 chevron that says so, as an expandable name is. */}}
            {{if .Expandable}}<button type="button" data-verso-expand-row aria-expanded="false" class="verso-table__expand flex min-w-0">{{icon "chevron-right" "size-3.5 shrink-0"}}{{end}}
            <span class="verso-table__phrase{{if .Identity}} verso-table__words{{end}}"{{template "table.name-state" .}}>
              {{template "table.phrase-parts" .Phrase}}
            </span>
            {{if .Expandable}}</button>{{end}}
            {{if .Off}}<span class="sr-only">{{t "off"}}</span>{{end}}
          </span>
          {{if .Detail}}{{template "table.detail" .}}{{end}}
        </td>
        {{else if eq .Kind "status"}}
        {{/* a state cell: a dot and the word for it. A hue at full chroma is a
             mark, so the dot is filled only where the state is asserted now —
             every other state wears the same ring, empty, and the word beside it
             drops to the secondary step. */}}
        <td class="verso-table__cell whitespace-nowrap"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}>
          <span class="flex items-center gap-2">
            <span class="verso-mark" data-verso-tone="{{.Variant}}"{{if .Key}} data-verso-dot{{end}}></span>
            {{/* a state with somewhere to read about it (a failed service's
                 log) leads there, in its own ink, underlined as a lane's
                 closing words are */}}
            {{if .Href}}<a href="{{.Href}}" class="verso-link {{if .Variant}}text-ink{{else}}text-meta{{end}}" data-verso-door{{if .Key}} data-verso-value{{end}}>{{.Text}}</a>{{else}}<span class="{{if .Verbatim}}type-body {{end}}{{if .Variant}}text-ink{{else}}text-meta{{end}}"{{if .Verbatim}} data-verso-verbatim{{end}}{{if .Key}} data-verso-value{{end}}>{{.Text}}</span>{{end}}{{if .Sub}}<span class="text-meta">{{.Sub}}</span>{{end}}
            {{if .Tag}}{{template "table.tag" .}}{{end}}
          </span>
        </td>
        {{else if eq .Kind "path"}}
        <td data-verso-verbatim class="verso-table__cell break-all"><span class="text-meta">{{.Sub}}</span><span class="text-ink">{{.Text}}</span></td>
        {{else if eq .Kind "count"}}
        <td class="verso-table__cell whitespace-nowrap text-meta">{{.Text}} {{.Sub}}</td>
        {{else if eq .Kind "actions"}}
        {{/* A 12px lead-in separates the preceding value from the 28px actions,
             including dense tables. The reference reserves 96px for three
             actions: 84px of controls plus this gap. The outer inset is extra. */}}
        {{/* the row's own acts, at its trailing edge: quiet glyphs that darken
             under the pointer. An act with no destination is drawn and inert —
             the shape is decided, what sits behind it is not. */}}
        <td class="verso-table__acts">
          {{/* the token is the cell's; inside the range the dot is one act, and
               a sub-template's $ is the row list rather than the table. */}}
          {{/* each act is named with its row, as a row's labelled act is; an
               inert mark explains a state, not an act, and keeps its sentence. */}}
          {{$csrf := .CSRFToken}}{{$panel := .Panel}}{{$row := .RowName}}
          <span class="flex items-center justify-end">
            {{range .Actions}}
            {{/* an act that ends something asks first, in the alert the
                 labelled row act uses, and posts only from its answer */}}
            {{if .Dialog}}<span x-data="modal" class="inline-flex">
              <button type="button" @click="show" aria-label="{{.Title}}{{if $row}} {{$row}}{{end}}" class="verso-button group/act relative" data-verso-size="icon">
                {{icon .Icon "size-4"}}
                {{template "verso-act-tip" .Title}}
              </button>
              {{template "table.confirm-dialog" .Dialog}}
            </span>
            {{else if .Opens}}<button type="button" @click="showTab"{{if .Tab}} data-verso-entity-tab="{{.Tab}}"{{end}} aria-label="{{.Title}}{{if $row}} {{$row}}{{end}}" class="verso-button group/act relative" data-verso-size="icon">
              {{icon .Icon "size-4"}}
              {{template "verso-act-tip" .Title}}
            </button>
            {{/* an act that posts is a form of its own, marked so the shell's
                 script can post it where it stands and reconcile the row from
                 the answer; with no script it is simply submitted. One whose
                 answer is the page read whole is submitted always. */}}
            {{else if .Name}}<form method="post"{{with .Post}} action="{{.}}"{{end}}{{if not .Whole}} data-verso-act{{end}} class="contents">
              {{template "verso-csrf" $csrf}}
              <input type="hidden" name="{{.Name}}" value="{{.Value}}">
              <button type="submit" aria-label="{{.Title}}{{if $row}} {{$row}}{{end}}" class="verso-button group/act relative" data-verso-size="icon">
                {{icon .Icon "size-4"}}
                {{template "verso-act-tip" .Title}}
              </button>
            </form>
            {{else if and $panel (eq .Href $panel)}}<a href="{{.Href}}" @click.prevent="showPanel" aria-label="{{.Title}}{{if $row}} {{$row}}{{end}}" class="verso-button group/act relative" data-verso-size="icon">
              {{icon .Icon "size-4"}}
              {{template "verso-act-tip" .Title}}
            </a>
            {{else if .Href}}<a href="{{.Href}}" aria-label="{{.Title}}{{if $row}} {{$row}}{{end}}" class="verso-button group/act relative" data-verso-size="icon">
              {{icon .Icon "size-4"}}
              {{template "verso-act-tip" .Title}}
            </a>
            {{else}}<span aria-label="{{.Title}}" aria-disabled="true" class="group/act relative grid size-7 shrink-0 place-items-center rounded-xs text-glyph">
              {{icon .Icon "size-4"}}
              {{template "verso-act-tip" .Title}}
            </span>{{end}}
            {{end}}
          </span>
        </td>
        {{else if eq .Kind "link"}}
        {{/* a right-aligned action link (e.g. "Details") to the cell's Href. */}}
        <td class="verso-table__cell text-right whitespace-nowrap">{{if .Text}}<a href="{{.Href}}" class="verso-link">{{.Text}}</a>{{end}}</td>
        {{else if eq .Kind "pill"}}
        {{/* a status pill. */}}
        <td class="verso-table__cell whitespace-nowrap">
          <span class="flex items-center">
          {{if .Pill}}{{template "badge.html.tmpl" .Pill}}
          {{else}}<span class="{{if .Muted}}text-meta{{else}}text-inert{{end}}">{{template "verso-none"}}</span>{{end}}
          </span>
        </td>
        {{else if eq .Kind "entity"}}
        {{/* entity references — an interface, a zone, or physical ports — as icon
             chips: the Lucide glyph names the kind, the label the one. One chip or
             a wrapping row of them; empty reads as a quiet dash. */}}
        <td class="verso-table__cell">
          {{if .Chips}}
          <span class="flex flex-wrap items-center gap-1.5">
            {{range .Chips}}{{template "verso-chip" .}}{{end}}
          </span>
          {{else}}<span class="text-inert">{{template "verso-none"}}</span>{{end}}
        </td>
        {{else if eq .Kind "mono"}}
        {{/* value and its copy control on one flex line, so the control's box
             cannot push the row taller than the text it sits beside. */}}
        {{/* A second line (Sub) is what the value becomes — a package's
             available version under the installed one. Which is which reads
             without colour: the value it was recedes to Meta, and what it
             becomes stands in Ink, led by an arrow turning down into it in the
             cell's tone (the action colour for info). */}}
        <td data-verso-verbatim class="verso-table__cell whitespace-nowrap {{if or .Muted .Sub}}text-meta{{else}}text-ink{{end}}"><span class="flex items-center"><span>{{.Text}}</span>{{if and .Dot (not .Sub)}}<span role="img" aria-label="{{t "Available version"}}" class="verso-mark ml-2" data-verso-tone="{{template "verso-dot-tone" .Variant}}"{{if eq .Variant "success"}} data-verso-live{{end}} title="{{t "Available version"}}"></span>{{end}}{{if and .Copy .Text}}{{template "verso-copy-inline" .Text}}{{end}}</span>{{if .Sub}}<span class="flex items-center gap-1.5 text-ink"><span role="img" aria-label="{{t "Available version"}}" title="{{t "Available version"}}" class="flex shrink-0 {{if eq .Variant "info"}}text-denim{{else}}text-glyph{{end}}">{{icon "corner-down-right" "size-4"}}</span><span>{{.Sub}}</span></span>{{end}}</td>
        {{else if eq .Kind "keyword"}}
        <td data-verso-verbatim class="verso-table__cell whitespace-nowrap text-body">{{.Text}}</td>
        {{else if eq .Kind "runtime"}}
        <td data-verso-figures class="verso-table__cell whitespace-nowrap text-meta">{{.Text}}</td>
        {{else if eq .Kind "comment"}}
        <td class="verso-table__cell max-w-[24rem] text-meta"><span class="line-clamp-1" title="{{.Text}}">{{.Text}}</span></td>
        {{else if eq .Kind "rate"}}
        {{/* a rate's longest is "999 Mb/s" or "1.2 Gb/s" (internal/units) */}}
        <td data-verso-figures class="verso-table__cell w-24 min-w-24 max-w-24 whitespace-nowrap text-meta"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}>{{.Text}}</td>
        {{else if eq .Kind "meter"}}
        {{/* the meter widget at a row's scale: the 6px track filled to the
             share, the figure hard beside it in a slot of one width, so the
             bars of a column end together. A headroom's limits tick the track
             as the compact meter ticks them, reaching past it above and below,
             so the track does not clip (the fill clips itself). The track keeps
             a floor, so a narrow window scrolls the listing rather than
             shrinking it to a stub. A reading with no ceiling keeps its figure
             and draws no track; a thing with no reading is the faint dash — an
             empty track would say "idle", which is a fact. */}}
        <td class="verso-table__cell">
          {{if .Clip}}<span class="verso-meter" data-verso-place="cell">
            <span class="verso-meter__track"><span class="verso-meter__bar"{{if or (eq .Variant "danger") (eq .Variant "warning")}} data-verso-tone="{{.Variant}}"{{end}} style="clip-path: {{.Clip}}"></span>{{if .WarnAt}}<span class="verso-meter__tick" data-verso-tone="warning" style="left: min({{.WarnAt}}, calc(100% - {{if .CritAt}}0.375rem{{else}}0.125rem{{end}}))"></span>{{end}}{{if .CritAt}}<span class="verso-meter__tick" data-verso-tone="danger" style="left: calc({{.CritAt}} - 0.125rem)"></span>{{end}}</span>
            <span data-verso-figures class="verso-meter__amount {{if .Muted}}text-meta{{else}}text-ink{{end}}">{{.Text}}</span>
          </span>{{else if and .NoTrack .Text (ne .Text "—")}}<span class="verso-meter" data-verso-place="cell">
            <span class="min-w-16 flex-1"></span>
            <span data-verso-figures class="verso-meter__amount {{if .Muted}}text-meta{{else}}text-ink{{end}}">{{.Text}}</span>
          </span>{{else}}<span class="text-inert">{{template "verso-none"}}</span>{{end}}
        </td>
        {{else if eq .Kind "figures"}}
        {{/* figures side by side, each in a slot of one width so a column of
             them lines up. An inked cell writes them in its tone's Deep step
             (blocks/table.css, data-verso-ink), which a live listing changes
             in place; otherwise they are Ink. Every slot is drawn even when it
             has nothing to say, unseen but keeping its width, so a live listing fills it in place and
             the cell is as wide busy as idle: a table squeezed below its columns' widths shares the
             shortfall by content, and a cell whose width swung would move its column with every
             reading. The dash stands over the slots, not beside them, for a cell with no figure. */}}
        <td class="verso-table__cell whitespace-nowrap{{if not .Ink}}{{if .Muted}} text-meta{{else}} text-ink{{end}}{{end}}"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}{{if .Ink}} data-verso-ink="{{.Variant}}"{{end}}>
          <span class="relative inline-block align-top"><span class="absolute top-0 left-0 text-inert" data-verso-figures-none{{if .FiguresShown}} hidden{{end}}>{{template "verso-none"}}</span>
          {{range .Figures}}<span data-verso-figures class="verso-table__slot{{if not .Text}} invisible{{end}}" data-verso-figure="{{.Label}}">
            <span data-verso-figure-text>{{.Text}}</span>{{if .Icon}}<span aria-hidden="true" class="text-glyph">{{icon .Icon "size-3.5"}}</span>{{end}}{{if .Label}}<span class="sr-only">{{ t .Label }}</span>{{end}}
          </span>{{end}}</span>
        </td>
        {{else if eq .Kind "num"}}
        {{/* a counter that has counted something is a fact about this row and
             reads in full ink; one that is nothing yet stays out of the way. */}}
        <td data-verso-figures class="verso-table__cell text-right {{if .Muted}}text-meta{{else}}text-ink{{end}}"{{if .Key}} data-verso-cell="{{.Key}}"{{end}}>{{if .SuffixSlot}}{{.Figure}}<span class="inline-block w-[1ch] text-left">{{.Suffix}}</span>{{else}}{{.Text}}{{end}}</td>
        {{else}}
        {{/* a word, and when it stands for a config value, that value in the
             chip beside it — "WPA3" and the `sae` it writes. */}}
        {{if .Detail}}
        <td class="verso-table__cell"><div class="whitespace-nowrap {{if .Muted}}text-meta{{else}}text-ink{{end}}">{{.Text}}</div>{{template "table.detail" .}}</td>
        {{else}}
        <td class="verso-table__cell {{if .Muted}}text-meta{{else}}text-ink{{end}}">{{if .Chip}}<span class="flex items-center gap-2 whitespace-nowrap">{{.Text}}<span class="verso-chip" data-verso-verbatim>{{.Chip}}</span></span>{{else if .Duration}}<span class="whitespace-nowrap tabular-nums">{{.Text}}</span>{{else}}{{.Text}}{{end}}</td>
        {{end}}
        {{end}}
        {{end}}
        {{if .HasDetail}}
        {{/* the trailing "more" affordance: a plain link hard-right, the only
             click target in the row. Blank when the row has nothing behind it,
             or when its drawer already opens from an in-cell button. */}}
        <td class="verso-table__cell text-right whitespace-nowrap">
          {{/* a fetched panel's Details is a link to it, so the panel is reachable with no script at all */}}
          {{if and .Drawer (not .Inline) .PanelURL}}<a href="{{.PanelURL}}" @click.prevent="showPanel" class="verso-link">{{if .DrawerIcon}}{{icon .DrawerIcon "size-3.5"}}{{end}}{{.DrawerLabel}}</a>
          {{else if and .Drawer (not .Inline)}}<button type="button" @click="show" class="verso-link cursor-pointer">{{if .DrawerIcon}}{{icon .DrawerIcon "size-3.5"}}{{end}}{{.DrawerLabel}}</button>{{end}}
        </td>
        {{end}}
        {{if .Entity}}{{template "verso-entity-drawer" .}}{{else if .PanelURL}}{{template "verso-drawer-fetched" .PanelURL}}{{else if .Drawer}}{{template "verso-drawer-panel" .Panel}}{{end}}
      </tr>
      {{if .Expanded}}<tr data-verso-expanded-row hidden><td colspan="{{.ColumnSpan}}" class="verso-table__sheet">{{range .Expanded}}{{.}}{{end}}</td></tr>{{end}}
      {{end}}
      {{/* The lane's last word, after its last row: what happens to what none
           of its rows caught. A line across the listing in the meta step, at a
           row's inset and pitch, with no drag and no place in the order. */}}
      {{if .Close}}<tr data-verso-lane-close{{if .Seam}} data-verso-seam{{end}}><td colspan="{{.ColumnSpan}}" class="verso-table__cell text-meta"><span class="flex flex-wrap items-center gap-x-2">{{template "table.phrase-parts" .Close}}</span></td></tr>{{end}}
      {{end}}
      {{end}}
{{end}}
{{/* table.phrase-parts: a phrase's parts in order — a chip for what it cites,
     a value in mono as the device wrote it, words in the sans, and words that
     lead to where they are decided in the line's own ink, underlined. */}}
{{define "table.phrase-parts"}}{{range .}}{{if .Chip}}{{template "verso-chip" .Chip}}{{else if .Value}}<span class="truncate type-body" data-verso-verbatim>{{.Value}}</span>{{else if .Href}}<a href="{{.Href}}" class="verso-link shrink-0" data-verso-door>{{.Words}}</a>{{else}}<span class="shrink-0">{{.Words}}</span>{{end}}{{end}}{{end}}
{{/* table.empty-row: a listing's nothing, said where its first row would be —
     one row across every column, the listing's inset, meta words. It gives up
     its hairline to whatever closes the table (the table's own, or the
     section's rule when the table ends its section). */}}
{{define "table.empty-row"}}<tr{{if .Stream}} data-verso-stream-empty{{end}}><td colspan="{{.ColumnSpan}}" class="verso-table__cell text-meta">{{.EmptyText}}</td></tr>{{end}}
{{define "table.head"}}
    <thead>
      <tr>
        {{range .Columns}}
        {{/* In the listing geometry an endpoint's head starts where the
             chip's glyph does — one hairline and the chip's own inset in — so
             the word sits over the column's ink rather than its border. */}}
        <th scope="col" class="verso-table__head{{if eq .Kind "reorder"}} verso-table__grip{{else if eq .Kind "rate"}} w-24 min-w-24 max-w-24{{else if or (eq .Kind "num") (eq .Kind "actions")}} text-right{{end}}{{if and $.Dense (eq .Kind "endpoint")}} pl-[0.4375rem]{{end}}">{{.Label}}</th>
        {{end}}
        {{if .HasDetail}}<th scope="col" class="verso-table__head"></th>{{end}}
      </tr>
    </thead>
{{end}}
{{/* the default: bare hairline rows, an optional header band, and inert rows —
     no stripe, no whole-row click, so values stay selectable. style "card" opts
     into the hairline card frame shared with the settings card, so every boxed
     listing speaks one card language. */}}
{{/* A table wider than its box scrolls sideways in it (blocks/listing.css). */}}
{{/* A console is not a table and is not drawn as one: the firewall's events
     are the console block's (blocks/console.css), the same frame the system
     log and a diagnostics run read in. Rows arrive from the shell's stream
     client, which builds them as the block's events; nothing is
     server-rendered here but the waiting line. Nothing on a line is cut
     short: where the window cannot hold a line whole, an address wraps at
     its separators and a rule's name at its words, as the system log's
     message does. */}}
{{if eq .Style "interfaces"}}
{{template "table.interfaces" .}}
{{else if eq .Style "console"}}
<div class="verso-console" data-verso-kind="events"
  data-verso-stream="{{.StreamSource}}" data-verso-stream-ring="{{.StreamRing}}" data-verso-stream-style="console">
  <div data-verso-console-rows data-verso-scroll="sand" class="verso-console__rows verso-drawer-scrollbar">
    <div data-verso-stream-empty class="verso-console__waiting">{{.EmptyText}}</div>
  </div>
</div>
{{else}}
{{/* Every row is inset from the table's edges, said once by the table block
     for the heads, the lanes and the cells alike. Rows are the same height at
     either density; density is horizontal, and a shorter row is a rhythm no
     design asks for. How far a listing stands from what sits above it is the
     page's rhythm, not the listing's own. */}}
{{if and .Empty (not .Stream) (not .Title) (not .Live)}}
{{/* Nothing to list: the listing says so as every set does, with the empty
     slot where its first row would stand (the slot block), outside
     the scroller so its frame keeps its pixel out on the lines. */}}
<div data-verso-slot class="verso-slot">
    {{template "verso-empty-slot-body" .EmptyText}}
  </div>
{{else}}
{{/* The listing's frame stands outside its scroller, so the fading edge
     never fades a card's border (blocks/listing.css). A list stands in its
     card's inset instead of running to the frame (data-verso-list). */}}
{{/* Among a form's fields (InForm) a set is a row's answer: its first and
     last words keep to the row's gutters, where the question and the set's
     add stand, since it draws no tint under the pointer for words to sit
     off. */}}
<div class="verso-listing" data-verso-listing{{with .Place}} data-verso-place="{{.}}"{{end}}{{if .List}} data-verso-list{{end}}{{if .InForm}} data-verso-in-form{{end}}>
<div{{if .Live}} data-verso-live-table{{end}} data-verso-scroller class="verso-listing__scroller verso-scroll-edge">
  {{if .Live}}<p data-verso-inventory-stale role="status" hidden class="verso-listing__stale">{{t "Live status could not be refreshed. Retrying…"}}</p>{{end}}
  {{if .Title}}
  {{/* the header band: a top row aligned to the table's own edges (flush
       left title, flush right link), a hairline under it so it reads as the
       table's first row. */}}
  <div class="verso-listing__header">
    <h2 class="verso-listing__title">{{.Title}}</h2>
    {{if .Detail}}<span class="verso-listing__detail">{{.Detail}}</span>{{end}}
    {{if .Action}}<a href="{{.Action.Href}}" class="verso-link verso-listing__act">{{.Action.Label}}</a>{{end}}
  </div>
  {{end}}
  {{/* a live listing states its source and its ring on the table itself. The
       shell's stream client draws arriving rows as a console (style
       "console", above); a grid carries the declaration and stays as it was
       rendered. */}}
  <table{{if .Reorderable}} data-verso-reorder-table data-verso-reorder-config="{{.ReorderConfig}}"{{end}}{{if .Stream}} data-verso-stream="{{.StreamSource}}" data-verso-stream-ring="{{.StreamRing}}"{{end}} class="verso-table"{{if .Dense}} data-verso-dense{{end}}{{if .InForm}} data-verso-in-form{{end}}{{with .Narrow}} data-verso-narrow="{{.}}"{{end}}>
    {{/* fit columns squeeze to their content through a colgroup width; the
         table's slack collects in the growing columns, so a huddle of fit
         columns sits together at the edge instead of drifting apart. */}}
    {{if .HasWidths}}<colgroup>{{range .Columns}}<col{{if .Width}} style="width:{{.Width.CSS}}"{{end}}>{{end}}{{if .HasDetail}}<col>{{end}}</colgroup>{{end}}
    {{if .HasLabels}}{{template "table.head" .}}{{end}}
    <tbody>
      {{if .Empty}}
      {{/* nothing to list: the column heads are gone (they describe data, and
           over none they are chrome) and one row states the absence where the
           first row would sit — a row's height, the listing's inset, meta words
           and the usual hairline. Every listing says its nothing this way,
           whether it is the whole page or one section of it; the toolbar's
           primary is the way in, so the row holds words only. */}}
      {{/* a live listing keeps its heads and marks this row: it is the wait,
           not the absence, and the first event that arrives removes it. */}}
      {{template "table.empty-row" .}}
      {{else}}
{{template "table.rows" .Rows}}
      {{if .EmptyUnderBand}}{{template "table.empty-row" .}}{{end}}
      {{if .SeamSummary}}
      {{/* A genuine spanning row keeps the collapsed affordance and every
           revealed row in this table's single column-sizing context. */}}
      <tr>
        <td colspan="{{.ColumnSpan}}" class="verso-table__seam">
          <details>
            <summary class="verso-table__summary group">
              {{icon "chevron-right" "verso-chevron size-4"}}
              {{icon "lock" "size-4 text-faint"}}
              <span class="underline-offset-2 group-hover:underline">{{.SeamSummary}}</span>
            </summary>
          </details>
        </td>
      </tr>
{{template "table.rows" .SeamRows}}
      {{end}}
      {{end}}
    </tbody>
  </table>
  {{if not .PageBlock}}{{template "table.legend" .}}{{end}}
  <p data-verso-listing-empty hidden class="verso-listing__note">{{t "Nothing matches."}}</p>
</div>
</div>
{{/* A page's own listing is its card; its legend and note follow the card
     under its bottom edge, the help about the card rather than a part of it. */}}
{{if .PageBlock}}{{template "table.legend" .}}{{end}}
{{end}}
{{end}}
{{if .Reorderable}}
{{/* The dragged sequence is a staged change like any edited field: the rows'
     current order rides in this page form, which the shell posts the moment a
     row lands, so the new order is in the stage and the staged-changes chip
     counts it. A page whose listing drags therefore already carries the page
     form — it must not compose a second one. */}}
{{/* data-verso-order-form: the page form is a hidden order carrier, not the
     page's whole editable surface — staged state renders outside it (row
     toggles), so a staged discard must reload the page rather than swap only
     the form. */}}
<form method="post" data-verso-page-form data-verso-order-form hidden>
  {{template "verso-csrf" .CSRFToken}}
  <input type="hidden" name="_uci_order_config" value="{{.ReorderConfig}}">
  <div data-verso-change-field data-verso-change-name="_uci_order" data-verso-change-label="{{if .ReorderLabel}}{{.ReorderLabel}}{{else}}{{ t "Order" }}{{end}}" data-verso-change-kind="order">
    {{range .ReorderIDs}}<input type="hidden" name="_uci_order" value="{{.}}">{{end}}
  </div>
</form>
{{end}}
