{{/* stat: a labelled big-number tile for at-a-glance metrics. The semantic variant
     tints only the icon and the status dot; the value stays ink so numbers read
     consistently (ADR-005). The frame is the one flat hairline card with the app's
     2px corners. When Href is set the whole tile is a doorway to a detail page — it
     takes the row's sand wash on hover and shows a corner chevron; otherwise it's a
     static tile. Icons from icons.go. */}}
{{/* The tints are the palette's marks — a tone on an icon is a mark, not text, so
     it takes the mark step rather than the deep one it would take as a word. The
     label, the unit and the subtitle are all the one meta ink: the ramp this used
     to reach into had two steps of grey there and the palette has one. */}}
{{if .Href}}<a href="{{.Href}}" class="group relative block rounded-xs border border-rule bg-ground p-4 transition-colors hover:border-rule-strong hover:bg-quiet focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">
{{else if eq .Style "bare"}}<div{{if .Name}} data-verso-stat="{{.Name}}"{{end}}>
{{else}}<div class="rounded-xs border border-rule bg-ground p-4"{{if .Name}} data-verso-stat="{{.Name}}"{{end}}>
{{end}}
  <div class="flex items-center justify-between gap-2">
    <span class="{{template "verso-kicker-class"}}">{{.Label}}</span>
    {{if .Icon}}
    <span class="shrink-0
      {{if eq .Variant "success"}}text-green
      {{else if eq .Variant "warning"}}text-marigold
      {{else if eq .Variant "danger"}}text-crimson
      {{else}}text-faint{{end}}">{{icon .Icon "size-5"}}</span>
    {{end}}
  </div>
  {{/* A bare stat is a vital on the open canvas, so its number is the
       canvas's figure — the home page's meter's — with its unit quiet beside
       it. A carded stat keeps its card's 24px number. */}}
  {{if eq .Style "bare"}}
  <div class="mt-3 flex items-baseline gap-1.5 leading-none">
    <span class="font-mono text-4xl font-bold tracking-[-.05em] tabular-nums text-ink" data-verso-stat-v>{{.Value}}</span>{{if or .Unit .Name}}<span class="text-base text-meta" data-verso-stat-u>{{.Unit}}</span>{{end}}
  </div>
  {{else}}
  <div class="mt-3 text-2xl font-bold tracking-tight tabular-nums text-ink">
    <span data-verso-stat-v>{{.Value}}</span>{{if or .Unit .Name}} <span class="text-sm font-normal text-meta" data-verso-stat-u>{{.Unit}}</span>{{end}}
  </div>
  {{end}}
  {{if .Sub}}
  <div class="mt-1.5 flex items-center gap-1.5 text-sm text-meta">
    {{if .Dot}}<span class="size-1.5 shrink-0 rounded-[1px] {{template "verso-tone-dot" .Variant}}"></span>{{end}}
    <span>{{.Sub}}</span>
  </div>
  {{end}}
  {{if .Href}}<span class="absolute right-4 bottom-4 text-faint transition group-hover:translate-x-0.5 group-hover:text-meta">{{icon "chevron-right" "size-4"}}</span>{{end}}
{{if .Href}}</a>{{else}}</div>{{end}}
