{{/* stat: a labelled big-number tile for at-a-glance metrics. The semantic variant
     tints only the icon and the status dot; the value stays ink so numbers read
     consistently (ADR-005). Corner radius is rounded-xl (radius-scales-with-size).
     When Href is set the whole tile is a doorway to a detail page — it lifts on hover
     and shows a corner chevron; otherwise it's a static tile. Icons from icons.go. */}}
{{if .Href}}<a href="{{.Href}}" class="group relative block rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-px hover:border-slate-300 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-600">
{{else if eq .Style "bare"}}<div{{if .Name}} data-verso-stat="{{.Name}}"{{end}}>
{{else}}<div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"{{if .Name}} data-verso-stat="{{.Name}}"{{end}}>
{{end}}
  <div class="flex items-center justify-between gap-2">
    <span class="text-xs font-semibold uppercase tracking-wider {{if eq .Style "bare"}}text-slate-400{{else}}text-slate-500{{end}}">{{.Label}}</span>
    {{if .Icon}}
    <span class="shrink-0
      {{if eq .Variant "success"}}text-emerald-600
      {{else if eq .Variant "warning"}}text-amber-600
      {{else if eq .Variant "danger"}}text-red-600
      {{else}}text-slate-400{{end}}">{{icon .Icon "size-5"}}</span>
    {{end}}
  </div>
  <div class="mt-3 {{if eq .Style "bare"}}text-base font-semibold{{else}}text-2xl font-bold{{end}} tracking-tight tabular-nums text-slate-900">
    <span data-verso-stat-v>{{.Value}}</span>{{if or .Unit .Name}} <span class="text-sm font-normal text-slate-400" data-verso-stat-u>{{.Unit}}</span>{{end}}
  </div>
  {{if .Sub}}
  <div class="mt-1.5 flex items-center gap-1.5 text-sm {{if eq .Style "bare"}}text-slate-400{{else}}text-slate-500{{end}}">
    {{if .Dot}}<span class="size-2 shrink-0 rounded-full {{template "verso-tone-dot" .Variant}}"></span>{{end}}
    <span>{{.Sub}}</span>
  </div>
  {{end}}
  {{if .Href}}<span class="absolute right-4 bottom-4 text-slate-300 transition group-hover:translate-x-0.5 group-hover:text-slate-500">{{icon "chevron-right" "size-4"}}</span>{{end}}
{{if .Href}}</a>{{else}}</div>{{end}}
