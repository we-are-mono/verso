{{/* traffic: a live traffic graph on the notebook's sand — its title and what it
     measures, the newest download and upload with their series' squares, and
     the chart under them. The live layer (verso-chart.js) finds the chart by
     data-verso-live-chart, seeds itself from data-verso-live-seed, and keeps the
     two figures by data-verso-live-down and -up, and the unit and direction
     after each by data-verso-live-down-label and -up-label. A graph with history behind it
     offers its window as a dropdown on the heading line, which fetches the graph
     for the window in this section's place; a past window carries none of the
     live attributes, and its figures are averages. In a panel, whose blocks stand
     a cell apart, it stands two from its neighbours: 39px over its border, so
     the border keeps its line, and 40px under it. The panel's blocks are
     spaced by margins that collapse into the larger, so the 39px is the whole
     distance, not an addition to the cell above. */}}
{{/* traffic.window: the graph's window, a dropdown that fetches the graph
     for the window chosen in this section's place, so the section that comes
     back carries it with that window selected. In a card it is the compact
     dropdown, on the legend's line. */}}
{{define "traffic.window"}}
<div class="relative flex {{if .Card}}shrink-0{{end}} items-center">
  <select name="range" aria-label="{{ t "Window" }}" hx-get="{{.RangeURL}}" hx-trigger="change" hx-target="closest section" hx-swap="outerHTML"
    class="{{if .Card}}{{template "verso-select-compact"}}{{else}}h-control cursor-pointer appearance-none rounded-xs border border-rule-strong bg-canvas pr-9 pl-3 text-sm text-ink shadow-(--shadow-field) transition-colors hover:border-faint focus:border-denim focus:outline-none{{end}}">
    {{range .Ranges}}<option value="{{.Value}}"{{if eq .Value $.Range}} selected{{end}}>{{.Label}}</option>{{end}}
  </select>
  {{if .Card}}<span class="{{template "verso-select-compact-chevron"}}">{{icon "chevron-down" "size-3.5"}}</span>{{else}}<span class="pointer-events-none absolute right-3 flex text-meta">{{icon "chevron-down" "size-4"}}</span>{{end}}
</div>
{{end}}
{{if .Card}}
{{/* In an Overview card the card's header names the graph. On the card's
     Paper: the newest figures at reading size on one 24px line, each led by
     its series' packet, the window at the line's right end on it (the
     figures wrap under the first line, the window stays), then,
     one of the chart's 16px rules under them, the plot (chart.html.tmpl)
     with its values on its right and its window's ends under it. */}}
<section aria-label="{{.Title}}" class="verso-traffic-card">
  <div class="flex items-start gap-x-6 pb-4 leading-6">
    <div class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-6 *:flex *:h-6 *:items-baseline *:gap-2">
      <span><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-denim"></span><span class="font-mono text-lg leading-6 font-semibold text-ink tabular-nums"{{if .Live}} data-verso-live-down{{end}}>{{.DownNow}}</span><span class="text-sm text-meta"{{if .Live}} data-verso-live-down-label{{end}}>{{.DownLabel}}</span></span>
      <span><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-amethyst"></span><span class="font-mono text-lg leading-6 font-semibold text-ink tabular-nums"{{if .Live}} data-verso-live-up{{end}}>{{.UpNow}}</span><span class="text-sm text-meta"{{if .Live}} data-verso-live-up-label{{end}}>{{.UpLabel}}</span></span>
      {{if .Latency}}<span><span class="font-mono text-lg leading-6 font-semibold text-ink tabular-nums">{{.Latency}}</span><span class="text-sm text-meta">{{ t "ms to gateway on average" }}</span></span>{{end}}
    </div>
    {{if .Ranges}}{{template "traffic.window" .}}{{end}}
  </div>
  <div{{if .Live}} data-verso-live-chart="{{.Live}}" data-verso-live-seed="{{.Seed}}"{{end}}>{{.Chart}}</div>
</section>
{{else}}
<section aria-label="{{.Title}}" class="{{if .Panel}}mt-9.75 mb-10 border-t border-rule{{else}}-mt-px border-t border-rule{{end}} bg-quiet bg-[linear-gradient(to_right,var(--color-mid)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-mid)_1px,transparent_1px)] bg-size-[16px_16px] bg-position-[-1px_-1px]">
  <div class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2 xl:h-10 xl:py-0">
    <h2 class="text-lg font-semibold tracking-tight text-body">{{.Title}}</h2>
    {{if .Meta}}<span aria-hidden="true" class="text-faint">·</span><span class="font-mono text-base font-medium text-meta">{{.Meta}}</span>{{end}}
    {{if .Ranges}}{{template "traffic.window" .}}{{end}}
    <div class="ml-auto flex flex-wrap items-baseline gap-x-7 gap-y-2">
      <span class="inline-flex items-baseline gap-2"><span class="inline-flex min-w-15.5 items-baseline justify-end gap-2"><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-green"></span><span class="font-mono text-lg font-semibold"{{if .Live}} data-verso-live-down{{end}}>{{.DownNow}}</span></span><span class="text-sm text-meta"{{if .Live}} data-verso-live-down-label{{end}}>{{.DownLabel}}</span></span>
      <span class="inline-flex items-baseline gap-2"><span class="inline-flex min-w-13.5 items-baseline justify-end gap-2"><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-amethyst"></span><span class="font-mono text-lg font-semibold"{{if .Live}} data-verso-live-up{{end}}>{{.UpNow}}</span></span><span class="text-sm text-meta"{{if .Live}} data-verso-live-up-label{{end}}>{{.UpLabel}}</span></span>
      {{if .Latency}}<span class="inline-flex items-baseline gap-2"><span class="font-mono text-lg font-semibold">{{.Latency}}</span><span class="text-sm text-meta">{{ t "ms to gateway on average" }}</span></span>{{end}}
    </div>
  </div>
  <div class="pt-4"{{if .Live}} data-verso-live-chart="{{.Live}}" data-verso-live-seed="{{.Seed}}"{{end}}>{{.Chart}}</div>
</section>
{{end}}
