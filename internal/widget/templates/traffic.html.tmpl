{{/* traffic: a live traffic graph on the notebook's sand — its title and what it
     measures, the newest download and upload with their series' squares, and
     the chart under them. The live layer (verso-chart.js) finds the chart by
     data-verso-live-chart, seeds itself from data-verso-live-seed, and keeps the
     two figures by data-verso-live-down and -up. In a panel, whose blocks stand
     a cell apart, it stands two from its neighbours: 39px over its border, so
     the border keeps its line, and 40px under it. The panel's blocks are
     spaced by margins that collapse into the larger, so the 39px is the whole
     distance, not an addition to the cell above. */}}
<section aria-label="{{.Title}}" class="{{if .Panel}}mt-9.75 mb-10{{else}}-mt-px{{end}} border-t border-rule bg-quiet bg-[linear-gradient(to_right,var(--color-mid)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-mid)_1px,transparent_1px)] bg-size-[20px_20px] bg-position-[-1px_-1px]">
  <div class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2 xl:h-10 xl:py-0">
    <h2 class="text-lg font-semibold tracking-tight text-body">{{.Title}}</h2>
    {{if .Meta}}<span aria-hidden="true" class="text-faint">·</span><span class="font-mono text-base font-medium text-meta">{{.Meta}}</span>{{end}}
    <div class="ml-auto flex flex-wrap items-baseline gap-x-7 gap-y-2">
      <span class="inline-flex items-baseline gap-2"><span class="inline-flex min-w-15.5 items-baseline justify-end gap-2"><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-green"></span><span class="font-mono text-lg font-semibold" data-verso-live-down>{{.DownNow}}</span></span><span class="text-sm text-meta">{{ t "Mbit/s down" }}</span></span>
      <span class="inline-flex items-baseline gap-2"><span class="inline-flex min-w-13.5 items-baseline justify-end gap-2"><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-amethyst"></span><span class="font-mono text-lg font-semibold" data-verso-live-up>{{.UpNow}}</span></span><span class="text-sm text-meta">{{ t "Mbit/s up" }}</span></span>
    </div>
  </div>
  <div class="pt-5" data-verso-live-chart="{{.Live}}" data-verso-live-seed="{{.Seed}}">{{.Chart}}</div>
</section>
