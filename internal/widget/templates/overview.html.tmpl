<div data-overview>
  {{template "overview.masthead" .Masthead}}

  <section aria-label="{{.ChartTitle}}" class="-mt-px border-t border-rule bg-quiet bg-[linear-gradient(to_right,var(--color-mid)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-mid)_1px,transparent_1px)] bg-size-[20px_20px] bg-position-[-1px_-1px]">
    <div class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-2 px-4 py-2 xl:h-10 xl:py-0">
      <h2 class="verso-section-heading text-lg font-semibold tracking-tight text-body">{{.ChartTitle}}</h2>
      {{if .ChartMeta}}<span aria-hidden="true" class="text-faint">·</span><span class="font-mono text-base font-medium text-meta">{{.ChartMeta}}</span>{{end}}
      <div class="ml-auto flex flex-wrap items-baseline gap-x-7 gap-y-2">
        <span class="inline-flex items-baseline gap-2"><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-green"></span><span class="min-w-12 text-right font-mono text-lg font-semibold" data-verso-traffic-down>{{.DownVal}}</span><span class="text-sm text-meta">{{ t "Mbit/s down" }}</span></span>
        <span class="inline-flex items-baseline gap-2"><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] bg-amethyst"></span><span class="min-w-10 text-right font-mono text-lg font-semibold" data-verso-traffic-up>{{.UpVal}}</span><span class="text-sm text-meta">{{ t "Mbit/s up" }}</span></span>
      </div>
    </div>
    <div class="pt-5" data-verso-traffic-chart data-verso-traffic-seed="{{.TrafficSeed}}">{{.Chart}}</div>
  </section>

  <section aria-label="{{ t "System" }}">
    <div class="grid grid-cols-1 border-t border-rule sm:grid-cols-2 xl:grid-cols-4">
      {{range .Metrics}}<div class="min-w-0 border-t border-rule px-4 pt-5.5 pb-6.5 first:border-t-0 sm:odd:border-r sm:nth-2:border-t-0 xl:border-t-0 xl:border-r xl:px-6 xl:first:pl-4 xl:last:border-r-0 xl:last:pr-4">{{.}}</div>{{else}}<p class="px-4 py-5 text-meta">{{ t "System readings unavailable" }}</p>{{end}}
    </div>
    <div class="grid grid-cols-1 divide-y divide-rule border-y border-rule xl:grid-cols-2 xl:divide-x xl:divide-y-0">
      <div class="min-w-0 px-4 py-2 xl:pr-6">{{.SysLeft}}</div>
      <div class="min-w-0 px-4 py-2 xl:pl-6">{{.SysRight}}</div>
    </div>
  </section>

</div>
