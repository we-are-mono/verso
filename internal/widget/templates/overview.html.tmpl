{{/* The Overview (ADR-022): one verdict over two columns of cards, each holding
     one kind of reading, in the order the browser keeps (the verso_overview
     cookie, read before this render, so nothing moves after load).
     verso-overview.js opens and closes cards and runs Arrange; verso-stream.js
     writes the verdict and every card's header in place. Arrange is a mode on
     the root (data-arranging), and every control it shows hangs off the named
     group, so a nested group never fires it. */}}
<div data-overview data-overview-tone="{{.Verdict.Tone}}" class="group/overview verso-overview">
  {{/* The heading line is every page's (DESIGN.md "Overview cards"): the
       verdict is the page's h1 on a control's 32px line, the clock and Arrange
       centred on it, 24px under the top bar and 24px over the cards. The
       heading and the shelf span the cards' own columns, which round their
       widths down to the grid, so Arrange and the shelf end where the cards
       do at any window width. */}}
  <div class="verso-overview-cols"><div class="col-span-full min-w-0">
  <div class="flex min-h-control flex-wrap items-center gap-x-6 gap-y-2">
    <h1 class="verso-page-heading text-balance"><span data-overview-lead>{{.Verdict.Lead}}</span><span data-overview-accent class="text-green-deep">{{.Verdict.Accent}}</span><span data-overview-tail>{{.Verdict.Tail}}</span></h1>
    {{if .Verdict.Clock}}
    <div class="flex items-baseline gap-2 text-sm leading-5 text-meta" data-overview-clock data-unix="{{.Verdict.Unix}}" data-offset="{{.Verdict.Offset}}">
      <span aria-hidden="true" data-overview-live class="size-1.5 shrink-0 self-center rounded-[1px] bg-green"></span>
      <time class="font-mono text-base leading-5 font-medium text-ink tabular-nums" data-overview-time>{{.Verdict.Clock}}</time>
      <span>{{.Verdict.Zone}}</span>
    </div>
    {{end}}
    <div class="ml-auto flex items-center">
      <button type="button" data-overview-arrange aria-pressed="false" class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim group-data-arranging/overview:border-denim group-data-arranging/overview:bg-denim group-data-arranging/overview:text-white group-data-arranging/overview:hover:border-denim-deep group-data-arranging/overview:hover:bg-denim-deep group-data-arranging/overview:hover:text-white">
        <span class="group-data-arranging/overview:hidden">{{ t "Arrange" }}</span><span class="hidden group-data-arranging/overview:inline">{{ t "Done" }}</span>
      </button>
    </div>
  </div>

  {{/* The shelf is a 40px frame 24px under the heading line, its top edge on
       a line: its words write on one 20px line, 10px under the top edge and
       8px over the bottom, and its 28px chips ride that line, so the cards
       24px under it start on a line. */}}
  <div data-overview-shelf class="mt-6 hidden flex-wrap items-center gap-x-2 gap-y-6 rounded-xs border border-dashed border-rule-strong bg-quiet px-3 pt-2.5 pb-2 text-sm leading-5 text-meta group-data-arranging/overview:flex">
    <span class="mr-1">{{if .Hidden}}{{ t "Hidden" }}{{else}}{{ t "No hidden cards" }}{{end}}</span>
    {{range .Hidden}}
    <button type="button" data-overview-restore="{{.ID}}" data-tone="{{.Tone}}" class="group/chip -my-1 inline-flex h-7 cursor-pointer items-center gap-2 rounded-xs border border-rule-strong bg-ground px-2.5 text-ink transition-colors hover:border-denim-line hover:bg-denim-soft hover:text-denim-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">
      <span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] border border-faint group-data-[tone=success]/chip:border-transparent group-data-[tone=success]/chip:bg-green group-data-[tone=warning]/chip:border-transparent group-data-[tone=warning]/chip:bg-marigold group-data-[tone=danger]/chip:border-transparent group-data-[tone=danger]/chip:bg-crimson"></span>{{icon "plus" "size-3.5"}}<span>{{.Title}}</span>
    </button>
    {{end}}
    <button type="button" data-overview-reset class="-my-1 ml-auto h-7 cursor-pointer rounded-xs px-2.5 font-medium text-denim-deep transition-colors hover:bg-denim-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">{{ t "Reset layout" }}</button>
  </div>
  </div></div>

  <div class="verso-overview-cols mt-6">
    {{range $i, $col := .Cols}}
    <div data-overview-col="{{$i}}" class="verso-overview-col">{{range $col}}{{template "overview.card" .}}{{end}}</div>
    {{end}}
  </div>
  <div class="sr-only" aria-live="polite" data-overview-say></div>
</div>

{{/* overview.card: one card. The header is the card's status — its word and
     packet at the end, open or closed — and a closed card adds its one line
     after the title. Clicking the header opens and closes it; while arranging,
     the header is where it is picked up, and the grip and hide stand in for
     the door and the chevron. */}}
{{define "overview.card"}}
{{/* On the grid the frame's top and left borders are lines, as a page
     card's are; the header is 48px (a 20px line, 14px over, 13px under, the
     body's hairline or the frame's bottom the next pixel) with its 28px acts
     riding the line, its words 24px in; the body opens 24px under its
     hairline and ends 23px over the frame, so content on the grid closes on a
     line and the next card, 23px on, starts on one. */}}
<article data-overview-card="{{.ID}}" data-tone="{{.Head.Tone}}"{{if .Closed}} data-closed{{end}} aria-labelledby="overview-card-{{.ID}}" class="group/card @container/card verso-overview-card min-w-0 rounded-xs border border-rule-strong bg-ground">
  <header data-overview-card-head class="flex min-w-0 cursor-pointer items-center gap-2 pt-3.5 pr-2.5 pb-3.25 pl-6 leading-5 select-none group-data-arranging/overview:cursor-grab group-data-arranging/overview:pl-1.5">
    <button type="button" data-overview-grip aria-label="{{printf (t "Move %s. Arrow keys move it.") .Title}}" class="hidden -my-1 {{template "verso-btn-icon"}} cursor-grab group-data-arranging/overview:grid">{{icon "grip-vertical" "size-4"}}</button>
    <span aria-hidden="true" class="flex shrink-0 text-glyph">{{icon .Icon "size-4"}}</span>
    <div class="flex min-w-0 flex-1 items-baseline gap-3">
      <h2 id="overview-card-{{.ID}}" class="text-base leading-5 font-semibold tracking-tight whitespace-nowrap text-ink">{{.Title}}</h2>
      <span data-overview-card-summary aria-hidden="{{if .Closed}}false{{else}}true{{end}}" class="verso-overview-summary min-w-0 truncate text-sm leading-5 text-meta tabular-nums">{{.Head.Summary}}</span>
    </div>
    {{if .Control}}<div data-overview-card-control class="flex shrink-0 items-center gap-3 group-data-arranging/overview:hidden">{{.Control}}</div>{{end}}
    <span data-overview-card-status class="flex shrink-0 items-center gap-2 text-sm leading-5 font-medium whitespace-nowrap text-body group-data-[tone=success]/card:text-green-deep group-data-[tone=warning]/card:text-marigold-deep group-data-[tone=danger]/card:text-crimson-deep"{{if not .Head.Status}} hidden{{end}}>
      <span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] border border-faint group-data-[tone=success]/card:border-transparent group-data-[tone=success]/card:bg-green group-data-[tone=warning]/card:border-transparent group-data-[tone=warning]/card:bg-marigold group-data-[tone=danger]/card:border-transparent group-data-[tone=danger]/card:bg-crimson"></span><span data-overview-card-word>{{.Head.Status}}</span>
    </span>
    {{if .Href}}<a href="{{.Href}}" data-overview-go aria-label="{{.OpenLabel}}" title="{{.OpenLabel}}" class="grid -my-1 {{template "verso-btn-icon"}} group-data-arranging/overview:hidden">{{icon "arrow-up-right" "size-4"}}</a>{{end}}
    <button type="button" data-overview-toggle aria-expanded="{{if .Closed}}false{{else}}true{{end}}" aria-controls="overview-card-body-{{.ID}}" aria-label="{{if .Closed}}{{printf (t "Open %s") .Title}}{{else}}{{printf (t "Close %s") .Title}}{{end}}" data-open-label="{{printf (t "Open %s") .Title}}" data-close-label="{{printf (t "Close %s") .Title}}" class="grid -my-1 {{template "verso-btn-icon"}} group-data-arranging/overview:hidden"><span class="verso-overview-chevron flex">{{icon "chevron-down" "size-4"}}</span></button>
    <button type="button" data-overview-hide aria-label="{{printf (t "Hide %s") .Title}}" title="{{t "Hide"}}" class="hidden -my-1 {{template "verso-btn-icon"}} hover:border-crimson-line hover:bg-crimson-soft hover:text-crimson-deep group-data-arranging/overview:grid">{{icon "x" "size-4"}}</button>
  </header>
  <div id="overview-card-body-{{.ID}}" class="verso-overview-body"><div class="min-h-0 overflow-hidden"><div class="verso-overview-content border-t border-rule px-6 pt-6 pb-5.75">{{.Body}}</div></div></div>
</article>
{{end}}

{{/* overview.internet: the Internet card's body — the uplink's device and how
     long it has been connected, then each address family under its name and
     protocol, or the sentence that stands where its rows would. */}}
{{define "overview.internet"}}
<div class="grid gap-6">
  {{if .Uplink}}<div class="min-w-0">{{.Uplink}}</div>{{end}}
  {{range .Families}}
  <section aria-label="{{.Kind}}" class="min-w-0">
    {{/* the family's name heads its rows as a row of its own: its 20px line,
         10px over and 9px under, its chip a pixel over the line, and a Strong
         Hairline under it, as a lane's head has; families stand a cell apart. */}}
    <div class="flex items-center gap-3 border-b border-rule-strong pt-2.5 pb-2.25">
      <h3 class="text-sm leading-5 font-semibold text-ink">{{.Kind}}</h3>
      {{if .Proto}}<span class="{{template "verso-chip-class"}}">{{.Proto}}</span>{{end}}
    </div>
    {{if .Empty}}<div class="{{template "verso-empty-slot-class"}}">{{template "verso-empty-slot-body" .Empty}}</div>{{else}}{{.Rows}}{{end}}
  </section>
  {{end}}
</div>
{{end}}

{{/* overview.window: the Traffic card's header control — the graph's window,
     whose choice fetches the graph for it into the card's body. The select
     rides the header's line, 6px over either edge. */}}
{{define "overview.window"}}
<div class="relative -my-1.5 flex items-center">
  <select name="range" aria-label="{{ t "Window" }}" hx-get="{{.RangeURL}}" hx-trigger="change" hx-target="[data-overview-card='traffic'] .verso-traffic-card" hx-swap="outerHTML"
    class="h-control cursor-pointer appearance-none rounded-xs border border-rule-strong bg-white pr-9 pl-3 text-sm text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] transition-colors hover:border-faint focus:border-denim focus:outline-none">
    {{range .Ranges}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
  </select>
  <span class="pointer-events-none absolute right-3 flex text-meta">{{icon "chevron-down" "size-4"}}</span>
</div>
{{end}}

{{/* overview.meters: the Resources card's gauges, two to a row where the
     card is wide enough, a cell apart both ways, so they stay whole cells. */}}
{{define "overview.meters"}}
{{if .}}<div class="grid grid-cols-1 gap-6 @[28rem]/card:grid-cols-2 @[28rem]/card:gap-x-10">{{range .}}{{.}}{{end}}</div>{{else}}<p class="text-sm leading-5 text-meta">{{ t "System readings unavailable" }}</p>{{end}}
{{end}}
