{{/* The Overview (ADR-022, blocks/overview.css): one verdict over two columns
     of cards, each holding one kind of reading, in the order the browser
     keeps (the verso_cards cookie, read before this render, so nothing
     moves after load). verso-overview.js opens and closes cards and runs
     Arrange; verso-stream.js writes the verdict and every card's header in
     place. Arrange is a mode on the root (data-arranging). */}}
<div data-overview data-overview-tone="{{.Verdict.Tone}}" class="verso-overview">
  {{/* The heading line is every page's (DESIGN.md "Overview cards"): the
       verdict is the page's h1 on a control's 32px line, Arrange centred on
       it, 24px under the top bar and 24px over the cards. The heading and
       the shelf span the cards' own columns, which round their widths down
       to the grid, so Arrange and the shelf end where the cards do at any
       window width. Arrange is seldom wanted, so it is a glyph that leaves
       the line to the verdict, named by its tip; while arranging the same
       square fills in denim and holds a check, its tip saying Done, so the
       way out of the mode is the one filled thing on the line. It keeps one
       name and says pressed, as a toggle does. */}}
  <div class="verso-overview__cols"><div class="verso-overview__top">
  <div class="verso-overview__masthead">
    <h1 class="verso-page__heading text-balance"><span data-overview-lead class="verso-overview__lead">{{.Verdict.Lead}}</span><span data-overview-accent class="verso-overview__accent">{{.Verdict.Accent}}</span><span data-overview-tail>{{.Verdict.Tail}}</span></h1>
    <div class="verso-overview__acts">
      <button type="button" data-overview-arrange aria-pressed="false" aria-label="{{ t "Arrange cards" }}" data-verso-size="icon" class="verso-button verso-overview__arrange group/arrange relative">
        <span class="verso-overview__idle">{{icon "arrange" "size-4"}}</span><span class="verso-overview__arranging">{{icon "check" "size-4"}}</span>
        <span aria-hidden="true" class="verso-tip group-hover/arrange:opacity-100 group-focus-visible/arrange:opacity-100" data-verso-place="below"><span class="verso-overview__idle">{{ t "Arrange cards" }}</span><span class="verso-overview__arranging">{{ t "Done" }}</span></span>
      </button>
    </div>
  </div>

  <div data-overview-shelf class="verso-overview__shelf">
    <span data-overview-shelf-label data-hidden-label="{{ t "Hidden" }}" class="verso-overview__shelf-label">{{if .Hidden}}{{ t "Hidden" }}{{else}}{{ t "No hidden cards" }}{{end}}</span>
    {{range .Hidden}}{{template "overview.chip" .}}{{end}}
    <button type="button" data-overview-reset class="verso-overview__reset">{{ t "Reset layout" }}</button>
    {{/* The blank chip the page clones when it hides a card in place. */}}
    <template data-overview-chip>{{template "overview.chip" .Blank}}</template>
  </div>
  </div></div>

  <div class="verso-overview__cols">
    {{range $i, $col := .Cols}}
    <div data-overview-col="{{$i}}" class="verso-overview__col">{{range $col}}{{template "overview.card" .}}{{end}}</div>
    {{end}}
  </div>
  <div class="sr-only" aria-live="polite" data-overview-say></div>
</div>

{{/* overview.chip: a hidden card on the shelf, wearing its card's tone. */}}
{{define "overview.chip"}}
<button type="button" data-overview-restore="{{.ID}}" data-tone="{{.Tone}}" class="verso-overview__restore">
  <span aria-hidden="true" class="verso-mark"></span>{{icon "plus" "size-3.5"}}<span data-overview-chip-title>{{.Title}}</span>
</button>
{{end}}

{{/* overview.card: one card, the card block (blocks/card.css) that folds and
     moves. The head is the card's status — its word and packet at the end,
     open or closed — and a closed card adds its one line after the title.
     Clicking the head opens and closes it; while arranging, the head is
     where it is picked up, and the grip and hide stand in for the door and
     the chevron. */}}
{{define "overview.card"}}
<article data-overview-card="{{.ID}}" data-tone="{{.Head.Tone}}"{{if .Closed}} data-closed{{end}} aria-labelledby="overview-card-{{.ID}}" class="verso-card verso-overview__card">
  <header data-overview-card-head class="verso-card__head verso-overview__head">
    <button type="button" data-overview-grip aria-label="{{printf (t "Move %s. Arrow keys move it.") .Title}}" data-verso-size="icon" class="verso-button verso-overview__grip">{{icon "grip-vertical" "size-4"}}</button>
    <span aria-hidden="true" class="verso-overview__glyph">{{icon .Icon "size-4"}}</span>
    <div class="verso-overview__line">
      <h2 id="overview-card-{{.ID}}" class="verso-card__title verso-overview__title">{{.Title}}</h2>
      <span data-overview-card-summary aria-hidden="{{if .Closed}}false{{else}}true{{end}}" class="verso-overview__summary" data-verso-figures>{{.Head.Summary}}</span>
    </div>
    <span data-overview-card-status class="verso-overview__status"{{if not .Head.Status}} hidden{{end}}>
      <span aria-hidden="true" class="verso-mark"></span><span data-overview-card-word>{{.Head.Status}}</span>
    </span>
    {{/* A choice that governs the whole card (the Traffic card's window) rides
         the head before its acts; choosing never opens or closes the card
         (verso-overview.js), and Arrange mode hides it with the acts. */}}
    {{if .Control}}<span data-overview-card-control class="verso-overview__control">{{.Control}}</span>{{end}}
    {{if .Href}}<a href="{{.Href}}" data-overview-go aria-label="{{.OpenLabel}}" title="{{.OpenLabel}}" data-verso-size="icon" class="verso-button verso-overview__act">{{icon "arrow-up-right" "size-4"}}</a>{{end}}
    <button type="button" data-overview-toggle aria-expanded="{{if .Closed}}false{{else}}true{{end}}" aria-controls="overview-card-body-{{.ID}}" aria-label="{{if .Closed}}{{printf (t "Open %s") .Title}}{{else}}{{printf (t "Close %s") .Title}}{{end}}" data-open-label="{{printf (t "Open %s") .Title}}" data-close-label="{{printf (t "Close %s") .Title}}" data-verso-size="icon" class="verso-button verso-overview__act"><span class="verso-overview__chevron">{{icon "chevron-down" "size-4"}}</span></button>
    <button type="button" data-overview-hide aria-label="{{printf (t "Hide %s") .Title}}" title="{{t "Hide"}}" data-verso-size="icon" class="verso-button verso-overview__hide">{{icon "x" "size-4"}}</button>
  </header>
  <div id="overview-card-body-{{.ID}}" class="verso-overview__fold"><div class="verso-overview__clip"><div class="verso-card__body verso-rhythm verso-overview__content">{{.Body}}</div></div></div>
</article>
{{end}}

{{/* overview.ports: the router's panel, then the list of its ports, a block
     step apart in the card's body. */}}
{{define "overview.ports"}}
{{.Panel}}
{{.Table}}
{{end}}

{{/* overview.internet: the Internet card's body — the uplink's device and how
     long it has been connected, then each address family, a fact list headed
     by its name and protocol (properties.html.tmpl), the families a block
     step apart in the card's body. */}}
{{define "overview.internet"}}
{{with .Uplink}}{{.}}{{end}}
{{range .Families}}{{.}}{{end}}
{{end}}

{{/* overview.withheld: why a card shows less than it holds, where the
     session may not see the rest (ADR-007 §9). */}}
{{define "overview.withheld"}}<p class="verso-overview__none">{{ t . }}</p>{{end}}

{{/* overview.meters: the Resources card's gauges, two to a row where the
     card is wide enough, a hairline between the rows. */}}
{{define "overview.meters"}}
{{if .}}<div class="verso-overview__meters">{{range .}}{{.}}{{end}}</div>{{else}}<p class="verso-overview__none">{{ t "System readings unavailable" }}</p>{{end}}
{{end}}
