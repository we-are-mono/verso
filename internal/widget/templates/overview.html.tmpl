{{/* overview: the home page, bare on the canvas (no card), composed from the
     widget vocabulary — the hero verdict, the stat tiles, the fact sheets, the
     bar gauges, and the flat listings are all injected widgets; this template
     owns only the page's composition and rhythm (the grid strips, the section
     headings, the traffic panel's live legend). Shell-owned content, outside
     the plugin gateway. */}}
<div>

  {{/* Verdict: kicker above, then the headline with the Basic/Advanced switch on
       its row (Basic is a view still to be built; the switch states the intent). */}}
  <div>
    <div class="flex items-center gap-2.5">
      <span class="size-2.5 shrink-0 rounded-full bg-emerald-500 verso-live-dot"></span>
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600">{{.Kicker}}</span>
    </div>
    <div class="mt-3.5 flex items-center justify-between gap-4">
      <h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight text-slate-900">{{.Lead}}<span class="text-emerald-600">{{.Accent}}</span></h1>
      <span class="inline-flex shrink-0 items-center gap-0.5 rounded-lg border border-slate-200 bg-slate-50 p-1 dark:border-gray-700 dark:bg-gray-800">
        <span class="rounded-md px-3 py-1 text-sm font-medium text-slate-500 dark:text-gray-400">{{ t "Basic" }}</span>
        <span class="rounded-md bg-white px-3 py-1 text-sm font-medium text-slate-900 shadow-sm dark:bg-gray-700 dark:text-gray-100 dark:shadow-none">{{ t "Advanced" }}</span>
      </span>
    </div>
  </div>

  {{/* Status tiles: Wi-Fi hardware earns a fourth column; without a kernel PHY,
       the remaining three expand evenly across the same full width. */}}
  <div class="mt-8 grid {{if .HasWiFi}}grid-cols-4{{else}}grid-cols-3{{end}} divide-x divide-slate-100 border-y border-slate-100">
    {{range .Tiles}}
    <div class="px-6 py-5 first:pl-0 last:pr-0">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">{{.Label}}</span>
        <span class="shrink-0 {{if eq .Variant "warning"}}text-amber-600{{else}}text-emerald-500{{end}}">{{icon .Icon "size-4"}}</span>
      </div>
      <div class="mt-3 flex items-center gap-2">
        <span class="size-2 shrink-0 rounded-full {{if eq .Variant "warning"}}bg-amber-500{{else}}bg-emerald-500{{end}}"></span>
        <span class="text-base font-semibold {{if eq .Variant "warning"}}text-amber-700{{else}}text-slate-900{{end}}">{{.Status}}</span>
      </div>
      <div class="mt-1.5 text-sm text-slate-400"{{if .Key}} data-verso-tile-caption="{{.Key}}"{{end}}>{{.Caption}}</div>
    </div>
    {{end}}
  </div>

  {{/* Connection facts: IPv4 and IPv6 side by side, label → mono value with copy. */}}
  <div class="grid grid-cols-2 divide-x divide-slate-100 border-b border-slate-100">
    {{range .Facts}}
    <div class="py-6 {{if eq .Side "left"}}pr-8{{else}}pl-8{{end}}">
      <div class="flex items-baseline gap-2.5">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">{{.Kind}}</span>
        <span class="text-xs text-slate-400">{{.Proto}}</span>
      </div>
      <div class="mt-2">{{.Rows}}</div>
    </div>
    {{end}}
  </div>

  {{/* Internet traffic: title + meta left, the down/up legend hard-right, plot below. */}}
  <section class="mt-12">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-900">{{.ChartTitle}}</h2>
      <span class="text-sm text-slate-400">{{.ChartMeta}}</span>
      <span class="ml-auto inline-flex items-center gap-5 text-sm text-slate-400">
        <span class="inline-flex items-center gap-2"><span class="size-2 rounded-sm bg-sky-600"></span><span class="font-bold tabular-nums text-slate-900" data-verso-traffic-down>{{.DownVal}}</span> {{.RateUnit}} down</span>
        <span class="inline-flex items-center gap-2"><span class="size-2 rounded-sm bg-violet-600"></span><span class="font-bold tabular-nums text-slate-900" data-verso-traffic-up>{{.UpVal}}</span> {{.RateUnit}} up</span>
      </span>
    </div>
    <div class="mt-6" data-verso-traffic-chart data-verso-traffic-seed="{{.TrafficSeed}}">{{.Chart}}</div>
  </section>

  {{/* System: headline metrics with bars, then the hardware facts in two columns. */}}
  <section class="mt-12">
    <div class="flex items-baseline gap-4">
      <h2 class="text-2xl font-semibold tracking-tight text-slate-900">{{ t "System" }}</h2>
      <span class="text-sm text-slate-400">{{.SysMeta}}</span>
    </div>
    {{/* The headline metrics: bar-layout Meter widgets, injected into a divided
         strip — the page owns the strip, the widget owns each gauge. */}}
    <div class="mt-7 grid grid-cols-4 divide-x divide-slate-100">
      {{range .Metrics}}<div class="px-9 first:pl-0 last:pr-0">{{.}}</div>{{end}}
    </div>
    <div class="mt-8 grid grid-cols-2 gap-14">
      <div>{{.SysLeft}}</div>
      <div>{{.SysRight}}</div>
    </div>
  </section>

  {{/* Kernel interfaces are one topology: physical ports, bridges, VLANs and
       tunnels in one telemetry-backed listing, followed by their clients. */}}
  <section class="mt-12">{{.Interfaces}}</section>
  <section class="mt-12">{{.Devices}}</section>

</div>
