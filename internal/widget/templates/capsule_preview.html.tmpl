{{/* Styleguide-only composition of the staged capsule and its upward-expanding
     review surface. It is intentionally inert: this establishes the exact anatomy the
     production shell will later hydrate. */}}
<div class="w-full pt-96">
  <div class="verso-capsule verso-review-open mr-8 rounded-r-sm border-y border-r border-slate-200 bg-surface-subtle dark:border-gray-700">
    <div class="relative flex flex-wrap items-center gap-3 px-8 py-5">
    <div class="verso-capsule-review is-open absolute bottom-full z-10 rounded-t-sm border border-b-0 border-slate-200 bg-surface-subtle dark:border-gray-700">
      <div class="flex items-center justify-between gap-4 px-8 pt-3 pb-2">
        <div class="text-sm font-semibold text-slate-900 dark:text-gray-100">{{.Label}}</div>
        <button type="button" aria-label="Close change review" class="grid size-7 shrink-0 place-items-center rounded text-slate-400 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 dark:hover:text-gray-100">
          {{icon "chevron-down" "size-4"}}
        </button>
      </div>
      <div class="px-8 pb-4">
        {{range .Children}}{{.}}{{end}}
      </div>
    </div>
      <button type="button" class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-sky-700 dark:bg-sky-700 dark:text-gray-100 dark:hover:bg-sky-800 dark:active:bg-sky-900">Save &amp; Apply</button>
      <button type="button" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-100 dark:text-gray-300 dark:hover:bg-gray-900 dark:active:bg-gray-950">Discard</button>
      <span class="ml-auto inline-flex items-center gap-2 text-sm text-slate-500 dark:text-gray-400">
        <span class="size-2 shrink-0 rounded-full bg-sky-500"></span>
        <span>{{.Label}}</span>
      </span>
    </div>
  </div>
</div>
