{{/* changes: the readable review of a staged form diff. On wider surfaces the
     three meanings align as columns; on a phone each row keeps the field name
     above its old/new pair so values retain useful room. */}}
<div>
  {{if .Groups}}
  <div class="verso-drawer-scrollbar max-h-80 overflow-y-auto pr-1">
    <ul class="divide-y divide-slate-200 dark:divide-gray-700">
      {{range .Groups}}
      <li>
        <details class="group"{{if .Expanded}} open{{end}}>
          <summary class="cursor-pointer list-none py-2">
            <div class="flex items-center gap-2">
              <span class="min-w-0 flex-1 truncate text-sm font-semibold text-slate-900 dark:text-gray-100">{{.Label}}</span>
              <span class="inline-flex shrink-0 items-center rounded-md bg-emerald-100 px-1.5 py-0.5 text-xs font-medium text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-400">{{.Operation}}</span>
            </div>
            {{if .Summary}}<p class="mt-1 truncate font-mono text-sm font-medium text-slate-500 dark:text-gray-400">{{.Summary}}</p>{{end}}
            {{if .Values}}<div class="mt-1.5 flex items-center gap-1 text-xs font-medium text-sky-700 dark:text-sky-400">
              <span>{{len .Values}} {{ t "settings" }}</span>
              {{icon "chevron-down" "size-3.5 transition-transform group-open:rotate-180"}}
            </div>{{end}}
          </summary>
          {{if .Values}}<dl class="mb-3 grid grid-cols-2 gap-x-4 gap-y-2 rounded-md bg-slate-50 p-3 dark:bg-gray-800">
            {{range .Values}}<div class="min-w-0">
              <dt class="text-xs text-slate-400 dark:text-gray-500">{{.Label}}</dt>
              <dd class="mt-0.5 break-words font-mono text-sm font-semibold text-slate-700 dark:text-gray-200">{{.Value}}</dd>
            </div>{{end}}
          </dl>{{end}}
        </details>
      </li>
      {{end}}
    </ul>
  </div>
  {{else}}
  <div class="hidden grid-cols-3 gap-4 border-b border-slate-200 pb-2 text-xs font-medium text-slate-400 sm:grid dark:border-gray-700 dark:text-gray-500">
    <span>{{ t "Field" }}</span>
    <span>{{ t "Previous" }}</span>
    <span>{{ t "New" }}</span>
  </div>
  <ul class="divide-y divide-slate-200 dark:divide-gray-700">
    {{range .Items}}
    <li class="{{if $.Compact}}py-2 first:pt-1.5{{else}}py-3 first:pt-2{{end}} last:pb-0 sm:grid sm:grid-cols-3 sm:gap-4">
      <div class="text-sm font-medium text-slate-700 dark:text-gray-300">{{.Label}}</div>
      <div class="mt-2 grid grid-cols-2 gap-4 sm:contents">
        <div class="min-w-0">
          <div class="mb-1 text-xs font-medium text-slate-400 sm:hidden dark:text-gray-500">{{ t "Previous" }}</div>
          <div class="break-words font-mono text-base font-medium text-slate-500 dark:text-gray-400">{{.Previous}}</div>
        </div>
        <div class="min-w-0">
          <div class="mb-1 text-xs font-medium text-slate-400 sm:hidden dark:text-gray-500">{{ t "New" }}</div>
          <div class="flex items-start gap-1.5 font-mono text-base font-semibold text-slate-900 dark:text-gray-100">
            <span class="mt-1 shrink-0 text-slate-300 sm:hidden dark:text-gray-600">{{icon "arrow-right" "size-3.5"}}</span>
            <span class="break-words">{{.Next}}</span>
          </div>
        </div>
      </div>
    </li>
    {{end}}
  </ul>
  {{end}}
</div>
