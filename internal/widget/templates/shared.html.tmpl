{{/* Shared partials: the fragments every widget template speaks identically —
     button colour chains, the input border/focus/error chain, the category
     chip, the tone dot, the card frame, the overlay backdrop, the close
     button, the CSRF carrier. Each lives here once so the treatments cannot
     drift apart; a widget's own template keeps only its layout. The class
     strings stay in template files (not Go) so Tailwind's scanner keeps them. */}}

{{/* verso-press: the shared press affordance — the control dips a pixel while
     active, unless the person prefers reduced motion. */}}
{{define "verso-press"}}active:translate-y-px active:shadow-none motion-reduce:active:translate-y-0{{end}}

{{/* verso-btn-box: the shape every button and button-shaped link takes — one
     height for the whole app, the app's radius, and the padding that goes with
     them. A button set beside a field then ends exactly where the field does,
     because both are 36px and both carry a 1px border. Colour comes from the
     chains below; this says nothing about colour. */}}
{{define "verso-btn-box"}}inline-flex h-9 cursor-pointer items-center justify-center gap-1.5 rounded-xs px-4 text-sm font-semibold whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2{{end}}

{{/* verso-btn-primary: the primary action's colour + interaction chain. The
     call site owns layout (flex, gap, padding, radius, focus treatment). */}}
{{define "verso-btn-primary"}}border border-denim bg-denim text-white transition-colors hover:border-denim-deep hover:bg-denim-deep {{template "verso-press"}}{{end}}

{{/* verso-btn-waiting: a primary that has nothing to act on yet — a settings
     form's Save before anything in it changed. It rests in sand, as a control
     that is there but not yet spoken for, and takes denim the moment it is. */}}
{{define "verso-btn-waiting"}}disabled:cursor-default disabled:border-rule-strong disabled:bg-quiet disabled:text-meta disabled:active:translate-y-0{{end}}

{{/* verso-btn-secondary: the quiet bordered action, in the colours of the
     subsection act: meta words on the strong hairline at rest, the hairline
     wash, the parked border and ink words under the pointer — so every quiet
     button answers the pointer alike, whatever its size. Layout stays at the
     call site, as with verso-btn-primary. */}}
{{/* verso-btn-act: an act on a part of a section — adding a key, installing
     or fetching a certificate. The 28px quiet size, the strong hairline of a
     secondary control at rest, warming to the hairline wash under the pointer.
     The call site adds the inset: pl-2 pr-2.5 before a leading glyph, px-2.5
     for words alone. */}}
{{define "verso-btn-act"}}group/act relative inline-flex h-7 shrink-0 cursor-pointer items-center gap-1.5 rounded-xs border border-rule-strong bg-transparent text-sm font-medium whitespace-nowrap text-meta transition-colors hover:border-sand-5 hover:bg-rule hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim{{end}}

{{/* verso-btn-icon: the one dress of a glyph-only act — a table row's edit or
     remove, a list's remove, a copy beside a value or on a code box. A 28px
     square in Glyph on no border, taking the parked border, the hairline wash
     and Ink under the pointer, as a subsection act does. The call site sets
     the display (grid, or inline-grid inside a line of text) and position. */}}
{{define "verso-btn-icon"}}size-7 shrink-0 cursor-pointer place-items-center rounded-xs border border-transparent text-glyph transition-colors hover:border-sand-5 hover:bg-rule hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim{{end}}

{{define "verso-btn-secondary"}}border-rule-strong bg-transparent text-meta transition-colors hover:border-sand-5 hover:bg-rule hover:text-ink {{template "verso-press"}}{{end}}

{{/* verso-btn-danger: the destructive action's colour + interaction chain —
     one red across the confirm widget and the table's confirmed row action. */}}
{{define "verso-btn-danger"}}border border-crimson bg-crimson text-white transition-colors hover:border-crimson-deep hover:bg-crimson-deep {{template "verso-press"}}{{end}}

{{/* verso-btn-caution: the act a caution confirm asks for. White on full
     marigold fails the 4.5 floor, so it is white on the deep step; the palette
     has no step below that, so hover darkens by a tenth instead. */}}
{{define "verso-btn-caution"}}border border-marigold-deep bg-marigold-deep text-white transition-[color,background-color,border-color,filter] hover:brightness-90 {{template "verso-press"}}{{end}}

{{/* verso-input-border: a form control's border, the only thing that changes
     about it — the strong hairline at rest, the faint step under the pointer,
     the action colour while typing. A refused field stays crimson at rest,
     under the pointer and while focused, deep crimson for the last two: it is
     the box that is wrong while it is being corrected. Focused, its edge
     doubles to 2px (an inset line beside the field's own inset shadow), since
     a change of shade alone does not read as focus. The crimson hangs on
     aria-invalid, which the page drops on the first keystroke (verso-forms.js),
     since the refusal was about the value that was there — the box then
     returns to the hairline and the action colour. */}}
{{define "verso-input-border"}}border-rule-strong hover:border-faint focus:border-denim{{if .}} aria-invalid:border-crimson aria-invalid:hover:border-crimson-deep aria-invalid:focus:border-crimson-deep aria-invalid:focus:shadow-[inset_0_0_0_1px_var(--color-crimson-deep),inset_0_1px_2px_rgba(27,25,23,.06)]{{end}}{{end}}

{{/* verso-kicker-class: the one kicker — a word or two naming the group under
     it, never a heading's rival: 12px at 500, uppercase at .08em, in the meta
     ink. Every label set this way wears exactly this, so a reader who learns
     it once reads it everywhere. */}}
{{define "verso-kicker-class"}}text-xs font-medium tracking-[.08em] text-meta uppercase{{end}}

{{/* verso-none: the dash a cell shows when it has no value. The dash is for
     the eye; a screen reader is told "None" instead of hearing a dash read out. */}}
{{define "verso-none"}}<span aria-hidden="true">—</span><span class="sr-only">{{ t "None" }}</span>{{end}}

{{/* verso-segment-focus: a segment's input is screen-reader-only, so the
     segment it sits in draws the keyboard focus ring for it. */}}
{{define "verso-segment-focus"}}has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-denim{{end}}

{{/* verso-field-aria: what a field's control says about itself beyond its
     label — what describes it (its help, its refusal), whether it was refused,
     and whether it is required. Required is stated rather than enforced: the
     browser's own bubble would stand in front of the shell's refusal. */}}
{{define "verso-field-aria"}}{{with .DescribedBy}} aria-describedby="{{.}}"{{end}}{{if .Error}} aria-invalid="true"{{end}}{{if .Required}} aria-required="true"{{end}}{{end}}

{{/* verso-input-box: one control, one box — the height a button beside it
     shares, white, the inset shadow, and a placeholder in the meta ink at the
     regular weight (it is text, and must read as such). */}}
{{define "verso-input-box"}}h-9 w-full rounded-xs border bg-white px-3 text-ink shadow-[inset_0_1px_2px_rgba(27,25,23,.06)] transition-colors placeholder:font-normal placeholder:text-meta focus:outline-none{{end}}

{{/* verso-input-class: the box for a machine string — an address, a port, a
     name a daemon will answer to — set in mono at the reading size, at the
     regular weight: a step under the 500 a displayed value takes, so what is
     being typed never reads as what has been stated. */}}
{{define "verso-input-class"}}{{template "verso-input-box"}} font-mono text-base font-normal{{end}}

{{/* verso-input-words: the box for words — a rule's name, a description, a
     password — set in the sans at 14px, which is what Hanken's taller
     x-height reads as beside mono at 16. */}}
{{define "verso-input-words"}}{{template "verso-input-box"}} font-sans text-sm font-normal{{end}}

{{/* verso-chip-box: every chip's shape, stated once. A chip is one height
     wherever it appears — beside a field's label, in a table's group band, on a
     panel's tab, after a row's name — because a reader who sees two heights
     reads two kinds of thing, and a chip is one kind of thing.

     22px, and the arithmetic that gets there rather than a height anyone has to
     honour by hand: a 14px value in a 16px line box (leading-4), 2px of padding
     above and below, and the 1px hairline. Retune it by moving the line box or
     the padding and the whole vocabulary follows. */}}
{{/* verso-chip-shape is that box with the type left out, for the one chip whose
     words are not chip-sized — a traffic endpoint, which reads at the mono
     reading size because it is an address someone could type. The 16px line box
     is what holds every chip to one height whatever size its words are. */}}
{{define "verso-chip-shape"}}inline-flex items-center gap-1.5 rounded-xs border px-1.5 py-0.5 leading-4 whitespace-nowrap{{end}}

{{/* The one form row, whatever control ends it. What the setting is on the left,
     growing; the control on the right at a fixed width, because a column of
     controls that all begin and end in the same place is what makes a form
     scannable — the labels are words and may be any length.

     A value to type and a state to flip are the same question asked of the same
     object, so they are the same row: every widget that is one setting renders
     through these three, and none of them may spell its own geometry. That is
     the whole reason a settings page reads as one page rather than as a pile of
     controls that each brought their own layout.

     Nothing rules between rows: fields inside a section already belong together,
     and a hairline every 40px turns a form into a table. Rules separate
     sections; space separates rows. */}}
{{define "verso-field-row-class"}}flex max-w-[40rem] flex-col gap-2 py-3 sm:flex-row sm:items-start sm:gap-8{{end}}
{{/* The control column holds a control's own height as its floor, so a row that
     ends in a 20px switch is exactly as tall as one that ends in a 36px box. A
     column of rows that changed height with the kind of control in it would read
     as a list of different things. */}}
{{define "verso-field-control-class"}}flex w-full min-w-0 flex-col justify-center gap-1.5 sm:w-64 sm:min-h-9 sm:flex-none{{end}}

{{/* verso-row-remove: the glyph that takes one row out of a set. It wears the
     same quiet treatment every icon act in a table wears, because that is what
     it is — taking a condition off a rule changes nothing on the device until the
     whole change is applied, so dressing it in crimson would promise a severity
     it does not have. The red is reserved for acts that cannot be taken back. */}}
{{define "verso-remove-glyph-class"}}grid size-7 flex-none cursor-pointer place-items-center rounded-xs text-glyph transition-colors hover:bg-mid/50 hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim{{end}}
{{define "verso-row-remove"}}<button type="button" data-verso-remove-field="{{.Name}}" aria-label="{{ t "Remove" }} {{.Label}}"
  class="group/act relative mt-1 {{template "verso-remove-glyph-class"}}">{{icon "x" "size-4"}}</button>{{end}}

{{/* The row's left column: what the setting is called, the option it writes, and
     — on a label that carries an explanation — the help cursor and tab stop that
     say the label is the thing to hover. Without one the label is inert, as
     every label was. */}}
{{define "verso-field-label"}}
<div class="flex min-w-0 flex-1 flex-wrap items-center gap-2 sm:pt-2">
  {{if .Label}}<label for="{{.For}}"{{with .For}} id="{{.}}-label"{{end}} class="text-sm font-semibold text-ink{{if .Explained}} group/tip relative cursor-help{{end}}"{{if .Explained}} data-verso-tip tabindex="0" aria-describedby="{{.Tip.ID}}"{{end}}>{{.Label}}{{if .Explained}}{{template "verso-tip-wide" .Tip}}{{end}}</label>{{end}}
  {{if .Key}}<span class="{{template "verso-chip-class"}}">{{.Key}}</span>{{end}}
  {{if .Staged}}{{template "verso-staged-row"}}{{end}}
</div>
{{end}}

{{/* verso-staged-row: this setting's change waits on the stage — the chip's
     own square and word beside the setting's name. The shell marks it on every
     visit until the change is applied or discarded (MarkStaged); the page's
     script flies the square from it to the chip once, after a save
     (verso-commit.js), and draws the same markup when it marks a row itself. */}}
{{define "verso-staged-row"}}<span data-verso-staged-row class="inline-flex items-center gap-1.5 text-sm font-medium text-marigold-deep"><span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] bg-marigold"></span>{{t "staged"}}</span>{{end}}
{{/* A chip's word is set at the regular weight. The box already separates it
     from the prose around it, so weight on top of a border and a fill is one
     emphasis too many — and a page of bolded chips reads as a page of shouting.
     The endpoint chips are the exception and spell their own weight: what they
     carry is an address someone will retype, and it holds the row's eye. */}}
{{define "verso-chip-box"}}{{template "verso-chip-shape"}} text-sm font-normal{{end}}
{{/* verso-chip-mono: the same box for a chip whose words the machine wrote —
     mono, one step heavier (500), because mono at 400 reads a size smaller
     than the sans beside it. */}}
{{define "verso-chip-mono"}}{{template "verso-chip-shape"}} text-sm font-medium font-mono{{end}}

{{/* verso-chip-class: the neutral category/reference chip — the one chip
     treatment an entity cited inside another row wears everywhere. Mono,
     because what it states is a machine string someone could type elsewhere. */}}
{{define "verso-chip-class"}}{{template "verso-chip-mono"}} border-rule bg-quiet text-meta{{end}}

{{/* verso-chip-accent-class: the same chip where what it states is the action
     colour's business — an address pinned by a reservation, say. Denim on its
     own soft ground, so it reads as a decision someone made rather than as one
     more fact about the row. */}}
{{define "verso-chip-accent-class"}}{{template "verso-chip-mono"}} border-denim-line bg-denim-soft text-denim-deep{{end}}

{{/* verso-chip-raised: the neutral chip on a surface that is itself quiet — a
     table's group band — where the chip has to sit a step above its ground
     rather than on it. */}}
{{define "verso-chip-raised"}}{{template "verso-chip-mono"}} border-rule bg-ground text-meta{{end}}

{{/* verso-token-chip: the one chip that is not a citation. Every chip above
     states a fact somewhere in the page's prose and is sized to the words around
     it; this one is a value a person put inside a control and can take back out,
     so it is sized to the control instead — 30px inside a 36px box, 2px of the
     box's own ground showing all round it. At citation size it read as a label
     that had wandered into a field, and left its remove glyph too small to wear
     the hover every other icon act wears.

     The value is set at the box's own reading size and weight, because what is in
     the chip is exactly what was typed into the box beside it. */}}
{{define "verso-token-chip"}}inline-flex h-7.5 items-center gap-1.5 rounded-xs border border-rule bg-quiet px-2 font-mono text-base font-medium whitespace-nowrap text-ink{{end}}

{{/* The glyph that takes one value out. Twenty pixels, so the quiet fill it
     takes on hover is a target rather than an outline of the glyph — the same act
     a table's row icons are, at the same size, with the same hover. It pulls 4px
     into the chip's right padding so the fill sits inside the chip's edge. */}}
{{define "verso-token-chip-remove"}}grid size-5 -mr-1 flex-none cursor-pointer place-items-center rounded-xs text-glyph transition-colors hover:bg-mid/50 hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim{{end}}

{{/* verso-entity-drawer: the same sliding frame as a row's own drawer, with
     nothing in it. A row whose subject several plugins have a say about does not
     carry its panel: the shell assembles that from every contributing plugin,
     and doing so for every row of a listing would mean asking each of them once
     per row before anyone had clicked anything. So the frame ships empty and
     fetches its contents the first time it opens. */}}
{{define "verso-entity-drawer"}}<template x-teleport="body">
  <div x-show="open" x-cloak @keydown.window="onKeydown" class="fixed inset-0 z-50">
    {{template "verso-overlay-backdrop"}}
    <aside x-show="open"
      x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
      x-transition:leave="transition duration-200 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
      x-ref="dialog" tabindex="-1" role="dialog" aria-modal="true"
      class="absolute inset-y-0 right-0 flex w-full max-w-3xl flex-col border-l border-rule-strong bg-ground shadow-[-8px_0_32px_rgba(27,25,23,.12)] focus:outline-none">
      {{/* The panel's contents are fetched when the drawer is opened, by the
           shell's own modal component rather than by a trigger on this element:
           what is asked for depends on which icon opened it, and an open that
           wants the tab already showing asks for nothing at all. Until then this
           is a spinner and the url it would fetch. */}}
      <div data-verso-entity-body data-verso-entity-url="{{.Entity}}" class="flex min-h-0 flex-1 flex-col">
        <div class="flex flex-1 items-center justify-center text-glyph">{{template "verso-waiting" ""}}<span class="sr-only">{{ t "Loading…" }}</span></div>
      </div>
    </aside>
  </div>
</template>{{end}}

{{/* verso-tip-class: the one tooltip — a small card in the page's own palette
     rather than an inverted bubble, because nothing else in Verso is inverted.
     It rests above whatever raises it and flush to that thing's right edge, so a
     tip on the last column stays inside the table. Hidden until its named group
     is hovered or focused; the caller supplies those variants. */}}
{{define "verso-tip-class"}}pointer-events-none absolute right-0 bottom-full z-30 mb-2 rounded-xs border border-rule-strong bg-ground px-3 py-2 text-sm leading-tight font-normal whitespace-nowrap text-ink opacity-0 shadow-[0_4px_12px_rgba(27,25,23,.14)] transition-opacity{{end}}

{{/* Copy feedback is prose, even beside a machine value. A refused copy keeps
     its explanation visible briefly, including after a touch activation. */}}
{{define "verso-copy-tip-class"}}{{template "verso-tip-class"}} font-sans group-hover/copy:opacity-100 group-focus-visible/copy:opacity-100 group-data-[copy-failed=true]/copy:opacity-100{{end}}
{{define "verso-copy-label"}}
  <span x-show="ready">{{t .}}</span>
  <span x-show="done" x-cloak>{{t "Copied"}}</span>
  <span x-show="failed" x-cloak>{{t "Couldn’t copy"}}</span>
{{end}}

{{/* verso-tip-wide: the tooltip that carries a sentence rather than a word —
     a form label explaining what the thing it names actually is. The narrow tip
     above states a control's name and so can sit on one line; this one wraps at
     a reading measure and hangs below its label, where a panel's first field
     has room for it and the label above stays legible while it is open.

     It ends on the option it explains and what reads that option, ruled off in
     mono: the prose is for someone meeting the setting for the first time, the
     footer for someone who already knows the config and wants the line.

     The raising element carries `group/tip` and `data-verso-tip`: the first
     reveals this on hover and focus, the second is what verso.js measures and
     what the stylesheet hangs the tip off, above or below. The stylesheet also
     decides when it takes the pointer (only while shown, and bridged across
     the gap to its label), so a pointer can move onto the sentence to read it,
     and Escape puts it away (verso-page.js). */}}
{{define "verso-tip-wide"}}
<span role="tooltip" id="{{.ID}}" class="absolute left-0 z-30 flex w-80 flex-col gap-2 rounded-xs border border-rule-strong bg-ground p-3 text-left font-normal whitespace-normal opacity-0 shadow-[0_4px_12px_rgba(27,25,23,.14)] transition-opacity group-hover/tip:opacity-100 group-focus-visible/tip:opacity-100">
  <span class="text-sm leading-[1.45] text-ink">{{.Tip}}</span>
  {{if .Footer}}<span class="flex items-center gap-2 border-t border-rule pt-2 font-mono text-sm font-medium text-meta">{{.Footer}}</span>{{end}}
</span>
{{end}}

{{/* verso-chip-packet: the one mark a chip may lead with besides an icon —
     the app's 6px packet square in the chip's hue, hollow when the chip has
     none (the packet absent). Still: a chip states a fact, and the pulse is
     for something live. Takes the tone or variant name. */}}
{{define "verso-chip-packet"}}<span class="size-1.5 shrink-0 rounded-[1px] {{if eq . "success"}}bg-green{{else if eq . "warning"}}bg-marigold{{else if eq . "danger"}}bg-crimson{{else if or (eq . "info") (eq . "accent")}}bg-denim{{else}}border border-faint{{end}}" aria-hidden="true"></span>{{end}}

{{/* verso-chip: the entity chip (an interface, a zone, a port) — the label
     names the one, led by one mark or none: a Lucide glyph naming the kind, or
     the packet square in the chip's tone. An icon wins. */}}
{{define "verso-chip"}}<span{{if .Title}} data-verso-tip tabindex="0" aria-describedby="{{.TipID}}"{{end}} class="{{if .LocalizeLabel}}{{template "verso-chip-box"}} font-sans{{else}}{{template "verso-chip-mono"}}{{end}} {{if eq .Tone "accent"}}border-denim-line bg-denim-soft text-denim-deep{{else if eq .Tone "success"}}border-green-line bg-green-soft text-green-deep{{else if eq .Tone "warning"}}border-marigold-line bg-marigold-soft text-marigold-deep{{else if eq .Tone "danger"}}border-crimson-line bg-crimson-soft text-crimson-deep{{else}}border-rule bg-quiet text-meta{{end}}{{if .Title}} group/tip relative z-10 cursor-help focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim{{end}}">{{if .Icon}}<span class="{{if eq .Tone "accent"}}text-denim{{else if eq .Tone "success"}}text-green-deep{{else if eq .Tone "warning"}}text-marigold-deep{{else if eq .Tone "danger"}}text-crimson-deep{{else}}text-faint{{end}}">{{icon .Icon "size-3.5"}}</span>{{else if .Dot}}{{template "verso-chip-packet" .Tone}}{{end}}{{.Label}}{{if .Title}}<span role="tooltip" id="{{.TipID}}" class="absolute left-0 z-30 {{if .LimitTip}}w-72 p-4{{else}}w-max max-w-64 px-3 py-2{{end}} rounded-xs border border-rule-strong bg-ground text-left font-sans text-sm leading-tight font-normal {{if .LimitTip}}whitespace-normal{{else}}whitespace-pre-line{{end}} text-ink opacity-0 shadow-[0_4px_12px_rgba(27,25,23,.14)] transition-opacity group-hover/tip:opacity-100 group-focus/tip:opacity-100">{{if .LimitTip}}<span class="sr-only">{{.Title}}</span>{{template "verso-device-limit-tip" .LimitTip}}{{else}}{{.Title}}{{end}}</span>{{end}}</span>{{end}}

{{/* verso-tone-dot: the status dot's colour for a tone (the badge vocabulary);
     success pulses — it marks something live. */}}
{{define "verso-tone-dot"}}{{if eq . "success"}}verso-live-dot bg-green{{else if eq . "warning"}}bg-marigold{{else if eq . "danger"}}bg-crimson{{else if eq . "info"}}bg-denim{{else}}bg-glyph{{end}}{{end}}

{{/* verso-tone-text: a tone worn as ink rather than as a pill — the badge's own
     text treatment, light and dark. A tone outside the vocabulary emits nothing,
     so the element keeps whatever colour it already carries. */}}
{{define "verso-tone-text"}}{{if eq . "success"}}text-green-deep{{else if eq . "warning"}}text-marigold-deep{{else if eq . "danger"}}text-crimson-deep{{else if eq . "info"}}text-denim-deep{{end}}{{end}}

{{/* verso-card-frame: the card's edge — one hairline border on white, no
     shadow — shared by card, settings, and table so every boxed surface
     speaks one card language. */}}
{{define "verso-card-frame"}}rounded-xs border border-rule bg-ground{{end}}

{{/* verso-overlay-backdrop: the click-to-close layer behind an open modal,
     drawer, or confirm dialog. Ink at 18% over a 2px blur, so what it covers
     stays legible as texture and the panel in front is plainly the thing in
     hand — a heavier scrim would make the page behind it look switched off.
     It fades over 280ms, a touch under the panel's own 300ms slide, so the
     dimming is already there as the panel arrives. */}}
{{define "verso-overlay-backdrop"}}<div x-show="open" x-transition.opacity.duration.280ms @click="hide" class="absolute inset-0 bg-ink/18 backdrop-blur-[0.125rem]"></div>{{end}}

{{/* verso-close-btn: the × that dismisses an overlay. */}}
{{define "verso-close-btn"}}<button type="button" @click="hide" aria-label="{{ t "Close" }}" class="grid size-7 shrink-0 cursor-pointer place-items-center rounded-xs text-meta transition-colors hover:bg-mid/50 hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim">{{icon "x" "size-4"}}</button>{{end}}

{{/* verso-csrf: the hidden CSRF carrier every state-changing form posts;
     renders nothing without a token (a render outside a session). */}}
{{define "verso-csrf"}}{{if .}}<input type="hidden" name="_csrf" value="{{.}}">{{end}}{{end}}

{{/* verso-flash: the one-shot outcome — a PRG confirmation, a plugin envelope's
     notice — toned by the tone vocabulary and drawn once. The page carries it
     at the top of its content; a panel answering its own submission carries it
     at the top of its body, because the page around it is not re-rendered to
     say what happened. One definition, so the two cannot drift apart. Nothing
     draws without a message. */}}
{{define "verso-flash"}}{{if .Message}}<div class="verso-flash mb-6 flex items-start gap-2 rounded-xs border px-4 py-3 text-sm leading-5 {{if eq .Variant "danger"}}border-crimson-line bg-crimson-soft text-crimson-deep{{else if eq .Variant "warning"}}border-marigold-line bg-marigold-soft text-marigold-deep{{else if eq .Variant "info"}}border-denim-line bg-denim-soft text-denim-deep{{else}}border-green-line bg-green-soft text-green-deep{{end}}" data-verso-flash-variant="{{.Variant}}">
  {{template "verso-message-mark" .Variant}}
  <span>{{.Message}}</span>
</div>{{end}}{{end}}

{{/* verso-message-mark: how an error, a notice, a warning or a confirmation
     says its tone — the state mark, the 6px square in the tone's hue, hung on
     the message's first 20px line. Never an alert glyph: the square is the
     one mark for state everywhere, and a message is state. */}}
{{define "verso-message-mark"}}<span aria-hidden="true" class="mt-1.75 size-1.5 shrink-0 rounded-[1px] {{template "verso-message-hue" .}}"></span>{{end}}

{{/* verso-error-line: a refusal under the thing it refuses — a box, a row, a
     button. The line's class, and its words after the crimson square; the
     words stand in their own span so a script that says a refusal
     (versoErrorLine, verso.js) writes them without losing the mark. */}}
{{define "verso-error-line"}}flex items-start gap-2 text-sm leading-5 text-crimson-deep{{end}}

{{/* verso-refusal-band: a refusal under the box it refuses — a field, a key's
     box, a list's box — is that line set on crimson's own wash, so a wrong
     value is findable without reading and reads the same wherever it was
     typed. Its words are verso-error-words. */}}
{{define "verso-refusal-band"}}flex items-start gap-2 rounded-xs bg-crimson-soft px-3 py-2 text-sm leading-5 text-crimson-deep{{end}}
{{define "verso-error-words"}}{{template "verso-message-mark" "danger"}}<span data-verso-error-text>{{.}}</span>{{end}}

{{/* verso-message-hue: the square's hue for a tone. Caution is marigold, as
     warning is; anything unnamed is an outcome that went well. */}}
{{define "verso-message-hue"}}{{if eq . "danger"}}bg-crimson{{else if or (eq . "warning") (eq . "caution")}}bg-marigold{{else if eq . "info"}}bg-denim{{else}}bg-green{{end}}{{end}}

{{/* verso-drawer-panel: the slide-in detail panel — the one drawer language,
     shared by the drawer widget and a table row's drawer (drawerPanelView).
     Behaviour is the shell's modal Alpine component; the caller provides the
     x-data scope and the trigger. The title band carries only the heading and close control. The body
     wrapper tames in-panel tables: the page-width floor and side padding go,
     the last column rides the right edge, hover tints go quiet (these rows
     open nothing), and a fact list following other content gets its own
     breath. */}}
{{/* A panel whose submission is done says so from inside (verso-forms.js), and
     the frame answers by finishing: closing, and letting go of what it holds
     once it is out of sight. */}}
{{define "verso-drawer-panel"}}<template x-teleport="body">
  <div x-show="open" x-cloak @keydown.window="onKeydown" @verso-panel-done="finish" class="fixed inset-0 z-50">
    {{template "verso-overlay-backdrop"}}
    <aside x-show="open"
      x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
      x-transition:leave="transition duration-200 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
      x-ref="dialog" tabindex="-1" role="dialog" aria-modal="true"
      class="absolute inset-y-0 right-0 flex w-full {{if or .Choices .Form}}max-w-[40rem]{{else if .Wide}}max-w-3xl{{else}}max-w-md{{end}} flex-col overflow-hidden border-l border-rule-strong bg-ground shadow-[-8px_0_32px_rgba(27,25,23,.12)] focus:outline-none">
      <div data-verso-panel class="contents">{{template "verso-drawer-contents" .}}</div>
    </aside>
  </div>
</template>{{end}}

{{/* verso-drawer-fetched: the same frame with nothing in it. A listing's rows
     ship this and nothing else: the panel's contents are one request away, made
     the first time someone opens it, rather than N panels rendered for a page
     where at most one will ever be looked at. The frame is what animates, and
     because it is mounted once it animates once — switching tabs later swaps
     what is inside it and the panel itself never moves. */}}
{{define "verso-drawer-fetched"}}<template x-teleport="body">
  <div x-show="open" x-cloak @keydown.window="onKeydown" @verso-panel-done="finish" class="fixed inset-0 z-50">
    {{template "verso-overlay-backdrop"}}
    <aside x-show="open"
      x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
      x-transition:leave="transition duration-200 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"
      x-ref="dialog" tabindex="-1" role="dialog" aria-modal="true"
      class="absolute inset-y-0 right-0 flex w-full max-w-3xl has-[[data-verso-panel-size=form]]:max-w-[40rem] flex-col overflow-hidden border-l border-rule-strong bg-ground shadow-[-8px_0_32px_rgba(27,25,23,.12)] focus:outline-none">
      <div data-verso-panel{{if .}} data-verso-panel-url="{{.}}"{{end}} class="contents"><span class="sr-only">{{ t "Loading…" }}</span></div>
    </aside>
  </div>
</template>{{end}}

{{/* The title band is shared by every drawer, including shell-assembled entity
     panels. Only the title and close control belong here; facts live in the body. */}}
{{define "verso-drawer-header"}}
<header class="flex h-13 flex-none items-center gap-4 border-b border-rule bg-quiet px-8">
  <h2 class="min-w-0 truncate text-lg font-semibold tracking-tight text-body">{{.}}</h2>
  <button type="button" @click="hide" aria-label="{{ t "Close" }}" class="ml-auto grid size-7 flex-none cursor-pointer place-items-center rounded-xs border border-transparent text-glyph transition-colors hover:border-sand-5 hover:bg-rule hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim">{{icon "x" "size-4"}}</button>
</header>
{{end}}

{{/* verso-drawer-contents: what is inside the frame — the title band, tabs,
     and the body. It is a template of its own because a fetch
     answers with exactly this: the frame stays where it is and only what it
     holds is replaced. */}}
{{define "verso-drawer-contents"}}
      {{if .Form}}<span hidden data-verso-panel-size="form"></span>{{end}}
      {{template "verso-drawer-header" .Title}}
      {{/* The strip cuts the body into the questions the object answers, each
           carrying where the object stands under it. A panel with one thing to
           say sends no tabs, and a strip that decides nothing is chrome. */}}
      {{if .Tabs}}
      <nav class="flex h-13 flex-none gap-6 overflow-x-auto border-b border-rule px-8" aria-label="{{ t "Sections" }}">
        {{range .Tabs}}
        {{/* A reading is swapped into the panel that is already open, never
             navigated to: the frame stays where it is, so it does not slide in
             again to show a different answer about the same rule. The address
             follows, so a reading is still a place you can link to — and with no
             script the link is simply followed and the page answers with the
             panel open on it. */}}
        <a href="{{.Href}}" hx-get="{{.Href}}" hx-target="closest [data-verso-panel]" hx-swap="innerHTML" hx-replace-url="true"{{if .Active}} aria-current="page"{{end}}
          class="flex shrink-0 items-center gap-2 whitespace-nowrap text-base leading-[1.3] transition {{if .Active}}font-medium text-ink shadow-[inset_0_-2px_0_var(--color-denim-deep)]{{else}}text-meta hover:text-ink hover:shadow-[inset_0_-2px_0_var(--color-inert)]{{end}}">{{.Label}}
          {{/* The state chip takes the tab's own colour — denim on the one in
               force, quiet on the rest — but never its weight: the tab's label
               is what the weight marks, and a bolded chip beside a bolded word
               says the same thing twice. Sans, because what it states is a count
               or a plain word rather than a string someone would type. The one
               chip box, as every chip is: the 52px tab strip holds it. */}}
          {{if .State}}<span class="{{template "verso-chip-box"}} {{if .Active}}border-denim-line bg-denim-soft text-denim-deep{{else}}border-rule bg-quiet text-meta{{end}}">{{.State}}</span>{{end}}</a>
        {{end}}
      </nav>
      {{end}}
      {{/* A panel that answered its own submission leads with how it went,
           where the page's flash slot would have said it: the page is not
           being drawn around this, so the panel says it itself. */}}
      <div data-scroll="sand"{{if not .Choices}} data-verso-drawer-body{{end}} class="verso-drawer-scrollbar min-h-0 flex-1 {{if not .Choices}}space-y-6 {{end}}overflow-x-hidden overflow-y-auto {{if .Choices}}space-y-0 pb-8 [&>section]:pt-0 [&>section>div:first-child]:mb-0 [&>section>div:first-child]:border-y [&>section>div:first-child]:border-rule [&>section>div:first-child]:bg-quiet [&>section>div:first-child]:px-8 [&>section>div:first-child]:py-2.5 [&_h3]:font-medium [&_h3]:tracking-[.08em] [&_.verso-rhythm>*]:!mt-0{{else}}px-8 pt-7 pb-8{{end}} [&>*+dl]:!mt-12 [&_table]:min-w-0 [&_.overflow-x-auto]:!overflow-visible [&_tbody_tr:hover]:!bg-transparent [&_td:first-child]:!pl-0 [&_th:first-child]:!pl-0 [&_td:last-child]:!pr-0 [&_th:last-child]:!pr-0 [&_td:last-child]:!text-right [&_th:last-child]:!text-right">
        {{template "verso-flash" .Flash}}
        {{range .Body}}{{.}}{{end}}
      </div>
{{end}}

{{define "verso-waiting"}}<span data-verso-wait aria-hidden="true" class="relative block size-3.5 shrink-0"><span class="absolute top-0 left-0 size-1.5 rounded-[1px] bg-sand-5"></span><span class="absolute top-0 left-2 size-1.5 rounded-[1px] bg-sand-5"></span><span class="absolute top-2 left-2 size-1.5 rounded-[1px] bg-sand-5"></span><span class="absolute top-2 left-0 size-1.5 rounded-[1px] bg-sand-5"></span></span>{{end}}
