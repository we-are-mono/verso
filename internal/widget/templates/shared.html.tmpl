{{/* Shared partials: the fragments every widget template speaks identically —
     button colour chains, the input border/focus/error chain, the category
     chip, the tone dot, the card frame, the overlay backdrop, the close
     button, the CSRF carrier. Each lives here once so the treatments cannot
     drift apart; a widget's own template keeps only its layout. The class
     strings stay in template files (not Go) so Tailwind's scanner keeps them. */}}

{{/* Every button and button-shaped link is the button block
     (blocks/button.css): class="verso-button", its dress by data-verso-style,
     its size by data-verso-size. */}}

{{/* Every typed box and dropdown is the input block (blocks/input.css), a
     box with a glyph inside it the control block (blocks/control.css), and
     fused values the box block (blocks/box.css). */}}

{{/* verso-empty-slot-body: what stands in a set's slot (the slot block,
     blocks/slot.css) — the hollow packet (absent) and the set's empty words.
     The slot element and its attributes stay at the call site, and the add
     stands 24px under it. */}}
{{define "verso-empty-slot-body"}}<span aria-hidden="true" class="verso-mark"></span>
    <p class="verso-slot__words">{{.}}</p>{{end}}

{{/* verso-kicker-class: the one kicker — a word or two naming the group under
     it, never a heading's rival: 12px at 500, uppercase at .08em, in the meta
     ink. Every label set this way wears exactly this, so a reader who learns
     it once reads it everywhere. */}}
{{/* A section's heading, stated once for every page that heads a section —
     the section widget and the pages the shell draws by hand alike. The band
     (data-verso-section-band, its rule and inset in input.css) lays out the
     title with whatever stands on its line (a count, an act) and wraps the
     lede to a line of its own under them. The title is the 18px heading; the
     lede is the section's one or two sentences in the reading style. */}}
{{define "verso-section-band-class"}}flex flex-wrap items-center justify-between gap-x-6{{end}}
{{define "verso-section-title-class"}}text-lg leading-6 font-semibold tracking-[-0.025em] text-ink{{end}}
{{define "verso-section-lede-class"}}verso-prose text-body{{end}}
{{define "verso-section-lede"}}<div class="w-full"><div data-verso-section-lede class="{{template "verso-section-lede-class"}}">{{.}}</div></div>{{end}}
{{/* A section meta: a fact standing on the heading's line — how long the
     router has run, when the firmware was last checked — its label in the
     meta ink and its value in the body ink at 600, so the value is what the
     eye lands on. data-verso-section-meta is the value's hook for a page that
     rewrites it live. */}}
{{define "verso-section-meta-class"}}inline-flex items-center gap-1.5 text-sm leading-6{{end}}
{{define "verso-section-meta-label-class"}}text-meta{{end}}
{{define "verso-section-meta-value-class"}}font-semibold text-body{{end}}

{{define "verso-kicker-class"}}text-xs leading-6 font-medium tracking-[.08em] text-meta uppercase{{end}}

{{/* verso-none: the dash a cell shows when it has no value. The dash is for
     the eye; a screen reader is told "None" instead of hearing a dash read out. */}}
{{define "verso-none"}}<span aria-hidden="true">—</span><span class="sr-only">{{ t "None" }}</span>{{end}}
{{/* verso-segment-focus: a segment's input is screen-reader-only, so the
     segment it sits in draws the keyboard focus ring for it. */}}
{{define "verso-segment-focus"}}has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-denim{{end}}

{{/* verso-field-aria: what a field's control says about itself beyond its
     label — what describes it (its help, its refusal), whether it was refused,
     and whether it is required. Required is stated rather than enforced: the
     browser's own bubble would stand in front of the shell's refusal. */}}
{{define "verso-field-aria"}}{{with .DescribedBy}} aria-describedby="{{.}}"{{end}}{{if .Error}} aria-invalid="true"{{end}}{{if .Required}} aria-required="true"{{end}}{{end}}


{{/* One form geometry on pages and in drawers: labels above controls, with
     checkboxes beside their labels. forms.css owns spacing, content measures
     and removable lanes. Layout hooks also cover locked fields and status
     rows, which intentionally have no change-tracking attributes. */}}
{{define "verso-field-row-class"}}verso-field-row max-w-form{{end}}
{{define "verso-field-control-class"}}verso-field-control{{end}}

{{/* verso-row-remove: the glyph that takes one row out of a set. It wears the
     same quiet treatment every icon act in a table wears, because that is what
     it is — taking a condition off a rule changes nothing on the device until the
     whole change is applied, so dressing it in crimson would promise a severity
     it does not have. The red is reserved for acts that cannot be taken back. */}}
{{define "verso-row-remove"}}<button type="button" data-verso-remove-field="{{.Name}}" aria-label="{{ t "Remove" }} {{.Label}}"
  class="verso-button group/act relative mt-1" data-verso-size="icon">{{icon "x" "size-4"}}</button>{{end}}

{{/* The field's label: what the setting is called, the option it writes, and
     — on a label that carries an explanation — the help cursor and tab stop that
     say the label is the thing to hover. Without one the label is inert, as
     every label was. */}}
{{/* A fused control's label is the one name covering every part, and its
     chip names every option, joined by a middot. */}}
{{define "verso-field-label"}}
<div class="verso-field-label flex min-w-0 flex-wrap items-center gap-2">
  {{if .Label}}{{if .Group}}<span{{template "verso-field-label-attrs" .}}>{{template "verso-field-label-text" .}}</span>{{else}}<label for="{{.For}}"{{template "verso-field-label-attrs" .}}>{{template "verso-field-label-text" .}}</label>{{end}}{{end}}
  {{if .Key}}<span class="verso-chip" data-verso-key data-verso-verbatim>{{.Key}}</span>{{end}}
  {{if .Staged}}{{template "verso-staged-row" .StagedAt}}{{end}}
</div>
{{end}}
{{/* verso-field-label-class: a setting's name, wherever a box is labelled —
     a form row, and the sign-in form that stands outside any row. It is set
     at 500, a step under a heading's 600, so a form reads as its headings
     over the names of what they hold. */}}
{{define "verso-field-label-class"}}text-sm font-medium text-ink{{end}}
{{define "verso-field-label-attrs"}}{{with .For}} id="{{.}}-label"{{end}} class="{{if .Mono}}font-mono text-base leading-6 font-medium text-ink{{else}}{{template "verso-field-label-class"}}{{end}}{{if .Explained}} relative cursor-help{{end}}"{{if .Explained}} data-verso-tip tabindex="0" aria-describedby="{{.Tip.ID}}"{{end}}{{end}}
{{define "verso-field-label-text"}}{{.Label}}{{if .Explained}}{{template "verso-tip-wide" .Tip}}{{end}}{{end}}

{{/* verso-staged-row: this setting's change waits on the stage — a bar in
     the stage's marigold down the row's left edge (blocks/staged.css), the
     word said to a screen reader beside the setting's name. The shell marks
     it on every visit until the change is applied or discarded (MarkStaged),
     named by the option's address so the Pending changes page can lead to
     it. */}}
{{define "verso-staged-row"}}<span{{with .}} id="staged-{{.}}"{{end}} data-verso-staged-row class="verso-staged"><span aria-hidden="true" class="verso-staged__bar"></span><span class="sr-only">{{t "staged"}}</span></span>{{end}}

{{/* verso-field: one setting's row, the same on a page, in a drawer and in a
     settings block (fieldFrame), and one shape whatever it holds: a ledger of
     its question and its answer (form-fields). The question is the label (the
     name, the key chip, the stage's mark) with the description under it; the
     answer is the control, drawn by the widget that owns it, in the form's
     answer column, with the refusal band under it, which an in-place value's
     own check also writes into; then the remove lane. A switch is an answer
     like any other. The row carries the change hooks the stage reads unless
     it posts nothing. No widget draws this row by hand. */}}
{{define "verso-field"}}<div class="{{template "verso-field-row-class"}}{{if .Wide}} verso-field-wide{{end}}{{if .Plain}} verso-field-plain{{end}}{{with .Class}} {{.}}{{end}}"{{with .Change}}{{if .Track}} data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="{{.Kind}}"{{with .Writes}} data-verso-writes="{{.}}"{{end}}{{end}}{{end}}>
  <div class="verso-field-ledger">
    <div class="verso-field-question">
      {{if .ShowsLabel}}{{template "verso-field-label" .Label}}{{end}}
      {{with .Detail}}<p{{with $.DetailID}} id="{{.}}"{{end}} data-verso-field-detail class="{{template "verso-field-desc-class"}}">{{.}}</p>{{end}}
      {{/* A description folds away with every other on the page (forms.css):
           its words stand in a span of their own, the one track that
           closes. A wide row says it under its answer instead. */}}
      {{if not .Wide}}{{with .Desc}}<p{{with $.DescID}} id="{{.}}"{{end}} data-verso-field-desc class="{{template "verso-field-desc-class"}}"><span>{{with $.DescHTML}}{{.}}{{else}}{{.}}{{end}}</span></p>{{end}}{{end}}
    </div>
    {{/* An act on the whole answer (a set's add) stands on the question's
         line at the row's end, at every width. */}}
    {{with .Act}}<div class="verso-field-act">{{.}}</div>{{end}}
    {{/* A row that is all question (a set's head, a fact with nothing to
         read out) draws no answer, so a stacked row leaves no empty
         control's height under it. */}}
    {{if or .Control .Errors .Note .Inline}}<div data-verso-control{{with .Measure}} data-verso-control-measure="{{.}}"{{end}}{{if .Inline}} data-verso-inline-field{{end}} class="{{template "verso-field-control-class"}} verso-field-answer relative">
      {{.Control}}
      {{range .Errors}}<span id="{{.ID}}" data-verso-error class="{{template "verso-refusal-band"}}">{{template "verso-error-words" .Text}}</span>{{else}}{{if .Inline}}<span id="{{.ErrorID}}" data-verso-inline-error hidden class="{{template "verso-refusal-band"}}"></span>{{end}}{{end}}
      {{/* A wide row's answer stands under its label, so what the row is for
           stands under the answer, after its refusal, as a note does: a
           sentence between a name and its box would part them. Such rows are
           rare, so it stays in view when the page's descriptions fold. */}}
      {{if .Wide}}{{with .Desc}}<p{{with $.DescID}} id="{{.}}"{{end}} data-verso-field-note class="{{template "verso-field-desc-class"}}">{{with $.DescHTML}}{{.}}{{else}}{{.}}{{end}}</p>{{end}}{{end}}
      {{with .Note}}<p{{with $.NoteID}} id="{{.}}"{{end}} data-verso-field-note class="{{template "verso-field-desc-class"}}">{{.}}</p>{{end}}
    </div>{{end}}
    {{/* A row that cannot be taken out of the set still reserves the glyph's
         width, so every control in the group begins and ends in one place. */}}
    {{if .Lane}}{{if .Removable}}{{template "verso-row-remove" .Change}}{{else}}<span data-verso-remove-lane class="size-7 flex-none" aria-hidden="true"></span>{{end}}{{end}}
  </div>
</div>{{end}}
{{define "verso-field-desc-class"}}text-sm leading-6 text-pretty text-body{{end}}

{{/* verso-field-set: related settings under one head (fieldSetView) — one
     setting asked of several things (which files load), or settings that
     belong together but cannot fuse into one box: its head row (the set's
     label, which names the set for a screen reader too, its chip and its
     description), then a row per setting under it, each a question and its
     answer in the column. */}}
{{define "verso-field-set"}}<div{{with .Group}} role="group" aria-labelledby="{{.}}"{{end}} class="verso-field-set">{{.Head}}{{range .Rows}}{{.}}{{end}}</div>{{end}}
{{/* verso-nothing: the control of a row that is all question (a group's
     head). */}}
{{define "verso-nothing"}}{{end}}

{{/* verso-box: one frame holding typed values (boxView). A value counted in
     a unit is a box of one part, its unit words inside the frame after it, so
     the box is as wide as the value's measure and the unit, whatever the unit
     is called in the reader's language. Values entered together are one box of
     several parts split by hairlines: they are one answer, and a reader sees
     one control rather than boxes that happen to stand near each other. The
     frame takes the field's states (forms.css). The row's label names the
     group; each part stays its own input under its own name, which a screen
     reader says as the caret enters it and a refusal band repeats. */}}
{{define "verso-box"}}<span class="verso-box"{{if .Stacked}} data-verso-stacked{{end}}{{with .Group}} role="group" aria-labelledby="{{.}}"{{end}}{{with .Described}} aria-describedby="{{.}}"{{end}}>{{range .Parts}}{{template "verso-box-part" .}}{{end}}</span>{{end}}
{{/* verso-select: one dropdown (a boxPart) — appearance-none and our own
     chevron, inset right-3 to mirror the text's pl-3, because the native arrow
     hugs the border and can't follow the theme. A part of a joined row is
     named on its own; a lone field is named by its row's label. */}}
{{define "verso-select"}}<div class="verso-control">
    <select id="{{.Name}}"{{if .Theme}} data-verso-theme{{else}} name="{{.Name}}"{{end}}{{with .Fetch}} hx-get="{{.URL}}" hx-trigger="change" hx-include="closest .verso-joined" hx-target="{{.Target}}" hx-swap="outerHTML"{{end}}{{if .Reshapes}} data-verso-reshape{{end}}{{if .Named}} aria-label="{{.Label}}"{{end}}{{template "verso-field-aria" .}} class="verso-input"{{if not .Words}} data-verso-verbatim{{end}} data-verso-trail>
      {{range .Options}}<option value="{{.Value}}"{{if eq .Value $.Value}} selected{{end}}>{{.Label}}</option>{{end}}
    </select>
    <span class="verso-control__trail">{{icon "chevron-down" "size-4"}}</span>
    {{if .Reshapes}}<span data-verso-reshape-wait hidden class="verso-control__wait">{{template "verso-waiting" ""}}</span>{{end}}
  </div>{{end}}
{{/* verso-listing-search: the search that narrows a listing, given its
     placeholder (.Filter) and the words standing in it (.Query); over a paged
     listing (.Paged) the page asks the server instead of narrowing. It is the
     app's one box, led by the lens. */}}
{{define "verso-listing-search"}}<div class="verso-control w-80">
    <span class="verso-control__lead">{{icon "search" "size-4"}}</span>
    <input type="search"{{if not .Paged}} data-verso-listing-filter{{end}}{{with .Query}} value="{{.}}"{{end}} autocomplete="off" placeholder="{{.Filter}}" aria-label="{{.Filter}}" class="verso-input" data-verso-lead>
  </div>{{end}}
{{/* verso-reshape-wait: the waiting mark beside a choice that reshapes its
     form, hidden until the choice is made and the form it names is on its way
     (verso-forms.js). It stands outside the control's box, so the control's
     measure never makes room for it. */}}
{{define "verso-reshape-wait"}}<span data-verso-reshape-wait hidden class="{{.}}">{{template "verso-waiting" ""}}</span>{{end}}

{{/* verso-text-input: one typed value (a boxPart) in its own box — words in
     the sans, a machine string in mono, as wide as its grammar needs: an
     address, a number, a clock time or a date its own measure, anything else
     the column. A part of a joined row is named on its own; a lone field is
     named by its row's label. */}}
{{define "verso-text-input"}}<input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="text"{{if .Named}} aria-label="{{.Label}}"{{end}}{{if eq .Measure "number"}} inputmode="numeric"{{end}}{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Autofocus}} autofocus{{end}}{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}}{{if .Suggests}} data-verso-suggest-input role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="{{.Name}}-options" autocomplete="off"{{end}}{{template "verso-field-aria" .}} class="verso-input"{{if not .Words}} data-verso-verbatim{{end}}{{if and (eq .Measure "address") (ne .ControlMeasure "prefix")}} data-verso-measure="address"{{else if or (eq .Measure "number") (eq .Measure "short")}} data-verso-measure="{{.Measure}}"{{end}}>{{end}}

{{/* verso-suggest-input: a typed value (a boxPart) with the values worth
     offering under its box — a device's address and its name. They are a
     reminder, not a menu: the box takes whatever is typed, the list narrows as
     it is typed into and goes when nothing matches, and taking one fills the
     box and closes the list (verso-forms.js). The arrow keys move through what
     is showing and Enter takes it, while focus stays in the box; the options
     are out of the tab order for the same reason. A box at a measure holds the
     list to its own edge; the list grows past it for a long name. */}}
{{define "verso-suggest-input"}}<div class="verso-control{{if or (eq .Measure "address") (eq .Measure "number") (eq .Measure "short")}} w-fit{{end}}">
  {{template "verso-text-input" .}}
  <div id="{{.Name}}-options" data-verso-suggest-menu role="listbox"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}} hidden class="verso-menu verso-drawer-scrollbar" data-verso-menu-width="words">
    {{range $i, $o := .Options}}
    <button type="button" id="{{$.Name}}-option-{{$i}}" role="option" aria-selected="false" tabindex="-1" data-verso-suggest-option="{{$o.Value}}" data-verso-suggest-label="{{$o.Label}}" class="verso-menu__option"><span class="verso-menu__value" data-verso-verbatim>{{$o.Value}}</span>{{if ne $o.Label $o.Value}}<span class="verso-menu__note">{{$o.Label}}</span>{{end}}</button>
    {{end}}
  </div>
</div>{{end}}

{{/* verso-time-input: a clock time (a boxPart) — a curfew's edge. The native
     control keeps the platform's own 12/24-hour habit and its picker; the box
     is sized to what it holds rather than to the column, because a time is
     four characters and a full-width field would say it might not be. It
     wears the app's clock where the platform's glyph would stand, in the
     quiet ink and inset right-3 as a dropdown's chevron is; the platform's own
     stays under it, invisible (blocks/input.css), so a press on the glyph
     still opens the picker. */}}
{{define "verso-time-input"}}<div class="verso-control w-32">
    <input id="{{.Name}}" name="{{.Name}}" value="{{.Value}}" type="time"{{if .Named}} aria-label="{{.Label}}"{{end}}{{template "verso-field-aria" .}} class="verso-input" data-verso-verbatim data-verso-trail>
    <span class="verso-control__trail">{{icon "clock" "size-4"}}</span>
  </div>{{end}}

{{/* verso-joined: a sentence of related fields as one row (boxView) — a path
     from one zone to another, a window from one time to the next. A word
     between parts always splits them: each stands as its own control, side
     by side, its own change under its own name, with the group's word between
     them as the sentence says it ("lan to wan", "09:00 to 17:00"). The word
     is read by sight; each part's own name says it to a screen reader. */}}
{{define "verso-joined"}}<div class="verso-joined" role="group" aria-labelledby="{{.Group}}"{{with .Described}} aria-describedby="{{.}}"{{end}}>{{range .Parts}}{{template "verso-joined-part" .}}{{end}}</div>{{end}}
{{define "verso-joined-part"}}{{with .Join}}<span id="{{$.JoinID}}" aria-hidden="true" class="verso-joined__word">{{.}}</span>{{end}}<div class="verso-joined__part"{{if .Track}} data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="{{.ChangeKind}}"{{with .Key}} data-verso-writes="{{.}}"{{end}}{{end}}>{{if eq .Kind "select"}}{{template "verso-select" .}}{{else if eq .Kind "time"}}{{template "verso-time-input" .}}{{else}}{{template "verso-text-input" .}}{{end}}</div>{{end}}
{{/* verso-box-part: one value in a box (a boxPart) — a typed value, or the
     dropdown of units a value is counted in, bare inside the box's frame with
     the app's chevron where the native arrow would stand. After a typed value
     stands its unit, or in a labelled set its own name, so the set reads
     without a tooltip; a screen reader hears the name from the input's own
     label, so the shown name is for sight alone. */}}
{{define "verso-box-part"}}<span class="verso-box__part" data-verso-measure="{{.Measure}}"{{if .Track}} data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="{{.ChangeKind}}"{{with .Key}} data-verso-writes="{{.}}"{{end}}{{end}}>{{if eq .Kind "select"}}<select id="{{.Name}}" name="{{.Name}}"{{if .Named}} aria-label="{{.Label}}"{{end}}{{template "verso-field-aria" .}} class="verso-box__select">
      {{range .Options}}<option value="{{.Value}}"{{if eq .Value $.Value}} selected{{end}}>{{.Label}}</option>{{end}}
    </select><span aria-hidden="true" class="verso-box__chevron">{{icon "chevron-down" "size-4"}}</span>{{else}}<input id="{{.Name}}" name="{{.Name}}"{{if eq .Kind "password"}} type="password" autocomplete="{{if .Autocomplete}}{{.Autocomplete}}{{else}}new-password{{end}}"{{else}} value="{{.Value}}" type="text"{{end}}{{if .Named}} aria-label="{{.Label}}"{{end}}{{if eq .Measure "number"}} inputmode="numeric"{{end}}{{with .Placeholder}} placeholder="{{.}}"{{end}}{{if .Autofocus}} autofocus{{end}}{{with .Datatype}} data-datatype="{{.}}"{{end}}{{template "verso-field-aria" .}} class="verso-box__input"{{if not .Words}} data-verso-verbatim{{end}}>{{with .Unit}}<span id="{{$.Name}}-unit" class="verso-box__unit">{{.}}</span>{{else}}{{if .Shown}}<span aria-hidden="true" class="verso-box__unit">{{.Label}}</span>{{end}}{{end}}{{end}}</span>{{end}}
{{/* A value a person put inside a token box is the tokens block's chip
     (blocks/tokens.css). */}}

{{/* verso-entity-drawer: the same sliding frame as a row's own drawer, with
     nothing in it. A row whose subject several plugins have a say about does not
     carry its panel: the shell assembles that from every contributing plugin,
     and doing so for every row of a listing would mean asking each of them once
     per row before anyone had clicked anything. So the frame ships empty and
     fetches its contents the first time it opens. */}}
{{define "verso-entity-drawer"}}<template x-teleport="body">
  <dialog x-ref="dialog" tabindex="-1" {{template "verso-dialog-on"}} class="verso-modal overflow-visible" data-verso-kind="drawer">
    {{/* The panel's contents are fetched when the drawer is opened, by the
         shell's own modal component rather than by a trigger on this element:
         what is asked for depends on which icon opened it, and an open that
         wants the tab already showing asks for nothing at all. Until then this
         is a spinner and the url it would fetch. */}}
    <div data-verso-entity-body data-verso-entity-url="{{.Entity}}" class="verso-modal__panel">
      <div class="verso-modal__loading">{{template "verso-waiting" ""}}<span class="sr-only">{{ t "Loading…" }}</span></div>
    </div>
  </dialog>
</template>{{end}}

{{/* verso-act-tip: an act's tip (blocks/tip.css), naming the act its group
     raises it from on hover or focus. */}}
{{define "verso-act-tip"}}<span class="verso-tip group-hover/act:opacity-100 group-focus-visible/act:opacity-100">{{.}}</span>{{end}}

{{/* verso-copy-tip: a copy control's tip. Copy feedback is prose, even beside
     a machine value. A refused copy keeps its explanation visible briefly,
     including after a touch activation. */}}
{{define "verso-copy-tip"}}<span class="verso-tip group-hover/copy:opacity-100 group-focus-visible/copy:opacity-100 group-data-[copy-failed=true]/copy:opacity-100">{{template "verso-copy-label" .}}</span>{{end}}
{{define "verso-copy-label"}}
  <span x-show="ready">{{t .}}</span>
  <span x-show="done" x-cloak>{{t "Copied"}}</span>
  <span x-show="failed" x-cloak>{{t "Couldn’t copy"}}</span>
{{end}}

{{/* verso-tip-wide: the tooltip that carries a sentence rather than a word —
     a form label explaining what the thing it names actually is. The narrow tip
     above states a control's name and so can sit on one line; this one wraps at
     a reading measure and rises above its label, clear of the control under it.

     It ends on the option it explains and what reads that option, ruled off in
     mono: the prose is for someone meeting the setting for the first time, the
     footer for someone who already knows the config and wants the line.

     The raising element carries `data-verso-tip`: the stylesheet reveals the
     tip from it, after a pause for the pointer and at once for focus, and
     hangs it above or below; verso-page.js sets it at the pointer and decides
     which. The stylesheet also decides when it takes the pointer (only while
     shown, and bridged across the gap to its label), so a pointer can move
     onto the sentence to read it, and Escape puts it away (verso-page.js). */}}
{{define "verso-tip-wide"}}
<span role="tooltip" id="{{.ID}}" class="verso-tip" data-verso-tip-kind="wide"><span class="flex flex-col gap-2">
  {{with .Tip}}<span>{{.}}</span>{{end}}
  {{if .Footer}}<span class="verso-tip__footer" data-verso-verbatim>{{.Footer}}</span>{{end}}
</span></span>
{{end}}

{{/* verso-chip-packet: the one mark a chip may lead with besides an icon —
     the app's 6px packet square in the chip's hue, hollow when the chip has
     none (the packet absent). Still: a chip states a fact, and the pulse is
     for something live. Takes the tone or variant name. */}}
{{define "verso-chip-packet"}}<span class="verso-mark" data-verso-tone="{{.}}" aria-hidden="true"></span>{{end}}

{{/* verso-chip: the entity chip (an interface, a zone, a port) — the label
     names the one, led by one mark or none: a Lucide glyph naming the kind, or
     the packet square in the chip's tone. An icon wins. */}}
{{define "verso-chip"}}<span class="verso-chip{{if .Title}} relative z-10 cursor-help focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim{{end}}"{{if not .LocalizeLabel}} data-verso-verbatim{{end}}{{with .Tone}} data-verso-tone="{{.}}"{{end}}{{if .Title}} data-verso-tip tabindex="0" aria-describedby="{{.TipID}}"{{end}}>{{if .Icon}}<span class="verso-chip__glyph">{{icon .Icon "size-3.5"}}</span>{{else if .Dot}}{{template "verso-chip-packet" .Tone}}{{end}}{{.Label}}{{if .Title}}<span role="tooltip" id="{{.TipID}}" class="verso-tip" data-verso-tip-kind="{{if .LimitTip}}limit{{else}}info{{end}}">{{if .LimitTip}}<span class="sr-only">{{.Title}}</span>{{template "verso-device-limit-tip" .LimitTip}}{{else}}{{.Title}}{{end}}</span>{{end}}</span>{{end}}

{{/* verso-dot: the status dot, a mark (blocks/mark.css) in a tone of the badge
     vocabulary, filled in Glyph for any other; success pulses, since it marks
     something live. verso-dot-tone names the tone. */}}
{{define "verso-dot"}}<span class="verso-mark" data-verso-tone="{{template "verso-dot-tone" .}}"{{if eq . "success"}} data-verso-live{{end}}></span>{{end}}
{{define "verso-dot-tone"}}{{if or (eq . "success") (eq . "warning") (eq . "danger") (eq . "info")}}{{.}}{{else}}muted{{end}}{{end}}

{{/* verso-tone-text: a tone worn as ink rather than as a pill — the badge's own
     text treatment, light and dark. A tone outside the vocabulary emits nothing,
     so the element keeps whatever colour it already carries. */}}
{{define "verso-tone-text"}}{{if eq . "success"}}text-green-deep{{else if eq . "warning"}}text-marigold-deep{{else if eq . "danger"}}text-crimson-deep{{else if eq . "info"}}text-denim-deep{{end}}{{end}}

{{/* verso-dialog-on: how an overlay of the shell's modal component answers
     the browser — Escape (its cancel event) and a press on its scrim close it
     through the component, and a close the browser made itself is followed. */}}
{{define "verso-dialog-on"}}@cancel="dismiss" @close="closed" @pointerdown="press" @click="scrim"{{end}}

{{/* verso-close-btn: the × that dismisses an overlay. */}}
{{define "verso-close-btn"}}<button type="button" @click="hide" aria-label="{{ t "Close" }}" class="verso-modal__close">{{icon "x" "size-4"}}</button>{{end}}

{{/* verso-csrf: the hidden CSRF carrier every state-changing form posts;
     renders nothing without a token (a render outside a session). */}}
{{define "verso-csrf"}}{{if .}}<input type="hidden" name="_csrf" value="{{.}}">{{end}}{{end}}

{{/* verso-flash: the one-shot outcome — a PRG confirmation, a plugin envelope's
     notice — toned by the tone vocabulary, as the notification at the top right
     of the viewport says it. A page and a panel answering its own submission
     both carry it in a template, never in their content, and the outcome layer
     says it (verso-page.js). One definition, so the two cannot drift apart.
     Nothing draws without a message. */}}
{{define "verso-flash"}}{{if .Message}}<div {{template "verso-flash-attrs" .Variant}}>
  {{template "verso-message-mark" .Variant}}
  <span>{{.Message}}</span>
</div>{{end}}{{end}}

{{/* verso-flash-attrs: a flash's box in its tone (the notice block's flash),
     for a flash whose words the page composes itself (the unanswered
     request's, with its Reload). Anything unnamed is an outcome that went
     well. */}}
{{define "verso-flash-attrs"}}class="verso-notice" data-verso-kind="flash" data-verso-tone="{{if or (eq . "danger") (eq . "warning") (eq . "info")}}{{.}}{{else}}success{{end}}" data-verso-flash-variant="{{.}}"{{end}}

{{/* verso-message-mark: how an error, a notice, a warning or a confirmation
     says its tone — the state mark, the 6px square in the tone's hue, hung on
     the message's first 20px line. Never an alert glyph: the square is the
     one mark for state everywhere, and a message is state. */}}
{{define "verso-message-mark"}}<span aria-hidden="true" class="verso-mark mt-2.25" data-verso-tone="{{template "verso-message-tone" .}}"></span>{{end}}

{{/* verso-error-line: a refusal under the thing it refuses — a box, a row, a
     button. The line's class, and its words after the crimson square; the
     words stand in their own span so a script that says a refusal
     (versoErrorLine, verso.js) writes them without losing the mark. */}}
{{define "verso-error-line"}}flex items-start gap-2 text-sm leading-6 text-crimson-deep{{end}}

{{/* verso-refusal-band: a refusal under the box it refuses — a field, a key's
     box, a list's box — is that line set on crimson's own wash, so a wrong
     value is findable without reading and reads the same wherever it was
     typed. Its words are verso-error-words. Half a cell inside at top and
     bottom keeps it whole cells of the notebook's grid. */}}
{{define "verso-refusal-band"}}flex items-start gap-2 rounded-xs bg-crimson-soft px-3 py-2 text-sm leading-6 text-crimson-deep{{end}}
{{define "verso-error-words"}}{{template "verso-message-mark" "danger"}}<span data-verso-error-text>{{.}}</span>{{end}}

{{/* verso-message-tone: the mark's tone for a message's tone. Caution is
     marigold, as warning is; anything unnamed is an outcome that went well. */}}
{{define "verso-message-tone"}}{{if or (eq . "danger") (eq . "warning") (eq . "caution") (eq . "info")}}{{.}}{{else}}success{{end}}{{end}}

{{/* verso-drawer-panel: the slide-in detail panel — the one drawer language,
     shared by the drawer widget and a table row's drawer (drawerPanelView).
     Behaviour is the shell's modal Alpine component; the caller provides the
     x-data scope and the trigger. The title band carries only the heading and close control. The body
     wrapper tames in-panel tables: the page-width floor and side padding go,
     the last column rides the right edge, hover tints go quiet (these rows
     open nothing), and a fact list following other content gets its own
     breath. */}}
{{/* A panel whose submission is done says so from inside (verso-forms.js), and
     the frame answers by finishing: closing, and letting go of what it holds
     once it is out of sight. */}}
{{/* The frame stays in <body> (x-teleport): what it holds is styled on the
     page's own ground rather than inheriting the row or section it opens from,
     a frame in a <tr> would not survive the parser there, and its forms are
     never nested in the page's. */}}
{{define "verso-drawer-panel"}}<template x-teleport="body">
  <dialog x-ref="dialog" tabindex="-1" {{template "verso-dialog-on"}} @verso-panel-done="finish" class="verso-modal overflow-hidden" data-verso-kind="drawer">
    <div data-verso-panel class="contents">{{template "verso-drawer-contents" .}}</div>
  </dialog>
</template>{{end}}

{{/* verso-drawer-fetched: the same frame with nothing in it. A listing's rows
     ship this and nothing else: the panel's contents are one request away, made
     the first time someone opens it, rather than N panels rendered for a page
     where at most one will ever be looked at. The frame is what animates, and
     because it is mounted once it animates once — switching tabs later swaps
     what is inside it and the panel itself never moves. */}}
{{define "verso-drawer-fetched"}}<template x-teleport="body">
  <dialog x-ref="dialog" tabindex="-1" {{template "verso-dialog-on"}} @verso-panel-done="finish" class="verso-modal overflow-hidden" data-verso-kind="drawer">
    <div data-verso-panel{{if .}} data-verso-panel-url="{{.}}"{{end}} class="contents"><span class="sr-only">{{ t "Loading…" }}</span></div>
  </dialog>
</template>{{end}}

{{/* The title band is shared by every drawer, including shell-assembled entity
     panels. Only the title and close control belong here; facts live in the body. */}}
{{/* A drawer's gutter, chrome and ground are the modal block's
     (blocks/modal.css: --verso-drawer-gutter, __head, __ground). */}}

{{/* verso-fold-act: the one act that folds every description on the page
     away and brings them back (form-fields), on the page's heading line and
     in every drawer's header, given its place's own classes. It holds both
     words; the stylesheet shows the one the page's state calls for, and
     shows the act only where there is a description to fold, through a
     wrapper whose display no utility sets (verso-page.js keeps the
     state). */}}
{{define "verso-fold-act"}}<span class="verso-fold {{.}}"><button type="button" data-verso-fold class="verso-button group/act relative" data-verso-size="act" data-verso-style="quiet" data-verso-glyph><span class="verso-fold__hide">{{icon "fold-vertical" "size-4"}}<span>{{t "Hide descriptions"}}</span></span><span class="verso-fold__show">{{icon "unfold-vertical" "size-4"}}<span>{{t "Show descriptions"}}</span></span></button></span>{{end}}

{{/* The band is 56px as the top bar is, and built the same way: its 28px
     line and 14px of air either side, the hairline drawn inside it. It is
     Paper over the body's Quiet Sand, as a live page's light masthead is over
     its log, so the chrome reads as the drawer's and the cards under it as
     what it holds. */}}
{{define "verso-drawer-header"}}
<header class="verso-modal__head">
  <h2 class="verso-modal__title">{{.}}</h2>
  {{/* The fold stands with the close, before it, at the band's end. */}}
  <div class="verso-modal__acts">
    {{template "verso-fold-act" ""}}
    {{template "verso-close-btn"}}
  </div>
</header>
{{end}}

{{/* verso-drawer-contents: what is inside the frame — the title band, tabs,
     and the body. It is a template of its own because a fetch
     answers with exactly this: the frame stays where it is and only what it
     holds is replaced. */}}
{{define "verso-drawer-contents"}}
      {{template "verso-drawer-header" .Title}}
      {{/* The strip cuts the body into the questions the object answers. A
           panel with one thing to say sends no tabs, and a strip that decides
           nothing is chrome. A tab names a reading as a label names a setting,
           so it is its name alone, set at the labels' 14px, and the section
           heading under the strip stays the clear step up. The strip is 56px
           as the header is, and its tabs are the air: each stands the full
           height, so an underline sits on the strip's own hairline. */}}
      {{if .Tabs}}
      {{/* A strip that keeps edits (RowDrawer.TabsKeepEdits) is marked, so a
           press posts the form to the tab rather than fetching it bare
           (verso-forms.js). */}}
      <nav{{if .TabsKeepEdits}} data-verso-tabs-keep{{end}} class="verso-tabs" aria-label="{{ t "Sections" }}">
        {{range .Tabs}}
        {{/* A reading is swapped into the panel that is already open, never
             navigated to: the frame stays where it is, so it does not slide in
             again to show a different answer about the same rule. The address
             follows, so a reading is still a place you can link to — and with no
             script the link is simply followed and the page answers with the
             panel open on it. */}}
        <a href="{{.Href}}" hx-get="{{.Href}}" hx-target="closest [data-verso-panel]" hx-swap="innerHTML" hx-replace-url="true"{{if .Active}} aria-current="page"{{end}} class="verso-tabs__tab">{{.Label}}</a>
        {{end}}
      </nav>
      {{end}}
      {{/* A choice drawer's section bands carry the drawer inset inside an
           arbitrary variant, where a partial cannot stand: the gutter there
           is verso-drawer-inset spelled out. A table keeps its own cell inset
           inside the drawer's, as an entity panel's does, so a lane's fill
           never touches its words. */}}
      {{/* A panel that answered its own submission carries how it went for the
           outcome layer to say (verso-page.js), never as a line of its own:
           the page is not drawn around this answer, so the panel brings it. */}}
      {{if .Flash.Message}}<template data-verso-arrival>{{template "verso-flash" .Flash}}</template>{{end}}
      {{if .Choices}}<div data-verso-scroll="sand" class="verso-drawer-scrollbar min-h-0 flex-1 overflow-x-hidden overflow-y-auto space-y-0 pb-8 [&>section]:pt-0 [&>section>div:first-child]:mb-0 [&>section>div:first-child]:border-y [&>section>div:first-child]:border-rule [&>section>div:first-child]:bg-quiet [&>section>div:first-child]:px-(--verso-drawer-gutter) [&>section>div:first-child]:py-2 [&_h3]:font-medium [&_h3]:tracking-[.08em] [&_.verso-rhythm>*]:!mt-0">
      {{- else}}<div data-verso-scroll="sand" data-verso-drawer-body class="verso-modal__ground verso-stack verso-drawer-scrollbar">{{end}}
        {{range .Body}}{{.}}{{end}}
      </div>
{{end}}

{{define "verso-waiting"}}<span class="verso-waiting" data-verso-wait aria-hidden="true"><span class="verso-waiting__square"></span><span class="verso-waiting__square"></span><span class="verso-waiting__square"></span><span class="verso-waiting__square"></span></span>{{end}}
