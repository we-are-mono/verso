{{/* row: a compact list item — leading icon, title + meta, trailing status badge
     and chevron. The status badge is pre-rendered trusted HTML. Icons come from the
     shared Lucide set (icons.go). */}}
<div class="flex items-center gap-4 px-1 py-3">
  {{if .Icon}}
  <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-600">{{icon .Icon "size-5"}}</span>
  {{end}}
  <div class="min-w-0 flex-1">
    <div class="font-medium text-slate-900">{{.Title}}</div>
    {{if .Meta}}<div class="text-sm text-slate-500">{{.Meta}}</div>{{end}}
  </div>
  {{if .Status}}<div class="shrink-0">{{.Status}}</div>{{end}}
  {{icon "chevron-right" "size-5 shrink-0 text-slate-300"}}
</div>
