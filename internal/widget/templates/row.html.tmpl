{{/* row: a compact list item — leading icon, title + meta, trailing status badge,
     and (only when the row actually opens something) a chevron. The status badge is
     pre-rendered trusted HTML. Icons come from the shared Lucide set (icons.go). */}}
<div class="flex items-center gap-3 px-1 py-2">
  {{if .Icon}}<span class="shrink-0 text-faint">{{icon .Icon "size-5"}}</span>{{end}}
  <div class="flex min-w-0 flex-1 items-baseline gap-2.5">
    <span class="truncate font-medium text-ink {{if .Columns}}w-40 shrink-0{{else}}min-w-0{{end}}">{{.Title}}</span>
    {{if .Meta}}<span class="truncate text-sm text-meta {{if .Columns}}w-32 shrink-0 font-mono tabular-nums{{else}}shrink-0{{end}}">{{.Meta}}</span>{{end}}
    {{if .Columns}}<span class="w-24 shrink-0">{{if .Tag}}<span class="{{template "verso-chip-class"}}">{{.Tag}}</span>{{end}}</span>{{else if .Tag}}<span class="shrink-0 {{template "verso-chip-class"}}">{{.Tag}}</span>{{end}}
  </div>
  {{if .Status}}<div class="shrink-0">{{.Status}}</div>{{end}}
  {{if .Chevron}}{{icon "chevron-right" "size-5 shrink-0 text-inert"}}{{end}}
</div>
