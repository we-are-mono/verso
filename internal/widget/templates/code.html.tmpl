{{/* code: a form's own footnote — the lines it will write, exactly as it will
     write them, under the file they go into. It is not documentation: someone
     who knows the config reads this to check the form said what they meant, and
     someone who does not can ignore it entirely, which is why it sits at the
     foot behind a hairline rather than beside the fields.

     The label is set in mono because it names a path, and the box keeps the
     copy control inside it, at the top right, where a terminal would put it —
     the value never reflows around it because the box scrolls rather than
     wraps. Lines stay whole: a wrapped uci line is a misread one. */}}
{{/* A live block is the form's answer to "what will this write", so it is the
     shell's to keep current: the marker below is what the form watcher finds,
     and what it replaces when the plugin has re-rendered from the values on
     screen. Everything inside it is ordinary code markup — a preview that
     styled itself differently would read as a different kind of thing. With
     nothing to read yet it is there for the watcher but hidden: an empty box
     would read as a box to fill. */}}
<div class="verso-code"{{if not (and .Live (not .Label))}} data-verso-code-divider{{end}}{{if .Live}} data-verso-preview{{if not .Value}} hidden{{end}}{{end}}>
  {{if .Lines}}
  {{/* The code block (blocks/code.css). Every token in its own ink: the
       keyword denim, a section's type amethyst, an option's name Ink, its
       value green, the quotes and a comment Meta. A line the form has
       changed is marked in the gutter by the form watcher (verso-forms.js). */}}
  <div data-verso-code-editor class="verso-code__editor">
    {{if or .Label .Copy}}
    <div data-verso-code-head class="verso-code__head">
      {{if .Label}}<span class="verso-code__path" data-verso-verbatim>{{.Label}}</span>{{end}}
      {{if .Copy}}
      <button type="button" x-data="copy" @click="run" :data-copy-failed="failed" aria-label="{{ t "Copy" }}{{with .Label}} {{.}}{{end}}" class="verso-button group/copy relative ml-auto" data-verso-size="icon">
        <span x-ref="src" class="hidden">{{.Value}}</span>
        <span x-show="idle">{{icon "copy" "size-4"}}</span>
        <span x-show="done" x-cloak class="text-green">{{icon "check" "size-4"}}</span>
        {{template "verso-copy-tip" "Copy"}}
      </button>
      {{end}}
    </div>
    {{end}}
    <div class="flex">
      <div data-verso-preview-gutter aria-hidden="true" class="verso-code__gutter" data-verso-figures{{if gt (len .Lines) 99}} data-verso-wide{{end}}>{{range .Lines}}<span data-verso-gutter-line>{{.Number}}</span>{{end}}</div>
      <div{{if .Live}} data-verso-preview-body{{end}} class="verso-code__text verso-drawer-scrollbar">{{range $i, $l := .Lines}}{{if $i}}{{"\n"}}{{end}}<span data-verso-line>{{if $l.Comment}}<span class="text-meta">{{$l.Raw}}</span>{{else if $l.Keyword}}{{$l.Indent}}<span class="text-denim-deep">{{$l.Keyword}}</span> {{if $l.Section}}<span class="text-amethyst-deep">{{$l.Key}}</span>{{else}}{{$l.Key}}{{end}}{{if $l.Quoted}} <span class="text-meta">'</span><span data-verso-value class="text-green-deep">{{$l.Value}}</span><span class="text-meta">'</span>{{else if $l.Rest}} {{$l.Rest}}{{end}}{{else}}{{$l.Raw}}{{end}}</span>{{end}}</div>
    </div>
  </div>
  {{else}}
  {{if .Label}}<span class="verso-code__path" data-verso-verbatim>{{.Label}}</span>{{end}}
  <div class="relative min-w-0">
    {{/* An opaque value — a key, a token — is one string in one box, the copy
         control inside it at the top right, where a terminal would put it. */}}
    <div{{if .Live}} data-verso-preview-body{{end}} class="verso-code__value verso-drawer-scrollbar">{{.Value}}</div>
    {{if .Copy}}
    <button type="button" x-data="copy" @click="run" :data-copy-failed="failed" aria-label="{{ t "Copy" }}{{with .Label}} {{.}}{{end}}" class="verso-button group/copy absolute top-1.5 right-1.5" data-verso-size="icon">
      <span x-ref="src" class="hidden">{{.Value}}</span>
      <span x-show="idle">{{icon "copy" "size-4"}}</span>
      <span x-show="done" x-cloak class="text-green">{{icon "check" "size-4"}}</span>
      {{template "verso-copy-tip" "Copy"}}
    </button>
    {{end}}
  </div>
  {{end}}
  {{/* What the lines do, in words: inside the block so the watcher replaces
       it with them, and the last thing over the form's act. */}}
  {{if .Says}}<p data-verso-preview-says class="verso-code__says">{{.Says}}</p>{{end}}
</div>
