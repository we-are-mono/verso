{{/* conditional: a shell-owned field-set gated by a toggle, shown via pure CSS
     (ADR-005 §7). The plugin declared only the intent; the shell owns the toggle
     and the show/hide — no JavaScript. */}}
<div class="verso-conditional space-y-4">
  <label class="flex items-center gap-2 text-sm font-medium text-verso-fg">
    <input type="checkbox" name="{{.Name}}" value="on"{{if .Checked}} checked{{end}} class="verso-conditional-toggle size-4 rounded border-verso-border text-verso-accent focus:ring-2 focus:ring-verso-accent focus:ring-offset-0">
    <span>{{.Label}}</span>
  </label>
  <div class="verso-conditional-body space-y-6">{{range .Fields}}{{.}}{{end}}</div>
</div>
