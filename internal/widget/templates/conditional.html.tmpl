{{/* conditional: shell-owned field-set branches gated by a toggle, shown via
     pure CSS (ADR-005 §7). The plugin declared only the intent; the shell owns
     the toggle and the show/hide — no JavaScript. */}}
<div class="verso-conditional space-y-4" data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="toggle">
  {{template "switch.row" .}}
  <div class="verso-conditional-body space-y-6">{{range .Fields}}{{.}}{{end}}</div>
  {{if .Otherwise}}<div class="verso-conditional-otherwise space-y-6">{{range .Otherwise}}{{.}}{{end}}</div>{{end}}
</div>
