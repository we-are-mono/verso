{{/* settings: a list of option rows — plain name, one-line description, the
     underlying option as a mono code chip, and the state on the right (a shared
     switch, value pills, or a mono read-out value). Bare hairline rows by
     default; the "card" style adds the quiet boxed frame (the same card as the
     table widget). A seam folds the long tail of options inside the same block. */}}
{{/* settings.value: an editing row's value. It is one setting's row like any
     form field's (verso-field, built in settingsItem.frame), with the
     description kept in view under it. An in-place value stages itself on
     blur or Enter and says its own refusal in the frame's band. */}}
{{define "settings.value"}}<input id="{{.Name}}" type="text" name="{{.Name}}" value="{{.Value}}"{{with .DescribedBy}} aria-describedby="{{.}}"{{end}}{{if .Inline}} data-verso-inline-input{{with .Datatype}} data-verso-datatype="{{.}}"{{end}}{{end}}{{if eq .Measure "number"}} inputmode="numeric"{{end}} class="{{template "verso-input-class"}} {{template "verso-input-border" .Inline}} tabular-nums{{if eq .Measure "number"}} w-24! max-w-full{{end}}">{{end}}
{{define "settings.row"}}
  {{if .Frame}}{{.Frame}}{{else}}
  {{/* Read-only facts and policy pills are fields on the grid: 24px of air
       (a row's 10px, condensed), the name's 20px line and the description's,
       and the hairline the line after the air under them. The pills ride
       the name's line. */}}
  <div data-verso-settings-row class="flex items-start gap-3 {{if .Condensed}}py-row{{else}}pt-6 pb-5.75{{end}} border-b border-rule last:border-b-0 last:pb-0 [&:has(+details)]:border-b-0">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <div class="text-base leading-5 font-semibold text-ink">{{.Title}}</div>
      </div>
      {{if .Desc}}<div class="text-sm leading-5 text-pretty text-body">{{.Desc}}</div>{{end}}
    </div>
    {{range .PillsHTML}}{{.}}{{end}}
    {{if .Value}}<span class="shrink-0 font-mono text-base leading-5 font-medium tabular-nums text-ink">{{.Value}}</span>{{end}}
  </div>
  {{end}}
{{end}}
{{/* bare: rows sit straight on the page, hairlines doing the separating.
     Each row brings its own air, so a section adds none above the set
     (data-verso-settings). */}}
<div data-verso-settings>
  {{/* the group label lives inside its card (same treatment as table column
       heads), so section headings above stay the only floating text. */}}
  {{/* bare groups rule off their head like a table's thead — the same hairline
       under the label; framed cards stay ruleless. */}}
  {{if .Title}}<div class="flex items-baseline justify-between gap-3 pt-1 pb-0.75 {{if not .Card}}border-b border-rule-strong {{end}}{{template "verso-kicker-class"}}">
    <span>{{.Title}}</span>
    {{if .Meta}}<span class="min-w-0 truncate text-xs font-normal normal-case text-faint">{{.Meta}}</span>{{end}}
  </div>{{end}}
  {{range .Items}}{{template "settings.row" .}}{{end}}
  {{if .SeamSummary}}
  <details class="border-t border-rule">
    {{/* the chevron sits with the label (an orphaned right-edge chevron fades)
         and the pair wears the action colour, so the fold reads as a place to
         go without button chrome. */}}
    <summary class="flex cursor-pointer items-center gap-1.5 px-3 py-3 text-sm font-semibold text-denim-deep transition-colors select-none hover:bg-quiet hover:text-denim [&::-webkit-details-marker]:hidden">
      {{icon "chevron-right" "verso-chevron size-4"}}
      {{.SeamSummary}}
    </summary>
    <div class="pb-1">
      {{range .SeamItems}}{{template "settings.row" .}}{{end}}
    </div>
  </details>
  {{end}}
</div>
