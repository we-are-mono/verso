{{/* list: repeating inputs sharing one name (multi-value) + one blank add-slot.
     The token style carries the same POST shape in a compact editor for lists
     such as ports, CIDRs and ICMP types. */}}
<fieldset class="space-y-1.5" data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="list">
  <legend class="block text-sm font-medium text-slate-900">{{.Label}}</legend>
  {{if eq .Style "tokens"}}
  <div data-verso-token-list data-verso-token-name="{{.Name}}" class="flex min-h-10 flex-wrap items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2 py-1.5 inset-shadow-sm focus-within:border-sky-600 focus-within:ring-2 focus-within:ring-sky-600/20 dark:border-gray-700 dark:bg-gray-900 dark:focus-within:border-sky-400 dark:focus-within:ring-sky-400/50">
    {{range .Items}}
    <span data-verso-token class="inline-flex items-center gap-1 rounded-md bg-slate-100 py-1 pr-1 pl-2 font-mono text-sm font-semibold text-slate-700 dark:bg-gray-700 dark:text-gray-200">
      <input type="hidden" name="{{$.Name}}" value="{{.}}"><span>{{.}}</span>
      <button type="button" data-verso-token-remove aria-label="Remove {{.}}" class="grid size-5 place-items-center rounded text-slate-400 transition-colors hover:bg-slate-200 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 dark:hover:bg-gray-600 dark:hover:text-gray-100">{{icon "x" "size-3.5"}}</button>
    </span>
    {{end}}
    <input data-verso-token-input type="text"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} placeholder="{{if .Prompt}}{{.Prompt}}{{else}}Add…{{end}}" class="min-w-32 flex-1 border-0 bg-transparent px-1 py-1 text-sm text-slate-900 shadow-none outline-none focus:ring-0 dark:text-gray-100">
  </div>
  {{else}}
  <div class="space-y-2">
    {{range $i, $item := .Items}}
    <div class="space-y-1.5">
      <input name="{{$.Name}}" value="{{$item}}" type="text"{{if $.Datatype}} data-datatype="{{$.Datatype}}"{{end}} class="w-full rounded-md border {{with index $.Errors (printf "%d" $i)}}border-red-600 focus:border-red-600 focus:ring-2 focus:ring-red-600/20 dark:border-red-400 dark:focus:border-red-400 dark:focus:ring-red-400/50{{else}}border-slate-300 focus:border-sky-600 focus:ring-2 focus:ring-sky-600/20 dark:focus:border-sky-400 dark:focus:ring-sky-400/50{{end}} bg-white px-3 py-2 inset-shadow-sm text-sm text-slate-900 focus:outline-none">
      {{with index $.Errors (printf "%d" $i)}}<p class="text-sm text-red-600 dark:text-red-400">{{.}}</p>{{end}}
    </div>
    {{end}}
    <input name="{{.Name}}" value="" type="text" placeholder="Add…"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="w-full rounded-md border border-slate-300 bg-white px-3 py-2 inset-shadow-sm text-sm text-slate-900 focus:border-sky-600 focus:ring-2 focus:ring-sky-600/20 focus:outline-none dark:focus:border-sky-400 dark:focus:ring-sky-400/50">
  </div>
  {{end}}
  {{if .Help}}<p class="mt-1.5 text-sm text-slate-500">{{.Help}}</p>{{end}}
</fieldset>
