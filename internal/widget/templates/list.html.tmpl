{{/* list: repeating inputs sharing one name (multi-value) + one blank add-slot.
     The token style carries the same POST shape in a compact editor for lists
     such as ports, CIDRs and ICMP types. */}}
{{/* A list is one setting: its label sits above the whole measured editor,
     including its values, removals and Add control. The frame (verso-field)
     draws the row; list.control is the editor inside it. */}}
{{define "list.control"}}
  {{if eq .Style "rows"}}
  {{/* The list block (blocks/list.css). The add box stands under the last
       row — while the set is empty, straight under the label, or beside it
       centred on the name's line as any control is. A value that has to
       wrap wraps after its own separators (Breakable), and anywhere only
       where one part alone outgrows the column. */}}
  <div class="verso-list" data-verso-list>
    <div data-verso-list-items class="verso-list__items">
    {{range $i, $item := .Items}}<div data-verso-list-row class="verso-list__row">
      <input type="hidden" name="{{$.Name}}" value="{{$item}}">{{template "list.packet"}}<span data-verso-list-value class="verso-list__value" data-verso-verbatim>{{breakable $item}}</span>
      <button type="button" data-verso-list-remove title="{{t "Remove"}}" aria-label="{{t "Remove"}}" class="verso-button -my-1" data-verso-size="icon">{{icon "x" "size-4"}}</button>
      {{with index $.Errors (printf "%d" $i)}}<span data-verso-error class="{{template "verso-error-line"}}">{{template "verso-error-words" .}}</span>{{end}}
    </div>{{end}}
    </div>
    <template><div data-verso-list-row class="verso-list__row"><input type="hidden" name="{{.Name}}">{{template "list.packet"}}<span data-verso-list-value class="verso-list__value" data-verso-verbatim></span><button type="button" data-verso-list-remove title="{{t "Remove"}}" aria-label="{{t "Remove"}}" class="verso-button -my-1" data-verso-size="icon">{{icon "x" "size-4"}}</button></div></template>
    <div class="flex items-center gap-2"><input id="{{.Name}}"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Described}} aria-describedby="{{.Name}}-desc"{{end}} data-verso-list-input {{if .Datatype}}data-datatype="{{.Datatype}}"{{end}} placeholder="{{if .Prompt}}{{.Prompt}}{{else}}{{t "Add…"}}{{end}}" class="verso-input min-w-0" data-verso-verbatim><button type="button" data-verso-list-add class="verso-button" data-verso-style="secondary">{{t "Add"}}</button></div>
  </div>
  {{else if eq .Style "tokens"}}
  {{/* The box is a field, and each value inside it is a chip — the same chip a
       value wears anywhere else, with the one thing added that only an editable
       value has: a way to take it out again. */}}
  {{/* The 24px chips sit 4px inside the box's edge on every side (3px and
       the border's pixel) and 4px apart, so each stands on the box's white
       rather than crowding its edge, and the box is a field's 32px. Wrapped
       rows of chips stand 16px apart, so each row adds 40px and the box stays
       on the grid. The value being typed stands at the same height as the
       chips it is about to join. */}}
  <div data-verso-token-list class="verso-tokens">
    {{range .Items}}
    <span data-verso-token class="verso-tokens__chip" data-verso-verbatim>
      <input type="hidden" name="{{$.Name}}" value="{{.}}"><span data-verso-token-label>{{.}}</span>
      <button type="button" data-verso-token-remove aria-label="{{ t "Remove" }} {{.}}" class="verso-button verso-tokens__remove" data-verso-size="glyph">{{icon "x" "size-3"}}</button>
    </span>
    {{end}}
    <input id="{{.Name}}"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Described}} aria-describedby="{{.Name}}-desc"{{end}} data-verso-token-input type="text"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}}{{if .Options}} role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="{{.Name}}-options"{{end}} autocomplete="off" placeholder="{{if .Prompt}}{{.Prompt}}{{else}}{{ t "Add…" }}{{end}}" class="verso-tokens__input" data-verso-verbatim>
  </div>
  {{/* The empty chip the shell clones when a value is typed in. A value the
       plugin sent and a value added here are one kind of thing, so there is one
       chip rather than the same markup written twice — once here and once in the
       script, where the two drifted apart the moment either was touched. */}}
  <template data-verso-token-chip>
    <span data-verso-token class="verso-tokens__chip" data-verso-verbatim>
      <input type="hidden" name="{{.Name}}" value=""><span data-verso-token-label></span>
      <button type="button" data-verso-token-remove class="verso-button verso-tokens__remove" data-verso-size="glyph">{{icon "x" "size-3"}}</button>
    </span>
  </template>
  {{/* The values worth offering, under the box. They are a reminder rather than
       a menu: the box still takes anything the daemon reads, so the list narrows
       as it is typed into and simply goes away when nothing matches. Several can
       be taken — picking one leaves the box open for the next. */}}
  {{if .Options}}
  {{/* A listbox the box drives: the arrow keys move through what is showing
       and Enter takes it, while focus stays in the box being typed into. The
       options are out of the tab order for the same reason. */}}
  <div id="{{.Name}}-options" data-verso-token-menu role="listbox"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}} hidden class="verso-menu verso-drawer-scrollbar" data-verso-menu-width="field">
    {{range $i, $o := .Options}}
    <button type="button" id="{{$.Name}}-option-{{$i}}" role="option" aria-selected="false" tabindex="-1" data-verso-token-option="{{$o.Value}}" class="verso-menu__option" data-verso-verbatim>{{.Label}}</button>
    {{end}}
  </div>
  {{end}}
  {{else}}
  <div class="space-y-2">
    {{/* Every box is one value of the setting the row's label names, so each is
         named by that label; the refused one also points at why. The label's
         own for goes to the empty box, where a click means "add one". */}}
    {{range $i, $item := .Items}}
    <div class="space-y-1">
      {{$err := index $.Errors (printf "%d" $i)}}
      <input name="{{$.Name}}" value="{{$item}}" type="text" aria-labelledby="{{$.Name}}-label"{{if $err}} aria-invalid="true" aria-describedby="{{$.Name}}-error-{{$i}}"{{end}}{{if $.Datatype}} data-datatype="{{$.Datatype}}"{{end}} class="verso-input" data-verso-verbatim>
      {{with $err}}<p id="{{$.Name}}-error-{{$i}}" data-verso-error class="{{template "verso-refusal-band"}}">{{template "verso-error-words" .}}</p>{{end}}
    </div>
    {{end}}
    <input id="{{.Name}}" name="{{.Name}}" value="" type="text"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Described}} aria-describedby="{{.Name}}-desc"{{end}} placeholder="{{ t "Add…" }}"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="verso-input" data-verso-verbatim>
  </div>
  {{end}}
  {{/* The explanation is raised onto the label, as every other row's is. */}}
{{end}}
{{/* A value row's packet, shared by the rows drawn and the one the shell
     clones. */}}
{{define "list.packet"}}<span aria-hidden="true" class="verso-mark mt-2.25" data-verso-tone="meta"></span>{{end}}
