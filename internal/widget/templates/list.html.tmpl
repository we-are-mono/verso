{{/* list: repeating inputs sharing one name (multi-value) + one blank add-slot.
     The token style carries the same POST shape in a compact editor for lists
     such as ports, CIDRs and ICMP types. */}}
{{/* A list of values is one setting, so it is the form's one row: the same
     measure, the same label column with the option it writes beside it, the same
     fixed control column. It used to draw its own fieldset and legend, which put
     its label above the box while every other row put it beside — one row in a
     form that did not line up with the rest of the form. */}}
<div class="{{template "verso-field-row-class"}}" data-verso-change-field data-verso-change-name="{{.Name}}" data-verso-change-label="{{.Label}}" data-verso-change-kind="list">
  {{template "verso-field-label" .LabelView}}
  <div data-verso-control class="{{template "verso-field-control-class"}} relative">
  {{if eq .Style "rows"}}
  <div data-verso-list>
    <div data-verso-list-items>
    {{range $i, $item := .Items}}<div data-verso-list-row class="flex min-h-8 items-center justify-between gap-3 border-b border-rule last:border-b-0">
      <input type="hidden" name="{{$.Name}}" value="{{$item}}"><span data-verso-list-value class="break-all font-mono text-base font-medium text-ink">{{$item}}</span>
      <button type="button" data-verso-list-remove title="{{t "Remove"}}" aria-label="{{t "Remove"}}" class="grid size-6 shrink-0 cursor-pointer place-items-center rounded-xs text-faint hover:bg-mid hover:text-ink">{{icon "x" "size-3.5"}}</button>
      {{with index $.Errors (printf "%d" $i)}}<span class="text-sm text-crimson-deep">{{.}}</span>{{end}}
    </div>{{end}}
    </div>
    <template><div data-verso-list-row class="flex min-h-8 items-center justify-between gap-3 border-b border-rule last:border-b-0"><input type="hidden" name="{{.Name}}"><span data-verso-list-value class="break-all font-mono text-base font-medium text-ink"></span><button type="button" data-verso-list-remove title="{{t "Remove"}}" aria-label="{{t "Remove"}}" class="grid size-6 shrink-0 cursor-pointer place-items-center rounded-xs text-faint hover:bg-mid hover:text-ink">{{icon "x" "size-3.5"}}</button></div></template>
    <div class="mt-2 flex items-center gap-2"><input id="{{.Name}}"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Explained}} aria-describedby="{{.Name}}-tip"{{end}} data-verso-list-input {{if .Datatype}}data-datatype="{{.Datatype}}"{{end}} placeholder="{{if .Prompt}}{{.Prompt}}{{else}}{{t "Add…"}}{{end}}" class="{{template "verso-input-class"}} {{template "verso-input-border" ""}} min-w-0"><button type="button" data-verso-list-add class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}}">{{t "Add"}}</button></div>
  </div>
  {{else if eq .Style "tokens"}}
  {{/* The box is a field, and each value inside it is a chip — the same chip a
       value wears anywhere else, with the one thing added that only an editable
       value has: a way to take it out again. */}}
  {{/* The chips sit 2px inside the box on every side, so the box reads as their
       ground rather than as a frame standing off from them. The value being typed
       stands at the same height as the chips it is about to join. */}}
  <div data-verso-token-list class="flex min-h-9 flex-wrap items-center gap-1 rounded-xs border border-rule-strong bg-ground p-0.5 transition-colors hover:border-denim focus-within:border-denim-deep">
    {{range .Items}}
    <span data-verso-token class="{{template "verso-token-chip"}}">
      <input type="hidden" name="{{$.Name}}" value="{{.}}"><span data-verso-token-label>{{.}}</span>
      <button type="button" data-verso-token-remove aria-label="{{ t "Remove" }} {{.}}" class="{{template "verso-token-chip-remove"}}">{{icon "x" "size-3"}}</button>
    </span>
    {{end}}
    <input id="{{.Name}}"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Explained}} aria-describedby="{{.Name}}-tip"{{end}} data-verso-token-input type="text"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}}{{if .Options}} role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="{{.Name}}-options"{{end}} autocomplete="off" placeholder="{{if .Prompt}}{{.Prompt}}{{else}}{{ t "Add…" }}{{end}}" class="h-7.5 min-w-18 flex-1 border-0 bg-transparent px-1.5 font-mono text-base font-medium text-ink outline-none placeholder:font-sans placeholder:text-sm placeholder:text-faint">
  </div>
  {{/* The empty chip the shell clones when a value is typed in. A value the
       plugin sent and a value added here are one kind of thing, so there is one
       chip rather than the same markup written twice — once here and once in the
       script, where the two drifted apart the moment either was touched. */}}
  <template data-verso-token-chip>
    <span data-verso-token class="{{template "verso-token-chip"}}">
      <input type="hidden" name="{{.Name}}" value=""><span data-verso-token-label></span>
      <button type="button" data-verso-token-remove class="{{template "verso-token-chip-remove"}}">{{icon "x" "size-3"}}</button>
    </span>
  </template>
  {{/* The values worth offering, under the box. They are a reminder rather than
       a menu: the box still takes anything the daemon reads, so the list narrows
       as it is typed into and simply goes away when nothing matches. Several can
       be taken — picking one leaves the box open for the next. */}}
  {{if .Options}}
  {{/* A listbox the box drives: the arrow keys move through what is showing
       and Enter takes it, while focus stays in the box being typed into. The
       options are out of the tab order for the same reason. */}}
  <div id="{{.Name}}-options" data-verso-token-menu role="listbox"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}} hidden class="verso-drawer-scrollbar absolute top-full right-0 left-0 z-20 mt-1 max-h-56 overflow-y-auto rounded-xs border border-rule-strong bg-ground py-1 shadow-[0_4px_12px_rgba(27,25,23,.14)]">
    {{range $i, $o := .Options}}
    <button type="button" id="{{$.Name}}-option-{{$i}}" role="option" aria-selected="false" tabindex="-1" data-verso-token-option="{{$o.Value}}" class="flex w-full cursor-pointer items-center gap-2 px-3 py-1.5 text-left font-mono text-base font-medium text-ink transition-colors hover:bg-denim-soft hover:text-denim-deep aria-selected:bg-denim-soft aria-selected:text-denim-deep">{{.Label}}</button>
    {{end}}
  </div>
  {{end}}
  {{else}}
  <div class="space-y-2">
    {{/* Every box is one value of the setting the row's label names, so each is
         named by that label; the refused one also points at why. The label's
         own for goes to the empty box, where a click means "add one". */}}
    {{range $i, $item := .Items}}
    <div class="space-y-1.5">
      {{$err := index $.Errors (printf "%d" $i)}}
      <input name="{{$.Name}}" value="{{$item}}" type="text" aria-labelledby="{{$.Name}}-label"{{if $err}} aria-invalid="true" aria-describedby="{{$.Name}}-error-{{$i}}"{{end}}{{if $.Datatype}} data-datatype="{{$.Datatype}}"{{end}} class="{{template "verso-input-class"}} {{template "verso-input-border" $err}}">
      {{with $err}}<p id="{{$.Name}}-error-{{$i}}" class="text-sm text-crimson-deep">{{.}}</p>{{end}}
    </div>
    {{end}}
    <input id="{{.Name}}" name="{{.Name}}" value="" type="text"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Explained}} aria-describedby="{{.Name}}-tip"{{end}} placeholder="{{ t "Add…" }}"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="{{template "verso-input-class"}} {{template "verso-input-border" ""}}">
  </div>
  {{end}}
  {{/* The explanation is raised onto the label, as every other row's is. */}}
  </div>
  {{/* The remove lane, matching a field's exactly so a set of rows mixing the
       two still begins and ends its controls in the same places. */}}
  {{if .Lane}}
  {{if .Removable}}{{template "verso-row-remove" .}}{{else}}<span class="size-7 flex-none" aria-hidden="true"></span>{{end}}
  {{end}}
</div>
