{{/* list: repeating inputs sharing one name (multi-value) + one blank add-slot.
     The token style carries the same POST shape in a compact editor for lists
     such as ports, CIDRs and ICMP types. */}}
{{/* A list is one setting: its label sits above the whole measured editor,
     including its values, removals and Add control. The frame (verso-field)
     draws the row; list.control is the editor inside it. */}}
{{define "list.control"}}
  {{if eq .Style "rows"}}
  {{/* Each value is a row, and a row's height is its line and its padding: the
       28px remove with 8px either side, 44px, a hairline above each value.
       The set holds the 8px that, with the
       last row's own, stands the add box 16px under the last remove — and holds
       none while it is empty, so the add box sits directly below the label.
       A value that has to wrap wraps after its own separators (Breakable),
       and anywhere only where one part alone outgrows the column; its remove
       hangs from its first line (2px above the value centres that 24px line
       on the 28px remove). */}}
  <div data-verso-list>
    <div data-verso-list-items class="has-[>*]:pb-2">
    {{range $i, $item := .Items}}<div data-verso-list-row class="flex items-start justify-between gap-3 border-t border-rule py-2">
      <input type="hidden" name="{{$.Name}}" value="{{$item}}"><span data-verso-list-value class="min-w-0 pt-0.5 wrap-anywhere font-mono text-base font-medium text-ink">{{breakable $item}}</span>
      <button type="button" data-verso-list-remove title="{{t "Remove"}}" aria-label="{{t "Remove"}}" class="grid {{template "verso-btn-icon"}}">{{icon "x" "size-4"}}</button>
      {{with index $.Errors (printf "%d" $i)}}<span data-verso-error class="{{template "verso-error-line"}}">{{template "verso-error-words" .}}</span>{{end}}
    </div>{{end}}
    </div>
    <template><div data-verso-list-row class="flex items-start justify-between gap-3 border-t border-rule py-2"><input type="hidden" name="{{.Name}}"><span data-verso-list-value class="min-w-0 pt-0.5 wrap-anywhere font-mono text-base font-medium text-ink"></span><button type="button" data-verso-list-remove title="{{t "Remove"}}" aria-label="{{t "Remove"}}" class="grid {{template "verso-btn-icon"}}">{{icon "x" "size-4"}}</button></div></template>
    <div class="flex items-center gap-2"><input id="{{.Name}}"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Explained}} aria-describedby="{{.Name}}-tip"{{end}} data-verso-list-input {{if .Datatype}}data-datatype="{{.Datatype}}"{{end}} placeholder="{{if .Prompt}}{{.Prompt}}{{else}}{{t "Add…"}}{{end}}" class="{{template "verso-input-class"}} {{template "verso-input-border" ""}} min-w-0"><button type="button" data-verso-list-add class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}}">{{t "Add"}}</button></div>
  </div>
  {{else if eq .Style "tokens"}}
  {{/* The box is a field, and each value inside it is a chip — the same chip a
       value wears anywhere else, with the one thing added that only an editable
       value has: a way to take it out again. */}}
  {{/* The chips sit 4px inside the box on every side and 4px apart, so each
       stands on the box's white rather than crowding its edge, and the box keeps
       a field's 36px. The value being typed stands at the same height as the
       chips it is about to join. */}}
  <div data-verso-token-list class="flex min-h-9 flex-wrap items-center gap-1 rounded-xs border border-rule-strong {{template "verso-input-fill"}} p-1 transition-colors hover:not-focus-within:border-faint focus-within:border-denim">
    {{range .Items}}
    <span data-verso-token class="{{template "verso-token-chip"}}">
      <input type="hidden" name="{{$.Name}}" value="{{.}}"><span data-verso-token-label>{{.}}</span>
      <button type="button" data-verso-token-remove aria-label="{{ t "Remove" }} {{.}}" class="{{template "verso-token-chip-remove"}}">{{icon "x" "size-3"}}</button>
    </span>
    {{end}}
    <input id="{{.Name}}"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Explained}} aria-describedby="{{.Name}}-tip"{{end}} data-verso-token-input type="text"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}}{{if .Options}} role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="{{.Name}}-options"{{end}} autocomplete="off" placeholder="{{if .Prompt}}{{.Prompt}}{{else}}{{ t "Add…" }}{{end}}" class="h-6.5 min-w-18 flex-1 border-0 bg-transparent px-1.5 font-mono text-base font-normal text-ink outline-none placeholder:font-sans placeholder:text-sm placeholder:font-normal placeholder:text-meta">
  </div>
  {{/* The empty chip the shell clones when a value is typed in. A value the
       plugin sent and a value added here are one kind of thing, so there is one
       chip rather than the same markup written twice — once here and once in the
       script, where the two drifted apart the moment either was touched. */}}
  <template data-verso-token-chip>
    <span data-verso-token class="{{template "verso-token-chip"}}">
      <input type="hidden" name="{{.Name}}" value=""><span data-verso-token-label></span>
      <button type="button" data-verso-token-remove class="{{template "verso-token-chip-remove"}}">{{icon "x" "size-3"}}</button>
    </span>
  </template>
  {{/* The values worth offering, under the box. They are a reminder rather than
       a menu: the box still takes anything the daemon reads, so the list narrows
       as it is typed into and simply goes away when nothing matches. Several can
       be taken — picking one leaves the box open for the next. */}}
  {{if .Options}}
  {{/* A listbox the box drives: the arrow keys move through what is showing
       and Enter takes it, while focus stays in the box being typed into. The
       options are out of the tab order for the same reason. */}}
  <div id="{{.Name}}-options" data-verso-token-menu role="listbox"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}} hidden class="verso-drawer-scrollbar absolute top-full right-0 left-0 z-20 mt-1 max-h-56 overflow-y-auto rounded-xs border border-rule-strong bg-ground py-1 shadow-[0_4px_12px_rgba(27,25,23,.14)]">
    {{range $i, $o := .Options}}
    <button type="button" id="{{$.Name}}-option-{{$i}}" role="option" aria-selected="false" tabindex="-1" data-verso-token-option="{{$o.Value}}" class="flex w-full cursor-pointer items-center gap-2 px-3 py-1.5 text-left font-mono text-base font-medium text-ink transition-colors hover:bg-denim-soft hover:text-denim-deep aria-selected:bg-denim-soft aria-selected:text-denim-deep">{{.Label}}</button>
    {{end}}
  </div>
  {{end}}
  {{else}}
  <div class="space-y-2">
    {{/* Every box is one value of the setting the row's label names, so each is
         named by that label; the refused one also points at why. The label's
         own for goes to the empty box, where a click means "add one". */}}
    {{range $i, $item := .Items}}
    <div class="space-y-1.5">
      {{$err := index $.Errors (printf "%d" $i)}}
      <input name="{{$.Name}}" value="{{$item}}" type="text" aria-labelledby="{{$.Name}}-label"{{if $err}} aria-invalid="true" aria-describedby="{{$.Name}}-error-{{$i}}"{{end}}{{if $.Datatype}} data-datatype="{{$.Datatype}}"{{end}} class="{{template "verso-input-class"}} {{template "verso-input-border" $err}}">
      {{with $err}}<p id="{{$.Name}}-error-{{$i}}" data-verso-error class="{{template "verso-refusal-band"}}">{{template "verso-error-words" .}}</p>{{end}}
    </div>
    {{end}}
    <input id="{{.Name}}" name="{{.Name}}" value="" type="text"{{if .Label}} aria-labelledby="{{.Name}}-label"{{end}}{{if .Explained}} aria-describedby="{{.Name}}-tip"{{end}} placeholder="{{ t "Add…" }}"{{if .Datatype}} data-datatype="{{.Datatype}}"{{end}} class="{{template "verso-input-class"}} {{template "verso-input-border" ""}}">
  </div>
  {{end}}
  {{/* The explanation is raised onto the label, as every other row's is. */}}
{{end}}
