{{/* card: a titled container that nests other widgets. The title and its optional
     subtitle form a header block that floats above the content — no divider rule; the
     box does the grouping. The subtitle sits tight under the title, with a line of
     space below the block so it never crowds the content. */}}
{{/* the hairline frame shared with settings/table cards — a card is a
     deliberate object on the flat page, no shadow. */}}
<section class="{{template "verso-card-frame"}} p-6">
  {{if or .Title .Subtitle}}
  <div class="{{if .Subtitle}}mb-8{{else}}mb-4{{end}}">
    {{if .Title}}<h3 class="text-base font-medium text-slate-900">{{.Title}}</h3>{{end}}
    {{if .Subtitle}}<p class="mt-1 text-sm text-slate-500">{{.Subtitle}}</p>{{end}}
  </div>
  {{end}}
  <div class="space-y-4">{{range .Children}}{{.}}{{end}}</div>
</section>
