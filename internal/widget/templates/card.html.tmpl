{{/* Legacy groups are sections. A frame is reserved for a stored artifact. */}}
<section{{if eq .Style "artifact"}} class="rounded-xs border border-rule bg-quiet px-5 py-4"{{end}}>
  {{if or .Title .Subtitle}}<div class="{{if eq .Style "preview"}}mt-8 mb-2{{else}}mb-5{{end}}">
    {{if .Title}}<h3 class="{{if eq .Style "preview"}}text-sm font-semibold{{else}}text-lg font-semibold tracking-tight{{end}} text-ink">{{.Title}}</h3>{{end}}
    {{if .Subtitle}}<p class="mt-1 text-sm leading-snug text-body">{{.Subtitle}}</p>{{end}}
  </div>{{end}}
  <div class="space-y-5">{{range .Children}}{{.}}{{end}}</div>
</section>
