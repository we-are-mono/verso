{{/* Legacy groups are sections. A frame is reserved for a stored artifact.
     Inside it every word stands 17px from the line above and below it — a
     row's 10px plus the 7px of air its 24px line keeps over its capitals and
     under its baseline — and the frame's top and bottom edges are lines like
     any other, so the frame adds nothing to them. At the sides it holds the
     words 20px in. */}}
<section{{if eq .Style "artifact"}} class="rounded-xs border border-rule bg-quiet px-5"{{end}}>
  {{if eq .Style "artifact"}}
  {{/* A stored document says what it is before its facts do: the name over a
       sentence of what it is for, closed off from the facts by the strong
       hairline a column head sits on. It opens 20px under the frame's top
       edge, as the sides hold the words 20px in (the title's capitals sit 6px
       into its 24px line, so 14px above it), and closes on the rows' 17px,
       the sentence on the rows' own 24px line. */}}
  {{if .Title}}<div class="border-b border-rule-strong pt-3.5 pb-2.5">
    <h3 class="text-base leading-6 font-semibold text-ink">{{.Title}}</h3>
    {{if .Subtitle}}<p class="text-sm leading-6 text-body">{{.Subtitle}}</p>{{end}}
  </div>{{end}}
  {{else if or .Title .Subtitle}}<div class="{{if eq .Style "preview"}}mt-8 mb-2{{else}}mb-5{{end}}">
    {{if .Title}}<h3 class="{{if eq .Style "preview"}}text-sm font-semibold{{else}}verso-section-heading text-lg font-semibold tracking-tight{{end}} text-ink">{{.Title}}</h3>{{end}}
    {{if .Subtitle}}<p class="mt-1 text-sm leading-snug text-body">{{.Subtitle}}</p>{{end}}
  </div>{{end}}
  <div class="space-y-5">{{range .Children}}{{.}}{{end}}</div>
</section>
