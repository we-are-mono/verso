{{/* Header and body are shared by the interactive overlay and the in-flow
     styleguide preview, so visual iteration cannot drift from the real modal. */}}
{{define "modal.standard.contents"}}
<header class="flex items-center justify-between px-5 pt-4 pb-2">
  <h3 class="text-base font-medium text-slate-900">{{.Title}}</h3>
  <button type="button"{{if not .Preview}} @click="hide"{{end}} aria-label="{{ t "Close" }}"
    class="rounded p-1 text-slate-400 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600">
    {{icon "x" "size-5"}}
  </button>
</header>
<div class="space-y-4 px-5 pt-2.5 pb-5">
  {{if .BusyTitle}}<div x-show="idle" class="space-y-4">{{range .Children}}{{.}}{{end}}</div>
  <div x-show="busy" x-cloak class="py-6">{{template "modal.busy" .}}</div>
  {{else}}{{range .Children}}{{.}}{{end}}{{end}}
</div>
{{end}}
{{define "modal.busy"}}
<div class="text-center">
  <span class="mx-auto grid size-12 place-items-center text-sky-600">{{icon "loader-circle" "size-9 animate-spin"}}</span>
  <h4 class="mt-4 text-base font-medium text-slate-900">{{.BusyTitle}}</h4>
  {{if .BusyBody}}<p class="mx-auto mt-2 max-w-sm text-sm text-slate-500">{{.BusyBody}}</p>{{end}}
</div>
{{end}}
{{define "modal.contents"}}{{template "modal.standard.contents" .}}{{end}}
{{/* modal: shell-owned Alpine dialog (CSP build). The plugin declares the intent;
     verso.js owns open/close/focus. Preview renders the same window in normal flow. */}}
{{if .Preview}}
<div class="flex items-start justify-center">
  <div class="relative w-full max-w-md rounded-lg border border-slate-200 bg-white shadow-xl">
    {{template "modal.contents" .}}
  </div>
</div>
{{else}}
<div x-data="modal" data-open="{{if .Open}}true{{else}}false{{end}}">
  {{if eq .TriggerStyle "add"}}
  {{/* "add" affordance: a full-width dashed button that invites creating a new item. */}}
  <button type="button" @click="show"
    class="flex w-full items-center justify-center gap-2 rounded-xl border-2 border-dashed border-slate-300 px-4 py-4 text-sm font-semibold text-sky-600 transition-colors hover:border-sky-400 hover:bg-sky-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2">
    {{icon "plus" "size-5"}}
    {{.Trigger}}
  </button>
  {{else}}
  <button type="button" @click="show"
    class="inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 {{if eq .TriggerStyle "secondary"}}border {{template "verso-btn-secondary"}}{{else}}{{template "verso-btn-primary"}}{{end}}">
    {{if .TriggerIcon}}{{icon .TriggerIcon "size-4"}}{{end}}{{.Trigger}}
  </button>
  {{end}}
  <template x-teleport="body">
    <div x-show="open" x-cloak @keydown.window="onKeydown" class="fixed inset-0 z-50 flex items-center justify-center p-4">
      {{template "verso-overlay-backdrop"}}
      <div x-show="open" x-transition @input="markDirty" @change="markDirty"{{if .BusyTitle}} @submit="startBusy"{{end}} x-ref="dialog" tabindex="-1" role="dialog" aria-modal="true"
        class="relative w-full max-w-md rounded-lg border border-slate-200 bg-white shadow-xl focus:outline-none">
        {{template "modal.contents" .}}
      </div>
    </div>
  </template>
</div>
{{end}}
