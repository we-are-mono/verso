{{/* link: a labelled hyperlink, optionally a download, in one of a few styles. */}}
{{if eq .Style "button"}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}} class="inline-flex items-center justify-center gap-2 rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-sky-700 dark:bg-sky-700 dark:text-gray-100 dark:hover:bg-sky-800 dark:active:bg-sky-900">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{else if eq .Style "ghost"}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}} class="inline-flex items-center justify-center gap-2 rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-slate-400 dark:border-gray-700 dark:bg-transparent dark:text-gray-300 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:active:bg-gray-900">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{else}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}} class="inline-flex items-center gap-1.5 text-sm font-medium text-sky-600 underline underline-offset-2 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{end}}
