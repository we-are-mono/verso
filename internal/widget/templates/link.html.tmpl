{{/* link: a labelled hyperlink, optionally a download, in one of a few styles. */}}
{{/* a link wearing a button's clothes is the same button: one height, one radius,
     one border — stated in the same place the form's own buttons take theirs. */}}
{{if eq .Style "status"}}
{{/* A status among settings follows the shared row: fact and explanation,
     then the field-height quiet action directly below them. An
     act on a thing of its own (a package) opens that thing's drawer over the
     page; the page keeps its address, since the drawer is not a place on it. */}}
<div class="{{template "verso-field-row-class"}}">
  <div class="flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-1">
    <span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] border border-faint"></span>
    <span class="text-sm font-semibold text-ink">{{.Label}}</span>
    {{if .Desc}}<p class="basis-full text-sm leading-[1.45] text-body">{{.Desc}}</p>{{end}}
  </div>
  <div class="{{template "verso-field-control-class"}} items-start">
    {{if .Panel}}<span x-data="modal" class="contents">{{end}}
    <a href="{{.Href}}"{{if .Panel}} @click.prevent="showPanel" data-verso-panel-chrome{{end}} class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{if .Icon}}{{icon .Icon "size-4 shrink-0"}}{{end}}{{.Act}}</a>
    {{if .Panel}}{{template "verso-drawer-fetched" ""}}</span>{{end}}
  </div>
</div>
{{else if eq .Style "choice"}}
<a href="{{.Href}}" class="group flex items-start gap-3.5 border-b border-rule px-8 py-4 text-ink transition-colors hover:bg-quiet focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim">
  {{if .Icon}}<span class="mt-0.5 shrink-0 text-glyph">{{icon .Icon "size-4"}}</span>{{end}}
  <span class="min-w-0 flex-1"><span class="flex flex-wrap items-baseline gap-2 text-sm"><span class="font-semibold">{{.Label}}</span>{{if .Code}}<span class="{{template "verso-chip-class"}}">{{.Code}}</span>{{end}}</span>
  {{if .Desc}}<span class="mt-1 block text-sm leading-relaxed text-body">{{.Desc}}</span>{{end}}</span>
  <span class="mt-0.5 shrink-0 text-faint group-hover:text-denim">{{icon "chevron-right" "size-4"}}</span>
</a>
{{else if eq .Style "button"}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}}{{if .NewTab}} target="_blank" rel="noopener noreferrer"{{end}} class="{{template "verso-btn-box"}} {{template "verso-btn-primary"}} focus-visible:outline-denim-deep">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{else if eq .Style "ghost"}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}}{{if .NewTab}} target="_blank" rel="noopener noreferrer"{{end}} class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{else if eq .Style "rail"}}
{{/* One place on this page, in the list of them. It is a block so a run of them
     is a column, and it carries its own left hairline so the run draws one
     continuous line without a container having to know it is a rail. Which one
     you are reading is the shell's to say — it marks this link aria-current, and
     verso.css draws the bar. */}}
{{/* The colour is the named rule's, not a utility's: resting, hovered and current
     are one set of three states, and a utility for any of them would beat the
     rule that draws the other two — the utility layer wins the cascade whatever
     the specificity. */}}
<a href="{{.Href}}" data-verso-rail-link class="verso-rail-link flex items-center gap-1.5 border-l border-rule py-1.5 pl-4 text-sm transition-colors">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{else if eq .Style "act"}}
{{/* act: an act on a part of a section, in the subsection act's one dress. One
     that makes or replaces the thing it stands under opens its form in a drawer
     over the page, which keeps its address. */}}
{{if .Panel}}<span x-data="modal" class="contents">
<a href="{{.Href}}" @click.prevent="showPanel" data-verso-panel-chrome class="{{template "verso-btn-act"}} {{if .Icon}}pl-2 pr-2.5{{else}}px-2.5{{end}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{template "verso-drawer-fetched" ""}}</span>
{{else}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}}{{if .NewTab}} target="_blank" rel="noopener noreferrer"{{end}} class="{{template "verso-btn-act"}} {{if .Icon}}pl-2 pr-2.5{{else}}px-2.5{{end}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{end}}
{{else if eq .Style "secondary"}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}}{{if .NewTab}} target="_blank" rel="noopener noreferrer"{{end}} class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{else}}
<a href="{{.Href}}"{{if .Download}} download="{{.Download}}"{{end}}{{if .NewTab}} target="_blank" rel="noopener noreferrer"{{end}} class="inline-flex items-center gap-1.5 text-sm font-medium text-denim underline underline-offset-2 transition-colors hover:text-denim-deep">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</a>
{{end}}
