{{/* link: a labelled hyperlink, in one of a few styles. */}}
{{/* verso-link-face: what a link wears inside its dress — its glyph, then its
     words. One that opens in a new tab leaves the router, and says so before
     its words (the external-link glyph, unless it names its own) and after
     them to a screen reader. */}}
{{define "verso-link-face"}}{{if .Icon}}{{icon .Icon "size-4"}}{{else if .NewTab}}{{icon "external-link" "size-4 shrink-0"}}{{end}}{{.Label}}{{if .NewTab}}<span class="sr-only">{{t "(opens in a new tab)"}}</span>{{end}}{{end}}
{{/* a link wearing a button's clothes is the same button: one height, one radius,
     one border — stated in the same place the form's own buttons take theirs. */}}
{{if eq .Style "button"}}
<a href="{{.Href}}" class="verso-button">{{template "verso-link-face" .}}</a>
{{else if eq .Style "rail"}}
{{/* One place on this page, in the list of them: the rail block
     (blocks/rail.css). Which one you are reading is the shell's to say — it
     marks this link aria-current. */}}
<a href="{{.Href}}" data-verso-rail-link class="verso-rail">{{template "verso-link-face" .}}</a>
{{else if eq .Style "act"}}
{{/* act: an act on a part of a section, in the subsection act's one dress. One
     that makes or replaces the thing it stands under opens its form in a drawer
     over the page, which keeps its address. */}}
{{if .Panel}}<span x-data="modal" class="contents">
<a href="{{.Href}}" @click.prevent="showPanel" data-verso-panel-chrome class="verso-button group/act relative" data-verso-size="act"{{if .Icon}} data-verso-glyph{{end}}>{{template "verso-link-face" .}}</a>
{{template "verso-drawer-fetched" ""}}</span>
{{else}}
<a href="{{.Href}}" class="verso-button group/act relative" data-verso-size="act"{{if .Icon}} data-verso-glyph{{end}}>{{template "verso-link-face" .}}</a>
{{end}}
{{else if eq .Style "secondary"}}
{{/* A secondary act may open its destination in a drawer over the page, as
     an act does (a package installed where its need is). */}}
{{if .Panel}}<span x-data="modal" class="contents">
<a href="{{.Href}}" @click.prevent="showPanel" data-verso-panel-chrome class="verso-button" data-verso-style="secondary">{{template "verso-link-face" .}}</a>
{{template "verso-drawer-fetched" ""}}</span>
{{else}}
<a href="{{.Href}}" class="verso-button" data-verso-style="secondary">{{template "verso-link-face" .}}</a>
{{end}}
{{else}}
<a href="{{.Href}}" class="verso-link"{{if .Door}} data-verso-door{{end}}{{if .NewTab}} target="_blank" rel="noopener noreferrer"{{end}}>{{template "verso-link-face" .}}</a>
{{end}}
