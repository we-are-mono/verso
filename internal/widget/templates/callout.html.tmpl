{{/* callout: a boxed notice, coloured by semantic variant with a matching icon. The
     plugin names intent (variant); the shell maps it to palette + a Lucide glyph
     (icons.go). */}}
<div class="flex w-full items-start border text-left text-sm{{if .Compact}} gap-2 rounded-md px-3 py-2{{else}} gap-3 rounded-lg p-4{{end}}
  {{if eq .Variant "success"}}border-green-200 bg-green-50 text-green-800 dark:border-green-500/15 dark:bg-green-500/10 dark:text-green-300
  {{else if eq .Variant "warning"}}border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-500/15 dark:bg-amber-500/10 dark:text-amber-300
  {{else if eq .Variant "danger"}}border-red-200 bg-red-50 text-red-800 dark:border-red-500/15 dark:bg-red-500/10 dark:text-red-300
  {{else if eq .Variant "neutral"}}border-slate-200 bg-slate-50 text-slate-700 dark:border-slate-400/15 dark:bg-slate-400/10 dark:text-slate-700
  {{else}}border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-500/15 dark:bg-sky-500/10 dark:text-sky-300{{end}}">
  {{if eq .Variant "success"}}{{if .Compact}}{{icon "circle-check" "mt-0.5 size-4 shrink-0 text-green-500"}}{{else}}{{icon "circle-check" "mt-0.5 size-5 shrink-0 text-green-500"}}{{end}}
  {{else if eq .Variant "warning"}}{{if .Compact}}{{icon "triangle-alert" "mt-0.5 size-4 shrink-0 text-amber-500"}}{{else}}{{icon "triangle-alert" "mt-0.5 size-5 shrink-0 text-amber-500"}}{{end}}
  {{else if eq .Variant "danger"}}{{if .Compact}}{{icon "circle-x" "mt-0.5 size-4 shrink-0 text-red-500"}}{{else}}{{icon "circle-x" "mt-0.5 size-5 shrink-0 text-red-500"}}{{end}}
  {{else if eq .Variant "neutral"}}{{if .Compact}}{{icon "info" "mt-0.5 size-4 shrink-0 text-slate-400"}}{{else}}{{icon "info" "mt-0.5 size-5 shrink-0 text-slate-400"}}{{end}}
  {{else}}{{if .Compact}}{{icon "info" "mt-0.5 size-4 shrink-0 text-sky-500"}}{{else}}{{icon "info" "mt-0.5 size-5 shrink-0 text-sky-500"}}{{end}}{{end}}
  <div class="min-w-0">
    {{if .Title}}<p class="font-semibold {{if eq .Variant "success"}}dark:text-green-400{{else if eq .Variant "warning"}}dark:text-amber-400{{else if eq .Variant "danger"}}dark:text-red-400{{else if eq .Variant "neutral"}}dark:text-slate-900{{else}}dark:text-sky-400{{end}}">{{.Title}}</p>{{end}}
    {{if .Body}}<p class="{{if .Title}}mt-0.5 {{end}}opacity-90">{{.Body}}</p>{{end}}
    {{if .RenderedLink}}<div class="mt-1.5">{{.RenderedLink}}</div>{{end}}
  </div>
</div>
