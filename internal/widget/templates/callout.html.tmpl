{{/* callout: a boxed notice, coloured by semantic variant with a matching icon. The
     plugin names intent (variant); the shell maps it to palette + a Lucide glyph
     (icons.go). */}}
<div class="flex w-full items-start gap-3 rounded-lg border p-4 text-left text-sm
  {{if eq .Variant "success"}}border-green-200 bg-green-50 text-green-800
  {{else if eq .Variant "warning"}}border-amber-200 bg-amber-50 text-amber-800
  {{else if eq .Variant "danger"}}border-red-200 bg-red-50 text-red-800
  {{else}}border-sky-200 bg-sky-50 text-sky-800{{end}}">
  {{if eq .Variant "success"}}{{icon "circle-check" "mt-0.5 size-5 shrink-0 text-green-500"}}
  {{else if eq .Variant "warning"}}{{icon "triangle-alert" "mt-0.5 size-5 shrink-0 text-amber-500"}}
  {{else if eq .Variant "danger"}}{{icon "circle-x" "mt-0.5 size-5 shrink-0 text-red-500"}}
  {{else}}{{icon "info" "mt-0.5 size-5 shrink-0 text-sky-500"}}{{end}}
  <div class="min-w-0">
    {{if .Title}}<p class="font-semibold">{{.Title}}</p>{{end}}
    {{if .Body}}<p class="{{if .Title}}mt-0.5 {{end}}opacity-90">{{.Body}}</p>{{end}}
  </div>
</div>
