{{/* callout: a notice in context, toned by intent, the notice block's band
     (blocks/notice.css). The plugin names the intent (variant); the shell
     maps it to the palette. Every notice is this one band, whether it
     explains the control it sits under or leads a page or a card. Compact
     says only where it stands: under a control it keeps that control's
     measure — the form's — rather than running past it; otherwise it
     reaches its container's width. */}}
{{/* callout.verbatim: what a tool reported, in its own words, verbatim,
     the copy control riding its first line. */}}
{{define "callout.verbatim"}}<div class="verso-notice__verbatim">
  <p class="verso-notice__said" data-verso-verbatim>{{.Verbatim}}</p>
  <button type="button" x-data="copy" @click="run" :data-copy-failed="failed" aria-label="{{ t "Copy" }}" class="verso-notice__copy verso-copy-inline group/copy">
    <span x-ref="src" class="hidden">{{.Verbatim}}</span>
    <span x-show="idle">{{icon "copy" "size-4"}}</span>
    <span x-show="done" x-cloak>{{icon "check" "size-4"}}</span>
    {{template "verso-copy-tip" "Copy"}}
  </button>
</div>{{end}}
{{/* Framed as every band is, in its tone one step darker than its ground.
     Its words stand 7px after the frame's top border and 8px over its
     bottom one, so a line of them fills a band of the grid and is a row's
     40px with the pixel it gives back. Across, its words stand 24px in from
     the frame's outer edge, on a line as a card's do, and the mark stands in
     the middle of the 8px cell in the middle of that 24px: the cell's lines
     are the frame's 8th and 16th pixels, so its 6px stand 10px from the
     frame's edge. */}}
<div data-verso-callout class="verso-notice" data-verso-tone="{{if or (eq .Variant "success") (eq .Variant "warning") (eq .Variant "danger") (eq .Variant "neutral")}}{{.Variant}}{{else}}info{{end}}"{{if .Compact}} data-verso-compact{{end}}>
  {{/* The mark sits on the first line's optical centre, 9px down its 24px
       line (7px of air, then 9), and 9px after the border's pixel. */}}
  <span aria-hidden="true" class="verso-mark verso-notice__mark" data-verso-tone="{{if or (eq .Variant "success") (eq .Variant "warning") (eq .Variant "danger")}}{{.Variant}}{{else if eq .Variant "neutral"}}muted{{else}}info{{end}}"></span>
  <div class="verso-notice__words">
    {{/* As a dialog's face (Named), the title and words carry the ids the
         dialog is labelled and described by. */}}
    {{if .Title}}<p{{with .Named}} id="{{.}}-title"{{end}} class="verso-notice__title">{{.Title}}</p>{{end}}
    {{/* One line of words, and its door closes that line — the sentence, then
         where to go about it — rather than standing on a line of its own. */}}
    {{if .Body}}<p{{with .Named}} id="{{.}}-body"{{end}}>{{.Body}}{{if .RenderedLink}} {{.RenderedLink}}{{end}}</p>{{else if .RenderedLink}}<p>{{.RenderedLink}}</p>{{end}}
    {{if .Verbatim}}{{template "callout.verbatim" .}}{{end}}
    {{template "callout.acts" .}}
  </div>
</div>
{{/* callout.acts: what resolves the notice, inside the band — a row of
     32px buttons 24px under its words, so the buttons stand on the band's
     lines and the band stays on the grid. A link act keeps its own shape
     and takes the band's ink (the notice block). */}}
{{define "callout.acts"}}{{if .RenderedActs}}<div data-verso-callout-acts class="verso-notice__acts">{{range .RenderedActs}}{{.}}{{end}}</div>{{end}}{{end}}
