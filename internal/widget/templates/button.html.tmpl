{{/* button: a direct action. A nameless button is inert (useful in visual
     references); a named one submits its value from the form that contains it. */}}
{{/* Live is the spinner without the surrender: the loader turns beside the
     label to say the thing this button governs is running, and every
     affordance stays — it is pressed to stop that thing. Loading, the
     in-flight submit, still disables. The label sits in its own span so the
     shell's stream client can rewrite it (Pause ⇄ Resume · N new) without
     touching the spinner beside it. */}}
{{/* The look is the button block's (blocks/button.css): an act is its 28px
     size in the secondary dress, the same as a Link's act, so a section's acts
     read as one set whether they lead somewhere or submit. A waiting button is
     one look whatever its style, on the same footprint, so the row does not
     jump when the press lands; it is the busy state the shell's script puts on
     a pressed button too (data-verso-busy), so a script ends a wait the server
     drew as it ends its own. */}}
<button type="{{if .Name}}submit{{else}}button{{end}}"{{if .Name}} name="{{.Name}}" value="{{.Value}}"{{with .Form}} form="{{.}}"{{end}}{{end}}{{with .Busy}} data-busy-label="{{.}}"{{end}}{{if or .Disabled .Loading}} disabled aria-disabled="true"{{end}}{{if .Loading}} aria-busy="true" data-verso-busy{{end}}{{if .Live}} data-verso-live{{end}} class="verso-button{{if eq .Style "act"}} group/act relative{{end}}"{{if eq .Style "act"}} data-verso-size="act"{{if or .Icon .Loading}} data-verso-glyph{{end}}{{else if eq .Style "secondary"}} data-verso-style="secondary"{{else if eq .Style "danger"}} data-verso-style="danger"{{end}}>{{if or .Loading .Live}}{{template "verso-waiting" ""}}{{else if .Icon}}{{icon .Icon "size-4"}}{{end}}{{if .Live}}<span data-verso-live-label>{{.Label}}</span>{{else}}{{.Label}}{{end}}</button>
