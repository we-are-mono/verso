{{/* button: a direct action. A nameless button is inert (useful in visual
     references); a named one submits its value from the form that contains it. */}}
<button type="{{if .Name}}submit{{else}}button{{end}}"{{if .Name}} name="{{.Name}}" value="{{.Value}}"{{end}}
  class="inline-flex items-center justify-center gap-2 rounded-md px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2
  {{if eq .Style "secondary"}}border border-slate-300 bg-white text-slate-700 hover:border-slate-400 focus-visible:ring-sky-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:border-gray-600 dark:hover:bg-gray-700
  {{else if eq .Style "danger"}}bg-red-600 text-white hover:bg-red-700 focus-visible:ring-red-600 dark:bg-red-600 dark:text-gray-100 dark:hover:bg-red-500
  {{else}}bg-sky-600 text-white hover:bg-sky-700 active:bg-sky-800 focus-visible:ring-sky-600 dark:bg-sky-700 dark:text-gray-100 dark:hover:bg-sky-800 dark:active:bg-sky-900{{end}}">{{if .Icon}}{{icon .Icon "size-4"}}{{end}}{{.Label}}</button>
