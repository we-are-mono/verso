{{/* button: a direct action. A nameless button is inert (useful in visual
     references); a named one submits its value from the form that contains it. */}}
{{/* Live is the spinner without the surrender: the loader turns beside the
     label to say the thing this button governs is running, and every
     affordance stays — it is pressed to stop that thing. Loading, the
     in-flight submit, still disables. The label sits in its own span so the
     shell's stream client can rewrite it (Pause ⇄ Resume · N new) without
     touching the spinner beside it. */}}
<button type="{{if .Name}}submit{{else}}button{{end}}"{{if .Name}} name="{{.Name}}" value="{{.Value}}"{{end}}{{if or .Disabled .Loading}} disabled aria-disabled="true"{{end}}{{if .Loading}} aria-busy="true"{{end}}{{if .Live}} data-verso-live{{end}}
  {{/* 36px tall, the one button height on the page, and a 1px border on every
       style — including the ones that draw it transparent — so a button dropped
       beside a field or another button lines up without anyone adjusting it.
       A waiting button is one look whatever its style — sand ground, strong
       hairline, glyph label — on the same footprint, so the row does not jump
       when the press lands. */}}
  class="inline-flex h-9 items-center justify-center gap-2 rounded-xs border px-4 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2
  {{if .Loading}}pointer-events-none border-rule-strong bg-quiet text-glyph
  {{else}}{{if .Disabled}}cursor-not-allowed opacity-70{{else}}cursor-pointer active:translate-y-px active:shadow-none motion-reduce:active:translate-y-0{{end}}
  {{if eq .Style "secondary"}}border-rule-strong bg-ground text-ink {{if not .Disabled}}hover:border-faint hover:bg-quiet{{end}} focus-visible:outline-denim
  {{else if eq .Style "ghost"}}border-transparent text-body {{if not .Disabled}}hover:bg-mid/50 hover:text-ink{{end}} focus-visible:outline-denim
  {{else if eq .Style "danger"}}border-crimson bg-crimson text-white {{if not .Disabled}}hover:border-crimson-deep hover:bg-crimson-deep{{end}} focus-visible:outline-crimson-deep
  {{else}}border-denim bg-denim text-white {{if not .Disabled}}hover:border-denim-deep hover:bg-denim-deep{{end}} focus-visible:outline-denim-deep{{end}}{{end}}">{{if or .Loading .Live}}{{template "verso-waiting" ""}}{{else if .Icon}}{{icon .Icon "size-4"}}{{end}}{{if .Live}}<span data-verso-live-label>{{.Label}}</span>{{else}}{{.Label}}{{end}}</button>
