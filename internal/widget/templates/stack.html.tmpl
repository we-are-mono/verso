{{/* stack: layout of pre-rendered children, with no surface of its own. Inline
     is a cluster (blocks/cluster.css): a wrapping row of acts. Every other is
     a stack (blocks/stack.css): Divided draws hairlines; Compact tightens the
     step, Loose widens it; as the page's root a stack takes the page's 40px.
     A flush stack adds no step and says it holds rows (data-verso-rows), so a
     section gives back its first and last rows' air as if they stood in it
     directly. */}}
{{if .Inline}}<div class="verso-cluster">{{range .Children}}{{.}}{{end}}</div>
{{- else}}<div class="verso-stack"{{if eq .Width "compact"}} data-verso-width="compact"{{end}}{{if .Flush}} data-verso-rows data-verso-gap="none"{{else if .Divided}} data-verso-divided data-verso-gap="none"{{else if .Compact}} data-verso-gap="compact"{{else if .Loose}} data-verso-gap="loose"{{end}}>{{range .Children}}{{.}}{{end}}</div>{{end}}
