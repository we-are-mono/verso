{{/* chart: the overview's traffic plot, drawn server-side to static SVG edge to
     edge on the notebook grid. Colours live in the .verso-chart-* classes
     (input.css), never in SVG presentation attributes — var() resolves in CSS
     properties but not inside SVG attrs. Geometry (viewBox, d) stays here.

     Axis labels are HTML, not SVG <text>: text inside a viewBox scales with the
     graph. This SVG is the first paint; the live layer glides the same series
     without touching the markup.

     On the notebook's sand the labels lie over the plot's left edge and its
     bottom corners. In an Overview card they stand outside it: the values in
     a four-cell gutter on its right, beside "now", where the newest sample is
     read across onto the scale, each centred on its quarter line; and the
     window's ends on the 20px line under it, flush with the plot's edges. The
     card's plot is eight cells tall over faint rules a cell apart, its frame
     a pixel up so the rules fall on the page's lines, the line over its top
     included, and every quarter line on a rule. */}}
{{if .Card}}
<div class="grid grid-cols-[minmax(0,1fr)_5rem]">
  <div class="-mt-px pt-px bg-[linear-gradient(to_bottom,var(--color-mid)_1px,transparent_1px)] bg-size-[100%_20px]">
    {{template "chart.svg" .}}
  </div>
  <div class="relative -mt-px" data-verso-chart-gutter>
    {{range .YLabels}}<span class="verso-chart-yl pointer-events-none absolute left-3 -translate-y-1/2 font-mono text-sm leading-5 font-medium whitespace-nowrap text-meta" style="top:{{printf "%.1f" .TopPct}}%">{{.Text}}</span>{{end}}
  </div>
  <div class="flex justify-between text-sm leading-5 text-meta" data-verso-chart-window><span>{{.XStart}}</span><span>{{.XEnd}}</span></div>
</div>
{{else}}
<div class="relative {{if .Short}}h-45{{else}}h-60{{end}} overflow-hidden">
  {{template "chart.svg" .}}
  {{range $i, $label := .YLabels}}<span class="verso-chart-yl pointer-events-none absolute left-0! flex h-4.75 {{if eq $i 0}}min-w-29.75{{else}}min-w-14.75{{end}} items-center bg-quiet/85 px-4 font-mono! text-sm! leading-none font-medium text-meta [text-shadow:none]!" style="top:{{printf "%.1f" .TopPct}}%">{{.Text}}</span>{{end}}
  <span class="pointer-events-none absolute bottom-px left-0 flex h-4.75 min-w-24.75 items-center bg-quiet/85 px-4 font-sans text-sm leading-none text-meta">{{.XStart}}</span>
  <span class="pointer-events-none absolute right-0 bottom-px flex h-4.75 min-w-14.75 items-center justify-end bg-quiet/85 px-4 font-sans text-sm leading-none text-meta">{{.XEnd}}</span>
</div>
{{end}}

{{define "chart.svg"}}
<svg class="verso-chart block {{if .Card}}h-40!{{else if .Short}}h-45!{{else}}h-60!{{end}} w-full overflow-hidden" viewBox="0 0 {{.W}} {{.H}}" preserveAspectRatio="none" role="img" aria-label="{{.Label}}" data-chart-padding="0">
  {{range .Marks}}{{if eq .Kind "boot"}}<line class="verso-chart-mark--boot" x1="{{printf "%.1f" .X}}" x2="{{printf "%.1f" .X}}" y1="0" y2="{{$.H}}" vector-effect="non-scaling-stroke"><title>{{.Label}}</title></line>{{else}}<rect class="verso-chart-mark--{{.Kind}}" x="{{printf "%.1f" .X}}" y="0" width="{{printf "%.1f" .Width}}" height="{{$.H}}"><title>{{.Label}}</title></rect>{{end}}
  {{end}}
  {{range .Series}}
  <g class="verso-chart-series verso-chart--{{.Role}}">
    {{if .Area}}
    <defs><linearGradient id="{{.GradID}}" x1="0" y1="0" x2="0" y2="1"><stop class="verso-chart-fill-0" offset="0"/><stop class="verso-chart-fill-1" offset="1"/></linearGradient></defs>
    <path class="verso-chart-area" fill="url(#{{.GradID}})" d="{{.Area}}"/>
    {{end}}
    <path class="verso-chart-line {{if eq .Role "violet"}}stroke-[1.5]!{{else}}stroke-2!{{end}}" d="{{.Line}}" vector-effect="non-scaling-stroke"/>
  </g>
  {{end}}
</svg>
{{end}}
