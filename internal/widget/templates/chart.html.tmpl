{{/* chart: a reading over time, drawn server-side to static SVG. Colours live in
     the .verso-chart-* classes (input.css), never in SVG presentation
     attributes — var() resolves in CSS properties but not inside SVG attrs.
     Geometry (viewBox, d) stays here.

     The plot stands over square cells, four tall, so each rule is a quarter
     line; its place sets the cell (data-chart-place: 32px on a page's card,
     24px in an Overview card or a drawer), and the CSS rounds the plot's width
     down to whole quarters of cells, so each time label stands on its line.
     The value labels stand in a 64px gutter on the plot's right, centred on
     their quarter lines (the top one carrying the unit), and the window's
     quarters on the 24px line under it, so nothing is laid over the curve.
     Labels are HTML, not SVG <text>: text inside a viewBox scales with the
     graph. This SVG is the first paint; the live layer glides the same series
     without touching the markup. */}}
<div class="verso-chart-graph" data-chart-place="{{.Place}}">
  {{/* A legend line per series that has one, as the Overview's facts read:
       the series' packet, its name as the term, its figure as the value and
       what the figure is, and the window's peak at the plot's right edge. */}}
  {{range .Legends}}
  <div class="verso-chart-legend" data-verso-chart-legend>
    <span class="verso-chart-legend-series"><span aria-hidden="true" class="size-1.5 shrink-0 self-center rounded-[1px] {{.Hue}}"></span><span class="text-meta">{{.Name}}</span><span class="verso-chart-figure" data-verso-live-figure>{{.Figure}}</span><span class="text-meta" data-verso-live-caption>{{.Caption}}</span></span>
    <span class="verso-chart-legend-peak"><span class="text-meta">{{ t "peak" }}</span><span class="verso-chart-figure" data-verso-live-peak>{{.Peak}}</span></span>
  </div>
  {{end}}
  <div class="verso-chart-frame">
    <div class="verso-chart-plot">
      <svg class="verso-chart block w-full overflow-hidden" viewBox="0 0 {{.W}} {{.H}}" preserveAspectRatio="none" role="img" aria-label="{{.Label}}" data-chart-padding="0">
        {{range .Marks}}{{if eq .Kind "boot"}}<line class="verso-chart-mark--boot" x1="{{printf "%.1f" .X}}" x2="{{printf "%.1f" .X}}" y1="0" y2="{{$.H}}" vector-effect="non-scaling-stroke"><title>{{.Label}}</title></line>{{else}}<rect class="verso-chart-mark--{{.Kind}}" x="{{printf "%.1f" .X}}" y="0" width="{{printf "%.1f" .Width}}" height="{{$.H}}"><title>{{.Label}}</title></rect>{{end}}
        {{end}}
        {{range .Peaks}}<line class="verso-chart-peak verso-chart-peak--{{.Role}}" x1="0" x2="{{$.W}}" y1="{{printf "%.1f" .Y}}" y2="{{printf "%.1f" .Y}}" vector-effect="non-scaling-stroke"/>{{end}}
        {{range .Series}}
        <g class="verso-chart-series verso-chart--{{.Role}}">
          {{if .Area}}
          <defs><linearGradient id="{{.GradID}}" x1="0" y1="0" x2="0" y2="1"><stop class="verso-chart-fill-0" offset="0"/><stop class="verso-chart-fill-1" offset="1"/></linearGradient></defs>
          <path class="verso-chart-area" fill="url(#{{.GradID}})" d="{{.Area}}"/>
          {{end}}
          <path class="verso-chart-line {{if eq .Role "violet"}}stroke-[1.5]!{{else}}stroke-2!{{end}}" d="{{.Line}}" vector-effect="non-scaling-stroke"/>
        </g>
        {{end}}
      </svg>
    </div>
    <div class="relative" data-verso-chart-gutter>
      {{range .YLabels}}<span class="verso-chart-yl pointer-events-none absolute left-3 -translate-y-1/2 whitespace-nowrap" style="top:{{printf "%.1f" .TopPct}}%">{{.Text}}</span>{{end}}
    </div>
    {{if .Ticks}}<div class="verso-chart-axis relative h-6" data-verso-chart-window>
      {{range .Ticks}}<span class="verso-chart-tick absolute top-0 whitespace-nowrap" data-verso-chart-tick data-align="{{.Align}}" style="left:{{printf "%.0f" .Pct}}%">{{.Text}}</span>{{end}}
    </div>{{end}}
  </div>
</div>
