{{/* chart: a generic time-series plot, drawn server-side to static SVG from the
     supplied values. Powers both the hero throughput graph (size "full": faint value
     gridlines, an endpoint dot, and an optional status/rates readout) and the per-port
     sparklines (size "spark": bare). Colours live in the .verso-chart-* classes
     (input.css), never in SVG presentation attributes — var() resolves in CSS properties
     but not inside SVG attrs. Geometry (viewBox, d, cx/cy) stays here.

     Axis labels are HTML overlaid on the plot, not SVG <text>: text inside a viewBox
     scales with the graph, so a nominal 11px renders far bigger on a wide plot. The HTML
     spans render at a true, fixed size. This SVG is the first paint; the live layer
     hydrates the same series without touching the schema. */}}
{{define "verso-chart-svg"}}<svg class="verso-chart {{.Class}} block h-auto w-full overflow-visible" viewBox="0 0 {{.W}} {{.H}}" role="img" aria-label="{{.Label}}">
  {{if .GridYs}}<g class="verso-chart-grid">{{range .GridYs}}<line x1="0" y1="{{.}}" x2="{{$.W}}" y2="{{.}}"/>{{end}}</g>{{end}}
  {{range .Series}}
  <g class="verso-chart-series verso-chart--{{.RoleClass}}">
    {{if .Area}}
    <defs><linearGradient id="{{.GradID}}" x1="0" y1="0" x2="0" y2="1"><stop class="verso-chart-fill-0" offset="0"/><stop class="verso-chart-fill-1" offset="1"/></linearGradient></defs>
    <path class="verso-chart-area" fill="url(#{{.GradID}})" d="{{.Area}}"/>
    {{end}}
    <path class="verso-chart-line" d="{{.Line}}"/>
    {{if .DotR}}<circle class="verso-chart-dot" cx="{{.DotX}}" cy="{{.DotY}}" r="{{.DotR}}"/>{{end}}
  </g>
  {{end}}
</svg>{{end}}
{{define "verso-chart-plot"}}<div class="verso-chart-plot">
  {{template "verso-chart-svg" .}}
  {{if .AxisTop}}<span class="verso-chart-yl verso-chart-yl-top">{{.AxisTop}}</span>{{end}}
  {{if .AxisMid}}<span class="verso-chart-yl verso-chart-yl-mid">{{.AxisMid}}</span>{{end}}
  {{if .XStart}}<span class="verso-chart-xl verso-chart-xl-start">{{.XStart}}</span>{{end}}
  {{if .XEnd}}<span class="verso-chart-xl verso-chart-xl-end">{{.XEnd}}</span>{{end}}
</div>{{end}}
{{if .Readout}}<div class="verso-chart-hero">
  <div class="verso-chart-readout">
    {{if .Title}}<div class="verso-chart-status">{{if .Live}}<span class="verso-live-dot size-2 shrink-0 rounded-full bg-green-500"></span>{{end}}{{.Title}}</div>{{end}}
    {{if .Note}}<div class="verso-chart-meta">{{.Note}}</div>{{end}}
    {{if .Rates}}<div class="verso-chart-rates">{{range .Rates}}<div class="verso-chart-rate verso-chart--{{.RoleClass}}"><div class="verso-chart-rate-v">{{.Value}}{{if .Unit}} <small>{{.Unit}}</small>{{end}}</div><div class="verso-chart-rate-k"><span class="verso-chart-rate-sw"></span>{{.Label}}</div></div>{{end}}</div>{{end}}
  </div>
  {{template "verso-chart-plot" .}}
</div>{{else if .HasAxis}}{{template "verso-chart-plot" .}}{{else}}{{template "verso-chart-svg" .}}{{end}}
