{{/* chart: a reading over time, drawn server-side to static SVG, the chart
     block (blocks/chart.css). Colours live in the block, never in SVG
     presentation attributes — var() resolves in CSS properties but not
     inside SVG attrs. Geometry (viewBox, d) stays here.

     The value labels stand in a 64px gutter on the plot's right, centred on
     their quarter lines, and the window's quarters on the 24px line under
     it, so nothing is laid over the curve. Labels are HTML, not SVG <text>:
     text inside a viewBox scales with the graph. This SVG is the first
     paint; the live layer glides the same series without touching the
     markup. */}}
<div class="verso-chart"{{if .ID}} id="{{.ID}}"{{end}} data-verso-place="{{.Place}}" data-verso-steps="{{.Steps}}" style="--verso-chart-step: {{.Step}}">
  {{if .Empty}}
  {{/* Nothing to draw: the chart says so where its plot would stand. */}}
  <p class="verso-chart__empty" data-verso-chart-empty><span aria-hidden="true" class="verso-mark"></span>{{.Empty}}</p>
  {{else}}
  {{range .Legends}}
  <div class="verso-chart__head">
    <div class="verso-chart__legend" data-verso-chart-legend>
      <span class="verso-chart__series-name"><span aria-hidden="true" class="verso-chart__key" data-verso-tone="{{.Hue}}"></span><span class="text-meta">{{.Name}}</span><span class="verso-chart__figure" data-verso-figures data-verso-live-figure>{{.Figure}}</span><span class="text-meta" data-verso-live-caption>{{.Caption}}</span></span>
      <span class="verso-chart__peak-key"><span class="text-meta">{{ t "peak" }}</span><span class="verso-chart__figure" data-verso-figures data-verso-live-peak>{{.Peak}}</span></span>
    </div>
  </div>
  {{end}}
  <div class="verso-chart__frame">
    <div class="verso-chart__plot">
      <svg class="verso-chart__svg" viewBox="0 0 {{.W}} {{.H}}" preserveAspectRatio="none" role="img" aria-label="{{.Label}}" data-chart-padding="0">
        {{range .Marks}}{{if eq .Kind "boot"}}<line class="verso-chart__mark" data-verso-kind="boot" x1="{{printf "%.1f" .X}}" x2="{{printf "%.1f" .X}}" y1="0" y2="{{$.H}}" vector-effect="non-scaling-stroke"><title>{{.Label}}</title></line>{{else}}<rect class="verso-chart__mark" data-verso-kind="{{.Kind}}" x="{{printf "%.1f" .X}}" y="0" width="{{printf "%.1f" .Width}}" height="{{$.H}}"><title>{{.Label}}</title></rect>{{end}}
        {{end}}
        {{range .Peaks}}<line class="verso-chart__peak" data-verso-tone="{{.Role}}" x1="0" x2="{{$.W}}" y1="{{printf "%.1f" .Y}}" y2="{{printf "%.1f" .Y}}" vector-effect="non-scaling-stroke"/>{{end}}
        {{range .Series}}
        <g class="verso-chart__series" data-verso-tone="{{.Role}}">
          {{if .Area}}
          <defs><linearGradient id="{{.GradID}}" x1="0" y1="0" x2="0" y2="1"><stop class="verso-chart__from" offset="0"/><stop class="verso-chart__to" offset="1"/></linearGradient></defs>
          <path class="verso-chart__area" fill="url(#{{.GradID}})" d="{{.Area}}"/>
          {{end}}
          <path class="verso-chart__line" d="{{.Line}}" vector-effect="non-scaling-stroke"/>
        </g>
        {{end}}
      </svg>
    </div>
    <div class="relative" data-verso-chart-gutter>
      {{range .YLabels}}<span class="verso-chart__scale" style="top:{{printf "%.1f" .TopPct}}%">{{.Text}}</span>{{end}}
      {{/* What the scale counts in, once, on its baseline: the zero line,
           where no figure stands, clear of the legend's peak. */}}
      <span class="verso-chart__scale" style="top:100%" data-verso-chart-unit>{{.Unit}}</span>
    </div>
    {{range $i, $a := .Axes}}<div class="verso-chart__axis" data-verso-chart-window data-verso-axis="{{.Steps}}"{{if eq $i 0}} data-verso-axis-first{{end}}>
      {{range .Ticks}}<span class="verso-chart__tick" data-verso-chart-tick data-verso-align="{{.Align}}" style="left:{{printf "%.3f" .Pct}}%">{{.Text}}</span>{{end}}
    </div>{{end}}
  </div>
  {{end}}
</div>
