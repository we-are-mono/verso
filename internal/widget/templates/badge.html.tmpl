{{/* badge: a status. The shell maps the semantic variant to a tone; the
     plugin never names a colour (ADR-005). Plain drops the pill to a tone
     dot + plain words — a resting status line, not a chip. The lg banner
     pill is not in a row and keeps its own, larger box (blocks/badge.css). */}}
{{/* A pill in a row is a chip (blocks/chip.css): one height for every small
     bordered thing on the page, and one place to retune it. */}}
{{if .Plain}}<span class="verso-badge" data-verso-plain>{{if .Icon}}<span class="verso-badge__glyph">{{icon .Icon "size-4"}}</span>{{else if .Dot}}{{template "verso-dot" .Variant}}{{end}}{{.Text}}</span>
{{else if eq .Size "lg"}}<span class="verso-badge"{{if or (eq .Variant "success") (eq .Variant "warning") (eq .Variant "danger") (eq .Variant "info")}} data-verso-tone="{{.Variant}}"{{end}}>{{if .Icon}}<span class="verso-badge__glyph">{{icon .Icon "size-4"}}</span>{{end}}{{if .Dot}}{{template "verso-dot" .Variant}}{{end}}{{.Text}}</span>
{{/* A pill with no hue — the firewall's drop, which says nothing at all rather
     than answering — is the neutral chip, like every chip without a hue. It
     leads with one mark or none: an icon, or the still packet square in its
     hue (an icon wins). */}}
{{else}}<span class="verso-chip" data-verso-verbatim{{with .Variant}} data-verso-tone="{{.}}"{{end}}>{{if .Icon}}<span class="verso-chip__glyph">{{icon .Icon "size-3.5"}}</span>{{else if .Dot}}{{template "verso-chip-packet" .Variant}}{{end}}{{.Text}}</span>{{end}}
