{{/* filter: the page-wide lens on a sticky ground-coloured dock. The sentinel div
     lets verso.js detect the pinned state (the dock gains .verso-filter-stuck and
     the bar breathes in). The dock bleeds past the content column (-mx-8/px-8, the
     page's own padding) so pinned rows slide fully beneath it, dissolving through
     the ::after gradient fade. Behaviour is shell-owned: see verso.js. */}}
<div class="h-px"></div>
{{/* pt-8 = the content column's own 2rem (px-8) gutter, so the pinned bar sits as
     far from the top as the content does from the sidebar. Constant padding — a
     pin-time change would shift the page, and the lens never moves anything. */}}
<div class="verso-filter-dock sticky top-0 z-20 -mx-8 bg-slate-50 px-8 pt-8 pb-3">
  <div class="verso-filter-bar flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4.5 py-3 shadow-sm focus-within:border-sky-600 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-sky-600">
    {{icon "search" "size-5 shrink-0 text-slate-400"}}
    <input type="search" data-verso-filter placeholder="{{.}}" aria-label="Filter everything on this page"
      class="w-full border-0 bg-transparent text-base text-slate-900 outline-none placeholder:text-slate-400">
    <kbd class="shrink-0 rounded-md border border-slate-300 px-1.5 py-0.5 font-mono text-xs text-slate-400" aria-hidden="true">/</kbd>
  </div>
</div>
