{{/* tabs: a segmented switch between panels. Pure CSS (ADR-005 §7) — a radio group
     drives which panel shows via :has() rules in verso.css, so the plugin ships no
     JS and gets native arrow-key navigation for free. A sliding indicator (the white
     pill) glides under the active tab. --verso-tabs-n tells the CSS how many equal
     columns to slide across. The group name is unique per render, so two tab groups
     on one page never share state. Icons from the shared Lucide set (icons.go). */}}
<div class="verso-tabs" style="--verso-tabs-n:{{len .Tabs}}">
  {{range $i, $t := .Tabs}}
  <input type="radio" name="{{$.Group}}" id="{{$.Group}}-{{$i}}" class="verso-tab-radio sr-only"{{if $t.First}} checked{{end}}>
  {{end}}
  <div class="verso-tab-list relative mb-5 inline-grid grid-flow-col auto-cols-fr rounded-full border border-slate-200 bg-slate-50 p-1" role="tablist">
    <span class="verso-tab-indicator" aria-hidden="true"></span>
    {{range $i, $t := .Tabs}}
    <label for="{{$.Group}}-{{$i}}" class="verso-tab-label relative z-10 inline-flex cursor-pointer items-center justify-center gap-2 rounded-full px-4 py-2 text-sm font-semibold text-slate-500 transition-colors">
      {{if $t.Icon}}{{icon $t.Icon "size-4"}}{{end}}
      {{$t.Label}}
    </label>
    {{end}}
  </div>
  <div class="verso-tab-panels">
    {{range $t := .Tabs}}
    <section class="verso-tab-panel space-y-5">{{$t.Body}}</section>
    {{end}}
  </div>
</div>
