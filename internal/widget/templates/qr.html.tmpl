{{/* qr: a real, scannable code rendered server-side as inline SVG (ADR-005 §7).
     Always dark-on-white so any scanner sees the contrast it needs, whatever the
     page theme. An optional download sits beneath as a quiet link, so the code and
     its "can't scan?" fallback read as one centred unit. */}}
<div class="flex flex-col items-center gap-3 text-center">
  {{/* The code's own ground stays pure white whatever the page is: a scanner reads
       the quiet zone around the modules, and the page's warm ground is not one. */}}
  <div class="size-52 rounded-xs border border-rule bg-white p-3 text-ink">
    {{.SVG}}
  </div>
  {{if .Caption}}<p class="max-w-[30ch] text-sm text-body">{{.Caption}}</p>{{end}}
  {{if .DownloadHref}}<a href="{{.DownloadHref}}" download="{{.DownloadName}}" class="text-sm font-medium text-denim underline underline-offset-2 hover:text-denim-deep">{{.DownloadLabel}}</a>{{end}}
</div>
