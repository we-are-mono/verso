{{/* qr: a real, scannable code rendered server-side as inline SVG (ADR-005 §7).
     Always dark-on-white so any scanner sees the contrast it needs, whatever the
     page theme. The plugin supplied the payload and caption; the shell drew it. */}}
<div class="flex flex-col items-center gap-3 text-center">
  <div class="size-52 rounded-2xl border border-slate-200 bg-white p-3 shadow-md">
    {{.SVG}}
  </div>
  {{if .Caption}}<p class="max-w-[30ch] text-sm text-slate-500">{{.Caption}}</p>{{end}}
</div>
