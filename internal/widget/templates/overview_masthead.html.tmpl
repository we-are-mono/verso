{{/* overview.masthead: the home page's top block — the verdict sentence under its
     live-dot kicker, the divided status-tile strip, and the IPv4/IPv6 connection
     facts. One define, two callers: the real page (overview.html.tmpl) and the
     overview-preview styleguide workbench, so the block cannot drift between them.

     The reading is chosen once, app-wide, by the shell's own switch (ADR-015 §1);
     this page states its verdict and shows what that reading contains. */}}
{{define "overview.masthead"}}
  {{/* Verdict: kicker above, then the headline. */}}
  <div>
    <div class="flex items-center gap-2.5">
      <span class="size-2.5 shrink-0 rounded-full bg-emerald-500 verso-live-dot"></span>
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600">{{.Kicker}}</span>
    </div>
    <div class="mt-3.5 flex items-center justify-between gap-4">
      <h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight text-slate-900">{{.Lead}}<span class="text-emerald-600">{{.Accent}}</span></h1>
    </div>
  </div>

  {{/* Status tiles: each fact the box can honestly state earns a column — Wi-Fi
       hardware one, a countable device roster another — and the strip divides
       the same full width evenly however many that is. A tile with an Href is
       the doorway to the page that fact belongs to. */}}
  <div class="mt-8 grid {{if eq (len .Tiles) 5}}grid-cols-5{{else if eq (len .Tiles) 4}}grid-cols-4{{else}}grid-cols-3{{end}} divide-x divide-slate-100 border-y border-slate-100">
    {{range .Tiles}}
    {{if .Href}}<a href="{{.Href}}" class="block px-6 py-5 transition-colors first:pl-0 last:pr-0 hover:bg-slate-50 dark:hover:bg-gray-800">{{else}}<div class="px-6 py-5 first:pl-0 last:pr-0">{{end}}
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">{{.Label}}</span>
        <span class="shrink-0 {{if eq .Variant "warning"}}text-amber-600{{else}}text-emerald-500{{end}}">{{icon .Icon "size-4"}}</span>
      </div>
      <div class="mt-3 flex items-center gap-2">
        <span class="size-2 shrink-0 rounded-full {{if eq .Variant "warning"}}bg-amber-500{{else}}bg-emerald-500{{end}}"></span>
        <span class="text-base font-semibold {{if eq .Variant "warning"}}text-amber-700{{else}}text-slate-900{{end}}">{{.Status}}</span>
      </div>
      <div class="mt-1.5 text-sm text-slate-400"{{if .Key}} data-verso-tile-caption="{{.Key}}"{{end}}>{{.Caption}}</div>
    {{if .Href}}</a>{{else}}</div>{{end}}
    {{end}}
  </div>

  {{/* Connection facts: IPv4 and IPv6 side by side, label → mono value with copy.
       The advanced reading only — a basic reader has the internet tile above. */}}
  {{if .Facts}}
  <div class="grid grid-cols-2 divide-x divide-slate-100 border-b border-slate-100">
    {{range .Facts}}
    <div class="py-6 {{if eq .Side "left"}}pr-8{{else}}pl-8{{end}}">
      <div class="flex items-baseline gap-2.5">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">{{.Kind}}</span>
        <span class="text-xs text-slate-400">{{.Proto}}</span>
      </div>
      <div class="mt-2">{{.Rows}}</div>
    </div>
    {{end}}
  </div>
  {{end}}
{{end}}
