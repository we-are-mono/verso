{{define "overview.masthead"}}
  <div class="group" data-overview-tone="{{.Tone}}">
    <div class="flex items-center gap-2 {{template "verso-kicker-class"}} group-data-[overview-tone=success]:text-green-deep group-data-[overview-tone=warning]:text-marigold-deep group-data-[overview-tone=danger]:text-crimson-deep">
      <span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] border border-faint group-data-[overview-tone=success]:border-transparent group-data-[overview-tone=success]:bg-green group-data-[overview-tone=warning]:border-transparent group-data-[overview-tone=warning]:bg-marigold group-data-[overview-tone=danger]:border-transparent group-data-[overview-tone=danger]:bg-crimson"></span>
      <span data-overview-kicker>{{.Kicker}}</span>
    </div>
    <div class="mt-2.5 flex flex-wrap items-baseline gap-x-4 gap-y-3">
      <h1 class="text-3xl leading-[1.1] font-semibold tracking-tight text-ink"><span data-overview-lead>{{.Lead}}</span><span data-overview-accent class="text-green">{{.Accent}}</span><span data-overview-tail>{{.Tail}}</span></h1>
      {{if .Clock}}
      <div class="ml-auto flex flex-wrap items-center gap-2 text-sm text-meta" data-overview-clock data-unix="{{.Unix}}" data-offset="{{.Offset}}">
        <span aria-hidden="true" data-overview-live class="size-1.5 shrink-0 rounded-[1px] bg-green"></span>
        <time class="font-mono text-base font-medium text-ink" data-overview-time>{{.Clock}}</time>
        <span>{{.Zone}}</span>
        {{if .Uptime}}<span aria-hidden="true" class="text-faint">·</span><span>{{ t "Uptime" }}</span><span data-overview-uptime class="text-ink">{{.Uptime}}</span>{{end}}
      </div>
      {{end}}
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 border-y border-rule sm:grid-cols-2 {{if eq (len .Tiles) 5}}xl:grid-cols-5{{else if eq (len .Tiles) 3}}xl:grid-cols-3{{else}}xl:grid-cols-4{{end}}">
    {{range .Tiles}}
    {{if .Href}}<a href="{{.Href}}"{{else}}<div{{end}} data-overview-tile="{{.ID}}" data-tone="{{.Variant}}" class="group relative flex min-w-0 flex-col gap-2.5 border-t border-rule px-4 py-5.5 first:border-t-0 sm:odd:border-r sm:nth-2:border-t-0 xl:border-t-0 xl:border-r xl:px-6 xl:first:pl-0 xl:last:border-r-0 xl:last:pr-0{{if .Href}} transition-colors hover:bg-quiet/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim{{end}}">
      <div class="flex items-center justify-between gap-2">
        <span class="text-xs font-medium tracking-[.08em] text-meta uppercase">{{.Label}}</span>
        <span class="shrink-0 text-faint" aria-hidden="true">{{icon .Icon "size-4"}}</span>
      </div>
      <div class="flex min-w-0 items-center gap-2.5 text-lg font-semibold text-body group-data-[tone=success]:text-green group-data-[tone=warning]:text-marigold-deep group-data-[tone=danger]:text-crimson-deep">
        <span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] border border-faint group-data-[tone=success]:border-transparent group-data-[tone=success]:bg-green group-data-[tone=warning]:border-transparent group-data-[tone=warning]:bg-marigold group-data-[tone=danger]:border-transparent group-data-[tone=danger]:bg-crimson"></span>
        <span data-overview-tile-status>{{.Status}}</span>
      </div>
      <div class="min-w-0 truncate text-sm text-meta" title="{{.Caption}} {{.Identity}}"><span data-overview-tile-caption{{if .Key}} data-verso-tile-caption="{{.Key}}"{{end}}>{{.Caption}}</span><span data-overview-tile-separator>{{if and .Caption .Identity}} · {{end}}</span><span data-overview-tile-identity class="font-mono font-medium text-ink">{{.Identity}}</span></div>
    {{if .Href}}</a>{{else}}</div>{{end}}
    {{end}}
  </div>

  {{if .Facts}}
  <div class="grid grid-cols-1 divide-y divide-rule border-b border-rule xl:grid-cols-2 xl:divide-x xl:divide-y-0">
    {{range .Facts}}
    <section aria-label="{{.Kind}}" class="min-w-0 py-6 {{if eq .Side "left"}}xl:pr-11{{else}}xl:pl-11{{end}}">
      <div class="flex min-h-7 items-center gap-3 pb-3">
        <h2 class="text-sm font-semibold text-ink">{{.Kind}}</h2>
        {{if .Proto}}<span class="{{template "verso-chip-class"}}">{{.Proto}}</span>{{end}}
      </div>
      {{if .Empty}}<p class="flex items-start gap-2.5 border-t border-mid pt-3 text-sm font-medium text-body"><span aria-hidden="true" class="mt-1.75 size-1.5 shrink-0 rounded-[1px] border border-faint"></span><span>{{.Empty}}</span></p>{{else}}{{.Rows}}{{end}}
    </section>
    {{end}}
  </div>
  {{end}}
{{end}}
