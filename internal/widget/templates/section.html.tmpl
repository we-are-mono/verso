{{/* section: a grouped block with an optional heading. Full headings and their
     descriptions share a Quiet Sand band with 16px vertical padding and 20px
     before the content. Nested sections keep their smaller ledger headings. */}}
{{/* Hairline is opt-in, and it means one of two things.

     A ruled section is one of a page's subjects, set off from the last by a rule
     with 24px on either side. When it has a full heading, the stylesheet replaces
     the rule and its lower gap with the heading band. The one a page opens with
     draws neither rule nor gap. first-of-type, not first-child: a form opens with its
     hidden CSRF carrier, so the leading section is never the first child of
     anything and would draw a rule with nothing above it to divide from.

     Ruled AND flush is the other thing a rule can mean: not a new subject but a
     continuation of the rows above — the control that adds another one. It
     always draws its rule, because a continuation of nothing is not a case, and
     it cancels the standoff its container would give it: the rule under the last
     row IS the separation, and air above that rule would detach it from the set
     it belongs to. */}}
{{/* A section inside a section takes no lead-in of its own: it is one of its
     parent's blocks, and the parent's block rhythm already stands it off. */}}
{{/* A section someone can be sent to stops short of the viewport's top edge: far
     enough that the phone's own bar is not covering the heading that was asked
     for, and on a wider screen no further than the air the section already keeps
     above itself. */}}
{{/* A section with no heading has nothing for its first row's top padding to
     stand off from: it is marked headless, and the stylesheet takes that
     padding back so its first box starts where the section does. */}}
{{/* The section says what it is and sections.css says how it stands — its
     air, its rule, how far the rule reaches on this surface — so a page and a
     drawer draw it by one definition. */}}
{{$band := and .Title (not .Nested) (not .Kicker)}}
<section data-verso-section="{{.Kind}}"{{if not (or .Title .Meta .Control)}} data-verso-headless{{end}}{{if .Anchor}} id="{{.Anchor}}"{{end}}{{if and .Hairline (not .Flush)}} data-verso-ruled{{if not .Nested}} data-verso-section-divider{{end}}{{end}}>
  {{if and .Nested .Title (not .Kicker)}}
  {{/* A section inside a section is a part of its subject, and it stands on
       a ledger line: its name at the label's size, how many things it holds,
       and a hairline running on to the column's end — the start of a group,
       which a field label never is. The count is the set's own length, keyed
       by the part's name, so the page can roll it when the number changes
       (verso-page.js). The ledger is one 20px line, and the first box in the
       part stands a cell under it, as a form's rows stand apart. The line is the strong hairline,
       the one that stands between sections, so a ledger is told from the
       hairlines between the rows under it; a part with a glyph leads with
       it, in Glyph, so parts of different kinds are told apart at a
       glance. */}}
  <div data-verso-ledger class="mb-5 flex h-5 items-center gap-3">
    {{if .Icon}}<span class="shrink-0 text-glyph">{{icon .Icon "size-4"}}</span>{{end}}
    <h3 class="shrink-0 text-sm leading-5 font-semibold text-ink">{{.Title}}</h3>
    {{if .Counted}}<span data-verso-count="{{.Title}}" class="inline-grid h-5 shrink-0 overflow-hidden text-sm leading-5 font-medium tabular-nums text-meta"><span data-verso-count-value class="[grid-area:1/1]">{{.Count}}</span></span>{{end}}
    {{/* A part's meta is its name as the config writes it (an expanded
         row's network `lan`), so it is set verbatim, in mono. */}}
    {{if .Meta}}<span data-verso-section-meta class="shrink-0 font-mono text-base leading-5 font-medium text-ink">{{.Meta}}</span>{{end}}
    <span aria-hidden="true" class="h-px min-w-6 flex-1 bg-rule-strong"></span>
    {{if .Control}}<span class="flex shrink-0 items-center">{{.Control}}</span>{{end}}
  </div>
  {{else if or .Title .Meta .Control}}
  {{/* A kicker's list stands a cell under it. */}}
  <div{{if $band}} data-verso-section-band{{end}} class="{{if and .Sub (not $band)}}flex flex-wrap items-center justify-between gap-x-6{{else}}{{template "verso-section-band-class"}}{{end}}{{if .Kicker}} mb-5{{end}}">
    <div class="flex flex-wrap items-center gap-3 leading-5">
      {{/* A kicker names the group under it and nothing more, so it is set at the
           meta size in caps rather than as a heading — a second 18px heading
           beside a rail's list of headings would read as one of them. */}}
      {{if .Title}}{{if .Kicker}}<h2 class="{{template "verso-kicker-class"}}">{{.Title}}</h2>{{else}}<h2 class="{{template "verso-section-title-class"}}">{{.Title}}</h2>{{end}}{{end}}
      {{/* the meta value carries a stable hook: a section whose content is live
           (a streaming listing) has the shell rewrite this one string — how
           many events are shown, how fast they arrive — and nothing else. */}}
      {{if and .Meta .MetaInline}}<span class="text-inert" aria-hidden="true">·</span><span class="inline-flex items-center gap-1.5 text-sm leading-5 text-meta">{{if .MetaIcon}}{{icon .MetaIcon "size-4 shrink-0 text-faint"}}{{end}}{{if .MetaLabel}}<span>{{.MetaLabel}}</span>{{end}}<span data-verso-section-meta class="font-medium">{{.Meta}}</span></span>{{end}}
    </div>
    {{if and .Meta (not .MetaInline)}}<span class="{{template "verso-section-meta-class"}}">{{if .MetaIcon}}{{icon .MetaIcon "size-4 shrink-0 text-faint"}}{{end}}{{if .MetaLabel}}<span class="{{template "verso-section-meta-label-class"}}">{{.MetaLabel}}</span>{{end}}<span data-verso-section-meta class="{{template "verso-section-meta-value-class"}}">{{.Meta}}</span></span>{{end}}
    {{/* Heading actions finish at the content's right edge, including when
         they wrap below the title. They keep a field's height, centred on
         the title's 20px line and reaching past it, so the title stays on
         the notebook's line whatever stands beside it. */}}
    {{if .Control}}<span class="ml-auto flex h-5 w-full items-center justify-end sm:w-auto [&>button]:h-control [&>button]:gap-2 [&>button]:px-4">{{.Control}}</span>{{end}}
    {{if and .Sub $band}}{{template "verso-section-lede" .Sub}}{{end}}
  </div>
  {{end}}
  {{if and .Sub (not $band)}}<div data-verso-section-lede class="{{template "verso-section-lede-class"}} mb-5">{{.Sub}}</div>{{end}}
  {{/* Blocks stand off from each other; form rows sit flush. The rule is named
       in input.css, where the two declarations can be ordered deliberately. */}}
  <div class="verso-rhythm">{{range .Children}}{{.}}{{end}}</div>
</section>
