{{/* section: a grouped block with an optional heading and generous space above it,
     marking a new context on the page. The top space is padding (not margin), so it
     never collapses against the previous element. With a sub, the description sits
     tight under the title (they read as one head unit) and the saved space moves
     below the sub — the title-to-content distance stays what it was without one. */}}
{{/* Hairline is opt-in. When enabled, a section that follows another draws the
     page's divider rule with air on both sides. */}}
<section class="pt-6{{if .Hairline}} [section+&]:mt-10 [section+&]:border-t [section+&]:border-slate-200 [section+&]:pt-10{{end}}">
  {{if or .Title .Meta}}
  <div class="{{if .Sub}}mb-1{{else}}mb-3{{end}} flex flex-wrap items-center justify-between gap-x-6 gap-y-1">
    {{if .Title}}<h3 class="text-xl font-semibold tracking-tight text-slate-900">{{.Title}}</h3>{{end}}
    {{if .Meta}}<span class="inline-flex items-center gap-1.5 text-sm">{{if .MetaIcon}}{{icon .MetaIcon "size-4 shrink-0 text-slate-500"}}{{end}}{{if .MetaLabel}}<span class="text-slate-500">{{.MetaLabel}}</span>{{end}}<span class="font-semibold text-slate-700">{{.Meta}}</span></span>{{end}}
  </div>
  {{end}}
  {{if .Sub}}<div class="verso-prose mb-6 max-w-[72ch] text-sm text-slate-500">{{.Sub}}</div>{{end}}
  <div class="space-y-8">{{range .Children}}{{.}}{{end}}</div>
</section>
