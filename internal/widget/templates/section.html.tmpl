{{/* section: a grouped block with an optional heading and generous space above it,
     marking a new context on the page. The top space is padding (not margin), so it
     never collapses against the previous element. With a sub, the description sits
     tight under the title (they read as one head unit) and the saved space moves
     below the sub — the title-to-content distance stays what it was without one. */}}
<section class="pt-6">
  {{if .Title}}<h3 class="{{if .Sub}}mb-1{{else}}mb-3{{end}} text-lg font-semibold tracking-tight text-slate-900">{{.Title}}</h3>{{end}}
  {{if .Sub}}<div class="verso-prose mb-6 max-w-[72ch] text-sm text-slate-500">{{.Sub}}</div>{{end}}
  <div class="space-y-4">{{range .Children}}{{.}}{{end}}</div>
</section>
