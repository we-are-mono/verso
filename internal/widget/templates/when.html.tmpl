{{/* when: the rows a choice shows for one of its values (blocks/when.css). */}}
<fieldset data-verso-when="{{.Name}}" data-verso-when-value="{{.Value}}"{{if not .Active}} hidden disabled{{end}} class="verso-when">
  {{range .Body}}{{.}}{{end}}
</fieldset>
