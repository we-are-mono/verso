{{/* disclosure: a native <details> expand/collapse. The chevron rotates via the
     shared .verso-chevron rule (details[open] > summary .verso-chevron). No JS. */}}
<details class="verso-disclosure rounded-lg border border-slate-200 bg-white">
  <summary class="flex cursor-pointer select-none items-center justify-between gap-2 px-4 py-3 text-sm font-medium text-slate-700 [&::-webkit-details-marker]:hidden">
    {{.Summary}}
    {{icon "chevron-right" "verso-chevron size-4 text-slate-400"}}
  </summary>
  <div class="space-y-4 border-t border-slate-200 px-4 py-4">
    {{range .Children}}{{.}}{{end}}
  </div>
</details>
