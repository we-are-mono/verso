{{/* disclosure: a native <details> expand/collapse (blocks/disclosure.css),
     the chevron block turning its glyph while the details is open. No JS. A
     reveal folds optional rows behind one quiet act (blocks/reveal.css). */}}
{{if eq .Style "reveal"}}
<details{{if .Open}} open{{end}} class="verso-reveal">
  <summary class="verso-reveal__act">{{icon "plus" "size-4"}}{{.Summary}}</summary>
  <div class="verso-rhythm">{{range .Children}}{{.}}{{end}}</div>
</details>
{{else}}
<details{{if .Open}} open{{end}} class="verso-disclosure"{{if eq .Style "condition"}} data-verso-style="condition"{{end}}>
  <summary class="verso-disclosure__summary">
    {{.Summary}}
    {{icon "chevron-right" "verso-chevron size-4 text-faint"}}
  </summary>
  <div class="verso-disclosure__body verso-rhythm">{{range .Children}}{{.}}{{end}}</div>
</details>
{{end}}
