{{/* conditions: optional typed form blocks. Every catalogue entry is rendered
     once into an inert template; the shell's shared JS adds/removes those blocks.
     Plugin code declares data and ordinary child widgets, never DOM behaviour. */}}
{{/* Added conditions use the shared stacked fields, with an action at the
     right to remove the whole condition. */}}
{{define "conditions.item"}}
{{/* The remove action stays inside the form measure, beside the first label. */}}
<section data-verso-condition="{{.Key}}" class="flex max-w-form items-start gap-3">
  <div class="verso-rhythm min-w-0 flex-1 [&>div]:border-0">{{range .Children}}{{.}}{{end}}</div>
  <button type="button" data-verso-condition-remove aria-label="{{ t "Remove" }} {{.Label}}" title="{{ t "Remove" }} {{.Label}}" class="mt-3 {{template "verso-remove-glyph-class"}}">{{icon "x" "size-4"}}</button>
</section>
{{end}}
<fieldset data-verso-conditions class="space-y-2">
  <div>
    <legend class="text-lg leading-tight font-semibold tracking-[-0.025em] text-ink">{{if .Label}}{{.Label}}{{else}}{{ t "Conditions" }}{{end}}</legend>
    {{if .Help}}<p class="verso-prose mt-2 max-w-[36rem] text-sm leading-snug text-body">{{.Help}}</p>{{end}}
  </div>
  <div data-verso-condition-list>{{range .Active}}{{.}}{{end}}</div>
  <p data-verso-condition-empty class="max-w-[36rem] rounded-xs bg-quiet px-3 py-2 text-sm leading-snug text-body{{if .Active}} hidden{{end}}">{{ t "No additional conditions. All traffic matching the path and protocol above is included." }}</p>
  {{/* The way in sits under a rule of its own: what is above it is this rule as
       it stands, what is below is the offer to add to it.

       One act, not two. It was a closed list beside an Add button, which made
       adding a condition a matter of finding it in a drop-down of everything and
       then pressing something else — and a drop-down cannot be searched, cannot
       show what a condition writes, and cannot say what sort of value it takes.
       The picker is a list someone reads or filters, and pressing a line adds it. */}}
  <div data-verso-condition-picker class="relative border-t border-rule pt-4">
    <button type="button" data-verso-condition-open aria-expanded="false" class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{icon "plus" "size-4"}}{{ t "Add a condition" }}</button>
    <div data-verso-condition-menu hidden class="absolute top-full left-0 z-30 mt-2 w-[36rem] max-w-[calc(100vw-2rem)] rounded-xs border border-rule-strong bg-ground shadow-[0_8px_24px_rgba(27,25,23,.14)]">
      {{/* The filter is the first thing focus lands on, because on a catalogue
           this size typing the name is faster than reading to find it. It is not
           a form control of this form: it filters a list and posts nothing. */}}
      <div class="flex items-center gap-2 border-b border-rule-strong px-3 py-2.5">
        <span class="flex flex-none text-faint">{{icon "search" "size-4"}}</span>
        <input data-verso-condition-filter type="text" autocomplete="off"
          placeholder="{{ t "Filter conditions" }}" aria-label="{{ t "Filter conditions" }}"
          class="h-6 min-w-0 flex-1 border-0 bg-transparent p-0 text-sm text-ink outline-none placeholder:font-normal placeholder:text-meta">
      </div>
      <div class="verso-drawer-scrollbar max-h-90 overflow-y-auto">
        {{/* Each hairline is the top of the thing below it, never the bottom of the
             thing above: a heading rules itself off from the group before it, and
             every entry but the first under a heading rules itself off from its
             neighbour. Drawn the other way round, the last entry's line lands
             against the panel's own border and the list ends in a seam. */}}
        {{range $i, $group := .Groups}}
        <div data-verso-condition-group{{if $group.Name}} data-verso-condition-group-name="{{$group.Name}}"{{end}}>
          {{if $group.Name}}<div class="border-b border-rule bg-quiet px-4 py-2.5{{if $i}} border-t{{end}}"><span class="{{template "verso-kicker-class"}}">{{$group.Name}}</span></div>{{end}}
          <div>
            {{range $group.Items}}
            {{/* A condition the rule already carries stays in the list and stays
                 legible — it is part of the catalogue whether or not it is in use —
                 but it is not an offer any more, so it is quiet and inert. */}}
            <button type="button" data-verso-condition-choose="{{.Key}}"{{if .Active}} disabled{{end}} class="flex w-full items-center gap-3 border-t border-rule px-4 py-2 text-left transition-colors first:border-t-0 enabled:cursor-pointer enabled:hover:bg-quiet/50 disabled:opacity-45">
              <span class="flex-none text-sm font-semibold text-ink">{{.Label}}</span>
              <span class="{{template "verso-chip-class"}}">{{.Key}}</span>
              {{if .Hint}}<span class="ml-auto flex-none text-sm text-meta">{{.Hint}}</span>{{end}}
            </button>
            {{end}}
          </div>
        </div>
        {{end}}
        <p data-verso-condition-none hidden class="px-4 py-5 text-sm leading-snug text-body">{{ t "Nothing matches. Try the option's name as the config spells it." }}</p>
      </div>
    </div>
  </div>
  {{range $i, $item := .Templates}}<template data-verso-condition-template="{{(index $.Options $i).Key}}">{{$item}}</template>{{end}}
</fieldset>
