{{/* conditions: optional typed form blocks. Every catalogue entry is rendered
     once into an inert template; the shell's shared JS adds/removes those blocks.
     Plugin code declares data and ordinary child widgets, never DOM behaviour. */}}
{{define "conditions.item"}}
<section data-verso-condition="{{.Key}}" class="rounded-lg border border-slate-200 bg-slate-50/70 dark:border-gray-700 dark:bg-gray-800/50">
  <header class="flex items-start justify-between gap-4 px-4 pt-3.5 pb-3">
    <div class="min-w-0">
      <h5 class="text-sm font-semibold text-slate-900 dark:text-gray-100">{{.Label}}</h5>
      {{if .Help}}<p class="mt-0.5 text-sm text-slate-500 dark:text-gray-400">{{.Help}}</p>{{end}}
    </div>
    <button type="button" data-verso-condition-remove class="shrink-0 text-sm font-medium text-slate-500 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 dark:text-gray-400 dark:hover:text-gray-200">{{ t "Remove" }}</button>
  </header>
  <div class="space-y-5 border-t border-slate-200 px-4 py-4 dark:border-gray-700">{{range .Children}}{{.}}{{end}}</div>
</section>
{{end}}
<fieldset data-verso-conditions class="space-y-4">
  <div>
    <legend class="text-base font-semibold text-slate-900 dark:text-gray-100">{{if .Label}}{{.Label}}{{else}}{{ t "Conditions" }}{{end}}</legend>
    {{if .Help}}<p class="mt-1 text-sm text-slate-500 dark:text-gray-400">{{.Help}}</p>{{end}}
  </div>
  <div data-verso-condition-list class="space-y-3">{{range .Active}}{{.}}{{end}}</div>
  <p data-verso-condition-empty class="rounded-md bg-slate-50 px-3 py-2.5 text-sm text-slate-500 dark:bg-gray-800 dark:text-gray-400{{if .Active}} hidden{{end}}">{{ t "No additional conditions. All traffic matching the path and protocol above is included." }}</p>
  <div class="flex items-end gap-3">
    <label class="min-w-0 flex-1 space-y-1.5">
      <span class="block text-sm font-medium text-slate-900 dark:text-gray-100">{{ t "Add condition" }}</span>
      <span class="relative block">
        <select data-verso-condition-select class="w-full appearance-none rounded-md border border-slate-300 bg-white py-2 pr-9 pl-3 text-sm text-slate-900 focus:border-sky-600 focus:ring-2 focus:ring-sky-600/20 focus:outline-none dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:focus:border-sky-400 dark:focus:ring-sky-400/50">
          <option value="">{{ t "Choose a condition…" }}</option>
          {{range .Options}}<option value="{{.Key}}"{{if .Active}} disabled hidden{{end}}>{{.Label}}</option>{{end}}
        </select>
        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">{{icon "chevron-down" "size-4"}}</span>
      </span>
    </label>
    <button type="button" data-verso-condition-add class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:border-sky-600 hover:text-sky-600 active:translate-y-px active:shadow-none motion-reduce:active:translate-y-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2 dark:border-gray-700 dark:bg-transparent dark:text-gray-300 dark:hover:border-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-200 dark:active:bg-gray-900">{{ t "Add" }}</button>
  </div>
  {{range $i, $item := .Templates}}<template data-verso-condition-template="{{(index $.Options $i).Key}}">{{$item}}</template>{{end}}
</fieldset>
