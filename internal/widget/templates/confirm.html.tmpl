{{/* confirm: a destructive action with an inline confirmation. The shell's
     confirm component (verso.js) swaps the trigger for the question: both are
     real buttons, so Tab reaches them and Enter or Space presses them. Asking
     puts focus on the first thing to answer with; the way back and Escape
     return it to the trigger. The confirm button submits. */}}
{{/* Both states stand on crimson's own soft ground inside its hairline, and the
     words are the step of that hue that can carry them. The full-chroma value
     stays a mark, on the icon — an alarm the size of a paragraph would read as
     the page shouting rather than as one act asking to be reconsidered. */}}
<div class="verso-confirm" x-data="confirm" @keydown.escape="escape">
  <button type="button" x-ref="trigger" x-show="idle" @click="ask" :aria-expanded="expanded" aria-controls="{{.ID}}" class="block w-full cursor-pointer rounded-xs border border-crimson-line bg-crimson-soft px-4 py-2.5 text-center text-sm font-semibold text-crimson-deep transition-colors hover:border-crimson active:translate-y-px active:shadow-none motion-reduce:active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-crimson-deep">{{.Trigger}}</button>
  <div id="{{.ID}}" x-show="asking" x-cloak class="rounded-xs border border-crimson-line bg-crimson-soft p-4 text-sm">
    <div class="flex gap-2 text-crimson-deep">
      {{icon "triangle-alert" "mt-0.5 size-4 shrink-0 text-crimson"}}
      {{if .Title}}<div><p class="text-base font-semibold">{{.Title}}</p><p class="mt-1 leading-[1.45]">{{.Message}}</p></div>{{else}}<p class="leading-[1.45]">{{.Message}}</p>{{end}}
    </div>
    <div class="mt-6 ml-6 flex items-center justify-start gap-2">
      {{if .RequirePassword}}<input x-ref="first" name="password" type="password" autocomplete="current-password" placeholder="{{ t "Password" }}" aria-label="{{ t "Administrator password" }}" class="{{template "verso-input-words"}} w-1/3 min-w-0 border-crimson-line hover:border-crimson focus:border-crimson-deep">{{end}}
      <button type="submit"{{if not .RequirePassword}} x-ref="first"{{end}} class="{{template "verso-btn-box"}} shrink-0 {{template "verso-btn-danger"}} focus-visible:outline-crimson-deep">{{.Confirm}}</button>
      {{/* the cancel keeps the explanation's tone at rest and hovers by a soft
           wash, not a colour shift — darkening the deep step desaturates it
           toward maroon and reads heavy. */}}
      <button type="button" @click="cancel" class="flex h-9 shrink-0 cursor-pointer items-center rounded-xs px-3 text-sm font-semibold text-crimson-deep transition-colors hover:bg-crimson-line/50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-crimson-deep">{{.Cancel}}</button>
    </div>
  </div>
</div>
