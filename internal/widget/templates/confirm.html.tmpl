{{/* confirm: a destructive action with an inline confirmation. Pure CSS (ADR-005 §7)
     — a hidden checkbox flips between the danger button and the confirm panel (see
     .verso-confirm in verso.css). Cancel is a label that unticks the checkbox; the
     confirm button submits. No JavaScript. */}}
<div class="verso-confirm">
  <input type="checkbox" id="{{.ID}}" class="verso-confirm-toggle sr-only">
  <label for="{{.ID}}" class="verso-confirm-trigger w-full cursor-pointer rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-center text-sm font-medium text-red-600 transition-colors hover:bg-red-100 dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-400 dark:hover:bg-red-500/15">{{.Trigger}}</label>
  <div class="verso-confirm-panel rounded-lg border border-red-200 bg-red-50 p-4 text-sm dark:border-red-500/20 dark:bg-red-500/10">
    <div class="flex gap-2 text-base text-red-800 dark:text-red-300">
      {{icon "triangle-alert" "mt-0.5 size-4 shrink-0 text-red-400"}}
      <p>{{.Message}}</p>
    </div>
    <div class="mt-6 ml-6 flex items-center justify-start gap-2">
      {{if .RequirePassword}}<input name="password" type="password" autocomplete="current-password" placeholder="Password" aria-label="Administrator password" class="w-1/3 min-w-0 rounded-md border border-slate-300 bg-white px-3 py-2 inset-shadow-sm text-sm text-slate-900 focus:border-sky-600 focus:outline-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:placeholder:text-gray-500">{{end}}
      <button type="submit" class="shrink-0 rounded-md bg-red-600 px-4 py-2 font-medium text-white transition-colors hover:bg-red-700 dark:bg-red-700 dark:text-gray-100 dark:hover:bg-red-800 dark:active:bg-red-900">{{.Confirm}}</button>
      <label for="{{.ID}}" class="shrink-0 cursor-pointer px-3 py-2 font-medium text-red-600 transition-colors hover:text-red-800 hover:underline dark:text-red-400 dark:hover:text-red-300">{{.Cancel}}</label>
    </div>
  </div>
</div>
