{{/* confirm: a destructive action with an inline confirmation. Pure CSS (ADR-005 §7)
     — a hidden checkbox flips between the danger button and the confirm panel (see
     .verso-confirm in verso.css). Cancel is a label that unticks the checkbox; the
     confirm button submits. No JavaScript. */}}
<div class="verso-confirm">
  <input type="checkbox" id="{{.ID}}" class="verso-confirm-toggle sr-only">
  <label for="{{.ID}}" class="verso-confirm-trigger w-full cursor-pointer rounded-lg border border-red-200 bg-red-50 px-4 py-2.5 text-center text-sm font-medium text-red-600 transition-colors hover:bg-red-100">{{.Trigger}}</label>
  <div class="verso-confirm-panel rounded-lg border border-red-200 bg-red-50 p-4 text-sm">
    <div class="flex gap-2 text-red-700">
      {{icon "triangle-alert" "mt-0.5 size-4 shrink-0"}}
      <p>{{.Message}}</p>
    </div>
    <div class="mt-3 flex justify-end gap-2">
      <label for="{{.ID}}" class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-1.5 font-medium text-slate-700 transition-colors hover:border-slate-400">{{.Cancel}}</label>
      <button type="submit" class="rounded-md bg-red-600 px-3 py-1.5 font-medium text-white transition-colors hover:bg-red-700">{{.Confirm}}</button>
    </div>
  </div>
</div>
