{{/* ports: a device's physical rear panel, drawn to scale from the supplied port list.
     Display-only; the hover/focus tooltip is pure CSS. The connector art, palette, and
     "connected" colour are the shell's (ADR-005) — the caller supplies ports + state.
     Connectors drawn to real spec: RJ45 (8P8C) ~11.68×8.0mm, SFP+ ~13.4×8.5mm. */}}
<div class="verso-ports verso-ports--{{.Accent}}">
  {{if .Device}}<div class="verso-ports-name">{{.Device}}</div>{{end}}
  {{if .HasPanel}}
  {{/* The board profile's own panel art, lit from live state (litPanel tagged its
       data-verso-port groups). One face carries no side label — which side the
       connectors sit on is not the point; both faces earn a Front/Rear control. */}}
  {{if .PanelBoth}}
  <div class="verso-panel-art" x-data="panelFaces">
    {{/* Which face of the board you are looking at: the app's segmented control,
         a quiet strip with the chosen segment filled in the body ink, as every
         selected segment is. The bindings are the panelFaces component's
         properties (verso.js): the CSP build of Alpine evaluates no expressions. */}}
    <div class="mb-3 inline-flex items-center gap-0.5 rounded-xs border border-rule-strong bg-quiet p-0.5 text-sm">
      <button type="button" @click="showRear" :class="rearClass" :aria-pressed="rearPressed" class="h-7 rounded-xs px-3.5 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">{{ t "Rear" }}</button>
      <button type="button" @click="showFront" :class="frontClass" :aria-pressed="frontPressed" class="h-7 rounded-xs px-3.5 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-denim">{{ t "Front" }}</button>
    </div>
    <div x-show="rear">{{.Back}}</div>
    <div x-show="front" x-cloak>{{.Front}}</div>
  </div>
  {{else}}
  <div class="verso-panel-art">{{if .Back}}{{.Back}}{{else}}{{.Front}}{{end}}</div>
  {{end}}
  {{if .Legend}}
  <div class="verso-ports-legend">
    <span class="verso-ports-key"><span class="verso-ports-dot on"></span>{{ t "Connected" }}</span>
    <span class="verso-ports-key"><span class="verso-ports-dot act"></span>{{ t "Traffic" }}</span>
    <span class="verso-ports-key"><span class="verso-ports-dot"></span>{{ t "Not connected" }}</span>
    {{if .HasWAN}}<span class="verso-ports-key">{{ t "Internet = your WAN connection" }}</span>{{end}}
  </div>
  {{end}}
</div>
{{else}}
  <div class="verso-ports-chassis-wrap">
    <div class="verso-ports-chassis">
      <span class="verso-ports-screw tl"></span><span class="verso-ports-screw tr"></span><span class="verso-ports-screw bl"></span><span class="verso-ports-screw br"></span>
      {{range .Items}}
      {{/* Two LEDs sit in the lip below the mouth, where a real jack carries
           them: green = link (solid when a cable is up), amber = activity
           (blinks while traffic flows). */}}
      <div class="verso-port {{if .Linked}}is-linked{{else}}is-empty{{end}}{{if .Active}} is-active{{end}}{{if eq .Role "wan"}} is-wan{{end}}" tabindex="0" role="group" aria-label="{{.Label}}"{{if .Iface}} data-verso-port="{{.Iface}}"{{end}}>
        {{/* The LEDs say the link state in colour; these say it in words. Both are
             here and the port's live class keeps the matching one (input.css), so
             a stream that relinks the port changes what is read too. */}}
        <span class="verso-port-state-on sr-only">{{ t "Connected" }}</span>
        <span class="verso-port-state-off sr-only">{{ t "Not connected" }}</span>
        {{if eq .Kind "sfp"}}
        <svg class="verso-port-cage" viewBox="0 0 86 60" aria-hidden="true">
          <rect class="verso-port-frame" x="4" y="3" width="78" height="54" rx="4"/>
          <rect class="verso-port-mouth" x="11" y="10" width="64" height="40" rx="2.5"/>
          <rect class="verso-port-module" x="14" y="13" width="58" height="34" rx="1.5"/>
          <path class="verso-port-clasp" d="M8 17 v26"/>
          <circle class="verso-port-led led-link" cx="64" cy="53.5" r="2.3"/>
          <circle class="verso-port-led led-act" cx="74" cy="53.5" r="2.3"/>
        </svg>
        {{else}}
        <svg class="verso-port-jack" viewBox="0 0 76 60" aria-hidden="true">
          <rect class="verso-port-frame" x="3" y="3" width="70" height="54" rx="4"/>
          <path class="verso-port-mouth" d="M9 11 h58 v33 h-19 v7 h-20 v-7 h-19 z"/>
          <line class="verso-port-pin" x1="20.2" y1="13" x2="20.2" y2="19"/><line class="verso-port-pin" x1="25.3" y1="13" x2="25.3" y2="19"/><line class="verso-port-pin" x1="30.4" y1="13" x2="30.4" y2="19"/><line class="verso-port-pin" x1="35.5" y1="13" x2="35.5" y2="19"/><line class="verso-port-pin" x1="40.6" y1="13" x2="40.6" y2="19"/><line class="verso-port-pin" x1="45.7" y1="13" x2="45.7" y2="19"/><line class="verso-port-pin" x1="50.8" y1="13" x2="50.8" y2="19"/><line class="verso-port-pin" x1="55.9" y1="13" x2="55.9" y2="19"/>
          <circle class="verso-port-led led-link" cx="16" cy="50.5" r="2.3"/>
          <circle class="verso-port-led led-act" cx="60" cy="50.5" r="2.3"/>
        </svg>
        {{end}}
        <div class="verso-port-label">{{.Label}}</div>
        {{/* A port with an Iface is live (the overview stream updates it in
             place), so its speed, addr, and link slots render empty — a later
             reading needs a place to land. */}}
        {{if .Iface}}<div class="verso-port-speed"></div>{{end}}
        <div class="verso-port-tip">
          <b>{{.Label}}</b>{{if .Role}} · <span class="role">{{.Role}}</span>{{end}}
          {{if .Iface}}<div class="r"><span class="k">iface</span>{{.Iface}}</div>{{end}}
          {{if .Note}}<div class="r"><span class="k">type</span>{{.Note}}</div>{{end}}
          {{if or .Addr .Iface}}<div class="r"><span class="k">addr</span><span data-verso-port-addr>{{.Addr}}</span></div>{{end}}
          {{if .Iface}}<div class="r"><span class="k">link</span><span data-verso-port-link></span></div>{{end}}
        </div>
      </div>
      {{end}}
    </div>
  </div>
  {{if .Legend}}
  <div class="verso-ports-legend">
    <span class="verso-ports-key"><span class="verso-ports-dot on"></span>{{ t "Connected" }}</span>
    <span class="verso-ports-key"><span class="verso-ports-dot act"></span>{{ t "Traffic" }}</span>
    <span class="verso-ports-key"><span class="verso-ports-dot"></span>{{ t "Not connected" }}</span>
    {{if .HasWAN}}<span class="verso-ports-key">{{ t "Internet = your WAN connection" }}</span>{{end}}
    {{if .HasRJ45}}<span class="verso-ports-key">{{ t "RJ45 = network cable" }}</span>{{end}}
    {{if .HasSFP}}<span class="verso-ports-key">{{ t "SFP+ = fiber" }}</span>{{end}}
  </div>
  {{end}}
{{end}}
</div>
