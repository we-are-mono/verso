{{/* Network inventory is still a typed table. The shell owns its tree,
     expansion, copy controls and runtime refresh; plugins supply only data. */}}
{{define "table.interfaces"}}
<div data-verso-inventory class="min-w-0 overflow-x-auto">
  <p data-verso-inventory-stale role="status" hidden class="mb-4 text-sm text-marigold-deep">{{t "Live status could not be refreshed. Retrying…"}}</p>
  <table class="group/inventory w-full min-w-[66rem] table-fixed border-collapse text-left text-sm">
    <colgroup><col><col class="w-30"><col class="w-44"><col class="w-50"><col class="w-32"><col class="w-39"></colgroup>
    <thead><tr>{{range $i, $col := .Columns}}<th scope="col" class="border-b border-rule-strong pb-2 text-xs font-medium tracking-[.08em] text-meta uppercase {{if eq $i 0}}pl-[122px]{{else if eq $i 5}}pr-4{{end}}">{{.Label}}</th>{{end}}</tr></thead>
    <tbody>
    {{range .Rows}}
      {{$row := .}}
      <tr data-verso-row-id="{{.ID}}" data-verso-tags="{{.Tags}}" class="group/row h-11 border-b border-rule hover:bg-quiet/50 data-[expanded=true]:bg-quiet">
      {{range $i, $cell := .Cells}}
        {{if eq $i 0}}
        <td class="relative py-0 pl-4">
          <svg width="66" viewBox="0 0 66 44" preserveAspectRatio="none" aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-4 h-full text-faint group-data-[filtered=true]/inventory:hidden"><path d="{{$row.TreePath}}" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke"/></svg>
          <button type="button" data-verso-expand-row aria-expanded="false" aria-label="{{t "Details"}} · {{.Text}}" aria-description="{{range .Chips}}{{if .Title}}{{.Title}} {{end}}{{end}}" class="group/identity flex min-h-11 w-full cursor-pointer items-center text-left focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-denim">
            <svg width="66" height="44" viewBox="0 0 66 44" class="relative shrink-0 overflow-visible text-glyph" aria-hidden="true">
              <g class="group-data-[filtered=true]/inventory:hidden">{{if $row.TreeRoot}}{{if eq .LeadIcon "physical"}}<rect x="{{$row.TreeNodeX}}" y="18" width="9" height="9" rx="1" stroke="currentColor" stroke-width="1.5" class="fill-ground"/>{{else}}<circle cx="{{$row.TreeNodeCenter}}" cy="22" r="4" stroke="currentColor" stroke-width="1.5" class="fill-ground"/>{{end}}{{end}}</g>
            </svg>
            <span data-verso-expand-chevron class="grid size-7 shrink-0 place-items-center rounded-xs border border-rule-strong text-glyph group-aria-expanded/identity:border-denim group-aria-expanded/identity:bg-denim group-aria-expanded/identity:text-white">{{icon "chevron-right" "size-3.5 group-aria-expanded/identity:rotate-90"}}</span>
            <span class="flex min-w-0 flex-wrap items-center gap-1 py-1.5 pr-3 pl-3"><span class="break-all font-mono text-base font-bold text-ink">{{.Text}}</span>{{range .Chips}}{{template "verso-chip" .}}{{end}}</span>
          </button>
        </td>
        {{else if eq $i 5}}
        <td class="py-1.5 pr-4"><div class="flex w-35 items-center justify-end">
          {{range .Actions}}
          {{if .Href}}<a href="{{.Href}}" aria-label="{{.Title}}" class="{{template "table.actbtn-class"}}">{{icon .Icon "size-4"}}<span class="{{template "verso-tip-class"}} group-hover/act:opacity-100 group-focus-visible/act:opacity-100">{{.Title}}</span></a>
          {{else if .Name}}<form method="post" class="flex">{{template "verso-csrf" $cell.CSRFToken}}<button type="submit" name="{{.Name}}" value="{{.Value}}" aria-label="{{.Title}}" class="{{template "table.actbtn-class"}}">{{icon .Icon "size-4"}}<span class="{{template "verso-tip-class"}} group-hover/act:opacity-100 group-focus-visible/act:opacity-100">{{.Title}}</span></button></form>
          {{else}}<span class="size-7 shrink-0" aria-hidden="true"></span>{{end}}
          {{end}}
        </div></td>
        {{else if eq $i 4}}
        <td class="py-2 pr-2"><span class="inline-flex items-center gap-2 text-sm {{if eq .Variant "danger"}}text-crimson-deep{{else if eq .Variant "warning"}}text-marigold-deep{{else if eq .Variant "success"}}text-ink{{else}}text-meta{{end}}"><span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] {{if eq .Variant "success"}}bg-green{{else if eq .Variant "danger"}}bg-crimson{{else if eq .Variant "warning"}}bg-marigold{{else}}border border-inert{{end}}"></span>{{.Text}}</span></td>
        {{else}}
        <td class="py-2 pr-2 font-mono text-base font-medium {{if eq $i 1}}text-body{{else if eq .Text "—"}}text-faint{{else}}text-ink{{end}}"><span class="flex min-w-0 items-center"><span class="min-w-0 break-words">{{.Text}}</span>{{if .Copy}}{{template "verso-copy-inline" .Text}}{{end}}</span></td>
        {{end}}
      {{end}}
      </tr>
      <tr data-verso-expanded-row hidden><td colspan="6" class="border-b border-rule p-0">
        <div class="relative bg-[#f9f7f3] pt-6 pr-4 pb-8 pl-[110px]">
          {{if .TreeContinuation}}<svg width="66" viewBox="0 0 66 1" preserveAspectRatio="none" aria-hidden="true" class="absolute inset-y-0 left-4 h-full text-faint group-data-[filtered=true]/inventory:hidden"><path d="{{.TreeContinuation}}" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke"/></svg>{{end}}
          <div class="@container min-w-0 [&>a]:mt-5">{{range .Expanded}}{{.}}{{end}}</div>
        </div>
      </td></tr>
    {{end}}
    </tbody>
  </table>
  <p data-verso-listing-empty hidden class="py-5 text-sm text-meta">{{t "Nothing matches."}}</p>
  {{if .Empty}}<p class="py-5 text-sm text-meta">{{.EmptyText}}</p>{{end}}
</div>
{{end}}
