{{/* grid: responsive column layout of pre-rendered children (blocks/grid.css).
     The plugin declared only a style and a target column count (ADR-005);
     turning the count into columns is the shell's job, stated in the block.
     Each child stands in a cell of its own; a split's first cell is the
     form's column. Cards of one kind side by side stand in the page's flow
     as one card does. */}}
{{if eq .Style "form"}}
{{/* Related fields share a row only when their own container has room. The
     group owns the outer field padding, so stacking keeps the same rhythm. */}}
<div class="verso-form-grid"><div class="verso-form-grid__fields" data-verso-columns="{{if le .Columns 1}}1{{else if eq .Columns 2}}2{{else}}3{{end}}">{{range .Children}}{{.}}{{end}}</div></div>
{{else}}
{{$split := or (eq .Style "settings") (eq .Style "editor") (eq .Style "rail")}}
<div class="verso-grid"{{if or $split (eq .Style "figure") (eq .Style "cards")}} data-verso-style="{{.Style}}"{{end}} data-verso-columns="{{if le .Columns 1}}1{{else if eq .Columns 2}}2{{else if eq .Columns 3}}3{{else}}4{{end}}">
  <div class="verso-grid__track">{{range $i, $child := .Children}}<div{{if and $split (eq $i 0)}} data-verso-form-column{{end}} class="verso-grid__cell">{{$child}}</div>{{end}}</div>
</div>
{{end}}
