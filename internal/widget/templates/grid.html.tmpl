{{/* grid: responsive column layout of pre-rendered children. The shell chose the
     responsive column classes (.Cols) and owns the gap; the plugin declared only the
     target column count (ADR-005). The strip style is the home page's divided tile
     row — hairline top and bottom, a divider between slots, each slot padded so the
     rules frame it — for the shell's own status/instrument rows. */}}
{{if .Strip}}
<div class="grid {{.Cols}} divide-x divide-slate-100 border-y border-slate-100">{{range .Children}}<div class="px-6 py-5 first:pl-0 last:pr-0">{{.}}</div>{{end}}</div>
{{else}}
<div class="grid {{.Cols}} {{.Gap}}">{{range .Children}}{{.}}{{end}}</div>
{{end}}
