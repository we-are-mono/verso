{{/* grid: responsive column layout of pre-rendered children. The plugin declared
     only a style and a target column count (ADR-005); turning the count into
     columns is the shell's job, and the classes that do it are stated here and
     only here. The stylesheet is built from the templates alone (input.css
     scans no Go), so a class named in Go is a class the page never gets — which
     is how every grid the shell built from Go once collapsed to one column. */}}
{{if eq .Style "strip"}}
{{/* The strip is the home page's divided tile row — hairline top and bottom, a
     divider between slots, each slot padded so the rules frame it — for the
     shell's own status/instrument rows. It divides evenly across its full width
     however many slots it has: fixed columns, no collapse, so the dividers read
     as one instrument panel at any width. */}}
<div class="grid {{if le .Columns 1}}grid-cols-1{{else if eq .Columns 2}}grid-cols-2{{else if eq .Columns 3}}grid-cols-3{{else if eq .Columns 4}}grid-cols-4{{else}}grid-cols-5{{end}} divide-x divide-rule border-y border-rule">{{range .Children}}<div class="px-6 py-5 first:pl-0 last:pr-0">{{.}}</div>{{end}}</div>
{{else if eq .Style "facts"}}
{{/* An expanded row's facts, in two columns 48px apart from the same top
     line: the first half of them on the left, the rest on the right, as the
     Interfaces canvas lays them out. Narrow, the right column stands under
     the left; an empty column keeps its place only while there are two. A
     code box in a column (what the daemon reported) is not a form's
     footnote, so it drops the rule and the standoff it keeps under a form,
     and takes a row's top padding so its caption stands on the first
     fact's line. */}}
<div data-verso-facts class="grid min-w-0 grid-cols-1 gap-x-12 gap-y-6 @2xl:grid-cols-2 [&_dl]:divide-rule [&_dl>div]:justify-start [&_dt]:w-24 [&_dd]:flex-1 [&_dd]:justify-start [&_dd]:text-left [&>dl:not(:has(*))]:hidden @2xl:[&>dl:not(:has(*))]:block [&>div]:mt-0 [&>div]:min-w-0 [&>div]:border-t-0 [&>div]:pt-2.5 [&>div>span]:text-base">{{range .Children}}{{.}}{{end}}</div>
{{else if eq .Style "settings"}}
<div class="@container"><div class="grid min-w-0 grid-cols-1 gap-10 @6xl:grid-cols-form [&>div:first-child]:max-w-form [&>div:last-child]:self-start @6xl:[&>div:last-child]:sticky @6xl:[&>div:last-child]:top-22 [&_section[id]>.verso-rhythm]:[--verso-rhythm:0rem]">{{range $i, $child := .Children}}<div{{if eq $i 0}} data-verso-form-column{{end}} class="min-w-0">{{$child}}</div>{{end}}</div></div>
{{else if eq .Style "editor"}}
<div class="@container">
  <div class="grid min-w-0 grid-cols-1 gap-10 @6xl:grid-cols-form [&_input]:font-normal [&_select]:font-normal [&_textarea]:font-normal [&_input[name=name]]:font-sans [&_input[name=name]]:text-sm [&_input[type=password]]:font-sans [&_input[type=password]]:text-sm">{{range $i, $child := .Children}}<div{{if eq $i 0}} data-verso-form-column{{end}} class="min-w-0 first:max-w-form">{{$child}}</div>{{end}}</div>
</div>
{{else if eq .Style "rail"}}
{{/* The work keeps the shared form measure; the rail takes the remaining
     width after the page's 40px gutter. Columns only split when their own
     container has room for both, and then the rail stays in view as the form
     scrolls, 32px under the top bar's 56px. At narrower widths the rail
     follows the form, whose measure stays the same. */}}
<div class="@container">
  <div class="grid grid-cols-1 gap-10 @6xl:grid-cols-form [&>:first-child]:max-w-form [&>div:last-child]:self-start @6xl:[&>div:last-child]:sticky @6xl:[&>div:last-child]:top-22">{{range $i, $child := .Children}}<div{{if eq $i 0}} data-verso-form-column{{end}} class="min-w-0">{{$child}}</div>{{end}}</div>
</div>
{{else if eq .Style "form"}}
{{/* Related fields share a row only when their own container has room. The
     group owns the outer field padding, so stacking keeps the same rhythm. */}}
<div class="verso-form-grid"><div class="verso-form-grid-fields" data-verso-columns="{{if le .Columns 1}}1{{else if eq .Columns 2}}2{{else}}3{{end}}">{{range .Children}}{{.}}{{end}}</div></div>
{{else}}
{{/* Small tile and card grids go two-up on phones — never a lonely full-width
     column — and widen on larger screens. */}}
<div class="grid {{if le .Columns 1}}grid-cols-1{{else if eq .Columns 2}}grid-cols-2{{else if eq .Columns 3}}grid-cols-2 md:grid-cols-3{{else}}grid-cols-2 md:grid-cols-4{{end}} gap-8">{{range .Children}}{{.}}{{end}}</div>
{{end}}
