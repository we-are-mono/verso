{{/* meter: a full donut ring. The ring fills by Fill% (a track circle plus a fill
     circle whose stroke-dasharray is the fraction, rotated to start at 12 o'clock);
     the centre shows the value over its unit. The ring carries the proportion, so the
     number never restates it. The shell colours the ring by fill (ADR-005); "info"
     forces the accent for a rate like speed. */}}
<div class="text-center">
  <svg viewBox="0 0 120 120" class="mx-auto w-full max-w-[7.5rem]" role="img" aria-label="{{.Label}} {{.Value}} {{.Unit}}">
    <circle cx="60" cy="60" r="50" fill="none" stroke-width="11" class="stroke-slate-200"/>
    <circle cx="60" cy="60" r="50" fill="none" stroke-width="11" stroke-linecap="round" stroke-dasharray="{{.Dash}}" transform="rotate(-90 60 60)"
      class="{{if eq .Band "info"}}stroke-sky-600{{else if eq .Band "danger"}}stroke-red-600{{else if eq .Band "warn"}}stroke-amber-500{{else}}stroke-green-600{{end}}"/>
    <text x="60" y="53" text-anchor="middle" dominant-baseline="central" font-size="27" font-weight="700" class="fill-slate-900 tabular-nums">{{.Value}}</text>
    {{if .Unit}}<text x="60" y="74" text-anchor="middle" dominant-baseline="central" font-size="13" font-weight="600" class="fill-slate-500">{{.Unit}}</text>{{end}}
  </svg>
  <div class="mt-1 text-sm font-bold uppercase tracking-wide text-slate-500">{{.Label}}</div>
  {{if .Detail}}<div class="mt-0.5 text-xs text-slate-400">{{.Detail}}</div>{{end}}
</div>
