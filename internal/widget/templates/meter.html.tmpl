{{/* meter: a left-aligned horizontal gauge. The label sits over the value in its
     own unit, a thin track carries the fill (coloured by band, ADR-005), and the
     caption holds the one fact worth acting on. The number never restates the
     fill — a storage meter reads "23 GB" over a ~72%-full track. A named meter is
     live (data-verso-meter*): the shell's client script streams fresh
     value/unit/detail and a new width into place (verso.js); "info" forces the
     accent for a rate. */}}
{{if .Overview}}
<div data-verso-meter="{{.Name}}" data-overview-meter aria-label="{{.Label}} {{.Value}} {{.Unit}}" class="flex min-w-0 flex-col gap-3">
  <div class="flex items-center justify-between gap-2"><span class="text-xs font-medium tracking-[.08em] text-meta uppercase">{{.Label}}</span><span aria-hidden="true" class="text-faint">{{icon .Icon "size-4"}}</span></div>
  <div class="flex items-baseline gap-1.5 leading-none"><span class="font-mono text-4xl font-bold tracking-[-.05em] text-ink" data-verso-meter-value>{{.Value}}</span><span class="text-base text-meta" data-verso-meter-unit>{{.Unit}}</span></div>
  <div class="h-1.5 overflow-hidden rounded-full bg-rule"><div class="h-full rounded-full transition-[width] duration-500 motion-reduce:transition-none {{if eq .Tone "danger"}}bg-crimson{{else if eq .Tone "warning"}}bg-marigold{{else}}bg-green{{end}}" style="width:{{.Width}}" data-verso-meter-bar></div></div>
  <div class="min-w-0 truncate text-sm text-meta" data-verso-meter-detail>{{.Detail}}</div>
</div>
{{else if .Compact}}
{{/* compact: one dense row — name · a thin track that fills 0→this reading's own
     critical, with warn/critical tick marks · the value with a status dot. A
     reading with no limits drops the track (never a guessed threshold) and keeps
     a neutral dot. Colour is reserved for state (the fill + dot tone). */}}
{{/* A reading in its ordinary range is a quantity, not a verdict, so its bar is
     the action colour — the canvas draws every normal meter in denim and turns it
     marigold only where the reading is a caveat. Green is reserved for the dot,
     where the palette puts it: a mark that something is well. */}}
<div class="grid grid-cols-[9.5rem_1fr_6.5rem] items-center gap-5 border-b border-rule py-2.5 last:border-0"{{if .Name}} data-verso-meter="{{.Name}}"{{end}} role="img" aria-label="{{.Label}} {{.Value}} {{.Unit}}">
  <span class="truncate text-sm font-medium text-ink">{{.Label}}</span>
  {{if .NoTrack}}
  <span class="text-xs text-meta">{{if .Detail}}{{.Detail}}{{else}}{{ t "no limits reported" }}{{end}}</span>
  {{else}}
  <span class="relative h-1 rounded-full bg-rule">
    <span class="verso-meter-bar absolute inset-y-0 left-0 rounded-full {{if eq .Tone "danger"}}bg-crimson{{else if eq .Tone "warning"}}bg-marigold{{else}}bg-denim{{end}}" style="width: {{.Width}}" data-verso-meter-bar></span>
    {{if .WarnMark}}<span class="absolute -top-1 -bottom-1 w-0.5 rounded-sm bg-marigold-deep" style="left: {{.WarnMark}}"></span>{{end}}
    {{if .CritMark}}<span class="absolute -top-1 -bottom-1 w-0.5 rounded-sm bg-crimson" style="left: calc({{.CritMark}} - 2px)"></span>{{end}}
  </span>
  {{end}}
  <span class="flex items-center justify-end gap-2 tabular-nums">
    <span class="size-2 shrink-0 rounded-full {{if .NoTrack}}bg-glyph{{else if eq .Tone "danger"}}bg-crimson{{else if eq .Tone "warning"}}bg-marigold{{else}}bg-green{{end}}"></span>
    <span class="text-base font-semibold text-ink"><span data-verso-meter-value>{{.Value}}</span>{{if .Unit}} <span class="font-medium text-meta" data-verso-meter-unit>{{.Unit}}</span>{{end}}</span>
  </span>
</div>
{{else}}
<div class="text-left"{{if .Name}} data-verso-meter="{{.Name}}"{{end}} role="img" aria-label="{{.Label}} {{.Value}} {{.Unit}}">
  {{/* A role is a fixed accent a dashboard assigns — download against upload —
       rather than a reading's health, so it keeps its colour whatever the value.
       The palette has two series hues and they are the two the charts use: denim
       for what comes down, amethyst for what goes up. The role names are the
       wire's, from when they were ramp names; what they paint is the palette. */}}
  <div class="flex items-center gap-2 {{template "verso-kicker-class"}}">
    {{if .Icon}}<span class="{{if eq .Role "sky"}}text-denim{{else if eq .Role "violet"}}text-amethyst{{else if eq .Role "emerald"}}text-green{{else if eq .Role "amber"}}text-marigold{{else}}text-faint{{end}}">{{icon .Icon "size-4"}}</span>{{end}}
    <span>{{.Label}}</span>
  </div>
  <div class="mt-3 flex items-baseline gap-1">
    <span class="text-4xl font-extrabold tracking-tight tabular-nums text-ink" data-verso-meter-value>{{.Value}}</span>
    {{if or .Unit .Name}}<span class="text-base font-medium text-meta" data-verso-meter-unit>{{.Unit}}</span>{{end}}
  </div>
  <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-rule">
    <div class="verso-meter-bar h-full rounded-full {{if .Role}}{{if eq .Role "sky"}}bg-denim{{else if eq .Role "violet"}}bg-amethyst{{else if eq .Role "emerald"}}bg-green{{else if eq .Role "amber"}}bg-marigold{{else}}bg-glyph{{end}}{{else if eq .Band "danger"}}bg-crimson{{else if eq .Band "warning"}}bg-marigold{{else}}bg-denim{{end}}" style="width: {{.Width}}" data-verso-meter-bar></div>
  </div>
  {{if or .Detail .Name}}<div class="mt-2.5 text-xs text-meta" data-verso-meter-detail>{{.Detail}}</div>{{end}}
</div>
{{end}}
