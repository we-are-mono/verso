{{/* meter: a reading against its range, the meter block (blocks/meter.css).
     A gauge is one line: the label, a lane holding as many blocks as fit,
     lit to the share (coloured by band, ADR-005), and the value in its own
     unit, the caption under the lane holding the one fact worth acting on. The number never
     restates the fill — a storage meter reads "23 GB" over a ~72%-full
     track. The track carries its share and warn limit as properties the
     block turns into whole blocks. A named meter is live (data-verso-meter*):
     the shell's client script streams fresh value/unit/detail, a new share
     and its band into place (verso-stream.js); "info" forces the accent for a
     rate. */}}
{{if .Overview}}
<div data-verso-meter="{{.Name}}" data-overview-meter aria-label="{{.Label}} {{.Value}} {{.Unit}}" class="verso-meter" data-verso-place="overview">
  <div class="verso-meter__head"><span class="verso-meter__label">{{.Label}}</span></div>
  <div class="verso-meter__reading"><span class="verso-meter__figure" data-verso-figures data-verso-meter-value>{{.Value}}</span><span class="verso-meter__unit" data-verso-meter-unit>{{.Unit}}</span></div>
  <div class="verso-meter__lane"><div class="verso-meter__track" style="{{.Track}}"><div class="verso-meter__bar"{{with .Tone}} data-verso-tone="{{.}}"{{end}} data-verso-meter-bar></div></div></div>
  <div class="verso-meter__detail" data-verso-meter-detail>{{template "meter.detail" .DetailRuns}}</div>
</div>
{{else if .Compact}}
{{/* compact: one dense row — name · as many blocks as the row has room
     for, lit 0→this reading's own ceiling, shaded past its warn limit · the
     value with a status dot. A
     reading with no limits drops the track (never a guessed threshold) and
     keeps a neutral dot. Colour is reserved for state (the fill + dot tone):
     green in the ordinary range, marigold past the warn trip, crimson past
     critical. On a phone the name's column narrows, so the row keeps to its
     card. */}}
<div class="verso-meter" data-verso-place="row"{{if .Name}} data-verso-meter="{{.Name}}"{{end}} role="img" aria-label="{{.Label}} {{.Value}} {{.Unit}}">
  <span class="verso-meter__name">{{.Label}}</span>
  {{if .NoTrack}}
  <span class="verso-meter__note"><span class="verso-mark" aria-hidden="true"></span><span class="truncate">{{if .Detail}}{{.Detail}}{{else}}{{ t "no limits reported" }}{{end}}</span></span>
  {{else}}
  <span class="verso-meter__lane"><span class="verso-meter__track" style="{{.Track}}"><span class="verso-meter__bar"{{with .Tone}} data-verso-tone="{{.}}"{{end}} data-verso-meter-bar></span></span></span>
  {{end}}
  <span class="verso-meter__value">
    <span class="verso-mark" data-verso-tone="{{if .NoTrack}}muted{{else if eq .Tone "danger"}}danger{{else if eq .Tone "warning"}}warning{{else}}success{{end}}"></span>
    <span class="type-card-title text-ink" data-verso-figures><span data-verso-meter-value>{{.Value}}</span>{{if .Unit}}&#x202F;<span class="type-value text-meta" data-verso-meter-unit>{{.Unit}}</span>{{end}}</span>
  </span>
</div>
{{else}}
{{/* A role is a fixed accent a dashboard assigns — download against upload —
     rather than a reading's health, so it keeps its colour whatever the value.
     The role names are the wire's, from when they were ramp names; what they
     paint is the palette. */}}
<div class="verso-meter"{{if .Name}} data-verso-meter="{{.Name}}"{{end}} role="img" aria-label="{{.Label}} {{.Value}} {{.Unit}}">
  <div class="verso-meter__head">
    {{if .Icon}}<span class="verso-meter__glyph"{{with .Role}} data-verso-role="{{.}}"{{end}}>{{icon .Icon "size-4"}}</span>{{end}}
    <span class="verso-meter__label">{{.Label}}</span>
  </div>
  <div class="verso-meter__reading">
    <span class="verso-meter__figure" data-verso-figures data-verso-meter-value>{{.Value}}</span>
    {{if or .Unit .Name}}<span class="verso-meter__unit" data-verso-meter-unit>{{.Unit}}</span>{{end}}
  </div>
  <div class="verso-meter__lane">
    <div class="verso-meter__track" style="{{.Track}}">
      <div class="verso-meter__bar"{{if .Role}} data-verso-role="{{.Role}}"{{else}} data-verso-tone="{{.Band}}"{{end}} data-verso-meter-bar></div>
    </div>
  </div>
  {{if or .Detail .Name}}<div class="verso-meter__detail" data-verso-meter-detail>{{template "meter.detail" .DetailRuns}}</div>{{end}}
</div>
{{end}}
{{/* meter.detail: a gauge's caption, its figures a step heavier than the
     words around them (widget.meterDetail; verso-stream.js cuts a live
     caption the same way). */}}
{{define "meter.detail"}}{{range .}}{{if .Figure}}<span class="verso-meter__number">{{.Text}}</span>{{else}}{{.Text}}{{end}}{{end}}{{end}}
