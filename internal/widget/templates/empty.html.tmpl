{{/* empty: a whole-page state that is not a listing (a listing's nothing is the
     table's one row), the empty block (blocks/empty.css). The children are
     the call(s) to action — typically a modal trigger — so the empty state
     composes the same widgets as the populated page. Icons come from the
     shared Lucide set (icons.go); a "shield" here uses the alert variant —
     nothing is set up yet. */}}
<div class="verso-empty">
  <span class="verso-empty__icon"{{if eq .Variant "success"}} data-verso-tone="success"{{end}}>
    {{if eq .Icon "shield"}}{{icon "shield-alert" "size-9"}}{{else}}{{icon .Icon "size-9"}}{{end}}
  </span>
  {{if .Title}}<h2 class="verso-empty__title">{{.Title}}</h2>{{end}}
  {{/* the body is Markdown, so it brings its own paragraph — the wrapper is a
       div carrying the prose rules, exactly as a section's sub does. */}}
  {{if .Body}}<div class="verso-prose verso-empty__body">{{.Body}}</div>{{end}}
  {{if .Children}}<div class="verso-empty__acts">{{range .Children}}{{.}}{{end}}</div>{{end}}
</div>
