{{/* toggle: a status-hero switch. Pure CSS (ADR-005 §7) — the checkbox's :checked
     state drives the headline swap and the beacon, so the plugin ships no JS. The
     state-varying styles live in verso.css (.verso-toggle), never as utilities, so
     Tailwind's utility layer can't override the :has() rules. Icon from the shared
     Lucide set (icons.go). */}}
<div class="verso-toggle flex items-center justify-between gap-6 rounded-md border border-slate-300 bg-white px-6 py-5 shadow-md">
  <div class="flex min-w-0 items-center gap-4">
    <span class="verso-beacon flex size-12 shrink-0 items-center justify-center rounded-xl">{{icon .Icon "size-6"}}</span>
    <div class="min-w-0">
      <div class="verso-toggle-on text-lg font-semibold text-slate-900">{{.Label}}</div>
      <div class="verso-toggle-off text-lg font-semibold text-slate-900">{{.OffLabel}}</div>
      {{if .Meta}}<div class="verso-toggle-meta mt-0.5 text-sm text-slate-500">{{.Meta}}</div>{{end}}
    </div>
  </div>
  <label class="relative inline-flex h-[1.875rem] w-[3.25rem] shrink-0 cursor-pointer items-center">
    <input type="checkbox" name="{{.Name}}" {{if .Checked}}checked{{end}}
      aria-label="{{.Label}}" class="peer sr-only">
    <span class="absolute inset-0 rounded-full bg-slate-300 transition-colors peer-checked:bg-emerald-500 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-sky-600"></span>
    <span class="absolute left-[0.1875rem] size-6 rounded-full bg-white shadow transition-transform peer-checked:translate-x-[1.375rem]"></span>
  </label>
</div>
