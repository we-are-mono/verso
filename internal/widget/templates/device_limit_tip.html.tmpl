{{/* A device's configured limits at a glance: a week, a time window, two rates
     (blocks/limits.css). The parent tooltip carries the complete text
     alternative. */}}
{{define "verso-device-limit-tip"}}
<span data-verso-limit-readout aria-hidden="true" class="verso-limits">
  {{if .Title}}
  <span class="verso-limits__title"><span class="verso-limits__glyph">{{icon "ban" "size-3.5"}}</span>{{.Title}}</span>
  {{if .Days}}<span class="verso-limits__days">
    {{range .Days}}<span class="verso-limits__day"{{if .Active}} data-verso-active{{end}}>{{.Label}}</span>{{end}}
  </span>{{end}}
  <span class="verso-limits__when">
    {{if and .From .Until}}
    <span class="verso-limits__range"><span class="verso-limits__figure" data-verso-verbatim data-verso-figures>{{.From}}</span><span class="verso-limits__arrow">{{icon "arrow-right" "size-4"}}</span><span class="verso-limits__figure" data-verso-verbatim data-verso-figures>{{.Until}}</span></span>
    {{else if or .From .Until}}
    <span class="verso-limits__range"><span class="verso-limits__qualifier">{{.Qualifier}}</span><span class="verso-limits__figure" data-verso-verbatim data-verso-figures>{{.From}}{{.Until}}</span></span>
    {{else}}<span class="verso-limits__hours">{{.Hours}}</span>{{end}}
    {{if .Clock}}<span class="verso-limits__note">{{.Clock}}</span>{{end}}
  </span>
  {{end}}
  {{if .Rates}}<span class="verso-limits__rates">
    {{range .Rates}}<span class="verso-limits__rate">
      <span class="verso-limits__note">{{icon .Icon "size-3.5 shrink-0"}}{{.Label}}</span>
      <span class="verso-limits__value"{{if .Unit}} data-verso-verbatim data-verso-figures{{end}}>{{.Value}}</span>
      {{if .Unit}}<span class="verso-limits__note">{{.Unit}}</span>{{end}}
    </span>{{end}}
  </span>{{end}}
</span>
{{end}}
