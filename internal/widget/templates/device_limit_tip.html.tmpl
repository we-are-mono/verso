{{/* A device's configured limits at a glance: a week, a time window, two rates.
     The parent tooltip carries the complete text alternative. */}}
{{define "verso-device-limit-tip"}}
<span data-verso-limit-readout aria-hidden="true" class="block">
  {{if .Title}}
  <span class="flex items-center gap-2 text-sm font-semibold text-ink"><span class="text-marigold-deep">{{icon "ban" "size-3.5"}}</span>{{.Title}}</span>
  {{if .Days}}<span class="mt-3 grid grid-cols-7 gap-1">
    {{range .Days}}<span class="flex h-7 min-w-0 items-center justify-center rounded-xs border text-xs {{if .Active}}border-marigold-line bg-marigold-soft font-semibold text-marigold-deep{{else}}border-transparent bg-quiet text-meta{{end}}">{{.Label}}</span>{{end}}
  </span>{{end}}
  <span class="mt-3 block">
    {{if and .From .Until}}
    <span class="flex items-center justify-between gap-3 font-mono text-2xl leading-tight font-medium tabular-nums"><span>{{.From}}</span><span class="text-faint">{{icon "arrow-right" "size-4"}}</span><span>{{.Until}}</span></span>
    {{else if or .From .Until}}
    <span class="flex items-baseline gap-2"><span class="text-sm text-meta">{{.Qualifier}}</span><span class="font-mono text-2xl leading-tight font-medium tabular-nums">{{.From}}{{.Until}}</span></span>
    {{else}}<span class="text-xl leading-tight font-medium">{{.Hours}}</span>{{end}}
    {{if .Clock}}<span class="mt-1 block text-xs text-meta">{{.Clock}}</span>{{end}}
  </span>
  {{end}}
  {{if .Rates}}<span class="grid grid-cols-2 gap-4{{if .Title}} mt-4 border-t border-rule pt-3{{end}}">
    {{range .Rates}}<span class="flex min-w-0 flex-col">
      <span class="flex items-center gap-1.5 text-xs text-meta">{{icon .Icon "size-3.5 shrink-0"}}{{.Label}}</span>
      <span class="mt-1 flex min-h-8 items-center {{if .Unit}}font-mono text-2xl font-medium tabular-nums{{else}}text-base font-medium{{end}} leading-tight">{{.Value}}</span>
      {{if .Unit}}<span class="text-xs text-meta">{{.Unit}}</span>{{end}}
    </span>{{end}}
  </span>{{end}}
</span>
{{end}}
