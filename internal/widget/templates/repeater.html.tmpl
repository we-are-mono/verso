{{/* repeater: a shell-owned repeatable group (ADR-005 §7). Items are the plugin's
     rendered subtrees; the add/remove affordances post back to the page and the
     shell realizes the uci section add/delete. The plugin ships no behaviour. */}}
<div class="space-y-6">
  {{range .Items}}
  <div class="space-y-2">
    {{.Body}}
    <form method="post" class="flex justify-end">
      {{if $.CSRFToken}}<input type="hidden" name="_csrf" value="{{$.CSRFToken}}">{{end}}
      <input type="hidden" name="{{$.OpField}}" value="{{$.OpRemove}}">
      <input type="hidden" name="{{$.ConfigField}}" value="{{$.Config}}">
      <input type="hidden" name="{{$.SectionField}}" value="{{.Section}}">
      <button type="submit" class="cursor-pointer rounded-md border border-red-200 px-3 py-1.5 text-sm font-medium text-red-600 transition-colors hover:bg-red-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2">Remove</button>
    </form>
  </div>
  {{end}}
  <form method="post">
    {{if .CSRFToken}}<input type="hidden" name="_csrf" value="{{.CSRFToken}}">{{end}}
    <input type="hidden" name="{{.OpField}}" value="{{.OpAdd}}">
    <input type="hidden" name="{{.ConfigField}}" value="{{.Config}}">
    <input type="hidden" name="{{.TypeField}}" value="{{.SectionType}}">
    <button type="submit" class="cursor-pointer rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-900 transition-colors hover:border-sky-600 hover:text-sky-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sky-600 focus-visible:ring-offset-2">{{.AddLabel}}</button>
  </form>
</div>
