{{/* repeater: a shell-owned repeatable group (ADR-005 §7). Items are the plugin's
     rendered subtrees; the add/remove affordances post back to the page and the
     shell realizes the uci section add/delete. The plugin ships no behaviour. */}}
<div class="space-y-6">
  {{range .Items}}
  <div class="space-y-2">
    {{.Body}}
    <form method="post" class="flex justify-end">
      {{template "verso-csrf" $.CSRFToken}}
      <input type="hidden" name="{{$.OpField}}" value="{{$.OpRemove}}">
      <input type="hidden" name="{{$.ConfigField}}" value="{{$.Config}}">
      <input type="hidden" name="{{$.SectionField}}" value="{{.Section}}">
      <button type="submit" class="inline-flex h-7 cursor-pointer items-center rounded-xs border border-crimson-line px-3 text-sm font-semibold text-crimson-deep transition-colors hover:bg-crimson-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-crimson-deep">{{ t "Remove" }}</button>
    </form>
  </div>
  {{end}}
  <form method="post">
    {{template "verso-csrf" .CSRFToken}}
    <input type="hidden" name="{{.OpField}}" value="{{.OpAdd}}">
    <input type="hidden" name="{{.ConfigField}}" value="{{.Config}}">
    <input type="hidden" name="{{.TypeField}}" value="{{.SectionType}}">
    <button type="submit" class="{{template "verso-btn-box"}} border {{template "verso-btn-secondary"}} focus-visible:outline-denim">{{.AddLabel}}</button>
  </form>
</div>
