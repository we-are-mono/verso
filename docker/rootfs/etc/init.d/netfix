# Backstop for the management address: if anything leaves eth0 bare between
# preinit's flush and netifd applying the mgmt interface, re-apply the address
# so Docker's published :8080 always has a target. No default route here — the
# default route is wan's (see /etc/config/network). The address MUST match the
# `vnet` static address in docker-compose.yml.
START=91
STOP=99

start() {
	ip link set dev eth0 up 2>/dev/null
	ip address add 172.20.0.10/16 dev eth0 2>/dev/null
	return 0
}
