#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Mono Technologies Inc.

USE_PROCD=1
START=18
STOP=11

# close_web_key makes the web certificate's key at $1 the shell's account's
# alone (ADR-017 §3): every plugin runs in the shell's group, so a key that
# group reads is theirs too. A key written group-readable by an earlier
# release, or brought back so by a sysupgrade or a restored backup, is closed
# here, before any plugin starts. A link there is left as it stands: one a
# restored backup brought back would hand the shell's account what it names.
# The owner is numeric, so it holds whatever /etc/passwd a restore left.
close_web_key() {
	[ -f "$1" ] && [ ! -L "$1" ] || return 0
	chmod 0600 "$1"
	chown 6000:0 "$1"
}

start_service() {
	# Prepare NFLOG before firewall (START=19) can install logging rules.
	/usr/libexec/verso/firewall-logging-setup || logger -t verso-rpcd -p daemon.err 'Firewall packet logging setup failed'
	mkdir -p /var/run/verso
	chown root:verso /var/run/verso
	# Shared runtime dir: the shell stages bounded upload temps (0600, owner-only)
	# here, and installed plugins with no socket directory of their own bind
	# their sockets here, their init scripts setting this same mode; bundled
	# plugins bind in a directory of their own. The sticky bit lets a group
	# member create its own entries but never rename or remove another account's,
	# so a plugin cannot swap the shell's staged archive; the helper still
	# validates file type, owner, and basename.
	chmod 1770 /var/run/verso

	# The update truth has two writers — the daily cron run as root and the
	# shell's own check as `verso` — and each replaces the file by renaming over
	# it. The sticky parent forbids that across accounts, so the file lives one
	# level down in a directory the shell's account owns: both writers can rename
	# into it, while the sticky parent then keeps any other group member (a
	# plugin, under its own uid) from swapping the directory once it exists.
	#
	# Creating it is the exposed moment: the parent is group-writable, so a plugin
	# account starting before this could plant a symlink where the directory
	# belongs, and a chown through it would hand that account whatever it points
	# at. Unlink anything already there (rm frees a symlink without following it),
	# then create with a plain mkdir, which fails on a link that reappears rather
	# than following it — so only a directory we just made is ever chowned.
	rm -rf /var/run/verso/state
	if mkdir /var/run/verso/state 2>/dev/null; then
		chown verso:verso /var/run/verso/state
		chmod 0700 /var/run/verso/state
	fi

	# Config history's spool (ADR-021): the helper renames each config's
	# latest reading in, the shell takes it out. Made as state is, for the
	# same reason; the helper also refuses one the shell's account does not
	# own. A restart empties it, and the helper spools every config again.
	rm -rf /var/run/verso/changes
	if mkdir /var/run/verso/changes 2>/dev/null; then
		chown verso:verso /var/run/verso/changes
		chmod 0700 /var/run/verso/changes
	fi

	# The helper's socket has a directory of its own. In the shared one above any
	# group member may create a name, so a plugin could bind the helper's path in
	# the moment a restart frees it and be sent the operator's session. Here only
	# root creates entries and the verso group may only reach the socket; /var/run
	# is root's, so nothing can stand where the directory belongs before it exists.
	# A helper that once served /var/run/verso/verso-rpcd.sock leaves that file,
	# root's, in place: while it stands no plugin can bind the old name for a shell
	# that still dials it during an upgrade, so it is never removed.
	mkdir -p /var/run/verso-rpcd
	chown root:verso /var/run/verso-rpcd
	chmod 0750 /var/run/verso-rpcd

	close_web_key /etc/verso/tls.key

	procd_open_instance verso-rpcd
	procd_set_param command /usr/sbin/verso-rpcd --socket /var/run/verso-rpcd/verso-rpcd.sock
	# Root owns the narrow privileged actions. The socket admits the verso group,
	# and the daemon additionally verifies peer uid 6000 before checking the SID;
	# the shell, for its part, talks only to a listener the kernel reports as root.
	procd_set_param user root
	procd_set_param group verso
	procd_set_param no_new_privs 1
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
