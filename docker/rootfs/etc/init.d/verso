#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# SPDX-FileCopyrightText: 2026 Mono Technologies Inc.

USE_PROCD=1
START=95
STOP=10

TLS_DIR=/etc/verso
EXTRA_COMMANDS="certificate"
EXTRA_HELP="	certificate	Make a new self-signed certificate for the web interface"

# make_certificate gives the shell a self-signed certificate to serve HTTPS with
# when it has none, or always when asked to "replace": named for every way the
# LAN reaches the router — the hostname, the hostname in the local domain, and
# the lan interface's addresses (the shell keeps IPv4 and unique local IPv6
# among them). It runs here, as root, because the shell cannot write /etc; the
# key is given to the verso account the shell runs as, readable by it alone,
# since every plugin shares the shell's group (ADR-017 §3, §5). The directory
# is root's, readable by that group, whoever made it: verso-rpcd keeps a key of
# its own there, readable by root alone.
make_certificate() {
	local host domain v4 v6
	mkdir -p "$TLS_DIR" && chgrp verso "$TLS_DIR" && chmod 0750 "$TLS_DIR"
	[ "$1" != replace ] && [ -s "$TLS_DIR/tls.crt" ] && [ -s "$TLS_DIR/tls.key" ] && return
	. /lib/functions/network.sh
	host="$(uci -q get system.@system[0].hostname)"
	host="${host:-OpenWrt}"
	domain="$(uci -q get dhcp.@dnsmasq[0].domain)"
	network_get_ipaddrs v4 lan
	network_get_ipaddrs6 v6 lan
	/usr/bin/verso certificate generate "$TLS_DIR" "$host" "$host.${domain:-lan}" $v4 $v6
}

# certificate is Make a new one on Access, run through verso-rpcd, which then
# has the running shell serve the new pair.
certificate() {
	make_certificate replace
}

# HISTORY_FROM records, for the shell's next start, the directory the running
# shell keeps the router's history in once the operator has chosen another
# (ADR-019), so that start moves the history into the one chosen. It is root's,
# in root's own directory, where no other account can point it anywhere.
HISTORY_FROM="$TLS_DIR/history-from"

# history_choice is the directory the router's history is kept in (ADR-019):
# the operator's choice, else /data/verso where /data is a mount, else on the
# overlay.
history_choice() {
	local dir
	config_get dir history directory
	if [ -z "$dir" ]; then
		if grep -qs ' /data ' /proc/mounts; then
			dir=/data/verso
		else
			dir=/usr/share/verso/history
		fi
	fi
	echo "$dir"
}

# history_flag is the directory a shell's arguments, one a line, name for its
# history: the value after -history-dir, among the arguments after
# /usr/bin/verso, as start_service hands it over (ujail, which procd runs the
# shell under, takes arguments of its own before it).
history_flag() {
	local arg shell= dir=
	while IFS= read -r arg; do
		if [ -z "$shell" ]; then
			[ "$arg" = /usr/bin/verso ] && shell=1
		elif [ "$arg" = -history-dir ]; then
			IFS= read -r dir
		fi
	done
	echo "$dir"
}

# history_running is the directory the running shell keeps the history in, as
# its own command line names it: an apply reaches the shell as a SIGHUP, so it
# writes on where it was started, whatever procd records for its next start.
# None when no shell runs.
history_running() {
	local pid
	pid="$(ubus call service list '{"name":"verso"}' 2>/dev/null | jsonfilter -e '@.verso.instances.verso.pid' 2>/dev/null)"
	[ -n "$pid" ] || return 0
	tr '\0' '\n' 2>/dev/null <"/proc/$pid/cmdline" | history_flag
}

# history_note records in HISTORY_FROM where the running shell keeps the
# history while another directory is chosen, and drops the record while the
# running shell keeps it where it is chosen. It answers the running shell's
# directory, none when no shell runs.
history_note() {
	local running
	running="$(history_running)"
	[ -n "$running" ] || return 0
	if [ "$running" = "$(history_choice)" ]; then
		rm -f "$HISTORY_FROM"
	else
		echo "$running" >"$HISTORY_FROM.new" && mv -f "$HISTORY_FROM.new" "$HISTORY_FROM"
	fi
	echo "$running"
}

# history_from is the directory the history moves from at this start: the
# running shell's, at an apply that chose another directory (procd keeps the
# command line for the shell's respawns), else the one HISTORY_FROM recorded
# when a shell last stopped, or ran, with another chosen, taken here once.
history_from() {
	local from
	from="$(history_note)"
	if [ -z "$from" ]; then
		from="$(cat "$HISTORY_FROM" 2>/dev/null)"
		rm -f "$HISTORY_FROM"
	fi
	echo "$from"
}

# history_dir is where the router's history is kept (history_choice). It is
# made here, as root, and given to the verso user, since the shell cannot make
# a directory on /data, the overlay or a USB stick.
#
# The path is the verso user's to set, and root handing that user a directory
# it names, /etc or one holding root's files, would hand it the router. So
# root gives away only a directory it makes here, private from the start, one
# name into /data or /tmp, or two into /mnt where sticks are mounted: below
# directories the verso user cannot rearrange, reached through no link. One
# that stands already is the verso user's from an earlier start, or the shell,
# unable to write it, says so (ADR-019); the shell keeps its own private
# (ADR-021). The two defaults, below directories only root writes, are handed
# over standing too, unless a link: a sysupgrade that keeps settings brings
# them back as root's.
history_dir() {
	local dir
	dir="$(history_choice)"
	case "$dir" in
		/data/*/* | /tmp/*/* | /mnt/*/*/* | /usr/share/verso/history/*) ;;
		/data/verso | /usr/share/verso/history)
			[ "$(readlink -f "${dir%/*}")" = "${dir%/*}" ] &&
				{ mkdir -m 0700 "$dir" 2>/dev/null || { [ -d "$dir" ] && [ ! -L "$dir" ]; }; } &&
				chown -h verso:verso "$dir"
			;;
		/data/?* | /tmp/?* | /mnt/?*/?*)
			[ "$(readlink -f "${dir%/*}")" = "${dir%/*}" ] &&
				mkdir -m 0700 "$dir" 2>/dev/null &&
				chown -h verso:verso "$dir"
			;;
	esac
	echo "$dir"
}

start_service() {
	local listen_http listen_https redirect_https addr history from changes probes alert_url heartbeat_url alert_kinds kind theme
	make_certificate
	# Where the shell answers is a Verso setting (ADR-017 §1): read here and
	# handed over on the command line, as uhttpd's init script hands uhttpd its
	# own: procd records an instance's command line, and a change to it is what
	# carries applied listeners to the shell's next start. An absent option is
	# not passed, and the shell holds what that means.
	config_load verso
	config_get listen_http web listen_http
	config_get listen_https web listen_https
	config_get redirect_https web redirect_https
	procd_open_instance verso
	procd_set_param command /usr/bin/verso
	for addr in $listen_https; do
		procd_append_param command -listen-https "$addr"
	done
	for addr in $listen_http; do
		procd_append_param command -listen-http "$addr"
	done
	[ -n "$redirect_https" ] && procd_append_param command -redirect-https "$redirect_https"
	history="$(history_dir)"
	[ -n "$history" ] && procd_append_param command -history-dir "$history"
	# A directory chosen since the history was last opened takes it at this
	# start: the shell moves it from where it was (ADR-019).
	from="$(history_from)"
	[ -n "$history" ] && [ -n "$from" ] && [ "$from" != "$history" ] &&
		procd_append_param command -history-from "$from"
	# How many entries config history keeps (ADR-021): 1000 unless the
	# operator says otherwise, as a whole number, so a typo cannot keep the
	# shell from starting.
	config_get changes history changes
	case "$changes" in
		'' | *[!0-9]*) ;;
		*) procd_append_param command -history-changes "$changes" ;;
	esac
	# Addresses on the internet the uplink is probed at beside its gateway
	# (ADR-019); none unless the operator lists them, since reaching out
	# unattended is opt-in (ADR-014).
	config_get probes history probe
	for addr in $probes; do
		procd_append_param command -probe "$addr"
	done
	# Where alerts and the heartbeat go, and which kinds alert (ADR-020);
	# nothing is sent unless the operator gives an address. An apply reaches
	# the running shell through its own confirm, so these carry the settings
	# to the next start.
	config_get alert_url alerts url
	config_get heartbeat_url alerts heartbeat
	config_get alert_kinds alerts kind
	[ -n "$alert_url" ] && procd_append_param command -alert-url "$alert_url"
	[ -n "$heartbeat_url" ] && procd_append_param command -heartbeat-url "$heartbeat_url"
	for kind in $alert_kinds; do
		procd_append_param command -alert-kind "$kind"
	done
	# The theme in force (ADR-024); unset, Sand follows the browser. The
	# Appearance card writes it and the running shell swaps its own, so this
	# carries the choice to the next start.
	config_get theme ui theme
	[ -n "$theme" ] && procd_append_param command -theme "$theme"
	# Multipart uploads spill to a private, group-protected runtime directory.
	# This keeps large backup/firmware bodies out of the shared system /tmp and
	# works even on images whose tmpfs is not writable by unprivileged services.
	procd_set_param env TMPDIR=/var/run/verso VERSO_TLS_DIR="$TLS_DIR"
	# The running shell changes its own listeners when an apply changes them
	# (ADR-017 §1), so the applied config must not restart it: procd sends
	# reload_signal in place of a restart when the instance changes, and records
	# the new command line for the next start. SIGHUP re-reads the certificate,
	# which is harmless. A hand edit takes effect on `/etc/init.d/verso restart`.
	procd_set_param reload_signal HUP
	# De-privilege the shell (ADR-007): run as the non-root `verso` user so it
	# cannot write /etc/config directly and does not get ubusd's uid-0 ACL
	# exemption — every backend op is then bounded by rpcd + the verso acl.d
	# grant. CAP_NET_BIND_SERVICE is the one capability kept (to bind :80/:443 in
	# production); no_new_privs blocks regaining anything via setuid binaries.
	#
	# procd applies capabilities and no_new_privs only through ujail, and runs
	# ujail only for an instance that declares a jail. This one names itself and
	# asks for nothing else: no filesystem, network or user namespace, so the
	# shell sees the router as it is, as the verso user with the one capability.
	# Without ujail procd still drops the user, and the shell, refused the
	# router's ports, answers on 8443 (ADR-017 §2). Do NOT make the dev
	# container privileged for any of this — that re-exposes /dev/watchdog and
	# can reboot the host (see docker-compose.yml).
	procd_add_jail verso
	procd_set_param user verso
	procd_set_param group verso
	procd_set_param capabilities /etc/capabilities/verso.json
	procd_set_param no_new_privs 1
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# stop_service records where the stopping shell keeps the history while
# another directory is chosen (history_note): a restart after a hand edit, a
# shutdown or an upgrade stops the shell before the start that moves it.
stop_service() {
	config_load verso
	history_note >/dev/null
}

service_triggers() {
	procd_add_reload_trigger verso
}
