#
# Points nlbwmon at the history Verso reads (ADR-018): one period a day, thirteen
# months of them, on storage that survives a reboot. The interval and the
# generations are Verso's, set every time; the directory moves only while it is
# the stock tmpfs one, so an owner's own choice stays.
#
# `usage-setup remove` gives nlbwmon its stock period, generations and tmpfs
# directory back, the directory only while it is one Verso chose. The days
# already written stay where they are, so a reinstall reads them again.
#
# nlbwmon is committed and a running one restarted only when a setting changed.
# A restart reads the router's whole connection table again at once: on a busy
# router it logs a line for every connection past nlbwmon's database_limit, and
# counts those connections without their device. An upgrade that changes no
# setting leaves it running.
mode=${1:-install}
case "$mode" in install|remove) ;; *) exit 2 ;; esac
cfg=nlbwmon.@nlbwmon[0]
init=${NLBWMON_INIT:-/etc/init.d/nlbwmon}
uci -q get "$cfg" >/dev/null || exit 0

changed=
# want sets option $1 to $2 where it holds anything else.
want() {
	[ "$(uci -q get "$cfg.$1")" = "$2" ] && return
	uci -q set "$cfg.$1=$2"
	changed=1
}

directory=$(uci -q get "$cfg.database_directory")
if [ "$mode" = remove ]; then
	want database_interval 1
	want database_generations 10
	case "$directory" in
	/data/nlbwmon | /usr/share/nlbwmon/db) want database_directory /var/lib/nlbwmon ;;
	esac
else
	want database_interval 2026-01-01/1
	want database_generations 400
	if [ "$directory" = /var/lib/nlbwmon ]; then
		if grep -qs ' /data ' /proc/mounts; then
			want database_directory /data/nlbwmon
		else
			want database_directory /usr/share/nlbwmon/db
		fi
	fi
fi
[ -n "$changed" ] || exit 0
uci -q commit nlbwmon
"$init" running 2>/dev/null && "$init" restart
exit 0
